---
/**
 * Homepage — one-pager.
 *
 * Each case study is inlined as a `<Showcase>` block (Rina Kang /
 * Aaron James-style mini case studies) instead of linking out to a deep
 * case-study page from a tile grid. Each block has an interactive hero
 * (auto-cycling phone stack or looping GIF) and a CTA to the full case
 * study for anyone who wants the long version.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import FadeIn from "../components/FadeIn.astro";
import HeroGrid from "../components/HeroGrid.astro";
import Arrow from "../components/Arrow.astro";
import Showcase from "../components/showcase/Showcase.astro";
import PhoneVideoParallax from "../components/showcase/PhoneVideoParallax.astro";
import VideoCardStack from "../components/showcase/VideoCardStack.astro";
import { snapchatGamesStackItems } from "../components/showcase/projects/snapchatGamesStack";
import MediaParallax from "../components/showcase/MediaParallax.astro";
import TappyCloudShowcase from "../components/showcase/projects/TappyCloudShowcase.astro";
import FestivalModeShowcase from "../components/showcase/projects/FestivalModeShowcase.astro";
import { showcaseContent } from "../data/showcases";

const snapchatGames = showcaseContent["snapchat-games"];
const topicChats = showcaseContent["topic-chats"];

const heroStatements = [
  "I design the moments where people connect.",
  "I build products used by millions daily.",
  "I turn ambiguous problems into shipped products.",
];

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="Julia Tang | Product Designer">
  <section class="v2-hero" data-home-hero>
    <HeroGrid />

    <div class="hero-reveal hero-reveal--snap" aria-hidden="true">
      <div class="hero-reveal__item hero-reveal__item--snap-chat">
        <div class="hero-reveal__chat-crop">
          <img src={`${base}/projects/hero/snap-chat.gif`} alt="" />
        </div>
      </div>
      <div class="hero-reveal__item hero-reveal__item--snap-envelope">
        <img src={`${base}/projects/hero/snap-envelope.png`} alt="" />
      </div>
      <div class="hero-reveal__item hero-reveal__item--snap-valentine">
        <img src={`${base}/projects/hero/valentinesday.png`} alt="" />
      </div>
    </div>

    <div class="hero-reveal hero-reveal--tinder" aria-hidden="true">
      <div class="hero-reveal__item hero-reveal__item--tinder-phone">
        <img src={`${base}/projects/hero/tinder-swiping.gif`} alt="" />
      </div>
      <div class="hero-reveal__item hero-reveal__item--tinder-festival">
        <img src={`${base}/projects/hero/festival-mode-hero.gif`} alt="" />
      </div>
    </div>

    <div class="v2-hero__grid">
      <div class="v2-hero__text">
        <FadeIn>
          <p class="v2-hero__eyebrow"><span class="v2-hero__wave" aria-hidden="true"><svg
              class="v2-hero__wave-hand"
              viewBox="0 0 32 32"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            ><path d="M9 11 V 7 a 2 2 0 0 1 4 0 v 9"/><path d="M13 7 V 5 a 2 2 0 0 1 4 0 v 11"/><path d="M17 7 V 6 a 2 2 0 0 1 4 0 v 11"/><path d="M21 9 V 8 a 2 2 0 0 1 4 0 v 9 c 0 6.5 -5 10 -10 10 -5.5 0 -10 -3.5 -10 -9 a 2 2 0 0 1 3.4 -1.4 l 1.6 1.4"/></svg></span><span class="v2-hero__hint"><span class="v2-hero__name"><span class="v2-hero__handwriting" role="img" aria-label="Hi, I'm Julia."></span><svg
              class="v2-hero__squiggle"
              viewBox="0 0 120 12"
              preserveAspectRatio="none"
              aria-hidden="true"
              focusable="false"
            ><path d="M2 7 C 14 1, 26 11, 38 6 S 62 1, 74 7 S 98 11, 118 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></span><span class="v2-hero__avatar" aria-hidden="true"><img src={`${base}/julia-avatar.png`} alt="" class="v2-hero__avatar-img" /><span class="v2-hero__avatar-wave v2-hero__avatar-wave--1"><svg viewBox="0 0 100 16" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" focusable="false"><path d="M2 8 C 12 0, 22 16, 32 8 S 52 0, 62 8 S 82 16, 98 8" /></svg></span><span class="v2-hero__avatar-wave v2-hero__avatar-wave--2"><svg viewBox="0 0 100 16" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" focusable="false"><path d="M2 8 C 12 0, 22 16, 32 8 S 52 0, 62 8 S 82 16, 98 8" /></svg></span><span class="v2-hero__avatar-wave v2-hero__avatar-wave--3"><svg viewBox="0 0 100 16" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" focusable="false"><path d="M2 8 C 12 0, 22 16, 32 8 S 52 0, 62 8 S 82 16, 98 8" /></svg></span></span></span></p>
        </FadeIn>

        <FadeIn delay={120}>
          <h1 class="v2-hero__headline" aria-label={heroStatements.join(" / ")}>
            {heroStatements.map((statement, i) => {
              const words = statement.split(" ");
              return (
                <span
                  class:list={["v2-hero__rot", { "is-active": i === 0 }]}
                  data-rot-index={i}
                  aria-hidden={i === 0 ? undefined : "true"}
                >
                  {words.flatMap((word, j) => {
                    const span = (
                      <span class="v2-hero__word" style={`--j:${j}`}>{word}</span>
                    );
                    return j === 0 ? [span] : [" ", span];
                  })}
                </span>
              );
            })}
          </h1>
        </FadeIn>

        <FadeIn delay={220}>
          <div class="v2-hero__meta" data-meta-scroll>
            <p class="v2-hero__meta-col v2-hero__meta-col--snap" data-cursor="scroll-pill">
              Currently building social experiences at <a class="hero-co hero-co--snap" href="#snapchat-games"><img src={`${base}/logos/snapchat.png`} alt="" aria-hidden="true" />Snapchat</a> with Cursor and Claude.
            </p>
            <p class="v2-hero__meta-col v2-hero__meta-col--tinder" data-cursor="scroll-pill">
              Previously led the swipe stack and introduced dynamic profiles at <a class="hero-co hero-co--tinder" href="#tappy-cloud"><img src={`${base}/logos/tinder.png`} alt="" aria-hidden="true" />Tinder</a>.
            </p>
            <p class="v2-hero__meta-col v2-hero__meta-col--ai">
              Tinkering with AI on the side. <span class="v2-hero__meta-secondary">AI projects coming soon. In the meantime, have fun with this <button type="button" class="v2-hero__doodle-link" data-doodle-trigger>doodle tool I vibecoded</button>.</span>
            </p>
          </div>
        </FadeIn>
      </div>
    </div>

    <!--
      Hand-drawn arrow from the "doodle tool I vibecoded" link down to
      the doodle toolbar. Visibility, path math, and animation are all
      handled by the Arrow component itself; we only pass the start /
      end / trigger selectors and the toolbar's lift compensation.
    -->
    <Arrow
      from=".v2-hero__doodle-link"
      to=".doodle__bar"
      toAnchor="top-center"
      trigger=".v2-hero__meta-col--ai"
      padding={12}
      liftCompensation={36}
      liftActiveSelector="[data-prompted], [data-active]"
    />
  </section>

  <script is:inline>
    // Rotate the hero headline through the prepared statements.
    // Statements are positioned in the same cell; we measure each one's
    // height and animate the container so the meta line below moves up
    // for shorter statements (no awkward gap).
    (() => {
      const headline = document.querySelector(".v2-hero__headline");
      const slots = document.querySelectorAll(".v2-hero__rot");
      if (!headline || slots.length < 1) return;

      // Switch layout to absolute-stacking so each statement's measured
      // height is its OWN rendered height (not the grid cell's max).
      headline.classList.add("is-measured");

      // Measure each statement's natural height by promoting it to a
      // normal-flow box one at a time. Pre-measuring while every slot is
      // absolutely positioned at the same coords yields a per-statement
      // height of zero (or the first slot's height) on some browsers, so
      // the longest statement gets clipped. Promoting + restoring is a
      // single layout pass per slot and runs once on load.
      function measure() {
        const out = [];
        for (const s of slots) {
          const prevPos = s.style.position;
          const prevVis = s.style.visibility;
          s.style.position = "static";
          s.style.visibility = "hidden";
          out.push(s.offsetHeight);
          s.style.position = prevPos;
          s.style.visibility = prevVis;
        }
        return out;
      }

      let heights = measure();
      let i = 0;
      headline.style.height = heights[i] + "px";

      // Web fonts (Geist) can land after this script runs; metrics shift
      // enough on the longest statement to clip a line. Remeasure once
      // fonts settle so the headline reserves the right height.
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(() => {
          heights = measure();
          headline.style.height = heights[i] + "px";
        });
      }

      let resizeT;
      window.addEventListener("resize", () => {
        clearTimeout(resizeT);
        resizeT = setTimeout(() => {
          heights = measure();
          headline.style.height = heights[i] + "px";
        }, 120);
      });

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce || slots.length < 2) return;
      setInterval(() => {
        slots[i].classList.remove("is-active");
        slots[i].setAttribute("aria-hidden", "true");
        i = (i + 1) % slots.length;
        slots[i].classList.add("is-active");
        slots[i].removeAttribute("aria-hidden");
        headline.style.height = heights[i] + "px";
      }, 4600);
    })();

    // Replay the greeting flourish on eyebrow hover:
    //   enter → re-run a short wave pendulum + draw squiggle L-to-R
    //   leave → erase squiggle L-to-R (wave pendulum self-resolves to 0°)
    // The first hover takes over from the on-load intro animation by
    // clearing inline `animation` and using transitions for the squiggle.
    (() => {
      const eyebrow = document.querySelector(".v2-hero__eyebrow");
      const path = document.querySelector(".v2-hero__squiggle path");
      const hand = document.querySelector(".v2-hero__wave-hand");
      if (!eyebrow || !path || !hand) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      const DRAW_EASE = "cubic-bezier(0.22, 1, 0.36, 1)";
      const ERASE_EASE = "cubic-bezier(0.4, 0, 0.6, 1)";
      const DRAW_MS = 700;
      const ERASE_MS = 700;

      function drawIn() {
        // Reset to invisible-before-draw, then transition to drawn.
        path.style.animation = "none";
        path.style.transition = "none";
        path.style.strokeDashoffset = "120";
        // Force reflow so the next transition picks up the reset.
        void path.getBoundingClientRect();
        path.style.transition = "stroke-dashoffset " + DRAW_MS + "ms " + DRAW_EASE;
        path.style.strokeDashoffset = "0";
      }

      function eraseOut() {
        path.style.animation = "none";
        path.style.transition = "stroke-dashoffset " + ERASE_MS + "ms " + ERASE_EASE;
        path.style.strokeDashoffset = "-120";
      }

      function replayWave() {
        hand.style.animation = "none";
        void hand.getBoundingClientRect();
        hand.style.animation =
          "hero-wave-pendulum-hover 1800ms cubic-bezier(0.36, 0, 0.64, 1) 1 both";
      }

      eyebrow.addEventListener("mouseenter", () => {
        drawIn();
        replayWave();
      });
      eyebrow.addEventListener("mouseleave", () => {
        eraseOut();
      });
    })();

    // Meta-column → case-study scroll. Clicking anywhere in the
    // .v2-hero__meta-col--snap or .v2-hero__meta-col--tinder column
    // (away from the inner company link) jumps to that company's
    // first case study on the page — same behavior the "See my work"
    // cursor pill is advertising. Inner <a> clicks pass through to
    // their own href so the existing scroll targets still work.
    //
    // The whole interaction is desktop-only: on touch/no-hover devices
    // the column reveal images don't render and the column reads as
    // plain prose, so a tap shouldn't surprise-scroll the page either.
    (() => {
      const canHover = window.matchMedia("(hover: hover)").matches;
      if (!canHover) return;
      const targets = [
        { sel: ".v2-hero__meta-col--snap", href: "#snapchat-games" },
        { sel: ".v2-hero__meta-col--tinder", href: "#tappy-cloud" },
      ];
      for (const { sel, href } of targets) {
        const col = document.querySelector(sel);
        if (!col) continue;
        col.style.cursor = "pointer";
        col.addEventListener("click", (e) => {
          // If the click already landed on a link, let it handle itself.
          if (e.target.closest && e.target.closest("a")) return;
          const target = document.querySelector(href);
          if (target) target.scrollIntoView({ behavior: "smooth", block: "center" });
        });
      }
    })();

    // AI meta column → doodle prompt. Hovering the third column flags
    // the doodle root with `data-prompted`, which the toolbar reads to
    // scale up, tint its halo to the active brush color, and surface
    // the "Press D to doodle" hint underneath. The hint and lift are
    // desktop-only at the CSS layer, so this stays hands-off on touch.
    //
    // The arrow itself (visibility, path math, animation) lives in the
    // <Arrow> component above; this IIFE only handles the doodle-side
    // state hookups. The click handler on the inline "doodle tool I
    // vibecoded" button arms draw mode directly — on mobile this is
    // the only available entry point (no hover, no D key); on desktop
    // it's a bonus path alongside the keyboard shortcut.
    //
    // Deferred to DOMContentLoaded because <DoodleToolbar /> is rendered
    // by BaseLayout AFTER <main>, so [data-doodle] doesn't exist yet
    // while this script is parsed inside <main>.
    (() => {
      function init() {
        const aiCol = document.querySelector(".v2-hero__meta-col--ai");
        const doodle = document.querySelector("[data-doodle]");
        if (!aiCol || !doodle) return;

        const onEnter = () => doodle.setAttribute("data-prompted", "");
        const onLeave = () => doodle.removeAttribute("data-prompted");
        aiCol.addEventListener("mouseenter", onEnter);
        aiCol.addEventListener("mouseleave", onLeave);
        // Drop the prompted state when focus leaves the column too,
        // so Tab-out doesn't strand the halo.
        aiCol.addEventListener("focusout", (e) => {
          if (!aiCol.contains(e.relatedTarget)) onLeave();
        });

        // Scroll bounds check: the toolbar halo / lift / "Press D"
        // hint should drop the moment the AI column scrolls out from
        // under a stationary cursor, even without a mouseleave. Reads
        // --cursor-x / --cursor-y published by CustomCursor on <html>
        // (set on every mousemove). Falls back to closing on any
        // scroll if those vars aren't populated. The Arrow component
        // does the same check for its own visibility, so the halo +
        // arrow stay in lockstep.
        let scrollRaf = 0;
        const checkOnScroll = () => {
          scrollRaf = 0;
          if (!doodle.hasAttribute("data-prompted")) return;
          const html = document.documentElement;
          const cx = parseFloat(html.style.getPropertyValue("--cursor-x"));
          const cy = parseFloat(html.style.getPropertyValue("--cursor-y"));
          if (Number.isFinite(cx) && Number.isFinite(cy)) {
            const r = aiCol.getBoundingClientRect();
            const inside =
              cx >= r.left && cx <= r.right && cy >= r.top && cy <= r.bottom;
            if (inside) return;
          }
          onLeave();
        };
        window.addEventListener(
          "scroll",
          () => {
            if (scrollRaf) return;
            scrollRaf = requestAnimationFrame(checkOnScroll);
          },
          { passive: true }
        );

        // "doodle tool I vibecoded" → arm draw mode on desktop; on
        // touch / no-hover devices we instead surface the arrow and
        // toolbar halo (data-prompted), since the user can't see the
        // hover affordance otherwise. They tap the toolbar itself to
        // actually arm the pencil. The hover-capable check uses the
        // (hover: hover) media query so phones / tablets get the
        // prompt-only behavior even at desktop widths.
        const trigger = aiCol.querySelector("[data-doodle-trigger]");
        const pencilBtn = doodle.querySelector('[data-tool="draw"]');
        let promptTimer = 0;
        function showPrompt() {
          doodle.setAttribute("data-prompted", "");
          aiCol.dispatchEvent(new MouseEvent("mouseenter"));
          if (promptTimer) window.clearTimeout(promptTimer);
          promptTimer = window.setTimeout(() => {
            doodle.removeAttribute("data-prompted");
            aiCol.dispatchEvent(new MouseEvent("mouseleave"));
            promptTimer = 0;
          }, 4000);
        }
        if (trigger && pencilBtn) {
          trigger.addEventListener("click", (e) => {
            e.preventDefault();
            const canHover =
              window.matchMedia("(hover: hover)").matches;
            if (canHover) {
              if (pencilBtn.classList.contains("is-active")) return;
              pencilBtn.click();
              return;
            }
            // Touch: surface the arrow + halo. Stop propagation so the
            // column-wide tap handler below doesn't also fire and toggle
            // the prompt back off.
            e.stopPropagation();
            showPrompt();
          });
        }

        // On touch, tapping ANYWHERE in the AI column (not just the
        // inline "doodle tool I vibecoded" link) should surface the
        // arrow pointing down to the toolbar. This mirrors what hover
        // does on desktop, since the column is the only hero meta col
        // that stays interactive on mobile (Snap / Tinder are inert).
        // Match the same media-query envelope the rest of the touch
        // surfaces use so a desktop-emulated mobile viewport still
        // exercises this code path.
        const isTouchSurface = window.matchMedia(
          "(hover: none), (pointer: coarse), (max-width: 720px)"
        ).matches;
        if (isTouchSurface) {
          aiCol.style.cursor = "pointer";
          aiCol.addEventListener("click", (e) => {
            // Inline link inside the column has its own handler that
            // already calls showPrompt — don't double-fire here.
            if (trigger && trigger.contains(e.target)) return;
            showPrompt();
          });
        }
      }
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init, { once: true });
      } else {
        init();
      }
    })();
  </script>

  <span id="work" aria-hidden="true"></span>
  <FadeIn class="fade-in--showcase">
    <Showcase
      companyLogo={snapchatGames.companyLogo}
      companyName={snapchatGames.companyName}
      role={snapchatGames.role}
      title={snapchatGames.title}
      tagline={snapchatGames.tagline}
      stats={snapchatGames.stats}
      statsGap="var(--s-3)"
      statsMaxWidth="36ch"
      ctaHref="/product-design/snapchat-games"
      ctaLabel="See how it scaled"
      accent={snapchatGames.accent}
      reverse
      tightHero
      id="snapchat-games"
    >
      <div data-cursor-bg="light">
        <VideoCardStack
          items={[...snapchatGamesStackItems]}
          hintTarget="#snapchat-games .showcase__text"
          autoShuffle
          autoShuffleMs={4000}
        />
      </div>
    </Showcase>
  </FadeIn>

  <FadeIn class="fade-in--showcase">
    <Showcase
      companyLogo={topicChats.companyLogo}
      companyName={topicChats.companyName}
      role={topicChats.role}
      title={topicChats.title}
      tagline={topicChats.tagline}
      stats={topicChats.stats}
      ctaHref="/product-design/topic-chats"
      ctaLabel="Read the case study"
      press={topicChats.press}
      accent={topicChats.accent}
      id="topic-chats"
    >
      <div data-cursor-bg="dark" style="transform: rotate(2deg); transform-origin: 50% 50%;">
        <MediaParallax
          src="/projects/topic-chats/topic-chat-sizzle.mp4"
          aspect="9 / 16"
          maxWidth="396px"
          label="Topic Chats feature sizzle reel"
          cellLeftSrc="/projects/topic-chats/Scoreboard.png"
          cellLeftAlt="Real-time sports scoreboard pinned inside a Topic Chat"
          cellLeftWidth="clamp(280px, 88%, 380px)"
          cellRightSrc="/projects/topic-chats/liveactivitywidget-detail.png"
          cellRightAlt="Topic Chats live activity widget detail"
          cellRightWidth="clamp(260px, 82%, 360px)"
        />
      </div>
    </Showcase>
  </FadeIn>

  <div id="tappy-cloud" data-cursor-bg="dark">
    <FadeIn class="fade-in--showcase">
      <TappyCloudShowcase reverse />
    </FadeIn>
  </div>

  <FadeIn class="fade-in--showcase">
    <Showcase
      companyLogo="/logos/tinder.png"
      companyName="Tinder"
      role="Senior Product Designer"
      title="App Redesign"
      tagline={[
        "Tinder's design language and profile system had barely changed since the app's inception. Profiles felt shallow because the content was shallow, and the app felt outdated because we hadn't invested in refreshed visuals or new interactions in years.",
        "I designed Sparks: Prompts, Quizzes, and refreshed swipe and match animations that gave people more to react to. Started as a 2022 Hackathon win, shipped globally in 2023.",
      ]}
      stats={[
        { value: "↑ 0.8%", label: "Subscription Cash" },
        { value: "↑ 0.3%", label: "Days Active" },
        { value: "↑ 0.9%", label: "Likes Sent" },
      ]}
      statsGap="var(--s-3)"
      statsMaxWidth="36ch"
      ctaHref="https://techcrunch.com/2023/11/20/tinder-redesigns-profile-pages-with-prompts-info-tags-and-quiz/"
      ctaLabel="See press coverage"
      press={[
        {
          src: "/projects/festival-mode/techcrunch-dark-logo.png",
          alt: "TechCrunch",
          href: "https://techcrunch.com/2023/11/20/tinder-redesigns-profile-pages-with-prompts-info-tags-and-quiz/",
        },
      ]}
      accent="#FD297C"
      id="app-redesign"
    >
      <PhoneVideoParallax
        videoSrc="/projects/tinder-app-redesign/sparks-recording.mp4"
        frameSrc="/projects/tinder-app-redesign/phone-frame.png"
        badgeSrc="/projects/tinder-app-redesign/Hackathon_winner_badge.png"
        promptSrc="/projects/tinder-app-redesign/Prompt.png"
        quizSrc="/projects/tinder-app-redesign/quiz.png"
        videoLabel="Tinder Sparks profile redesign in motion"
        badgeAlt="2022 Tinder Hackathon Winner badge"
        promptAlt="Tinder Prompts feature example"
        quizAlt="Tinder Quizzes feature example"
      />
    </Showcase>
  </FadeIn>

  <FadeIn class="fade-in--showcase">
    <div data-cursor-bg="dark">
      <FestivalModeShowcase reverse />
    </div>
  </FadeIn>

  <div class="home-footer-spacer" aria-hidden="true"></div>

</BaseLayout>

<style>
  .home-footer-spacer {
    height: var(--s-24);
  }
  @media (max-width: 720px) {
    .home-footer-spacer { height: var(--s-16); }
  }

  /* Desktop-only decorative nudge: the staggered Dynamic Profiles columns
     read better pulled slightly left into the gutter. Below the desktop
     breakpoint the section fills the column, so the shift would push its
     left edge (eyebrow, logo, title) off-canvas — drop it there. */
  :global(#tappy-cloud) {
    transform: translateX(-40px);
  }
  @media (max-width: 1023px) {
    :global(#tappy-cloud) {
      transform: none;
    }
  }

  /* Tappy Cloud's staggered columns make the section visually taller
     than the others, so give it extra breathing room from the topic-chats
     section above and the app-redesign section below. */
  :global(#tappy-cloud) :global(.showcase) {
    padding-block: var(--s-32);
  }
  @media (max-width: 720px) {
    :global(#tappy-cloud) :global(.showcase) {
      padding-block: var(--s-16);
    }
  }

  .v2-hero {
    position: relative;
    overflow: visible;
    padding-top: 0;
    padding-bottom: var(--s-16);
    /* Locked so the dot background never reflows when the rotating headline
       changes line count. Sized so the right text block sits visually centered
       with the left rail's nav and the rotating 100px display headline has
       room to land 2 or 3 lines without clipping. Capped to viewport height
       on shorter laptops so the scroll chevron at the bottom never falls
       below the fold. */
    min-height: min(820px, 100vh);
  }
  @media (max-width: 1023px) {
    /* Off-desktop the SideRail collapses into the sticky Header, so the hero
       no longer needs to reserve the desktop rail's full ~820px height —
       size it to roughly the tallest 3-line headline + 3-paragraph meta
       block + paddings, then let content flow. The old 640px floor left
       ~280px of empty dot field below the meta on tablet. */
    .v2-hero { min-height: 0; padding-top: var(--s-12); padding-bottom: var(--s-12); }
  }
  @media (max-width: 720px) {
    .v2-hero { padding-top: var(--s-8); padding-bottom: var(--s-10); }
  }
  @media (max-width: 420px) {
    .v2-hero { padding-top: var(--s-6); padding-bottom: var(--s-8); }
  }

  /* The global SideRail handles wordmark + nav on desktop; on smaller
     widths the rail collapses and the sticky Header takes over (rule
     lives in global.css so it applies to every page, not just home). */

  /* Anchor scroll targets sit below the (restored on scroll) sticky header. */
  :global(#snapchat-games),
  :global(#topic-chats),
  :global(#tappy-cloud),
  :global(#app-redesign) {
    scroll-margin-top: 80px;
  }

  /* 12-col grid container — desktop.
     Row 1 (auto): wordmark pinned at the top-left, no other content
     Row 2 (1fr):  nav + text block vertically centered within remaining space
     Drops to a single column under 1024 so the right-side text fills the
     width and the left rail dissolves into the (restored) sticky header. */
  .v2-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto 1fr;
    column-gap: var(--s-6);
    /* Wider than the standard .page container so the wordmark sits close
       to the viewport edge per the Figma; padding stays a touch generous on
       very-wide displays via clamp. */
    max-width: 1640px;
    margin: 0 auto;
    padding: var(--s-10) clamp(var(--s-6), 3vw, var(--s-12)) 0;
    /* Grid is inside .v2-hero which already has --s-16 bottom padding, so
       subtract that from the cap so the outer hero never exceeds the
       viewport (otherwise the scroll chevron falls off-screen). */
    min-height: min(820px, calc(100vh - var(--s-16)));
  }
  @media (max-width: 1023px) {
    .v2-hero__grid {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      grid-template-rows: auto;
      padding: 0 var(--s-6);
      min-height: 0;
    }
  }
  @media (max-width: 720px) {
    .v2-hero__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding: 0 var(--s-5);
    }
  }

  /* Wordmark + nav live in the global <SideRail> now; the hero just
     reserves cols 1-3 visually so the right text block aligns to col 5
     under the same 12-col rhythm. */
  /* Right text block: eyebrow → headline → 2-col meta.
     Vertically centered in row 2 so it visually balances the left-rail nav. */
  .v2-hero__text {
    grid-column: 3 / span 8;
    grid-row: 2;
    align-self: center;
    display: grid;
    row-gap: var(--s-5);
    /* Cap the hero text container so the headline + 3-col meta band
       reads as a contained editorial block rather than sprawling all
       the way to col 10's right edge. 760px is wide enough for the
       100px display headline to hold a 2-line statement (the rotating
       phrases are tuned to break around this width) while making the
       hero feel proportional to the Showcase rows below, where the
       text column itself is only ~440px wide. */
    max-width: 760px;
  }
  .v2-hero__text > :nth-child(2) {
    /* breathy gap below the headline before the meta cols */
    margin-bottom: var(--s-6);
  }
  @media (max-width: 1023px) {
    .v2-hero__text {
      grid-column: 1 / -1;
      grid-row: auto;
      align-self: auto;
      padding-top: var(--s-6);
    }
  }

  .v2-hero__eyebrow {
    font-family: var(--font-hand);
    font-size: clamp(28px, 2.6vw, 40px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.05em;
    text-transform: none;
    color: var(--text-secondary);
    margin: 0;
    display: inline-flex;
    align-items: baseline;
    font-feature-settings: "calt" 0, "liga" 0, "dlig" 0;
  }
  .v2-hero__hint {
    vertical-align: baseline;
  }
  .v2-hero__tight {
    letter-spacing: -0.05em;
  }
  .v2-hero__kern-j {
    margin-right: -0.08em;
  }
  .v2-hero__wave-hand {
    width: 0.78em;
    height: 0.78em;
    color: currentColor;
    overflow: visible;
    transform-origin: 70% 80%;
  }
  /* Scanned handwritten "Hi, I'm Julia." rendered via CSS mask so it
     inherits color: var(--text-secondary) from the eyebrow and follows
     light/dark mode automatically. Height matches the wave hand icon. */
  .v2-hero__handwriting {
    display: inline-block;
    height: 0.78em;
    aspect-ratio: 1485 / 260;
    vertical-align: baseline;
    background-color: currentColor;
    -webkit-mask: url("/hi-im-julia.svg") center / contain no-repeat;
            mask: url("/hi-im-julia.svg") center / contain no-repeat;
  }

  /* One-shot greeting flourish on page load. Wave + squiggle finish at
     the same absolute time (both end at 5400ms after page load).
     Squiggle exits left-to-right so it reads as the line continuing on.

     Wave uses two stacked animations on nested spans so the pendulum
     rotation runs the FULL duration (starts immediately during slide-in)
     while the slide-in/out is symmetric (same easing, same 600ms each). */
  .v2-hero__hint { display: inline-block; position: relative; }

  /* Easter egg: hover "Hi, I'm Julia." to reveal Julia's avatar + squiggles
     drifting to the right of the line. */
  .v2-hero__avatar {
    position: absolute;
    left: calc(100% + 0.15em);
    top: 50%;
    width: 4.1em;
    height: 4.1em;
    transform: translateY(-50%) translateX(-6px) scale(0.85);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 280ms var(--ease-out),
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .v2-hero__avatar-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
  }
  /* Three sine-wave squiggles, each anchored at the avatar center and
     rotated outward so they read as radiating from the portrait. */
  .v2-hero__avatar-wave {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2.6em;
    height: 0.8em;
    transform-origin: 0 50%;
    color: var(--brand-primary, currentColor);
    pointer-events: none;
  }
  .v2-hero__avatar-wave svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .v2-hero__avatar-wave path {
    stroke-dasharray: 110;
    stroke-dashoffset: 110;
  }
  /* Translate outward past the avatar edge with breathing room. */
  .v2-hero__avatar-wave--1 { transform: rotate(-60deg) translateX(3em); }
  .v2-hero__avatar-wave--2 { transform: rotate(-20deg) translateX(3.1em); }
  .v2-hero__avatar-wave--3 { transform: rotate(25deg)  translateX(3em); }

  .v2-hero__hint:hover .v2-hero__avatar {
    opacity: 1;
    transform: translateY(-50%) translateX(0) scale(0.72);
  }
  /* On hover, each wave draws in from the avatar end then erases from the
     same end, so the line reads as traveling outward away from the circle.
     Loops while hover holds. */
  .v2-hero__hint:hover .v2-hero__avatar-wave path {
    animation: avatar-wave-radiate 1800ms cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  .v2-hero__hint:hover .v2-hero__avatar-wave--1 path { animation-delay: 0ms; }
  .v2-hero__hint:hover .v2-hero__avatar-wave--2 path { animation-delay: 200ms; }
  .v2-hero__hint:hover .v2-hero__avatar-wave--3 path { animation-delay: 400ms; }
  @keyframes avatar-wave-radiate {
    0%   { stroke-dashoffset: 110; }
    45%  { stroke-dashoffset: 0; }
    55%  { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -110; }
  }
  @media (prefers-reduced-motion: reduce) {
    .v2-hero__avatar { transition: none; }
    .v2-hero__hint:hover .v2-hero__avatar-wave path { animation: none; }
  }
  .v2-hero__wave {
    display: inline-block;
    width: 0;
    margin-right: 0;
    opacity: 0;
    /* outer: slides in once and stays — wave is a permanent fixture. */
    animation: hero-wave-slide 600ms cubic-bezier(0.22, 1, 0.36, 1) 600ms 1 both;
    will-change: transform, opacity, width;
  }
  .v2-hero__wave-hand {
    transform-origin: 70% 80%;
    /* inner: pendulum runs through the slide-in and the next few
       seconds, then settles to rest at 0°. */
    animation: hero-wave-pendulum 4200ms cubic-bezier(0.36, 0, 0.64, 1) 600ms 1 both;
  }
  .v2-hero__name {
    position: relative;
    display: inline-block;
    color: inherit;
  }
  .v2-hero__squiggle {
    position: absolute;
    /* Anchor under the "Julia." portion of the handwriting (roughly the
       right ~45% of the phrase) rather than spanning the whole line. */
    left: 55%;
    right: 0;
    bottom: -0.18em;
    width: 45%;
    height: 0.32em;
    color: var(--brand-primary, currentColor);
    pointer-events: none;
    overflow: visible;
  }
  .v2-hero__squiggle path {
    stroke-dasharray: 120;
    stroke-dashoffset: 120;
    /* Delay 900ms → draw in 900ms → hold → erase L-to-R, ends at 4500ms total. */
    animation: hero-squiggle-intro 3600ms linear 900ms 1 both;
  }

  /* Slide in once on load and stay — no exit. */
  @keyframes hero-wave-slide {
    0%   { width: 0;      margin-right: 0;       opacity: 0; transform: translateX(-6px) scale(0.85); }
    100% { width: 0.78em; margin-right: 0.45em;  opacity: 1; transform: translateX(0) scale(1); }
  }

  /* Shorter pendulum used on hover replay — fits in ~1.8s and settles at 0°.
     scaleX(-1) on every frame so the hand stays mirrored throughout the swing. */
  @keyframes hero-wave-pendulum-hover {
    0%   { transform: scaleX(-1) rotate(0deg); }
    10%  { transform: scaleX(-1) rotate(22deg); }
    20%  { transform: scaleX(-1) rotate(-16deg); }
    30%  { transform: scaleX(-1) rotate(18deg); }
    40%  { transform: scaleX(-1) rotate(-12deg); }
    50%  { transform: scaleX(-1) rotate(14deg); }
    60%  { transform: scaleX(-1) rotate(-8deg); }
    72%  { transform: scaleX(-1) rotate(8deg); }
    84%  { transform: scaleX(-1) rotate(-3deg); }
    100% { transform: scaleX(-1) rotate(0deg); }
  }

  /* Pendulum: starts swinging at 0% so the wave is already mid-wave as
     it slides in. Five decaying swings, then settles at 0° before exit.
     scaleX(-1) on every frame so the hand stays mirrored throughout the swing. */
  @keyframes hero-wave-pendulum {
    0%    { transform: scaleX(-1) rotate(0deg); }
    6.25% { transform: scaleX(-1) rotate(22deg); }
    12.5% { transform: scaleX(-1) rotate(-16deg); }
    20%   { transform: scaleX(-1) rotate(18deg); }
    27.5% { transform: scaleX(-1) rotate(-12deg); }
    35%   { transform: scaleX(-1) rotate(14deg); }
    42.5% { transform: scaleX(-1) rotate(-8deg); }
    50%   { transform: scaleX(-1) rotate(10deg); }
    57.5% { transform: scaleX(-1) rotate(-4deg); }
    65%   { transform: scaleX(-1) rotate(6deg); }
    72.5% { transform: scaleX(-1) rotate(-2deg); }
    80%   { transform: scaleX(-1) rotate(0deg); }
    100%  { transform: scaleX(-1) rotate(0deg); }
  }

  /* Squiggle: draws in L-to-R (0→25%), holds (25→75%), then erases
     L-to-R (75→100%) so the line reads as continuing on rather than
     rewinding. Total active duration = 3600ms; with the 900ms delay
     the whole sequence ends at 4500ms. */
  @keyframes hero-squiggle-intro {
    0%   { stroke-dashoffset: 120;  animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1); }
    25%  { stroke-dashoffset: 0;    animation-timing-function: linear; }
    75%  { stroke-dashoffset: 0;    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); }
    100% { stroke-dashoffset: -120; }
  }

  @media (prefers-reduced-motion: reduce) {
    .v2-hero__wave,
    .v2-hero__wave-hand,
    .v2-hero__squiggle path {
      animation: none;
    }
  }

  /* Rotating headline. Statements are stacked in the same grid cell so the
     tallest one reserves the height and the layout never jumps. */
  .v2-hero__headline {
    margin: 0;
    /* Display serif (Instrument Serif, not italic) for editorial weight
       on the rotating hero statements; sans elsewhere keeps the rest of
       the page utilitarian. */
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(44px, 7.6vw, 100px);
    line-height: 1.1;
    letter-spacing: -0.005em;
    color: var(--text-primary);
    /* Reserve a hair of room below the baseline so serif descenders
       (e.g. `p`, `y`, `g`) don't clip against the headline's
       overflow:hidden during the height transition. */
    padding-bottom: 0.12em;
    display: grid;
    transition: height 620ms var(--ease-out);
    overflow: hidden;
  }
  /* Pre-JS / no-JS fallback: grid stacking, max child reserves height. */
  .v2-hero__rot {
    grid-area: 1 / 1;
    pointer-events: none;
  }
  .v2-hero__rot.is-active {
    pointer-events: auto;
  }
  /* After JS measures each statement, children switch to absolute so the
     container's height can be sized to the ACTIVE statement only (not the
     tallest one). This is what lets the meta line move up for shorter copy. */
  .v2-hero__headline.is-measured {
    display: block;
    position: relative;
  }
  .v2-hero__headline.is-measured .v2-hero__rot {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: auto;
    height: auto;
    grid-area: auto;
  }

  /* Per-word stagger: each word rises into view with a small delay,
     creating a soft wave on rotation. Exit is uniform (no stagger). */
  .v2-hero__word {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.4em);
    filter: blur(6px);
    transition:
      opacity 540ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 720ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 540ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0ms;
    will-change: opacity, transform, filter;
  }
  .v2-hero__rot.is-active .v2-hero__word {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    transition-delay: calc(var(--j, 0) * 45ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .v2-hero__word {
      transition: opacity 200ms ease;
      transform: none;
      filter: none;
    }
    .v2-hero__rot.is-active .v2-hero__word {
      transform: none;
      filter: none;
      transition-delay: 0ms;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .v2-hero__rot { transition: none; transform: none; }
  }

  .v2-hero__meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(var(--s-8), 6vw, var(--s-20));
    row-gap: var(--s-5);
    margin: 0;
  }
  .v2-hero__meta p {
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.25vw, 19px);
    line-height: 1.55;
    color: var(--text-primary);
    margin: 0;
    font-weight: 400;
  }
  .v2-hero__meta-secondary {
    color: var(--text-secondary);
    font-family: var(--font-hand);
    letter-spacing: -0.02em;
    font-size: 1.15em;
    line-height: 1.25;
    display: block;
    margin-top: 0.5em;
  }
  /* The doodle toolbar's prompted-state styling (scale, halo, "Press D
     to doodle" hint) lives in DoodleToolbar.astro and is driven by the
     `data-prompted` attribute that the script above sets on the doodle
     root while this column is hovered. */

  /* Pulled-out phrase that names the easter egg. Rendered as a <button>
     so it's a real interactive control (keyboard, screen reader, native
     click), but reset to inline text styling so it flows in the
     sentence. At rest it carries the same hairline brand underline used
     for fx-- words elsewhere on the site; on column hover (or :active
     during a tap on mobile) the underline fills into a soft brand wash
     so the phrase reads as the destination the arrow is pointing to. */
  .v2-hero__doodle-link {
    appearance: none;
    border: 0;
    margin: 0;
    padding: 0;
    background-color: transparent;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-align: inherit;
    cursor: pointer;
    display: inline;
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    padding-bottom: 1px;
    border-radius: var(--r-xs);
    transition:
      background-size 280ms var(--ease-out),
      background-image 280ms var(--ease-out);
  }
  .v2-hero__meta-col--ai:hover .v2-hero__doodle-link,
  .v2-hero__meta-col--ai:focus-within .v2-hero__doodle-link,
  .v2-hero__doodle-link:hover,
  .v2-hero__doodle-link:focus-visible,
  /* :active is the reliable mobile tap-feedback hook (sticky-hover is
     unreliable across iOS/Android). Pairs with the JS click handler
     below to give a brief wash flash on tap before the toolbar takes
     over. */
  .v2-hero__doodle-link:active {
    background-image: linear-gradient(var(--brand-wash-soft), var(--brand-wash-soft));
    background-size: 100% 100%;
  }
  .v2-hero__doodle-link:focus-visible {
    outline: 2px solid var(--brand-primary-2);
    outline-offset: 3px;
  }

  /* The hand-drawn arrow's styling lives in <Arrow> (src/components/
     Arrow.astro) — global so the SVG can be portaled to <body> at
     runtime without losing scope. The component handles its own
     visibility, animation, and viewport-tracking path math. */

  @media (max-width: 720px) {
    .v2-hero__meta {
      grid-template-columns: 1fr;
      column-gap: 0;
    }
  }

  .v2-hero__pop {
    display: inline-block;
    color: var(--text-primary);
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    padding-bottom: 1px;
    border-radius: var(--r-xs);
    transition:
      background-size 280ms var(--ease-out),
      background-image 280ms var(--ease-out),
      transform 220ms var(--ease-out);
  }

  /* Company name + logo as a clickable link to the first case study of
     that company on the homepage. At rest: subtle brand underline below
     the whole unit. On hover: the underline fills into a full wash in
     that company's color (Snap yellow, Tinder pink) and the unit lifts. */
  .hero-co {
    display: inline-flex;
    align-items: baseline;
    line-height: inherit;
    white-space: nowrap;
    gap: 0.32em;
    margin-left: 0.18em;
    /* Trim the trailing right padding so a sentence-final period sits
       close to the link instead of opening a visible gap and (at narrow
       widths like 320px) wrapping onto its own line as an orphan. */
    padding: 0.08em 0.04em 0.12em 0.18em;
    color: inherit;
    text-decoration: none;
    border-radius: var(--r-xs);
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    /* Anchor the wash to the BOTTOM of the .hero-co box and grow it
       upward on hover. Bottom-anchored avoids the calc()-offset clipping
       that left a sliver missing under the logo. */
    background-position: 0 100%;
    background-size: 100% 0;
    transition:
      background-size 280ms var(--ease-out),
      background-image 280ms var(--ease-out),
      color 220ms var(--ease-out),
      transform 220ms var(--ease-out);
  }
  .hero-co img {
    height: 0.95em;
    width: auto;
    max-width: 1.4em;
    display: inline-block;
    object-fit: contain;
    position: relative;
    z-index: 1;
    /* Nudge down so the logo's optical center sits on the text baseline
       rather than above it. Use margin-top (not transform) so the parent
       .hero-co layout box grows with the offset — otherwise the hover
       wash bg clips at the un-shifted box bottom. */
    margin-top: 0.22em;
  }
  /* Snap ghost PNG has more empty space above the visual mark than the
     Tinder flame, so it reads as floating higher than its sibling at the
     same margin-top. Nudge it down a little more so the optical baselines
     match. */
  .hero-co--snap img {
    margin-top: 0.32em;
  }
  .hero-co:focus-visible {
    outline: 2px solid var(--brand-primary-2, currentColor);
    outline-offset: 4px;
    border-radius: var(--r-xs);
  }

  /* Hover-reveal imagery layer.
     Two groups (snap + tinder): three Snap artifacts, two Tinder. Hidden by
     default, fade in when the matching .hero-co link is hovered. Sits behind
     the text but above the HeroGrid dot field. Pointer-events disabled so
     the imagery never intercepts cursor events targeting the text. */
  .hero-reveal {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 320ms var(--ease-out);
  }
  @media (min-width: 1000px) {
    .v2-hero:has(.v2-hero__meta-col--snap:hover) .hero-reveal--snap,
    .v2-hero:has(.v2-hero__meta-col--snap :focus-visible) .hero-reveal--snap,
    .v2-hero:has(.v2-hero__meta-col--tinder:hover) .hero-reveal--tinder,
    .v2-hero:has(.v2-hero__meta-col--tinder :focus-visible) .hero-reveal--tinder {
      opacity: 1;
    }
    .v2-hero:has(.v2-hero__meta-col--snap:hover) .hero-reveal--snap .hero-reveal__item,
    .v2-hero:has(.v2-hero__meta-col--snap :focus-visible) .hero-reveal--snap .hero-reveal__item,
    .v2-hero:has(.v2-hero__meta-col--tinder:hover) .hero-reveal--tinder .hero-reveal__item,
    .v2-hero:has(.v2-hero__meta-col--tinder :focus-visible) .hero-reveal--tinder .hero-reveal__item {
      transform: translateY(0);
    }
  }
  .hero-reveal__item {
    position: absolute;
    transform: translateY(8px);
    transition: transform 360ms var(--ease-out);
  }
  .hero-reveal__item img {
    width: 100%;
    height: auto;
    display: block;
  }
  /* Snap chat: hugs the LEFT edge, sized small so it lives in the margin
     beside the text rather than under it. The GIF includes a dynamic
     island top and a keyboard bottom that we don't want — crop them out
     with overflow:hidden + a fixed aspect-ratio frame. The visible region
     of the source is y=210..1625 of the 1206x2622 frame, hence
     aspect-ratio 1206/1415 and image translated up 14.85%. */
  .hero-reveal__item--snap-chat {
    width: clamp(234px, 19.8vw, 324px);
    right: 12%;
    top: 8%;
  }
  .hero-reveal__chat-crop {
    position: relative;
    width: 100%;
    aspect-ratio: 1206 / 1449;
    overflow: hidden;
    border-radius: var(--r-md);
    border: 1px solid rgba(20, 20, 40, 0.08);
    box-shadow: 0 24px 60px -32px rgba(20, 20, 40, 0.18);
