---
/**
 * NotificationTaxonomy — interactive version of the "structure notification
 * priority around users' mental models" diagram. A vertical relevance axis
 * sits beside a stack of notification-type cells. Clicking a cell expands
 * it to reveal the matching lock-screen screenshots and collapses the rest.
 */
interface ItemImage {
  src: string;
  alt: string;
  caption?: string;
}
interface Item {
  label: string;
  description?: string;
  images: ItemImage[];
}
interface Props {
  heading?: string;
  axisTopLabel?: string;
  axisBottomLabel?: string;
  items: Item[];
}

const {
  heading = "Structure notification priority and type around users' mental models",
  axisTopLabel = "Always relevant (Most important)",
  axisBottomLabel = "Sometimes relevant (Less important)",
  items,
} = Astro.props;

const uid = `nt-${Math.random().toString(36).slice(2, 8)}`;
---

<section class="nt" data-nt-root={uid}>
  <div class="nt__left">
    <p class="nt__heading">{heading}</p>
  </div>

  <div class="nt__axis" aria-hidden="true">
    <span class="nt__axis-cap nt__axis-cap--top">{axisTopLabel}</span>
    <span class="nt__axis-line">
      <span class="nt__axis-arrow nt__axis-arrow--up"></span>
      <span class="nt__axis-arrow nt__axis-arrow--down"></span>
    </span>
    <span class="nt__axis-cap nt__axis-cap--bottom">{axisBottomLabel}</span>
  </div>

  <ul class="nt__cells" role="tablist" aria-label="Notification types by relevance">
    {items.map((item, i) => (
      <li class="nt__cell" data-cell-index={i}>
        <button
          type="button"
          class="nt__btn"
          role="tab"
          aria-expanded={i === 0 ? "true" : "false"}
          aria-controls={`${uid}-panel-${i}`}
          id={`${uid}-tab-${i}`}
          data-nt-trigger={i}
        >
          <span class="nt__btn-dot" aria-hidden="true"></span>
          <span class="nt__btn-text">
            <span class="nt__btn-label">&ldquo;{item.label}&rdquo;</span>
            {item.description && (
              <span class="nt__btn-desc">{item.description}</span>
            )}
          </span>
          <span class="nt__btn-chev" aria-hidden="true">
            <svg viewBox="0 0 12 12" width="12" height="12">
              <path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </button>
        <div
          class="nt__panel"
          id={`${uid}-panel-${i}`}
          role="tabpanel"
          aria-labelledby={`${uid}-tab-${i}`}
          data-nt-panel={i}
          hidden={i !== 0}
        >
          <div class="nt__images">
            {item.images.map((img) => (
              <figure class="nt__figure">
                <img src={img.src} alt={img.alt} loading="lazy" />
                {img.caption && <figcaption>{img.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>

<script define:vars={{ uid }}>
  const root = document.querySelector(`[data-nt-root="${uid}"]`);
  if (root) {
    const triggers = root.querySelectorAll("[data-nt-trigger]");
    const panels = root.querySelectorAll("[data-nt-panel]");
    triggers.forEach((btn) => {
      btn.addEventListener("click", () => {
        const i = btn.getAttribute("data-nt-trigger");
        triggers.forEach((b) => {
          b.setAttribute("aria-expanded", b === btn ? "true" : "false");
        });
        panels.forEach((p) => {
          if (p.getAttribute("data-nt-panel") === i) {
            p.removeAttribute("hidden");
          } else {
            p.setAttribute("hidden", "");
          }
        });
      });
    });
  }
</script>

<style>
  .nt {
    display: grid;
    grid-template-columns: minmax(180px, 240px) 44px minmax(0, 1fr);
    gap: var(--s-6);
    align-items: stretch;
    max-width: var(--content-max);
    margin: var(--s-12) auto;
    padding: 0 var(--s-5);
  }

  .nt__left {
    display: flex;
    align-items: center;
  }

  .nt__heading {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.3vw, 17px);
    font-weight: 600;
    line-height: 1.35;
    color: var(--text-primary);
    letter-spacing: -0.005em;
  }

  /* Axis */
  .nt__axis {
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2) 0;
  }
  .nt__axis-cap {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--text-tertiary);
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
  }
  .nt__axis-cap--bottom { transform: rotate(180deg); }
  .nt__axis-line {
    position: relative;
    width: 1.5px;
    flex: 1;
    align-self: stretch;
    background: var(--text-primary);
    border-radius: var(--r-full);
    min-height: 120px;
  }
  .nt__axis-arrow {
    position: absolute;
    left: 50%;
    width: 8px;
    height: 8px;
    border-left: 1.5px solid var(--text-primary);
    border-top: 1.5px solid var(--text-primary);
  }
  .nt__axis-arrow--up {
    top: -1px;
    transform: translateX(-50%) rotate(45deg);
  }
  .nt__axis-arrow--down {
    bottom: -1px;
    transform: translateX(-50%) rotate(-135deg);
  }

  /* Cells */
  .nt__cells {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-3);
  }
  .nt__cell {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition: border-color var(--dur-fast) var(--ease),
                box-shadow var(--dur-fast) var(--ease);
  }
  .nt__cell:has([aria-expanded="true"]) {
    border-color: var(--border-default);
    box-shadow: var(--shadow-sm);
  }

  .nt__btn {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-3);
    width: 100%;
    padding: var(--s-4) var(--s-5);
    background: transparent;
    border: 0;
    text-align: left;
    cursor: pointer;
    font-family: var(--font-sans);
    color: var(--text-primary);
    transition: background var(--dur-fast) var(--ease);
  }
  .nt__btn:hover { background: var(--bg-sunken); }
  .nt__btn:focus-visible {
    outline: 2px solid var(--brand-primary-2);
    outline-offset: -2px;
  }

  .nt__btn-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--r-full);
    background: var(--border-default);
    transition: background var(--dur-fast) var(--ease),
                transform var(--dur-fast) var(--ease);
  }
  .nt__btn[aria-expanded="true"] .nt__btn-dot {
    background: var(--brand-primary-2);
    transform: scale(1.25);
  }

  .nt__btn-text {
    display: grid;
    gap: 2px;
  }
  .nt__btn-label {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.005em;
  }
  .nt__btn-desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.4;
  }
  .nt__btn-chev {
    display: inline-flex;
    color: var(--text-tertiary);
    transition: transform var(--dur-normal) var(--ease),
                color var(--dur-fast) var(--ease);
  }
  .nt__btn[aria-expanded="true"] .nt__btn-chev {
    transform: rotate(180deg);
    color: var(--text-primary);
  }

  .nt__panel {
    padding: 0 var(--s-5) var(--s-5);
    background: var(--bg-sunken);
    border-top: 1px solid var(--border-subtle);
  }
  .nt__panel[hidden] { display: none; }

  .nt__images {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--s-4);
    padding-top: var(--s-5);
  }
  .nt__figure {
    margin: 0;
    display: grid;
    gap: var(--s-2);
  }
  .nt__figure img {
    width: 100%;
    height: auto;
    border-radius: var(--r-md);
    background: var(--bg-surface);
    display: block;
  }
  .nt__figure figcaption {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--text-tertiary);
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .nt {
      grid-template-columns: 32px minmax(0, 1fr);
      gap: var(--s-4);
    }
    .nt__left {
      grid-column: 1 / -1;
      margin-bottom: var(--s-2);
    }
    .nt__axis {
      grid-column: 1;
    }
    .nt__cells {
      grid-column: 2;
    }
    .nt__axis-cap { font-size: 10px; }
  }
</style>
