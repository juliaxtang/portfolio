---
import BaseLayout from "../layouts/BaseLayout.astro";
import FadeIn from "../components/FadeIn.astro";
import HeroGrid from "../components/HeroGrid.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Hi, in five languages. Auto-rotates with a width-animated container so
// the comma after the ticker glides instead of jumping.
const greetings = [
  { lang: "English",  hi: "Hi" },
  { lang: "Mandarin", hi: "你好" },
  { lang: "French",   hi: "Bonjour" },
  { lang: "Spanish",  hi: "Hola" },
  { lang: "Japanese", hi: "こんにちは" },
];

const hobbies = [
  {
    emoji: "🐈‍⬛",
    label: "Cat mom",
    photo: `${base}/about/cat-mom.JPG`,
    tilt: 5,
  },
  {
    emoji: "🤿",
    label: "Scuba diver",
    photo: `${base}/about/scuba-diving.JPG`,
    tilt: -5,
  },
  {
    emoji: "🏂",
    label: "Snowboarder",
    photo: `${base}/about/snowboarding.JPG`,
    tilt: 4,
  },
  {
    emoji: "🌐",
    label: "Language learner",
    captionList: ["Mandarin", "French", "Spanish", "Japanese", "English"],
  },
];
---

<BaseLayout title="About">
  <div class="about-canvas" id="about-canvas">
    <HeroGrid />
    <article class="page-narrow about">
      <FadeIn>
        <p class="t-eyebrow about-eyebrow">About</p>
      </FadeIn>

      <FadeIn delay={80}>
        <h1 class="about-title">
          <span class="hi-ticker" aria-live="polite">
            <span class="hi-ghost" aria-hidden="true">&nbsp;</span>
            {greetings.map((g, i) => (
              <span class={`hi-word ${i === 0 ? "is-active" : ""}`} data-lang={g.lang}>{g.hi}</span>
            ))}
          </span><span class="title-rest">, I'm Julia.</span>
        </h1>
      </FadeIn>

      <FadeIn delay={160}>
        <ul class="pill-row" aria-label="Outside of work">
          {hobbies.map((h) => (
            <li>
              <span class="pill" tabindex="0">
                {h.photo && (
                  <span
                    class="pill-photo"
                    style={`--tilt:${h.tilt}deg`}
                    aria-hidden="true"
                  >
                    <img src={h.photo} alt="" loading="lazy" />
                  </span>
                )}
                {h.captionList && (
                  <ul class="pill-caption" aria-hidden="true">
                    {h.captionList.map((item) => <li>{item}</li>)}
                  </ul>
                )}
                <span class="pill-emoji" aria-hidden="true">{h.emoji}</span>
                <span class="pill-label">{h.label}</span>
              </span>
            </li>
          ))}
        </ul>
      </FadeIn>

      <div class="about-body-stack">
        <div class="about-row">
          <div class="fade-in portrait-wrap" style="transition-delay: 240ms">
            <div class="portrait portrait--inline">
              <img src={`${base}/about/julia.jpg`} alt="Portrait of Julia Tang" loading="eager" />
            </div>
          </div>

          <div class="about-row__text">
            <FadeIn delay={240}>
              <p class="about-body">
                I'm a Staff Product Designer at <span class="co-wrap"><strong class="co co--snap"><img src={`${base}/logos/snapchat.png`} alt="" aria-hidden="true" />Snap</strong>,</span> based in LA, where I present product strategy to the CEO weekly.
              </p>
            </FadeIn>

            <FadeIn delay={240}>
              <p class="about-body">
                As an internet kid, I taught myself HTML to deck out my Neopets profile with <img class="glitter-inline" src={`${base}/about/glittergraphics.gif`} alt="glitter graphics" /> (shoutout to the <span class="fx fx--neopets"
                  ><span class="fx-photo fx-photo--bare fx-photo--wide" style="--tilt:0deg" aria-hidden="true"><img
                    src={`${base}/about/neopets.jpg`} alt="" loading="lazy" /></span
                  >Neopets HTML guide</span>). My taste was "..." questionable. But the love for making digital things stuck.
              </p>
            </FadeIn>
          </div>
        </div>

        <div class="about-row about-row--reverse">
          <div class="about-row__text">
            <FadeIn delay={240}>
              <p class="about-body">
                Before product design, I studied <span class="fx fx--film"
                  ><span class="fx-photo" style="--tilt:-5deg" aria-hidden="true"><img
                    src={`${base}/about/film.png`} alt="" loading="lazy" /></span
                  >film</span> at USC. I got my start in design working at an
                agency on major film marketing campaigns, including my award-winning work on <a
                  class="prose-out prose-out--preview"
                  href="https://www.thetangentagency.com/projects/lego-movie-2"
                  target="_blank"
                  rel="noopener noreferrer"
                ><span
                  class="prose-out__preview prose-out__preview--bare prose-out__preview--wide"
                  style="--tilt:0deg; width:656px"
                  aria-hidden="true"
                ><img src={`${base}/about/lego-movie-2.gif`} alt="" loading="lazy" /></span><em>The
                  Lego Movie 2</em></a>.
              </p>
            </FadeIn>

            <FadeIn delay={240}>
              <p class="about-body">
                Mostly, I just love making things. Sometimes small, just for me. Sometimes a feature that solves a real problem. Sometimes quieter, the kind that exists to make you feel a particular way. The reasons change. The instinct doesn't.
              </p>
            </FadeIn>

            <FadeIn delay={320}>
              <div class="about-cta">
                <a href={`${base}/#work`} class="cta-btn">
                  Check out my work!
                  <span class="cta-arrow" aria-hidden="true">↗</span>
                </a>
              </div>
            </FadeIn>
          </div>

          <div class="fade-in portrait-wrap" style="transition-delay: 240ms">
            <div class="portrait portrait--inline portrait--inline-alt">
              <img src={`${base}/about/julia%202.JPG`} alt="Second portrait of Julia Tang" loading="lazy" />
            </div>
          </div>
        </div>
      </div>

    </article>
  </div>
</BaseLayout>

<script is:inline>
  // Polyglot ticker — width-animated container + cross-fade so the comma
  // after the ticker glides smoothly instead of snapping.
  (async function () {
    const ticker = document.querySelector(".hi-ticker");
    if (!ticker) return;
    const words = Array.from(ticker.querySelectorAll(".hi-word"));
    if (words.length < 2) return;

    if (document.fonts && document.fonts.ready) {
      try { await document.fonts.ready; } catch (e) {}
    }

    function measure() {
      return words.map((w) => {
        const clone = w.cloneNode(true);
        clone.removeAttribute("class");
        clone.style.cssText =
          "position:absolute;visibility:hidden;opacity:1;transform:none;" +
          "white-space:nowrap;left:0;top:0;";
        ticker.appendChild(clone);
        const width = Math.ceil(clone.getBoundingClientRect().width);
        clone.remove();
        return width;
      });
    }

    let widths = measure();
    let i = 0;
    ticker.style.setProperty("--w", widths[i] + "px");

    const HOLD = 2400;
    const FADE = 700;

    setInterval(() => {
      const current = words[i];
      i = (i + 1) % words.length;
      const next = words[i];

      current.classList.remove("is-active");
      current.classList.add("is-leaving");
      next.classList.add("is-active");
      ticker.style.setProperty("--w", widths[i] + "px");

      setTimeout(() => {
        current.classList.remove("is-leaving");
      }, FADE);
    }, HOLD);

    let resizeT;
    window.addEventListener("resize", () => {
      clearTimeout(resizeT);
      resizeT = setTimeout(() => {
        widths = measure();
        ticker.style.setProperty("--w", widths[i] + "px");
      }, 120);
    });
  })();
</script>

<style>
  .about-canvas {
    position: relative;
    isolation: isolate;
  }

  .about { padding-top: var(--s-16); position: relative; }
  @media (max-width: 720px) {
    .about { padding-top: var(--s-10); }
  }
  .about-eyebrow { margin-bottom: var(--s-3); color: var(--text-tertiary); }

  /* Body stack — paragraphs flush-left at the same edge as the title and
     pills. Portrait floats inside so body wraps next to it, then continues
     full-width below the float (no empty space under the portrait). */
  .about-body-stack {
    margin-top: var(--s-4);
  }
  .about-body-stack::after {
    content: "";
    display: block;
    clear: both;
  }

  /* Each about row pairs a portrait with a stack of paragraphs and
     vertically centers them. The second row reverses so the portrait
     sits on the right. Stacks vertically on narrow viewports. */
  .about-row {
    display: flex;
    align-items: center;
    gap: var(--s-10);
    /* Scale the row-to-row gap fluidly with viewport width — narrower
       viewports get a tighter rhythm (so stacked text doesn't look
       stranded between paragraphs) while the big-canvas layout still
       gets the generous --s-10 breathing room. */
    margin-bottom: clamp(var(--s-5), 3.2vw, var(--s-10));
  }
  .about-row:last-child { margin-bottom: 0; }
  .about-row--reverse { /* portrait on the right */ }
  .about-row__text {
    flex: 0 1 auto;
    min-width: 0;
    max-width: 380px;
  }
  /* Each paragraph in the two-up column is wrapped in a FadeIn div, so
     the `:last-child` test has to target the outer wrapper. Without
     this the original rule matched every paragraph (each is the only
     .about-body inside its FadeIn) and zeroed all the bottom margins. */
  .about-row__text > .fade-in:last-child .about-body { margin-bottom: 0; }
  @media (max-width: 760px) {
    .about-row,
    .about-row--reverse {
      flex-direction: column;
      align-items: stretch;
      gap: var(--s-5);
    }
  }

  .portrait-wrap {
    flex: 0 0 auto;
    width: 308px;
    position: relative;
    z-index: 1;
  }
  /* Opening portrait: render the image at its natural aspect so the
     full body is in frame, not just the face. */
  .about-row:first-child .portrait-wrap {
    width: 320px;
  }
  .about-row:first-child .portrait img {
    aspect-ratio: auto;
    object-fit: cover;
    object-position: 50% 50%;
  }
  /* Secondary portrait: a touch larger than the opening portrait but
     not overwhelming next to the two-paragraph text column. */
  .about-row--reverse .portrait-wrap {
    width: 340px;
  }
  .about-row--reverse .portrait img {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 35%;
  }
  .portrait {
    /* polaroid card — natural aspect ratio image, generous bottom matte. */
    background: var(--bg-surface);
    padding: 12px 12px 38px;
    border-radius: var(--r-sm);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-subtle);
  }
  .portrait--inline {
    transform: rotate(0deg);
    transform-origin: 50% 50%;
    transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .portrait--inline:hover {
    transform: rotate(-2deg);
  }
  /* The right-column portrait tilts the other way on hover for a tiny
     bit of asymmetry between the two rows. */
  .portrait--inline-alt:hover {
    transform: rotate(2deg);
  }
  .portrait img {
    width: 100%;
    height: auto;
    display: block;
  }
  @media (max-width: 760px) {
    .portrait-wrap {
      width: 220px;
      align-self: center;
    }
  }

  .about-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: normal;
    font-size: clamp(48px, 6.4vw, 88px);
    line-height: 1.0;
    letter-spacing: -0.01em;
    margin: 0 0 var(--s-10);
    color: var(--text-primary);
    white-space: nowrap;
  }
  @media (max-width: 720px) {
    .about-title { white-space: normal; font-size: clamp(40px, 9vw, 56px); margin-bottom: var(--s-8); }
  }
  @media (max-width: 420px) {
    .about-title { font-size: 38px; }
  }

  .hi-ticker {
    position: relative;
    display: inline-block;
    vertical-align: baseline;
    width: var(--w, auto);
    height: 1em;
    line-height: 1;
    transition: width 600ms cubic-bezier(0.16, 1, 0.3, 1);
    overflow: visible;
  }
  .hi-ghost {
    display: inline-block;
    width: 0;
    visibility: hidden;
  }
  .hi-word {
    position: absolute;
    top: 0;
    left: 0;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-0.32em);
    transition:
      opacity 480ms var(--ease-out),
      transform 700ms var(--ease-out);
    will-change: opacity, transform;
  }
  .hi-word.is-active {
    opacity: 1;
    transform: translateY(0);
    transition-duration: 700ms;
  }
  .hi-word.is-leaving {
    opacity: 0;
    transform: translateY(0.32em);
    transition-duration: 380ms;
  }
  .title-rest { color: var(--text-primary); }

  /* All about-page body paragraphs share the same type so the page reads
     as a single voice, not a resume summary + body. */
  .about-body-stack :global(.below-portrait) {
    clear: left;
  }

  .about-body {
    font-size: clamp(20px, 2vw, 24px);
    line-height: 1.5;
    color: var(--text-primary);
    margin: 0 0 var(--s-5);
    /* Let the browser rebalance the last 1–2 lines so we don't end up
       with a lonely "(" or a single-word widow at the end of a paragraph
       in the narrow two-up columns. */
    text-wrap: pretty;
  }
  .about-body strong {
    font-weight: 600;
    color: var(--text-primary);
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    padding-bottom: 1px;
  }

  /* Interactive company callouts — small logo to the left, brand underline
     at rest, company-colored wash on hover. Matches the homepage hero pattern. */
  .about-body .co {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    line-height: inherit;
    white-space: nowrap;
    gap: 0.32em;
    padding: 0 0.18em;
    cursor: default;
    font-weight: 400;
    border-radius: var(--r-xs);
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 0;
    transition:
      background-size 280ms var(--ease-out),
      background-image 280ms var(--ease-out);
  }
  .about-body .co img {
    height: 0.95em;
    width: auto;
    max-width: 1.4em;
    display: inline-block;
    object-fit: contain;
    position: relative;
    z-index: 1;
    /* Nudge the logo down a hair so its visual mid-line aligns with
       the text baseline (logos read top-heavy at baseline alignment). */
    transform: translateY(0.08em);
  }
  /* Keep the company callout and its trailing comma on the same line so
     the comma can't be orphaned to the start of the next line. */
  .about-body .co-wrap {
    white-space: nowrap;
  }
  .about-body .co:hover {
    background-size: 100% 100%;
  }
  .about-body .co--snap:hover {
    background-image: linear-gradient(var(--co-wash-snap), var(--co-wash-snap));
  }
  .about-body .co--tinder:hover {
    background-image: linear-gradient(var(--co-wash-tinder), var(--co-wash-tinder));
  }
  .about-body .co--tvtime:hover {
    background-image: linear-gradient(var(--co-wash-tvtime), var(--co-wash-tvtime));
  }
  .about-body .co--whip:hover {
    background-image: linear-gradient(var(--co-wash-whip), var(--co-wash-whip));
  }

  .fx {
    position: relative;
    display: inline-block;
    cursor: default;
  }

  /* Polaroid photo that appears above an .fx word on hover. Image renders
     at natural aspect (no crop). Each .fx-photo can set its own --tilt. */
  .fx-photo {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    width: 240px;
    pointer-events: none;
    opacity: 0 !important;
    transform: translateX(-50%) translateY(8px) rotate(var(--tilt, -4deg)) scale(0.94);
    transform-origin: 50% 100%;
    transition:
      opacity 240ms var(--ease-out),
      transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 5;
    background: var(--bg-surface);
    /* Thin polaroid border so the image fills the frame instead of
       floating in a bulky matte. */
    padding: 3px 3px 10px;
    border-radius: var(--r-xs);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-subtle);
  }
  .fx-photo img {
    width: 100%;
    height: auto;
    display: block;
  }
  /* Bare + wide variant — no polaroid frame, larger so a full
     screenshot like the Neopets HTML guide reads at this scale. */
  .fx-photo--bare {
    background: none;
    border: none;
    box-shadow: none;
    padding: 0;
    border-radius: var(--r-xs);
    overflow: hidden;
  }
  .fx-photo--wide { width: 460px; }
  /* The hover-revealed photo is rendered as a clone inside the
     custom cursor (.cursor__media), so the original stays invisible. */

  .fx--film,
  .fx--clio {
    font-weight: 600;
    color: var(--text-primary);
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    padding-bottom: 1px;
    border-radius: var(--r-xs);
    transition:
      background-size 280ms var(--ease-out),
      background-image 280ms var(--ease-out);
  }
  .fx--film:hover,
  .fx--clio:hover {
    background-image: linear-gradient(var(--brand-wash-soft), var(--brand-wash-soft));
    background-size: 100% 100%;
  }

  /* Neopets nod — softer than .fx--film, no bold weight, just a thin
     brand underline that fills into the wash on hover. The cursor-portal
     image is the main hover signal; the underline is only a hint that
     the parenthetical is hoverable. */
  /* Glitter graphics — always-on inline GIF that replaces the words
     "glitter graphics" in the sentence flow. Sized to sit inside the
     paragraph's line-box without pushing the line taller than its
     text-only siblings (1.4em + a -0.15em baseline nudge keeps the
     glyphs centered on the x-height, per the HM stress-test fix). */
  .glitter-inline {
    display: inline-block;
    vertical-align: -0.15em;
    height: 1.4em;
    width: auto;
    margin: 0 0.1em;
  }

  /* Keep .fx--neopets as plain inline so the link wraps with the
     surrounding sentence instead of being treated as an inline-block
     atom that pushes adjacent punctuation onto its own line. */
  .fx--neopets {
    display: inline;
    color: var(--text-primary);
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    padding-bottom: 1px;
    border-radius: var(--r-xs);
    transition:
      background-size 280ms var(--ease-out),
      background-image 280ms var(--ease-out);
  }
  .fx--neopets:hover {
    background-image: linear-gradient(var(--brand-wash-soft), var(--brand-wash-soft));
    background-size: 100% 100%;
  }

  .about-highlight {
    position: relative;
    background-color: var(--bg-surface);
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.62), rgba(255, 255, 255, 0.62)),
      linear-gradient(
        135deg,
        #F8E4D9 0%,
        #EAE2F0 45%,
        #F8E4D9 75%,
        #DDEAF2 100%
      );
    background-size: 100% 100%, 260% 260%;
    background-position: 0 0, 0% 50%;
    background-repeat: no-repeat, no-repeat;
    border-radius: var(--r-sm);
    padding: var(--s-4) var(--s-5);
    text-align: center;
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(20px, 2.2vw, 24px);
    line-height: 1.35;
    transition: background-color 600ms var(--ease-out);
  }
  .about-highlight::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1.5px;
    background: conic-gradient(
      from var(--shine-angle, 0deg),
      transparent 0deg,
      rgba(197, 220, 234, 0.9) 60deg,
      rgba(220, 210, 232, 0.9) 110deg,
      rgba(244, 217, 204, 0.9) 160deg,
      transparent 220deg,
      transparent 360deg
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
            mask-composite: exclude;
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
    pointer-events: none;
  }
  .about-highlight:hover {
    animation: about-highlight-drift 8s ease-in-out infinite;
  }
  .about-highlight:hover::before {
    opacity: 1;
    animation: about-highlight-shine 6s linear infinite;
  }
  @keyframes about-highlight-drift {
    0%   { background-position: 0 0, 0% 50%; }
    50%  { background-position: 0 0, 100% 50%; }
    100% { background-position: 0 0, 0% 50%; }
  }
  @property --shine-angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }
  @keyframes about-highlight-shine {
    to { --shine-angle: 360deg; }
  }
  @media (prefers-reduced-motion: reduce) {
    .about-highlight,
    .about-highlight:hover,
    .about-highlight:hover::before { animation: none; transition: none; }
  }

  .about-body b {
    font-weight: 600;
    color: var(--text-primary);
  }

  .fx--key {
    font-weight: 600;
    color: var(--text-primary);
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    padding-bottom: 1px;
    border-radius: var(--r-xs);
    transition:
      background-size 280ms var(--ease-out),
      background-image 280ms var(--ease-out);
  }
  .fx--key:hover {
    background-image: linear-gradient(var(--brand-wash-soft), var(--brand-wash-soft));
    background-size: 100% 100%;
  }

  /* Outbound prose links — match the fx-- words: brand underline fills to a
     full wash on hover so the whole word highlights. */
  .prose-out {
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    padding-bottom: 1px;
    border-radius: var(--r-xs);
    transition:
      background-size 280ms var(--ease-out),
      background-image 280ms var(--ease-out);
  }
  .prose-out:hover {
    background-image: linear-gradient(var(--brand-wash-soft), var(--brand-wash-soft));
    background-size: 100% 100%;
  }

  /* Image preview that floats above the link on hover. Default has a
     polaroid frame; the --bare modifier drops the frame for actual work
     images (Webby, Lego Movie 2). Each preview can set its own --tilt. */
  .prose-out--preview {
    position: relative;
  }
  .prose-out__preview {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    /* width intentionally omitted so the global
       .prose-out__preview--wide value (820px) isn't shadowed by a
