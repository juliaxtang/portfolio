---
/**
 * PearlField — ambient pastel dot grid that fills the hero.
 *
 * Renders a soft constellation of pastel dots edge-to-edge in its parent.
 * A radial mask gathers the dots into a soft cloud (no hard circle) so the
 * field has presence but bleeds off into the page.
 *
 * Cursor anywhere over the parent parts the dots; mouse speed scales the
 * push. Click sends a radial pulse wave from the click point. The canvas
 * itself is `pointer-events: none` so text on top remains selectable —
 * cursor + click events are listened on the parent element.
 */
---

<div class="field-wrap" aria-hidden="true">
  <canvas class="field-canvas"></canvas>
</div>
<div class="dots-hint" data-dots-hint aria-hidden="true">
  <img class="dots-hint__arrow" src="/click-me-arrow.png" alt="arrow pointing to click me" />
  <span class="dots-hint__label">click me</span>
</div>

<script is:inline>
  (() => {
    const wraps = document.querySelectorAll(".field-wrap");
    wraps.forEach((wrap) => {
      const canvas = wrap.querySelector(".field-canvas");
      const host = wrap.parentElement; // listen on whatever contains the field
      if (!canvas || !host || canvas.__init) return;
      canvas.__init = true;

      const ctx = canvas.getContext("2d");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const COLORS = ["#C5DCEA", "#DCD2E8", "#F4D9CC", "#A9C7DC", "#E9C2B0"];
      const STEP = 26;
      const DOT_R = 3.4;
      const PUSH_RADIUS = 130;
      const dots = [];
      let pulses = [];

      let dpr = 1, w = 0, h = 0;

      function build() {
        const r = wrap.getBoundingClientRect();
        if (r.width === 0 || r.height === 0) return;
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = r.width;
        h = r.height;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        canvas.style.width = w + "px";
        canvas.style.height = h + "px";
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        dots.length = 0;
        const cols = Math.ceil(w / STEP) + 1;
        const rows = Math.ceil(h / STEP) + 1;
        const offX = (w - (cols - 1) * STEP) / 2;
        const offY = (h - (rows - 1) * STEP) / 2;
        for (let y = 0; y < rows; y++) {
          for (let x = 0; x < cols; x++) {
            const px = offX + x * STEP;
            const py = offY + y * STEP;
            dots.push({
              hx: px, hy: py,
              x: px, y: py,
              vx: 0, vy: 0,
              c: COLORS[(x * 31 + y * 17) % COLORS.length],
            });
          }
        }
      }

      let mx = -9999, my = -9999;
      let lastMx = mx, lastMy = my;
      let mSpeed = 0;
      let inside = false;

      function onMove(e) {
        const r = wrap.getBoundingClientRect();
        mx = e.clientX - r.left;
        my = e.clientY - r.top;
        inside = true;
      }
      function onLeave() {
        inside = false;
        mx = -9999; my = -9999;
        mSpeed = 0;
      }
      function onClick(e) {
        const r = wrap.getBoundingClientRect();
        pulses.push({
          x: e.clientX - r.left,
          y: e.clientY - r.top,
          r: 0,
          life: 1,
        });
      }
      host.addEventListener("mousemove", onMove);
      host.addEventListener("mouseleave", onLeave);
      host.addEventListener("click", onClick);

      // First-visit hint: a tiny curved arrow + "click me" appears the
      // first time the user mouses over the dots, and dismisses on click.
      // Persisted in localStorage so it's truly once-per-user.
      const hint = wrap.parentElement?.querySelector("[data-dots-hint]");
      const HINT_KEY = "pearl-hint-seen";
      let hintSeen = false;
      try { hintSeen = localStorage.getItem(HINT_KEY) === "1"; } catch (_) {}
      if (hint && !hintSeen && !reduceMotion) {
        const showHint = () => {
          hint.classList.add("is-visible");
          host.removeEventListener("mousemove", showHint);
        };
        const dismissHint = () => {
          hint.classList.remove("is-visible");
          hint.classList.add("is-dismissed");
          try { localStorage.setItem(HINT_KEY, "1"); } catch (_) {}
          host.removeEventListener("mousemove", showHint);
          host.removeEventListener("click", dismissHint);
        };
        host.addEventListener("mousemove", showHint);
        host.addEventListener("click", dismissHint);
      }

      const ro = new ResizeObserver(build);
      ro.observe(wrap);
      build();

      let visible = true;
      if ("IntersectionObserver" in window) {
        new IntersectionObserver(
          (entries) => { visible = entries[0].isIntersecting; },
          { threshold: 0 }
        ).observe(canvas);
      }

      function frame() {
        requestAnimationFrame(frame);
        if (!visible || w === 0) return;

        const dx = mx - lastMx, dy = my - lastMy;
        const inst = Math.min(Math.hypot(dx, dy), 80) / 80;
        mSpeed += (inst - mSpeed) * 0.25;
        lastMx = mx; lastMy = my;

        ctx.clearRect(0, 0, w, h);

        for (let i = pulses.length - 1; i >= 0; i--) {
          const p = pulses[i];
          p.r += 7;
          p.life -= 0.010;
          if (p.life <= 0) pulses.splice(i, 1);
        }

        const pushScale = 1 + mSpeed * 1.6;

        for (let i = 0; i < dots.length; i++) {
          const d = dots[i];

          if (!reduceMotion) {
            if (inside) {
              const dxh = d.x - mx, dyh = d.y - my;
              const dist = Math.hypot(dxh, dyh);
              if (dist < PUSH_RADIUS && dist > 0.01) {
                const f = (1 - dist / PUSH_RADIUS) * 1.6 * pushScale;
                d.vx += (dxh / dist) * f;
                d.vy += (dyh / dist) * f;
              }
            }

            for (let k = 0; k < pulses.length; k++) {
              const p = pulses[k];
              const dxp = d.x - p.x, dyp = d.y - p.y;
              const dist = Math.hypot(dxp, dyp);
              const ring = Math.abs(dist - p.r);
              if (ring < 32 && dist > 0.01) {
                const f = (1 - ring / 32) * 3.4 * p.life;
                d.vx += (dxp / dist) * f;
                d.vy += (dyp / dist) * f;
              }
            }

            const k = 0.06;
            const damp = 0.78;
            d.vx += (d.hx - d.x) * k;
            d.vy += (d.hy - d.y) * k;
            d.vx *= damp;
            d.vy *= damp;
            d.x += d.vx;
            d.y += d.vy;
          }

          ctx.fillStyle = d.c;
          ctx.beginPath();
          ctx.arc(d.x, d.y, DOT_R, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      frame();
    });
  })();
</script>

<style>
  .field-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* Soft elliptical cloud anchored to the right side of the hero where
       the orb used to live. Bleeds off into the page; no hard edges.
       Mask values:
         - center 65% across, 50% down (right of text column)
         - opaque core ~28%, fading to 0 at ~80% radius
         - additionally fade the bottom 10% so dots don't crowd the work grid */
    -webkit-mask-image:
      radial-gradient(ellipse 55% 90% at 78% 50%, #000 0%, #000 18%, transparent 65%),
      linear-gradient(to bottom, #000 0%, #000 88%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      radial-gradient(ellipse 55% 90% at 78% 50%, #000 0%, #000 18%, transparent 65%),
      linear-gradient(to bottom, #000 0%, #000 88%, transparent 100%);
    mask-composite: intersect;
  }
  .field-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .dots-hint {
    position: absolute;
    right: clamp(24px, 6vw, 72px);
    bottom: 6%;
    z-index: 1;
    display: inline-flex;
    align-items: flex-end;
    gap: var(--s-2);
    pointer-events: none;
    color: var(--text-secondary, #6b6776);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 360ms var(--ease-out), transform 360ms var(--ease-out);
  }
  .dots-hint.is-visible { opacity: 0.85; transform: translateY(0); }
  .dots-hint.is-dismissed {
    opacity: 0 !important;
    transform: translateY(-4px);
    transition: opacity 240ms var(--ease-out), transform 240ms var(--ease-out);
  }
  .dots-hint__arrow {
    width: clamp(56px, 6vw, 80px);
    height: auto;
    display: block;
    margin-bottom: 8px;
    filter: brightness(0) saturate(100%) invert(38%) sepia(7%) saturate(330%) hue-rotate(199deg) brightness(91%) contrast(90%);
  }
  .dots-hint__label { white-space: nowrap; padding-bottom: 2px; }

  @media (max-width: 720px) {
    .dots-hint { display: none; }
  }

  @media (max-width: 720px) {
    .field-wrap {
      /* Center the cloud on mobile since the layout collapses to a single column. */
      -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 60%, #000 0%, #000 30%, transparent 80%);
      mask-image: radial-gradient(ellipse 90% 70% at 50% 60%, #000 0%, #000 30%, transparent 80%);
    }
  }
</style>
