---
/**
 * HomeAbout — about section on the homepage, anchored at `#about`.
 *
 *  ┌──────────────────────────────────────────────────────────────────┐
 *  │ About me (polyglot ticker)                                       │
 *  │ ┌──────────────┬───────────────────────────────────────────────┐ │
 *  │ │   PHOTO      │  AT WORK                                      │ │
 *  │ │   CAROUSEL   │  sensibility paragraph                        │ │
 *  │ │   + dots     │  making-things paragraph                      │ │
 *  │ │              │                                               │ │
 *  │ │              │  IN LIFE                                      │ │
 *  │ │              │  Neopets · Film · Red Note                    │ │
 *  │ └──────────────┴───────────────────────────────────────────────┘ │
 *  │                  [ Check out my work ↑ ]                         │
 *  └──────────────────────────────────────────────────────────────────┘
 *
 * Rebuilt after the v2 worktree was removed without committing — copy
 * matches the latest session state (At work / In life bifurcation,
 * single-column body inside each labeled section, carousel + dot nav).
 */
import FadeIn from "./FadeIn.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Title cycles "About me" through five languages.
const titlePhrases = [
  { lang: "English",  text: "About me" },
  { lang: "Mandarin", text: "关于我" },
  { lang: "French",   text: "À propos de moi" },
  { lang: "Spanish",  text: "Sobre mí" },
  { lang: "Japanese", text: "私について" },
];

const defaultHero = `${base}/about/julia.jpg`;
const interests = [
  { emoji: "🐈‍⬛", label: "Cat mom",     image: `${base}/about/cat-mom.JPG` },
  { emoji: "🤿",   label: "Scuba diver", image: `${base}/about/scuba-diving.JPG` },
  { emoji: "🏂",   label: "Snowboarder", image: `${base}/about/snowboarding.JPG` },
];
---

<section class="ha" id="about" aria-labelledby="ha-title">
  <article class="ha__article">
    <FadeIn>
      <div class="ha__grid">
        <div class="ha__hero">
          <div class="ha__carousel" role="region" aria-label="Photos of Julia">
            <div class="ha__slide">
              <div class="ha__slide-img">
                <img src={defaultHero} alt="Portrait of Julia Tang" loading="lazy" />
              </div>
              <p class="ha__slide-caption" aria-hidden="true">&nbsp;</p>
            </div>
            {interests.map((it) => (
              <div class="ha__slide">
                <div class="ha__slide-img">
                  <img src={it.image} alt={it.label} loading="lazy" />
                </div>
                <p class="ha__slide-caption">
                  <span class="ha__slide-emoji" aria-hidden="true">{it.emoji}</span> {it.label}
                </p>
              </div>
            ))}
          </div>
          <div class="ha__dots" role="tablist" aria-label="Photo navigation">
            <button type="button" class="ha__dot" data-slide-index="0" aria-label="Show portrait" aria-selected="true"></button>
            {interests.map((it, i) => (
              <button type="button" class="ha__dot" data-slide-index={i + 1} aria-label={`Show ${it.label} photo`} aria-selected="false"></button>
            ))}
          </div>
        </div>

        <header class="ha__head">
          <h2 class="ha__title" id="ha-title">
            <span class="hi-ticker" aria-live="polite">
              <span class="hi-ghost" aria-hidden="true">&nbsp;</span>
              {titlePhrases.map((p, i) => (
                <span class={`hi-word ${i === 0 ? "is-active" : ""}`} data-lang={p.lang}>{p.text}</span>
              ))}
            </span>
          </h2>
        </header>

        <div class="ha__body">
          <section class="ha__body-section">
            <h3 class="ha__body-label">At work</h3>
            <p>
              I'm drawn to 0→1 consumer products and ambiguous problem spaces, the kind where the answer isn't given. I like zooming out to read the long arc, then zooming back in to sweat the details (sometimes I overstay in the zoom-in). Motion and interactivity are where the work feels most alive.
            </p>
            <p>
              Mostly, I love making things. Sometimes a feature that solves a real problem. Sometimes something small, just for me. Sometimes something quieter, the kind that exists to make you feel a particular way. The reasons change. The instinct doesn't.
            </p>
          </section>
          <section class="ha__body-section">
            <h3 class="ha__body-label">In life</h3>
            <p>
              As an internet kid, I taught myself HTML to put glitter graphics on my Neopets profile (shoutout to the Neopets HTML guide). My taste was questionable. The love for making things on the internet stuck.
            </p>
            <p>
              Film at USC pulled me deeper. I fell for cinematography (composition and light, like painting) and title design, where a 90-second sequence sets a film's entire mood. I still keep a camera on me.
            </p>
            <p>
              I've been learning Mandarin on Red Note. It's also been a quiet education in Eastern UX patterns. Design instinct often comes from outside design.
            </p>
          </section>
        </div>
      </div>
    </FadeIn>

    <FadeIn delay={320}>
      <div class="ha__cta">
        <a class="ha__cta-btn" href="#snapchat-games">
          <span class="ha__cta-label">Check out my work</span>
          <span class="ha__cta-arrow" aria-hidden="true">↑</span>
        </a>
      </div>
    </FadeIn>
  </article>
</section>

<script is:inline>
  // Polyglot ticker — width-animated container + cross-fade.
  (async function () {
    const ticker = document.querySelector(".ha .hi-ticker");
    if (!ticker) return;
    const words = Array.from(ticker.querySelectorAll(".hi-word"));
    if (words.length < 2) return;

    if (document.fonts && document.fonts.ready) {
      try { await document.fonts.ready; } catch (e) {}
    }

    function measure() {
      return words.map((w) => {
        const clone = w.cloneNode(true);
        clone.removeAttribute("class");
        clone.style.cssText =
          "position:absolute;visibility:hidden;opacity:1;transform:none;" +
          "white-space:nowrap;left:0;top:0;";
        ticker.appendChild(clone);
        const width = Math.ceil(clone.getBoundingClientRect().width);
        clone.remove();
        return width;
      });
    }

    let widths = measure();
    let i = 0;
    ticker.style.setProperty("--w", widths[i] + "px");

    const HOLD = 2400;
    const FADE = 700;

    setInterval(() => {
      const current = words[i];
      i = (i + 1) % words.length;
      const next = words[i];
      current.classList.remove("is-active");
      current.classList.add("is-leaving");
      next.classList.add("is-active");
      ticker.style.setProperty("--w", widths[i] + "px");
      setTimeout(() => { current.classList.remove("is-leaving"); }, FADE);
    }, HOLD);

    let resizeT;
    window.addEventListener("resize", () => {
      clearTimeout(resizeT);
      resizeT = setTimeout(() => {
        widths = measure();
        ticker.style.setProperty("--w", widths[i] + "px");
      }, 120);
    });
  })();

  // Photo carousel — scroll-snap with dot navigation.
  (function () {
    const carousel = document.querySelector(".ha__carousel");
    if (!carousel) return;
    const slides = Array.from(carousel.querySelectorAll(".ha__slide"));
    const dots = Array.from(document.querySelectorAll(".ha__dot"));
    if (!slides.length || !dots.length) return;

    function setActiveIdx(i) {
      dots.forEach(function (d, di) {
        d.setAttribute("aria-selected", di === i ? "true" : "false");
      });
    }

    const observer = new IntersectionObserver(
      function (entries) {
        let bestIdx = -1;
        let bestRatio = 0;
        entries.forEach(function (e) {
          if (e.intersectionRatio > bestRatio) {
            bestRatio = e.intersectionRatio;
            bestIdx = slides.indexOf(e.target);
          }
        });
        if (bestIdx >= 0 && bestRatio > 0.5) setActiveIdx(bestIdx);
      },
      { root: carousel, threshold: [0.5, 0.75, 1] }
    );
    slides.forEach(function (s) { observer.observe(s); });

    dots.forEach(function (dot, i) {
      dot.addEventListener("click", function () {
        slides[i].scrollIntoView({ behavior: "smooth", block: "nearest", inline: "start" });
      });
    });
  })();
</script>

<style>
  .ha {
    position: relative;
    padding: var(--s-20) var(--s-6) var(--s-24);
    scroll-margin-top: 72px;
    isolation: isolate;
  }
  .ha__article {
    max-width: 1080px;
    margin: 0 auto;
    position: relative;
  }
  @media (max-width: 720px) {
    .ha { padding: var(--s-12) var(--s-5) var(--s-16); }
  }

  /* Title block sits at row 1 of the right area. */
  .ha__head { margin: 0 0 var(--s-6); }
  .ha__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(40px, 5.4vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.014em;
    margin: 0;
    color: var(--text-primary);
    white-space: nowrap;
  }
  @media (max-width: 720px) { .ha__title { white-space: normal; } }

  /* 4-col grid: image col (1.3fr, rowspan 2) | text area (3fr, two rows). */
  .ha__grid {
    display: grid;
    grid-template-columns: 1.3fr 3fr;
    grid-template-rows: auto auto;
    align-items: stretch;
    margin-bottom: var(--s-10);
    row-gap: var(--s-5);
    column-gap: var(--s-8);
  }
  .ha__hero {
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    min-width: 0;
  }
  .ha__head { grid-column: 2; grid-row: 1; padding: 0; }
  .ha__body { grid-column: 2; grid-row: 2; display: flex; flex-direction: column; gap: var(--s-8); }

  .ha__body-section { display: flex; flex-direction: column; gap: var(--s-3); }
  .ha__body-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin: 0 0 var(--s-1);
  }
  .ha__body-section p {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.78;
    letter-spacing: -0.001em;
    color: var(--text-primary);
    max-width: 62ch;
    margin: 0 0 var(--s-4);
  }
  .ha__body-section p:last-child { margin-bottom: 0; }

  /* Carousel: native horizontal scroll-snap; dots below sync via IO. */
  .ha__carousel {
    flex: 1;
    width: 100%;
    min-width: 0;
    min-height: 360px;
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .ha__carousel::-webkit-scrollbar { display: none; }
  .ha__slide {
    flex: 0 0 100%;
    width: 100%;
    min-width: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .ha__slide-img {
    flex: 1;
    width: 100%;
    min-height: 0;
    border-radius: var(--r-xs);
    overflow: hidden;
    box-shadow: 0 30px 60px -30px rgba(20, 22, 28, 0.22);
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface);
  }
  .ha__slide-img img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  .ha__slide-caption {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0;
    text-align: center;
    line-height: 1.4;
    min-height: 1.4em;
  }
  .ha__slide-emoji {
    text-transform: none;
    letter-spacing: 0;
    margin-right: 2px;
    font-size: 13px;
    vertical-align: -1px;
  }
  .ha__dots {
    display: flex;
    gap: 7px;
    justify-content: center;
    margin-top: var(--s-1);
  }
  .ha__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: 0;
    padding: 0;
    background: var(--border-default);
    cursor: pointer;
    transition:
      background-color 200ms var(--ease-out),
      transform 200ms var(--ease-out);
  }
  .ha__dot:hover { background: var(--text-tertiary); }
  .ha__dot[aria-selected="true"] {
    background: var(--text-secondary);
    transform: scale(1.15);
  }

  /* Polyglot ticker */
  .hi-ticker {
    position: relative;
    display: inline-block;
    vertical-align: baseline;
    width: var(--w, auto);
    height: 1em;
    line-height: 1;
    transition: width 600ms cubic-bezier(0.16, 1, 0.3, 1);
    overflow: visible;
  }
  .hi-ghost { display: inline-block; width: 0; visibility: hidden; }
  .hi-word {
    position: absolute;
    top: 0;
    left: 0;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-0.32em);
    transition:
      opacity 480ms var(--ease-out),
      transform 700ms var(--ease-out);
    will-change: opacity, transform;
  }
  .hi-word.is-active {
    opacity: 1;
    transform: translateY(0);
    transition-duration: 700ms;
  }
  .hi-word.is-leaving {
    opacity: 0;
    transform: translateY(0.32em);
    transition-duration: 380ms;
  }

  /* CTA — picks up the global liquid-fill treatment via the .ha__cta-btn class. */
  .ha__cta { margin-top: var(--s-2); text-align: center; }
  .ha__cta-btn {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 12px 22px;
    border-radius: var(--r-full);
    border: 1.5px solid var(--border-default);
    background: var(--bg-surface);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color var(--dur-normal) var(--ease-out),
      gap var(--dur-normal) var(--ease-out),
      transform var(--dur-normal) var(--ease-out),
      box-shadow var(--dur-normal) var(--ease-out);
  }
  .ha__cta-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--brand-wash);
    transform: translateY(101%);
    border-radius: 50% 50% 0 0 / 18px 18px 0 0;
    transition:
      transform 720ms cubic-bezier(0.45, 0, 0.15, 1),
      border-radius 720ms cubic-bezier(0.45, 0, 0.15, 1);
    pointer-events: none;
    z-index: 0;
  }
  .ha__cta-btn > * { position: relative; z-index: 1; }
  .ha__cta-arrow {
    font-size: 1.1em;
    line-height: 0;
    transition: transform var(--dur-normal) var(--ease-out);
  }
  .ha__cta-btn:hover,
  .ha__cta-btn:focus-visible {
    gap: var(--s-3);
    border-color: var(--text-tertiary);
    transform: translateY(-1px);
    box-shadow: 0 12px 28px -14px rgba(20, 22, 28, 0.22);
  }
  .ha__cta-btn:hover::before,
  .ha__cta-btn:focus-visible::before {
    transform: translateY(0);
    border-radius: 0;
  }
  .ha__cta-btn:hover .ha__cta-arrow,
  .ha__cta-btn:focus-visible .ha__cta-arrow {
    transform: translate(-2px, -2px);
  }

  @media (max-width: 720px) {
    .ha__grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      row-gap: var(--s-6);
      align-items: start;
    }
    .ha__hero,
    .ha__head,
    .ha__body {
      grid-column: 1;
      grid-row: auto;
    }
    .ha__hero {
      align-self: start;
      max-width: 380px;
      width: 100%;
    }
    .ha__carousel { min-height: 0; }
    .ha__slide-img { aspect-ratio: 3 / 4; }
    .ha__body { gap: var(--s-6); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hi-ticker { transition: none; }
    .hi-word { transition: opacity 240ms ease; transform: none !important; }
    .ha__carousel { scroll-behavior: auto; }
    .ha__dot { transition: none; }
  }
</style>
