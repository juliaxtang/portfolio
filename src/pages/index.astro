---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCell from "../components/ProjectCell.astro";
import FadeIn from "../components/FadeIn.astro";
import HeroOrb from "../components/HeroOrb.astro";
import CompanyPills from "../components/CompanyPills.astro";

// Order shown on the home grid. Snap projects first (current), then Tinder, then TV Time.
// "delight" rendered letter-by-letter so each can wave on hover.
// Build the HTML string in frontmatter so there's no whitespace between
// the inline-block letters (that would create visible gaps).
const delightHtml = ["d", "e", "l", "i", "g", "h", "t"]
  .map((c, i) => `<span class="wave-letter" style="--i:${i}">${c}</span>`)
  .join("");

// "Julia" letter-by-letter — bobs in a wave on greeting hover.
const juliaHtml = ["J", "u", "l", "i", "a"]
  .map((c, i) => `<span class="julia-letter" style="--i:${i}">${c}</span>`)
  .join("");

const tiles = [
  {
    title: "Snapchat Games",
    subtitle:
      "Growing Games in Snapchat from the ground up to over 30M DAU.",
    tags: ["Snapchat", "0-1", "Growth"],
    // No destination — renders as a placeholder ("Coming soon").
  },
  {
    title: "Topic Chats",
    subtitle:
      "Building and launching a 0-1 feature that helps Snapchatters find communities and chat over shared interests, driving US DAU via events and fandom.",
    tags: ["Snapchat", "0-1", "Communities"],
  },
  {
    title: "App Redesign",
    subtitle:
      "A globally launched UI refresh with richer profile content and delightful new interactions.",
    tags: ["Tinder", "Brand", "UI"],
    externalUrl: "https://techcrunch.com/", // TODO replace with real article URL
    badge: "Read the article",
  },
  {
    title: "Tappy Cloud",
    subtitle: "Introducing backend-driven, dynamically configurable profiles.",
    tags: ["Tinder", "Profiles", "Design Systems"],
    slug: "tappy-cloud",
    cover: "/projects/tappy-cloud/title-slide.png",
    alt: "Tappy Cloud",
  },
  {
    title: "Festival Mode",
    subtitle:
      "A new experience on Tinder Explore that allows festivalgoers to meet others going to the same festival.",
    tags: ["Tinder", "Strategy", "Branding"],
    slug: "festival-mode",
    cover: "/projects/festival-mode/cover.png",
    alt: "Festival Mode brand artwork",
  },
  {
    title: "Custom Lists",
    subtitle:
      "Improving the existing Lists feature to make it easier and more fun for users to curate lists of TV shows and movies.",
    tags: ["TV Time", "UX/UI", "Research"],
    slug: "custom-lists",
    cover: "/projects/custom-lists/tv-time-hero.jpg",
    alt: "TV Time brand lockup",
  },
  {
    title: "Onboarding Redesign",
    subtitle:
      "Redesigning onboarding to better educate users and communicate product value.",
    tags: ["TV Time", "Design Sprint"],
    slug: "tv-time-onboarding",
    cover: "/projects/tv-time-onboarding/hero-1.webp",
    alt: "TV Time brand lockup",
  },
];
---

<BaseLayout title="Julia Tang | Design">
  <section class="hero">
    <div class="page hero-grid">
      <div class="hero-text">
        <FadeIn>
          <p class="hero-greeting">
            <span class="hero-greeting__text">Hi, I'm <span class="julia-name" set:html={juliaHtml} />.</span>
            <span class="hero-greeting__wave" aria-hidden="true">👋</span>
          </p>
        </FadeIn>

        <FadeIn delay={140}>
          <p class="hero-lede">
            A Staff Product Designer with 10+ years building and shipping
            products that
            <span class="fx fx--delight">
              <span class="fx-icon fx-icon--tl" aria-hidden="true">✨</span>
              <span class="wave-text" set:html={delightHtml} />
              <span class="fx-icon fx-icon--tr" aria-hidden="true">✨</span>
            </span>
            users and
            <span class="fx fx--biz">
              move the business
              <span class="fx-icon fx-icon--brfloat" aria-hidden="true">📈</span>
            </span>.
          </p>
        </FadeIn>

        <FadeIn delay={240}>
          <p class="hero-lede">
            I solve ambiguous problems and ship
            <span class="fx fx--launch">
              <span class="hero-lede__pop">0-to-1</span>
              <span class="fx-icon fx-icon--up" aria-hidden="true">🚀</span>
            </span>
            features that scale to
            <span class="fx fx--reach">
              <span class="hero-lede__pop">millions</span>
              <span class="fx-icon fx-icon--brfloat" aria-hidden="true">🌍</span>
            </span>.
          </p>
        </FadeIn>

        <FadeIn delay={340}>
          <CompanyPills />
        </FadeIn>
      </div>

      <FadeIn delay={300} class="hero-orb-slot">
        <HeroOrb size={320} />
      </FadeIn>
    </div>
  </section>

  <section class="work">
    <div class="page">
      <ul class="cell-grid">
        {
          tiles.map((tile, i) => (
            <li>
              <FadeIn delay={i * 80}>
                <ProjectCell {...tile} />
              </FadeIn>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: var(--s-8);
    padding-bottom: var(--s-12);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: var(--s-10);
    align-items: center;
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
  }

  .hero-text {
    display: grid;
    /* Bigger gap between greeting and body to differentiate them. */
    gap: var(--s-6);
  }

  /* === Greeting — large italic display, anchors the visual hierarchy. === */
  .hero-greeting {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(44px, 6vw, 72px);
    line-height: 1.0;
    letter-spacing: -0.012em;
    color: var(--text-primary);
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-4);
  }
  .hero-greeting__text { display: inline-block; }
  .hero-greeting__wave {
    display: inline-block;
    font-style: normal;
    font-size: 0.7em;
    transform-origin: 70% 70%;
    animation: hero-wave 2.4s var(--ease-out) 700ms 1 normal both;
  }
  .hero-greeting:hover .hero-greeting__wave {
    animation: hero-wave 1.6s var(--ease-out) 0s 1 normal both;
  }
  @keyframes hero-wave {
    0%   { transform: rotate(0); }
    10%  { transform: rotate(16deg); }
    20%  { transform: rotate(-10deg); }
    30%  { transform: rotate(16deg); }
    40%  { transform: rotate(-4deg); }
    50%  { transform: rotate(12deg); }
    60%, 100% { transform: rotate(0); }
  }

  /* "Julia" letters bob in a wave on greeting hover. */
  .julia-name { display: inline-block; }
  :global(.julia-letter) {
    display: inline-block;
    will-change: transform;
  }
  .hero-greeting:hover :global(.julia-letter) {
    animation: julia-bob 800ms var(--ease-out);
    animation-delay: calc(var(--i, 0) * 75ms);
  }
  @keyframes julia-bob {
    0%, 100% { transform: translateY(0) rotate(0); }
    40%      { transform: translateY(-6px) rotate(4deg); }
  }

  /* === Body — smaller, calmer. Two short paragraphs. === */
  .hero-lede {
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.55;
    color: var(--text-primary);
    max-width: 560px;
    margin: 0;
    font-weight: 400;
  }

  /* === Hover effects framework ===
     `.fx` is a generic positioned wrapper around any decorated word.
     `.fx-icon` is the emoji that pops out on hover.
     Position modifiers control where the icon sits at rest and where it
     animates to. */
  .fx {
    position: relative;
    display: inline-block;
    cursor: default;
  }
  .fx-icon {
    position: absolute;
    font-style: normal;
    font-size: 0.7em;
    line-height: 1;
    pointer-events: none;
    opacity: 0;
    will-change: transform, opacity;
    transition:
      opacity 240ms var(--ease-out),
      transform 540ms var(--ease-out);
  }

  /* Top-left sparkle (rest hidden up-and-left, animates down-and-out). */
  .fx-icon--tl {
    top: -0.1em;
    left: -0.7em;
    transform: translate(0.4em, 0.3em) scale(0.6) rotate(-25deg);
  }
  .fx:hover .fx-icon--tl {
    opacity: 1;
    transform: translate(-0.1em, -0.5em) scale(1.05) rotate(-12deg);
  }

  /* Top-right sparkle (mirror of TL). */
  .fx-icon--tr {
    top: -0.1em;
    right: -0.7em;
    transform: translate(-0.4em, 0.3em) scale(0.6) rotate(25deg);
  }
  .fx:hover .fx-icon--tr {
    opacity: 1;
    transform: translate(0.1em, -0.5em) scale(1.05) rotate(12deg);
  }

  /* Bottom-right floating-up icon (used for chart, globe). */
  .fx-icon--brfloat {
    bottom: -0.1em;
    right: -1.05em;
    transform: translateY(0.4em) scale(0.7) rotate(8deg);
  }
  .fx:hover .fx-icon--brfloat {
    opacity: 1;
    transform: translateY(-0.55em) scale(1.05) rotate(-4deg);
  }

  /* Up-launch (used for rocket). */
  .fx-icon--up {
    top: -0.05em;
    right: -1em;
    transform: translateY(0.5em) rotate(40deg) scale(0.6);
  }
  .fx:hover .fx-icon--up {
    opacity: 1;
    transform: translateY(-0.65em) rotate(-25deg) scale(1.05);
  }

  /* === Shared rest state for all decorated words === */
  /* Powder-blue 2px underline so every interactive word reads as interactive. */
  .fx--delight,
  .fx--biz,
  .fx--launch,
  .fx--reach {
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 2px;
    padding-bottom: 1px;
    border-radius: var(--r-xs);
    transition:
      background-size 280ms var(--ease-out),
      background-image 280ms var(--ease-out);
  }

  /* "delight" — powder wash behind on hover (background grows up from underline). */
  .fx--delight:hover {
    background-image: linear-gradient(var(--brand-wash-soft), var(--brand-wash-soft));
    background-size: 100% 100%;
  }

  /* Per-letter wave for "delight" letters. */
  .wave-text {
    display: inline-block;
  }
  :global(.wave-letter) {
    display: inline-block;
    will-change: transform;
  }
  .fx--delight:hover :global(.wave-letter) {
    animation: letter-bob 800ms var(--ease-out);
    animation-delay: calc(var(--i, 0) * 65ms);
  }
  @keyframes letter-bob {
    0%, 100% { transform: translateY(0) rotate(0); }
    40%      { transform: translateY(-7px) rotate(-5deg); }
  }

  /* "move the business" — peach highlight grows on hover (replaces the underline). */
  .fx--biz:hover {
    background-image: linear-gradient(var(--brand-secondary), var(--brand-secondary));
    background-size: 100% 0.55em;
  }

  /* "0-to-1" and "millions" — inner span scales on hover; outer wash grows. */
  .hero-lede__pop {
    display: inline-block;
    color: var(--text-primary);
    transition: transform 220ms var(--ease-out);
  }
  .fx--launch:hover,
  .fx--reach:hover {
    background-image: linear-gradient(var(--brand-wash-soft), var(--brand-wash-soft));
    background-size: 100% 100%;
  }
  .fx--launch:hover .hero-lede__pop,
  .fx--reach:hover .hero-lede__pop {
    transform: translateY(-1px) scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-greeting__wave { animation: none; }
    .hero-greeting:hover :global(.julia-letter) { animation: none; }
    .fx-icon { transition: opacity 200ms var(--ease-out); transform: none !important; }
    .fx:hover .fx-icon { opacity: 1; }
    .fx--launch:hover .hero-lede__pop,
    .fx--reach:hover .hero-lede__pop { transform: none; }
    .fx--delight:hover :global(.wave-letter) { animation: none; }
  }

  /* Hero orb placement */
  :global(.hero-orb-slot) {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }
  @media (max-width: 900px) {
    :global(.hero-orb-slot) { justify-content: center; }
  }

  .work {
    padding-top: var(--s-8);
    padding-bottom: var(--s-24);
  }
  .cell-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
  }
</style>
