---
/**
 * SectionNav — sticky in-page nav rail for case studies.
 *
 * The nav is built client-side from `.cs-section[data-cs-section]` elements
 * in the page (each authored as `<Section title="...">`). Each entry shows
 * the section's nav label, links to `#<id>`, and highlights when the
 * matching section is the most prominent one in the viewport.
 *
 * Layout:
 *   - Desktop (≥1100px): vertical rail floats left of the content column
 *   - Below 1100px:      collapses into a sticky horizontal pill bar near
 *                        the top of the page (under the global header)
 */
---

<aside class="cs-nav" aria-label="Sections">
  <p class="cs-nav__eyebrow">On this page</p>
  <ol class="cs-nav__list" data-cs-nav>
    <!-- Filled in by the inline script below. -->
  </ol>
</aside>

<script is:inline>
  (function () {
    if (typeof window === "undefined") return;

    // Defer until the body is parsed so `.cs-section` elements (which
    // appear after this script in the DOM) are available.
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }

    function init() {
    const list = document.querySelector("[data-cs-nav]");
    if (!list) return;

    const sections = Array.from(
      document.querySelectorAll(".cs-section[data-cs-section]")
    ).filter((s) => s.id);

    if (sections.length < 2) {
      // Don't show the nav for very short case studies.
      const aside = list.closest(".cs-nav");
      if (aside) aside.remove();
      return;
    }

    // Group sections by stage and dedupe globally so each stage label
    // appears only once in the nav (in order of first appearance). When a
    // case study iterates Design → Test → Design → Test, the nav still
    // shows just "Design" and "Test"; the active class hops between them
    // as you scroll.
    const stageOrder = [];
    const stageMap = new Map();
    for (const s of sections) {
      const stage = s.dataset.csStage || s.dataset.csNavLabel || s.id;
      if (!stageMap.has(stage)) {
        stageMap.set(stage, { label: stage, anchor: s, sections: [] });
        stageOrder.push(stage);
      }
      stageMap.get(stage).sections.push(s);
    }
    const groups = stageOrder.map((s) => stageMap.get(s));

    const items = groups.map((g) => {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = "#" + g.anchor.id;
      a.dataset.csNavLink = g.anchor.id;
      a.textContent = g.label;
      li.appendChild(a);
      list.appendChild(li);
      return { id: g.anchor.id, el: g.anchor, sections: g.sections, link: a };
    });

    const setActive = (id) => {
      items.forEach((it) => {
        if (it.id === id) it.link.classList.add("is-active");
        else it.link.classList.remove("is-active");
      });
    };

    // IntersectionObserver tracks which sections are visible. We pick the
    // earliest visible one as "current" — feels right when the user is
    // scrolling down through long sections.
    // Track each section's top relative to the document, then on scroll pick
    // the one whose top is just above the activation line (~25% from top).
    // This handles the gap between sections (where figures sit) gracefully —
    // the previous section stays active until you reach the next one.
    // Build a flat list of all sections in DOM order with a back-pointer to
    // their stage group, so scroll tracking still works across the merged
    // (deduped) nav. Sections appear in DOM order, not stage order.
    const sectionToItem = new Map();
    for (let i = 0; i < groups.length; i++) {
      for (const s of groups[i].sections) sectionToItem.set(s, items[i]);
    }
    const allSections = sections.map((s) => ({ el: s, item: sectionToItem.get(s) }));

    let ticking = false;
    const updateActive = () => {
      const line = window.scrollY + window.innerHeight * 0.25;
      let current = allSections[0];
      for (const s of allSections) {
        const top = s.el.getBoundingClientRect().top + window.scrollY;
        if (top <= line) current = s;
        else break;
      }
      setActive(current.item.id);
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        updateActive();
        ticking = false;
      });
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    updateActive();

    // Smooth scroll on click; leave the URL hash intact.
    items.forEach((it) => {
      it.link.addEventListener("click", (e) => {
        e.preventDefault();
        history.replaceState(null, "", "#" + it.id);
        const top = it.el.getBoundingClientRect().top + window.scrollY - 80;
        window.scrollTo({ top, behavior: "smooth" });
      });
    });
    }
  })();
</script>

<style>
  .cs-nav {
    /* Desktop: floats left of the content. Hidden below 1100px. */
    position: sticky;
    top: var(--s-16);
    align-self: start;
    width: 200px;
    max-width: 200px;
    margin-right: var(--s-6);
    padding-block: var(--s-3);
  }

  .cs-nav__eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin: 0 0 var(--s-3);
  }

  .cs-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
    border-left: 2px solid var(--border-subtle);
  }

  .cs-nav__list :global(li) { margin: 0; }

  .cs-nav__list :global(a) {
    display: block;
    padding: var(--s-2) var(--s-3);
    margin-left: -2px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-tertiary);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition:
      color var(--dur-normal) var(--ease),
      border-color var(--dur-normal) var(--ease),
      background-color var(--dur-normal) var(--ease);
  }
  .cs-nav__list :global(a:hover) {
    color: var(--text-primary);
  }
  .cs-nav__list :global(a.is-active) {
    color: var(--text-primary);
    border-left-color: var(--brand-primary-2);
    background: var(--brand-wash-soft);
  }

  /* Below 1100px: collapse to a sticky horizontal scroller below the page header. */
  @media (max-width: 1100px) {
    .cs-nav {
      position: sticky;
      top: 64px;
      width: 100%;
      max-width: 100%;
      margin: 0;
      padding: var(--s-3) var(--s-5);
      background: color-mix(in srgb, var(--bg-canvas) 92%, transparent);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border-subtle);
      z-index: 10;
    }
    .cs-nav__eyebrow { display: none; }
    .cs-nav__list {
      display: flex;
      gap: var(--s-2);
      border-left: none;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: var(--s-1);
    }
    .cs-nav__list::-webkit-scrollbar { display: none; }
    .cs-nav__list :global(a) {
      flex-shrink: 0;
      margin-left: 0;
      padding: var(--s-2) var(--s-3);
      border-left: none;
      border-radius: var(--r-full);
      font-size: 12px;
    }
    .cs-nav__list :global(a.is-active) {
      border-left-color: transparent;
      color: var(--text-primary);
      background: var(--brand-wash);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cs-nav__list :global(a) { transition: none; }
  }
</style>
