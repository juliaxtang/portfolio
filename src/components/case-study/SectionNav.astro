---
/**
 * SectionNav — floating in-page nav rail for case studies.
 *
 * Positioned fixed at the left edge of the viewport, sitting below the
 * global header. Auto-hides after a short period of inactivity (no
 * scroll, no hover) so the page can fully breathe; reappears as soon as
 * the user starts scrolling or hovers near the left edge.
 *
 * Built client-side from `.cs-section[data-cs-section]` elements; entries
 * are grouped by stage so the rail stays short.
 */
---

<aside class="cs-nav is-hidden" aria-label="Sections" data-cs-nav-rail>
  <ol class="cs-nav__list" data-cs-nav>
    <!-- Filled in by the inline script below. -->
  </ol>
</aside>

<script is:inline>
  (function () {
    if (typeof window === "undefined") return;

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }

    function init() {
    const rail = document.querySelector("[data-cs-nav-rail]");
    const list = document.querySelector("[data-cs-nav]");
    if (!list || !rail) return;

    const sections = Array.from(
      document.querySelectorAll(".cs-section[data-cs-section]")
    ).filter((s) => s.id);

    if (sections.length < 2) {
      rail.remove();
      return;
    }

    const stageOrder = [];
    const stageMap = new Map();
    for (const s of sections) {
      const stage = s.dataset.csStage || s.dataset.csNavLabel || s.id;
      if (!stageMap.has(stage)) {
        stageMap.set(stage, { label: stage, anchor: s, sections: [] });
        stageOrder.push(stage);
      }
      stageMap.get(stage).sections.push(s);
    }
    const groups = stageOrder.map((s) => stageMap.get(s));

    const items = groups.map((g) => {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = "#" + g.anchor.id;
      a.dataset.csNavLink = g.anchor.id;
      a.textContent = g.label;
      li.appendChild(a);
      list.appendChild(li);
      return { id: g.anchor.id, el: g.anchor, sections: g.sections, link: a };
    });

    const setActive = (id) => {
      items.forEach((it) => {
        if (it.id === id) it.link.classList.add("is-active");
        else it.link.classList.remove("is-active");
      });
    };

    const sectionToItem = new Map();
    for (let i = 0; i < groups.length; i++) {
      for (const s of groups[i].sections) sectionToItem.set(s, items[i]);
    }
    const allSections = sections.map((s) => ({ el: s, item: sectionToItem.get(s) }));

    let ticking = false;
    const updateActive = () => {
      const line = window.scrollY + window.innerHeight * 0.25;
      let current = allSections[0];
      for (const s of allSections) {
        const top = s.el.getBoundingClientRect().top + window.scrollY;
        if (top <= line) current = s;
        else break;
      }
      setActive(current.item.id);
    };

    // ===== Auto-hide behavior =====
    // The rail stays hidden while the hero is visible. Once the user scrolls
    // past the hero, it appears on scroll/pointer-near-edge and auto-hides
    // after 2s of inactivity.
    const HIDE_AFTER_MS = 2000;
    const EDGE_REVEAL_PX = 48;
    let hideTimer = null;
    let heroPassed = false;

    const reveal = () => {
      if (!heroPassed) return;
      rail.classList.remove("is-hidden");
      if (hideTimer) clearTimeout(hideTimer);
      hideTimer = setTimeout(() => {
        if (!rail.matches(":hover")) rail.classList.add("is-hidden");
      }, HIDE_AFTER_MS);
    };

    // Watch the hero bidirectionally — show nav when hero leaves viewport,
    // hide it again if the user scrolls back up and hero re-enters.
    const hero = document.querySelector(".cs-hero");
    if (hero) {
      new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              // Hero visible again — force-hide and lock
              heroPassed = false;
              if (hideTimer) clearTimeout(hideTimer);
              rail.classList.add("is-hidden");
            } else {
              // Hero left viewport — unlock and reveal
              heroPassed = true;
              reveal();
            }
          }
        },
        { threshold: 0 }
      ).observe(hero);
    } else {
      heroPassed = true;
    }

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(() => {
          updateActive();
          ticking = false;
        });
      }
      reveal();
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);

    // Edge-of-viewport hover detection (desktop only). Pointer near the
    // left edge brings the rail back even if the user isn't actively
    // scrolling.
    window.addEventListener(
      "pointermove",
      (e) => {
        if (e.clientX <= EDGE_REVEAL_PX) reveal();
      },
      { passive: true }
    );
    rail.addEventListener("pointerenter", reveal);
    rail.addEventListener("pointerleave", () => {
      if (hideTimer) clearTimeout(hideTimer);
      hideTimer = setTimeout(() => rail.classList.add("is-hidden"), HIDE_AFTER_MS);
    });

    // Always start hidden; hero observer controls first reveal.
    updateActive();

    items.forEach((it) => {
      it.link.addEventListener("click", (e) => {
        e.preventDefault();
        history.replaceState(null, "", "#" + it.id);
        const top = it.el.getBoundingClientRect().top + window.scrollY - 80;
        window.scrollTo({ top, behavior: "smooth" });
      });
    });
    }
  })();
</script>

<style>
  .cs-nav {
    position: fixed;
    top: clamp(96px, 14vh, 160px);
    left: var(--s-5);
    z-index: 20;
    width: 148px;
    padding: var(--s-2) var(--s-2);
    background: color-mix(in srgb, var(--bg-canvas) 90%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: var(--r-md);
    transition:
      transform var(--dur-slow) var(--ease-out),
      opacity var(--dur-slow) var(--ease-out);
    will-change: transform, opacity;
  }
  /* Start hidden — JS unlocks after hero leaves viewport */
  .cs-nav.is-hidden {
    transform: translateX(calc(-100% - var(--s-5)));
    opacity: 0;
    pointer-events: none;
  }

  .cs-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
    border-left: 2px solid var(--border-subtle);
  }

  .cs-nav__list :global(li) { margin: 0; }

  .cs-nav__list :global(a) {
    display: block;
    padding: var(--s-2) var(--s-3);
    margin-left: -2px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-tertiary);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition:
      color var(--dur-normal) var(--ease),
      border-color var(--dur-normal) var(--ease),
      background-color var(--dur-normal) var(--ease);
  }
  .cs-nav__list :global(a:hover) {
    color: var(--text-primary);
  }
  .cs-nav__list :global(a.is-active) {
    color: var(--text-primary);
    border-left-color: var(--brand-primary-2);
    background: var(--brand-wash-soft);
  }

  /* On narrow viewports, collapse to a sticky horizontal scroller below
     the page header. The auto-hide behavior doesn't apply on mobile. */
  @media (max-width: 900px) {
    .cs-nav {
      position: sticky;
      top: 56px;
      left: 0;
      width: 100%;
      padding: var(--s-3) var(--s-5);
      background: color-mix(in srgb, var(--bg-canvas) 94%, transparent);
      border-radius: 0;
      border-bottom: 1px solid var(--border-subtle);
      z-index: 10;
    }
    .cs-nav.is-hidden {
      transform: none;
      opacity: 1;
      pointer-events: auto;
    }
    .cs-nav__list {
      display: flex;
      gap: var(--s-2);
      border-left: none;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .cs-nav__list::-webkit-scrollbar { display: none; }
    .cs-nav__list :global(a) {
      flex-shrink: 0;
      margin-left: 0;
      padding: var(--s-2) var(--s-3);
      border-left: none;
      border-radius: var(--r-full);
      font-size: 12px;
    }
    .cs-nav__list :global(a.is-active) {
      border-left-color: transparent;
      color: var(--text-primary);
      background: var(--brand-wash);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cs-nav { transition: none; }
    .cs-nav__list :global(a) { transition: none; }
  }
</style>
