---
/**
 * Figure — single image with optional caption.
 *
 * `width`:
 *   - "narrow" (default) — fits the prose column (~760px)
 *   - "wide"             — fills the content max (~1240px)
 *   - "bleed"            — full viewport width, edge to edge
 *
 * `device`:
 *   - "phone"  — locks aspect to a phone screen (9/18), centers the image
 *   - "tablet" — locks to 4/3
 *   - "auto"   — natural aspect, capped by max-height (default)
 *
 * `frame` adds a soft surface card around the image (padding + radius +
 * subtle border) so screenshots and mockups feel intentional rather than
 * floating.
 *
 * Images always letterbox with `object-fit: contain` so screenshots are
 * never cropped. The figure's max-height keeps tall portrait mockups from
 * dominating the page.
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
  width?: "narrow" | "wide" | "bleed";
  device?: "phone" | "tablet" | "auto";
  frame?: boolean;
  aspect?: string;
  maxHeight?: string;
  maxWidth?: string;
  background?: "soft" | "surface" | "none";
  centered?: boolean;
  crop?: boolean;
  cropFrom?: string;
  class?: string;
  captionTop?: boolean;
}

const {
  src,
  alt,
  caption,
  width = "narrow",
  device = "auto",
  frame = false,
  aspect,
  maxHeight,
  maxWidth,
  background = "none",
  centered = false,
  crop = false,
  cropFrom = "left top",
  class: className = "",
  captionTop = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolved = src.startsWith("http") || src.startsWith(base)
  ? src
  : `${base}${src.startsWith("/") ? "" : "/"}${src}`;


const aspectMap: Record<string, string | undefined> = {
  phone: "9 / 18",
  tablet: "4 / 3",
  auto: undefined,
};
const finalAspect = aspect ?? aspectMap[device];

const cls = [
  "cs-figure",
  `cs-figure--${width}`,
  frame ? "cs-figure--framed" : "",
  device !== "auto" ? `cs-figure--device-${device}` : "",
  `cs-figure--bg-${background}`,
  centered ? "cs-figure--centered" : "",
  crop ? "cs-figure--crop" : "",
  maxHeight ? "cs-figure--capped" : "",
  className,
].filter(Boolean).join(" ");

// Inline style only when necessary so cascade order stays predictable.
const styleParts: string[] = [];
if (finalAspect && !maxHeight) styleParts.push(`aspect-ratio:${finalAspect}`);
if (maxHeight) styleParts.push(`--cs-figure-max-h:${maxHeight}`);
if (maxWidth) styleParts.push(`max-width:${maxWidth}`);
if (maxWidth) styleParts.push(`margin-inline:auto`);
const mediaStyle = styleParts.join(";");
---

<figure class={cls}>
  {caption && captionTop && <figcaption class="cs-figure__caption cs-figure__caption--top">{caption}</figcaption>}
  <div class="cs-figure__media" style={mediaStyle}>
    <img src={resolved} alt={alt} loading="lazy" style={crop ? `object-position:${cropFrom}` : undefined} />
  </div>
  {caption && !captionTop && <figcaption class="cs-figure__caption">{caption}</figcaption>}
</figure>

<style>
  .cs-figure {
    margin: var(--s-8) auto;
    transition: transform 0.35s var(--ease-out, cubic-bezier(0.2, 0, 0, 1));
    will-change: transform;
  }
  .cs-figure:hover {
    transform: scale(1.015);
  }
  .cs-figure--narrow { max-width: var(--content-narrow); }
  /* Wide figures left-align with narrow text, right margin matches the
     natural right-side margin of full content-max centering. */
  .cs-figure--wide {
    max-width: var(--content-max);
    margin-left: max(var(--s-5), calc((100% - var(--content-narrow)) / 2));
    margin-right: max(var(--s-5), calc((100% - var(--content-max)) / 2));
  }
  /* Centered wide figure: same max-width as wide, but auto-centered on page
     instead of left-aligning with the narrow prose column. Used for lone
     wide images that should sit centered when not paired with prose. */
  .cs-figure--centered.cs-figure--wide {
    margin-left: auto;
    margin-right: auto;
  }
  .cs-figure--bleed  {
    max-width: none;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  /* Phone-shaped figures shouldn't span the full prose column — they look
     ridiculous wider than ~360px even on desktop. */
  .cs-figure--device-phone.cs-figure--narrow .cs-figure__media { max-width: 320px; margin-inline: auto; }
  .cs-figure--device-phone.cs-figure--wide   .cs-figure__media { max-width: 360px; margin-inline: auto; }

  .cs-figure__media {
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  :global(.cs-figure--rounder) .cs-figure__media  { border-radius: 28px; }
  :global(.cs-figure--roundest) .cs-figure__media { border-radius: 36px; }
  :global(.cs-figure--crop-top) .cs-figure__media img { margin-top: 0; }
  /* Phone/tablet figures: lock the container to the phone aspect ratio
     so the image is constrained vertically and the caption sits right
     below the phone with no large empty box. */
  .cs-figure--device-phone .cs-figure__media,
  .cs-figure--device-tablet .cs-figure__media {
    display: block;
    text-align: center;
  }
  .cs-figure--device-phone .cs-figure__media {
    aspect-ratio: 9 / 18;
  }
  .cs-figure--device-tablet .cs-figure__media {
    aspect-ratio: 4 / 3;
  }

  /* Background variants — covers letterboxing space when an image's natural
     aspect doesn't match the figure box. */
  .cs-figure--bg-soft    .cs-figure__media { background: var(--brand-wash-soft); }
  .cs-figure--bg-surface .cs-figure__media { background: var(--bg-surface); }
  .cs-figure--bg-none    .cs-figure__media { background: transparent; }

  /* Drop shadow on all non-transparent figures. */
  .cs-figure:not(.cs-figure--bg-none):not(.cs-figure--framed) .cs-figure__media {
    box-shadow: 0 4px 24px -6px rgba(0, 0, 0, 0.14), 0 1px 4px -1px rgba(0, 0, 0, 0.06);
  }

  .cs-figure--bleed .cs-figure__media { border-radius: 0; }

  /* Height-capped figures: the image is constrained by max-height with
     auto width and is centered horizontally inside its column. Use for
     rows of images (TwoUp/ThreeUp) so each tile shares a vertical budget
     instead of growing to fill the column width. The 36px corner radius
     matches the device frame radius used elsewhere for mobile mockups. */
  .cs-figure--capped .cs-figure__media {
    display: flex;
    justify-content: center;
    align-items: center;
    aspect-ratio: auto;
    overflow: visible;
    background: transparent;
  }
  .cs-figure--capped .cs-figure__media img,
  .cs-figure--capped .cs-figure__media video {
    border-radius: 36px;
  }
  .cs-figure--capped .cs-figure__media img,
  .cs-figure--capped .cs-figure__media video {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: var(--cs-figure-max-h);
    margin: 0 auto;
  }

  .cs-figure--framed .cs-figure__media {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: var(--s-6);
    box-shadow: var(--shadow-sm);
  }
  @media (max-width: 720px) {
    .cs-figure--framed .cs-figure__media { padding: var(--s-4); }
  }

  .cs-figure__media img,
  .cs-figure__media video {
    width: 100%;
    height: auto;
    display: block;
  }
  /* crop: fill the aspect-ratio container and anchor top-left so
     black edges on right/bottom are clipped by overflow:hidden */
  .cs-figure--crop .cs-figure__media img,
  .cs-figure--crop .cs-figure__media video {
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }
  /* Phone/tablet image fills its container's width and uses its natural
     height — no letterboxing or empty space. */
  .cs-figure--device-phone .cs-figure__media img,
  .cs-figure--device-phone .cs-figure__media video,
  .cs-figure--device-tablet .cs-figure__media img,
  .cs-figure--device-tablet .cs-figure__media video {
    width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .cs-figure__caption {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-tertiary);
    text-align: center;
    margin-top: var(--s-3);
    padding-inline: var(--s-4);
  }
  .cs-figure__caption--top {
    margin-top: 0;
    margin-bottom: var(--s-3);
    font-size: 14px;
    color: var(--text-secondary);
    font-weight: 500;
  }
</style>
