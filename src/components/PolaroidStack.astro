---
/**
 * PolaroidStack — a swipeable / tappable deck of polaroid photos with
 * handwritten captions on the matte. Same interaction model as
 * VideoCardStack on the homepage (drag the top card past a threshold to
 * throw, tap to advance, infinite shuffle), tuned for static images
 * instead of looping video.
 *
 * Each item is a polaroid: square photo on top, white matte below with
 * Julia's handwritten font for the caption. Optional pinned annotations
 * float over the photo (used to label "Poe" and "Mocha" on the cat
 * photo); optional inline mountain scribble sits next to the snowboard
 * caption; optional bullet list takes the place of a single-line caption
 * (used for the language-learning notebook).
 */
interface Annotation {
  label: string;
  /** CSS top / left, percentages or any length unit. */
  top: string;
  left: string;
  /** Tilt angle for that scribble (default ~ -6deg). */
  tilt?: number;
  /** Override the default annotation size scaling factor. */
  scale?: number;
}

interface Item {
  src: string;
  alt: string;
  /** object-position override for the photo crop. */
  position?: string;
  /** Single-line handwritten caption shown on the matte. */
  caption?: string;
  /** Optional doodle next to the caption ("mountain" for the snowboard
   *  card, "arrow" for the swipe-hint card on the topmost polaroid). */
  scribble?: "mountain" | "arrow";
  /** Bullet list shown in the matte instead of a single caption. */
  bullets?: string[];
  /** Pinned handwritten annotations over the photo. */
  annotations?: Annotation[];
  /** Initial resting tilt of the polaroid in the stack. */
  tilt?: number;
}

interface Props {
  items: Item[];
  /** Width of the polaroid card. */
  width?: string;
  /** ARIA label that describes what the deck contains. */
  label?: string;
}

const {
  items,
  width = "320px",
  label = "Personal photos. Press Enter, Space, or arrow keys to flip through the stack.",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolve = (p: string) =>
  p.startsWith("http") || p.startsWith(base)
    ? p
    : `${base}${p.startsWith("/") ? "" : "/"}${p}`;
---

<div
  class="polaroid-stack"
  data-polaroid-stack
  style={`--ps-width:${width};`}
>
  <div class="polaroid-stack__deck" data-deck data-cursor="swipe-pill" aria-label={label}>
    {items.map((it) => (
      <div
        class="polaroid-stack__card"
        data-card
        style={it.tilt != null ? `--rest-tilt:${it.tilt}deg;` : ""}
      >
        <div class="polaroid-card">
          <div class="polaroid-photo" style={it.position ? `--photo-pos:${it.position};` : ""}>
            <img src={resolve(it.src)} alt={it.alt} loading="lazy" draggable="false" />
            {it.annotations && it.annotations.map((a) => (
              <span
                class="polaroid-anno"
                style={`top:${a.top};left:${a.left};--anno-tilt:${a.tilt ?? -6}deg;--anno-scale:${a.scale ?? 1};`}
                aria-hidden="true"
              >{a.label}</span>
            ))}
          </div>
          {(it.caption || it.bullets) && (
            <div class="polaroid-matte">
              {it.bullets ? (
                <ul class="polaroid-matte__bullets" aria-hidden="true">
                  {it.bullets.map((b) => <li>{b}</li>)}
                </ul>
              ) : (
                <p class="polaroid-matte__caption" aria-hidden="true">
                  <span class="polaroid-matte__text">{it.caption}</span>
                  {it.scribble === "mountain" && (
                    <svg
                      class="polaroid-matte__doodle"
                      viewBox="0 0 60 32"
                      aria-hidden="true"
                    >
                      <path
                        d="M3 28 Q 9 26 14 18 Q 18 12 22 19 Q 25 24 28 22 L 33 14 Q 37 6 41 14 L 46 22 Q 50 27 57 28"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <path
                        d="M30 18 L 33 14 L 36 18"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        opacity="0.7"
                      />
                    </svg>
                  )}
                  {it.scribble === "arrow" && (
                    <svg
                      class="polaroid-matte__doodle polaroid-matte__doodle--arrow"
                      viewBox="0 0 64 22"
                      aria-hidden="true"
                    >
                      <path
                        d="M3 12 Q 12 8 22 13 Q 32 17 42 11 Q 50 7 56 12"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <path
                        d="M48 5 L 56 12 L 48 19"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}
                </p>
              )}
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</div>

<script is:inline>
  (function () {
    if (typeof window === "undefined") return;
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }

    function init() {
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.querySelectorAll("[data-polaroid-stack]").forEach((root) =>
        setupDeck(root, reduced)
      );
    }

    function setupDeck(root, reduced) {
      const deck = root.querySelector("[data-deck]");
      if (!deck) return;
      const order = Array.from(deck.querySelectorAll("[data-card]"));
      if (!order.length) return;

      // Resting positions — softer offsets than the homepage games deck
      // because polaroid frames are larger and the stack lives behind a
      // hero image, so the back cards just need to peek out enough to
      // signal there's more.
      const POSE = [
        { ty: 0,  scale: 1.00, rot:  0,    blur: 0,    opacity: 1     },
        { ty: 18, scale: 0.97, rot: -5.5,  blur: 0.2,  opacity: 0.96  },
        { ty: 36, scale: 0.94, rot:  6,    blur: 0.5,  opacity: 0.90  },
        { ty: 52, scale: 0.91, rot: -3,    blur: 0.8,  opacity: 0.82  },
        { ty: 68, scale: 0.88, rot:  4,    blur: 1.0,  opacity: 0.74  },
      ];

      function applyResting() {
        order.forEach((card, i) => {
          const p = POSE[Math.min(i, POSE.length - 1)];
          const restRot = card.style.getPropertyValue("--rest-tilt");
          const rot = i === 0 && restRot ? restRot : p.rot + "deg";
          card.style.transition =
            "transform 480ms var(--ease-out), opacity 320ms var(--ease-out), filter 320ms var(--ease-out)";
          card.style.transform =
            "translate3d(0, " + p.ty + "px, 0) rotate(" + rot + ") scale(" + p.scale + ")";
          card.style.opacity = String(p.opacity);
          card.style.filter = p.blur ? "blur(" + p.blur + "px)" : "";
          card.style.zIndex = String(order.length - i);
          card.style.pointerEvents = i === 0 ? "auto" : "none";
          card.classList.toggle("is-top", i === 0);
        });
      }

      let advancing = false;

      function advance(direction) {
        if (advancing) return;
        advancing = true;
        const top = order[0];
        if (!top) {
          advancing = false;
          return;
        }
        const dir = direction || (Math.random() < 0.5 ? -1 : 1);
        root.classList.add("is-advanced");

        if (reduced) {
          order.push(order.shift());
          applyResting();
          setTimeout(() => { advancing = false; }, 160);
          return;
        }

        const sideX = dir * Math.min(220, (root.clientWidth || 320) * 0.6);
        const sideRot = dir * 12;

        order.push(order.shift());

        top.style.transition =
          "transform 260ms cubic-bezier(0.32, 0, 0.32, 1), opacity 260ms ease-out, filter 260ms ease-out";
        top.style.zIndex = "0";
        top.style.transform =
          "translate3d(" + sideX + "px, 12px, 0) rotate(" + sideRot + "deg) scale(0.92)";
        top.style.opacity = "0.85";
        top.style.filter = "blur(0.4px)";
        top.classList.remove("is-top");
        top.style.pointerEvents = "none";

        for (let i = 0; i < order.length - 1; i++) {
          const card = order[i];
          const p = POSE[Math.min(i, POSE.length - 1)];
          card.style.transition =
            "transform 380ms var(--ease-out), opacity 280ms var(--ease-out), filter 280ms var(--ease-out)";
          card.style.transform =
            "translate3d(0, " + p.ty + "px, 0) rotate(" + p.rot + "deg) scale(" + p.scale + ")";
          card.style.opacity = String(p.opacity);
          card.style.filter = p.blur ? "blur(" + p.blur + "px)" : "";
          card.style.zIndex = String(order.length - i);
          card.style.pointerEvents = i === 0 ? "auto" : "none";
          card.classList.toggle("is-top", i === 0);
        }

        setTimeout(() => {
          const back = POSE[Math.min(order.length - 1, POSE.length - 1)];
          top.style.transition =
            "transform 360ms var(--ease-out), opacity 280ms var(--ease-out), filter 280ms var(--ease-out)";
          top.style.transform =
            "translate3d(0, " + back.ty + "px, 0) rotate(" + back.rot + "deg) scale(" + back.scale + ")";
          top.style.opacity = String(back.opacity);
          top.style.filter = back.blur ? "blur(" + back.blur + "px)" : "";
          top.style.zIndex = "1";
        }, 240);

        setTimeout(() => { advancing = false; }, 240);
      }

      let dragging = false;
      let startX = 0;
      let startY = 0;
      let dx = 0;
      let dy = 0;
      let pointerId = null;
      let didDrag = false;

      function topCard() { return order[0]; }

      function onPointerDown(e) {
        if (advancing) return;
        const card = topCard();
        if (!card) return;
        if (!card.contains(e.target)) return;
        dragging = true;
        didDrag = false;
        startX = e.clientX;
        startY = e.clientY;
        dx = 0;
        dy = 0;
        pointerId = e.pointerId;
        try { card.setPointerCapture(pointerId); } catch (_) {}
        card.style.transition = "none";
        card.style.cursor = "grabbing";
      }

      function onPointerMove(e) {
        if (!dragging) return;
        if (e.pointerId !== pointerId) return;
        dx = e.clientX - startX;
        dy = e.clientY - startY;
        if (Math.abs(dx) > 4 || Math.abs(dy) > 4) didDrag = true;
        const card = topCard();
        if (!card) return;
        const rot = dx / 16;
        card.style.transform =
          "translate3d(" + dx + "px, " + dy * 0.4 + "px, 0) rotate(" + rot + "deg) scale(1)";
      }

      function onPointerUp(e) {
        if (!dragging) return;
        if (e.pointerId !== pointerId) return;
        dragging = false;
        const card = topCard();
        if (!card) return;
        try { card.releasePointerCapture(pointerId); } catch (_) {}
        card.style.cursor = "";
        const threshold = Math.min(160, (root.clientWidth || 320) * 0.22);
        if (Math.abs(dx) > threshold) {
          advance(dx > 0 ? 1 : -1);
        } else if (!didDrag) {
          advance(0);
        } else {
          applyResting();
        }
        pointerId = null;
      }

      deck.addEventListener("pointerdown", onPointerDown);
      window.addEventListener("pointermove", onPointerMove);
      window.addEventListener("pointerup", onPointerUp);
      window.addEventListener("pointercancel", onPointerUp);

      deck.setAttribute("tabindex", "0");
      deck.setAttribute("role", "button");
      deck.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " " || e.key === "ArrowRight") {
          e.preventDefault();
          advance(1);
        } else if (e.key === "ArrowLeft") {
          e.preventDefault();
          advance(-1);
        }
      });

      applyResting();
    }
  })();
</script>

<style>
  .polaroid-stack {
    position: relative;
    width: var(--ps-width, 320px);
    /* Aspect chosen so the deck's box reserves space for the topmost
       polaroid (1/1 photo + slim matte) plus enough headroom for the
       back cards' translateY peek without overflowing the layout
       below. */
    aspect-ratio: 1 / 1.5;
    isolation: isolate;
    overflow: visible;
    touch-action: pan-y;
    z-index: 1;
  }

  .polaroid-stack__deck {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: start center;
    outline: none;
  }
  .polaroid-stack__deck:focus-visible {
    outline: 2px solid var(--brand-primary-2, #A9C7DC);
    outline-offset: 10px;
    border-radius: 14px;
  }

  .polaroid-stack__card {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    transform-origin: 50% 50%;
    will-change: transform, opacity, filter;
    cursor: grab;
    user-select: none;
    -webkit-user-drag: none;
  }
  .polaroid-stack__card.is-top:active { cursor: grabbing; }

  .polaroid-card {
    width: 100%;
    background: #FFFFFF;
    border: 1px solid #EAE6DF;
    border-radius: var(--r-xs);
    padding: 12px 12px 0;
    box-shadow:
      0 24px 40px rgba(20, 22, 28, 0.18),
      0 8px 16px rgba(20, 22, 28, 0.10);
    /* Anchor every card at the same outer height so the back-of-stack
       offsets read as a clean deck regardless of how long an individual
       caption is. The fixed aspect = photo (1/1) + matte (~46px) over a
       320px-wide card, which keeps the photo dominant and the matte
       just tall enough for one line of handwritten caption. */
    aspect-ratio: 320 / 450;
    display: flex;
    flex-direction: column;
  }
  .polaroid-stack__card.is-top .polaroid-card {
    box-shadow:
      0 36px 60px rgba(20, 22, 28, 0.26),
      0 14px 24px rgba(20, 22, 28, 0.14);
  }

  .polaroid-photo {
    position: relative;
    flex: 0 0 auto;
    aspect-ratio: 1 / 1.35;
    overflow: hidden;
    background: #f3eee7;
    border-radius: 2px;
  }
  .polaroid-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--photo-pos, 50% 50%);
    display: block;
    pointer-events: none;
  }

  /* Pinned handwritten labels floating over the photo (e.g. Poe, Mocha
     above each cat). The label sits ABOVE the point we're pointing at,
     with a small downward arrow tail under each scribble. */
  .polaroid-anno {
    position: absolute;
    transform: translate(-0%, -70%) rotate(var(--anno-tilt, -6deg)) scale(var(--anno-scale, 1));
    transform-origin: 50% 100%;
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: 28px;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #FFFFFF;
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.55),
      0 0 6px rgba(0, 0, 0, 0.35);
    pointer-events: none;
    white-space: nowrap;
    z-index: 2;
  }
  .polaroid-anno::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 100%;
    width: 2px;
    height: 16px;
    background: #FFFFFF;
    border-radius: 1px;
    transform: translateX(-50%) rotate(var(--anno-arrow-rot, 8deg));
    transform-origin: 50% 0%;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
  }

  .polaroid-matte {
    flex: 1 1 auto;
    padding: 4px 8px 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #15171C;
    overflow: hidden;
  }
  .polaroid-matte__caption {
    margin: 0;
    font-family: var(--font-hand);
    font-weight: 500;
    font-size: 18px;
    line-height: 1.0;
    letter-spacing: -0.05em;
    color: #15171C;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: left;
  }
  .polaroid-matte__text { display: inline-block; }
  .polaroid-matte__doodle {
    width: 44px;
    height: 22px;
    color: #2a2a2f;
    display: inline-block;
    vertical-align: -4px;
  }
  .polaroid-matte__doodle--arrow {
    width: 38px;
    height: 14px;
    color: var(--text-tertiary, #6b6b72);
    vertical-align: -2px;
  }
  .polaroid-matte__bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-hand);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: #15171C;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 12px;
    justify-content: center;
  }
  .polaroid-matte__bullets li::before {
    content: "·  ";
    color: #6b6b72;
    margin-right: 2px;
  }
  .polaroid-matte__bullets li:first-child::before {
    content: "";
    margin: 0;
  }

  /* Idle hint — top card pulses a subtle outer shadow until the first
     interaction so the deck reads as alive even before the user
     hovers. */
  @keyframes polaroid-stack-hint {
    0%, 100% { box-shadow: 0 36px 60px rgba(20, 22, 28, 0.26), 0 14px 24px rgba(20, 22, 28, 0.14); }
    50%      { box-shadow: 0 36px 60px rgba(20, 22, 28, 0.26), 0 14px 24px rgba(20, 22, 28, 0.14), 0 0 0 6px rgba(20, 22, 28, 0.04); }
  }
  .polaroid-stack:not(.is-advanced) .polaroid-stack__card.is-top .polaroid-card {
    animation: polaroid-stack-hint 2200ms ease-in-out 600ms 3;
  }

  @media (prefers-reduced-motion: reduce) {
    .polaroid-stack__card { transition: opacity 220ms ease-out !important; }
    .polaroid-stack:not(.is-advanced) .polaroid-stack__card.is-top .polaroid-card {
      animation: none;
    }
  }
</style>
