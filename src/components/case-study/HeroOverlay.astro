---
/**
 * HeroOverlay — a single composite image that floats over the hero
 * background with a subtle scroll parallax. Used for cases where the
 * hero visual is a pre-composed asset (e.g. TV Time Onboarding hero-2).
 */
interface Props {
  src: string;
  alt?: string;
}
const { src, alt = "" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolve = (p: string) =>
  p.startsWith("http") || p.startsWith(base) ? p : `${base}${p.startsWith("/") ? "" : "/"}${p}`;
---

<div class="ho" aria-hidden="true">
  <img class="ho__img" src={resolve(src)} alt={alt} draggable="false" />
</div>

<script is:inline>
  (function () {
    if (typeof window === "undefined") return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    function init() {
      document.querySelectorAll(".ho").forEach(function (root) {
        const img = root.querySelector(".ho__img");
        if (!img) return;
        let raf = 0;
        function update() {
          raf = 0;
          const hero = root.closest(".cs-hero, .cs-more__band");
          if (!hero) return;
          const rect = hero.getBoundingClientRect();
          /* Symmetric viewport-traversal: 0 when the band first enters
             the bottom, 0.5 at center, 1 when it exits the top. Works
             for the case-study hero at the top AND the MoreWork band at
             the bottom (where you can't scroll the band fully past the
             viewport, only into/through it). */
          const vh = window.innerHeight || document.documentElement.clientHeight;
          const total = vh + rect.height;
          if (total <= 0) return;
          const progress = Math.min(Math.max((vh - rect.top) / total, 0), 1);
          const centered = progress - 0.5;
          /* Write the scroll offset to a CSS custom property instead of
             setting `transform` directly. This lets the host stylesheet
             (e.g. the MoreWork band) compose its own transform without
             being stomped on by the scroll handler. */
          img.style.setProperty("--scroll-y", (-centered * 64).toFixed(1) + "px");
        }
        window.addEventListener("scroll", function () {
          if (!raf) raf = requestAnimationFrame(update);
        }, { passive: true });
        window.addEventListener("resize", update);
        update();
      });
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
  })();
</script>

<style>
  .ho {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: var(--s-6);
    overflow: visible;
    pointer-events: none;
  }

  .ho__img {
    --scroll-y: 0px;
    width: 90%;
    max-width: 500px;
    height: auto;
    display: block;
    object-fit: contain;
    will-change: transform;
    filter: drop-shadow(0 24px 48px rgba(0,0,0,0.20));
    transform-origin: bottom center;
    transform: translate3d(0, var(--scroll-y), 0);
  }
</style>
