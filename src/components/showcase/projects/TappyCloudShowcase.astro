---
/**
 * Tappy Cloud Showcase block — homepage version (interactive hero).
 * The footer "more work" block on case-study pages uses MoreWork.astro
 * instead, which pairs this same text content with the case-study Hero.
 */
import Showcase from "../Showcase.astro";
import ProfileColumns from "../ProfileColumns.astro";
import { showcaseContent } from "../../../data/showcases";

interface Props {
  reverse?: boolean;
  id?: string;
}
const { reverse = false, id = "tappy-cloud" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const data = showcaseContent["tappy-cloud"];
---

<Showcase
  companyLogo={data.companyLogo}
  companyName={data.companyName}
  year={data.year}
  role={data.role}
  title={data.title}
  tagline={data.tagline}
  stats={data.stats}
  statsValueFontSize="26px"
  ctaHref={`${base}/product-design/tappy-cloud`}
  accent={data.accent}
  reverse={reverse}
  id={id}
>
  <div class="tappy-cloud__profiles-wrap">
    <ProfileColumns
      left="/projects/tappy-cloud/profiles-left.png"
      right="/projects/tappy-cloud/profiles-right.png"
      altLeft="Tinder profiles styled by Tappy Cloud"
      altRight="More Tinder profiles styled by Tappy Cloud"
      maxWidth="480px"
      minHeight="1100"
      cards={4}
      showCards={3}
      offsetRight="80px"
    />
  </div>
</Showcase>

<style>
  /* On reverse layout the ProfileColumns sit in cols 3-6 (left side of the
     Showcase). At 1024-1340px viewports the SideRail wordmark + Work/About/
     Resume nav are still visible (the rail dissolves into the sticky header
     at ≤1023px), and the default ProfileColumns max-width (480px) fills the
     ~440px-wide grid cell entirely, so the leftmost profile card ends up
     sitting only ~10-15px from where the SideRail nav lives. Cap the
     ProfileColumns to a smaller width and push it right within the cell so
     it visibly clears the rail without spilling into the project text column
     across the gutter on the right. */
  @media (min-width: 1024px) and (max-width: 1340px) {
    .tappy-cloud__profiles-wrap :global(.profile-cols) {
      max-width: clamp(240px, 22vw, 300px);
      margin-left: clamp(80px, 9vw, 130px);
      margin-right: auto;
    }
  }
</style>
