---
/**
 * TwoUp — two-column layout for side-by-side media or before/after pairs.
 *
 * Two usage modes:
 *
 *   Headless (default): pass two children as the default slot. They become
 *   the two columns and the layout stacks on mobile.
 *
 *   Headed: pass `title` (and optionally `eyebrow`/`titleId`). The header
 *   renders inside the left column directly above the left content. Use
 *   named slots <slot name="left" /> and <slot name="right" /> to place
 *   each column explicitly. The right column sits vertically centered
 *   against the title-plus-left-content unit.
 */
interface Props {
  ratio?: "1:1" | "1:2" | "2:1";
  align?: "start" | "center" | "end" | "stretch";
  gap?: "sm" | "md" | "lg";
  wide?: boolean;
  centered?: boolean;
  title?: string;
  eyebrow?: string;
  titleId?: string;
}

const {
  ratio = "1:1",
  align = "stretch",
  gap = "md",
  wide = false,
  centered = false,
  title,
  eyebrow,
  titleId,
} = Astro.props;
const ratioMap: Record<string, string> = {
  "1:1": "minmax(0, 1fr) minmax(0, 1fr)",
  "1:2": "minmax(0, 1fr) minmax(0, 2fr)",
  "2:1": "minmax(0, 2fr) minmax(0, 1fr)",
};
const gapMap: Record<string, string> = {
  sm: "var(--s-4)",
  md: "var(--s-6)",
  lg: "var(--s-10)",
};
const hasHeader = Boolean(title || eyebrow);
const hasLeftSlot = await Astro.slots.has("left");
const hasRightSlot = await Astro.slots.has("right");
const useNamedSlots = hasHeader || hasLeftSlot || hasRightSlot;
const cls = [
  "cs-twoup",
  wide ? "cs-twoup--wide" : "",
  centered ? "cs-twoup--centered" : "",
  hasHeader ? "cs-twoup--headed" : "",
].filter(Boolean).join(" ");
const finalAlign = useNamedSlots && hasHeader ? "center" : align;
const styleVars = `--cs-twoup-cols:${ratioMap[ratio]};--cs-twoup-gap:${gapMap[gap]};--cs-twoup-align:${finalAlign};`;
---

<div class={cls} style={styleVars}>
  {useNamedSlots ? (
    <>
      <div class="cs-twoup__left">
        {hasHeader && (
          <header class="cs-twoup__head">
            {eyebrow && <p class="t-eyebrow cs-twoup__eyebrow">{eyebrow}</p>}
            {title && (
              <h2 id={titleId} class="cs-twoup__title">{title}</h2>
            )}
          </header>
        )}
        <slot name="left" />
      </div>
      <slot name="right" />
    </>
  ) : (
    <slot />
  )}
</div>

<style>
  .cs-twoup {
    display: grid;
    grid-template-columns: var(--cs-twoup-cols);
    gap: var(--cs-twoup-gap);
    align-items: var(--cs-twoup-align);
    margin: var(--s-8) auto;
    max-width: var(--content-narrow);
  }
  .cs-twoup--wide {
    max-width: var(--content-max);
    margin-left: max(var(--s-5), calc((100% - var(--content-narrow)) / 2));
    margin-right: max(var(--s-5), calc((100% - var(--content-max)) / 2));
  }
  .cs-twoup--centered {
    margin-left: auto;
    margin-right: auto;
  }

  .cs-twoup__left { display: grid; gap: var(--s-4); }

  /* Prose text in a TwoUp left column: match Section body sizing and
     strip browser-default <p> margins so grid gap alone controls spacing. */
  .cs-twoup__left :global(p) {
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-primary);
    margin: 0;
  }
  .cs-twoup__head { display: grid; gap: var(--s-2); }
  .cs-twoup__left p.cs-twoup__eyebrow {
    margin: 0;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    line-height: normal;
    letter-spacing: 0.18em;
  }
  .cs-twoup__title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(22px, 2.2vw, 28px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.014em;
    color: var(--text-primary);
    scroll-margin-top: var(--s-16);
  }

  @media (max-width: 720px) {
    .cs-twoup { grid-template-columns: 1fr; }
  }
</style>
