---
/**
 * Stats — grid container for a row of <Stat> tiles. 1/2/3 columns adaptive.
 */
interface Props {
  cols?: 2 | 3 | 4;
  wide?: boolean;
  bare?: boolean;
  class?: string;
}
const { cols = 3, wide = false, bare = false, class: className = "" } = Astro.props;
const cls = ["cs-stats", `cs-stats--${cols}`, wide ? "cs-stats--wide" : "", bare ? "cs-stats--bare" : "", className]
  .filter(Boolean)
  .join(" ");
---

<div class={cls}>
  <slot />
</div>

<style>
  .cs-stats {
    display: grid;
    gap: var(--s-4);
    margin: var(--s-8) auto;
    max-width: var(--content-narrow);
  }
  .cs-stats--wide { max-width: var(--content-narrow); }
  .cs-stats--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .cs-stats--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .cs-stats--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (max-width: 720px) {
    .cs-stats--3, .cs-stats--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 480px) {
    .cs-stats { grid-template-columns: 1fr; }
  }

  /* Bare variant: strip card chrome, match homepage metric style */
  .cs-stats--bare {
    --cs-stat-bg: transparent;
    --cs-stat-border-color: transparent;
    --cs-stat-padding: 0;
    --cs-stat-radius: 0;
    --cs-stat-value-size: clamp(28px, 3vw, 40px);
    --cs-stat-label-size: 13px;
    --cs-stat-label-color: var(--text-secondary);
    gap: var(--s-8);
  }
</style>
