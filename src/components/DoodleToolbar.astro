---
/**
 * Doodle easter egg. A tiny sticky pill at the bottom-left of every page
 * lets a visitor scribble anywhere on the site. The toolbar itself is
 * fixed, but the SVG canvas is absolute-positioned over the full document
 * so the strokes scroll with the page (a doodle drawn next to the hero
 * stays next to the hero when the visitor scrolls down). Doodles are
 * ephemeral and cleared on navigation.
 */
---

<div class="doodle" data-doodle>
  <svg class="doodle__canvas" data-doodle-canvas aria-hidden="true"></svg>

  <div class="doodle__bar" role="toolbar" aria-label="Doodle tools">
    <button
      type="button"
      class="doodle__btn"
      data-tool="draw"
      aria-label="Draw"
      aria-pressed="false"
    >
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L8 18l-4 1 1-4Z"/>
      </svg>
    </button>

    <span class="doodle__divider" aria-hidden="true"></span>

    <div class="doodle__color" data-doodle-color>
      <button
        type="button"
        class="doodle__color-trigger"
        data-color-trigger
        aria-label="Pick color"
        aria-haspopup="true"
        aria-expanded="false"
        style="--c:#A9C7DC"
      >
        <!-- The visible color disk lives inside the button so the entire
             button area (sized to match the other toolbar buttons) is the
             tap target, not just the small disk. -->
        <span class="doodle__color-dot" aria-hidden="true"></span>
      </button>
      <div
        class="doodle__palette"
        role="radiogroup"
        aria-label="Color"
        data-color-palette
        hidden
      >
        <button type="button" class="doodle__swatch" data-color="#A9C7DC" aria-label="Powder blue" aria-pressed="true" style="--c:#A9C7DC"></button>
        <button type="button" class="doodle__swatch" data-color="#DCD2E8" aria-label="Lavender" aria-pressed="false" style="--c:#DCD2E8"></button>
        <button type="button" class="doodle__swatch" data-color="#E9C2B0" aria-label="Peach" aria-pressed="false" style="--c:#E9C2B0"></button>
        <button type="button" class="doodle__swatch" data-color="#F2C94C" aria-label="Marigold" aria-pressed="false" style="--c:#F2C94C"></button>
        <button type="button" class="doodle__swatch doodle__swatch--ink" data-color="ink" aria-label="Ink" aria-pressed="false"></button>
      </div>
    </div>

    <span class="doodle__divider doodle__divider--clear" aria-hidden="true"></span>

    <button
      type="button"
      class="doodle__btn doodle__btn--clear"
      data-action="clear"
      aria-label="Clear all"
      title="Clear all"
    >
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 7h16"/>
        <path d="M9 7V5a1.5 1.5 0 0 1 1.5-1.5h3A1.5 1.5 0 0 1 15 5v2"/>
        <path d="M6 7v12a1.5 1.5 0 0 0 1.5 1.5h9A1.5 1.5 0 0 0 18 19V7"/>
      </svg>
    </button>
  </div>

  <!--
    Desktop-only hints that surface the keyboard shortcuts. Mobile users
    don't have Esc or D, so both are hidden under 720px and the bar's
    accompanying lift is suppressed there too. The two hints share styling
    and position; only one shows at a time (active beats prompted).
  -->
  <div class="doodle__hint doodle__hint--prompt" aria-hidden="true">
    Press <kbd>D</kbd> to doodle
  </div>
  <div class="doodle__hint doodle__hint--esc" aria-hidden="true">
    Press <kbd>Esc</kbd> to exit
  </div>
</div>

<style>
  .doodle {
    /* No positioning context; the bar is fixed and the canvas is
       absolute-positioned against <body> so it scrolls with the page. */
    pointer-events: none;
    position: static;
  }

  .doodle__canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    /* JS keeps height in sync with document.documentElement.scrollHeight
       so the drawable area covers everything you can scroll to. */
    height: var(--doodle-canvas-h, 100vh);
    pointer-events: none;
    overflow: visible;
    z-index: 199;
  }
  .doodle[data-active] .doodle__canvas {
    pointer-events: auto;
    /* Prevent touch from scrolling the page while drawing. Without this,
       drag-to-draw on mobile competes with vertical scroll and the stroke
       breaks every time the browser claims the gesture. */
    touch-action: none;
  }

  /* On mobile, lock the entire page scroll while draw mode is armed so
     the canvas owns every touch gesture. The canvas itself uses
     touch-action: none above, but on mobile the canvas's bounding box
     can be shorter than the viewport (or the user can land their finger
     just outside it), and any touch that escapes the canvas would
     otherwise scroll the page and yank the doodle surface out from
     under the gesture. Restricted to ≤720px because on desktop the
     drawer arms the cursor only over interactive regions and scrolling
     stays useful. */
  @media (max-width: 720px) {
    :global(html[data-doodle-active]),
    :global(html[data-doodle-active] body) {
      overflow: hidden;
      overscroll-behavior: none;
      touch-action: none;
    }
  }

  /* Trash + its leading divider stay hidden until the first stroke lands,
     then fade in. Avoids surfacing a clear-all affordance with nothing to
     clear. Selectors stack two classes (.doodle__btn.doodle__btn--clear)
     so they beat the bare .doodle__btn{display:inline-flex} that follows. */
  .doodle .doodle__btn--clear,
  .doodle .doodle__divider--clear {
    display: none;
  }
  .doodle[data-has-strokes] .doodle__btn--clear {
    display: inline-flex;
    animation: doodleFadeIn var(--dur-normal) var(--ease-out);
  }
  .doodle[data-has-strokes] .doodle__divider--clear {
    display: inline-block;
    animation: doodleFadeIn var(--dur-normal) var(--ease-out);
  }
  @keyframes doodleFadeIn {
    from { opacity: 0; transform: scale(0.8); }
    to   { opacity: 1; transform: scale(1); }
  }

  .doodle__bar {
    pointer-events: auto;
    /* Must sit ABOVE .doodle__canvas (z-index 199); otherwise the canvas
       — which captures pointer events while draw mode is on — swallows
       clicks meant for the swatches, eraser, or trash. */
    z-index: 201;
    position: fixed;
    /* Bottom-center on every breakpoint. JS sets --doodle-bottom on
       scroll so the bar lifts above the hero scroll chevron at the top
       of the page and above the footer at the bottom. --doodle-bar-lift
       is added on activation / prompted-from-AI-col so there's room for
       the keyboard hint below the bar (desktop only). --doodle-bar-scale
       drives the prompted-state grow-up effect. */
    left: 50%;
    transform: translateX(-50%)
      translate3d(var(--doodle-melt-x, 0px), var(--doodle-melt-y, 0px), 0)
      scale(
        calc(
          var(--doodle-bar-scale, 1) * (1 - 0.08 * var(--doodle-melt, 0))
        )
      );
    transform-origin: 50% 100%;
    bottom: calc(
      var(--doodle-bottom, max(env(safe-area-inset-bottom), 24px))
      + var(--doodle-bar-lift, 0px)
    );
    display: flex;
    align-items: center;
    gap: var(--s-1);
    padding: 6px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-full);
    box-shadow: var(--shadow-md);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition:
      bottom var(--dur-normal) var(--ease-out),
      box-shadow var(--dur-normal) var(--ease-out),
      border-color var(--dur-normal) var(--ease-out),
      opacity var(--dur-normal) var(--ease-out),
      backdrop-filter var(--dur-normal) var(--ease-out);
  }

  /* Footer melt: scroll pulls the bar into the footer row (transform only,
     no transition) so it tracks the finger; shadow and halo soften as it
     settles between the brand line and the contact block. */
  .doodle[data-melt] .doodle__bar {
    border-color: var(--border-subtle);
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .doodle[data-melt-full] .doodle__bar {
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .doodle[data-melt] .doodle__hint--esc,
  .doodle[data-melt] .doodle__hint--prompt {
    display: none !important;
    opacity: 0;
  }

  /* Armed (draw mode on) and prompted (AI col is being hovered) both
     ring the bar in the active brush color so the highlight matches the
     pen. Active uses --doodle-brush-color set by JS on every color pick;
     resting fallback is --brand-primary-2 so the halo still reads if the
     var hasn't been set yet. Both states also lift the bar on desktop
     to make room for the keyboard hint underneath (suppressed on mobile
     by a media query below). Prompted additionally scales the bar up. */
  .doodle[data-active] .doodle__bar,
  .doodle[data-prompted] .doodle__bar {
    border-color: var(--doodle-brush-color, var(--brand-primary-2));
    box-shadow:
      var(--shadow-md),
      0 0 0 4px color-mix(in srgb, var(--doodle-brush-color, var(--brand-primary-2)) 38%, transparent);
  }
  .doodle[data-active] .doodle__bar {
    --doodle-bar-lift: 36px;
  }
  .doodle[data-prompted] .doodle__bar {
    --doodle-bar-lift: 36px;
    --doodle-bar-scale: 1.06;
  }

  /* All bar buttons share a 40px hitbox so a tap anywhere inside a
     section lands the action — not just on the icon glyph. */
  .doodle__btn,
  .doodle__color-trigger {
    appearance: none;
    border: 0;
    background: transparent;
    width: 40px;
    height: 40px;
    border-radius: var(--r-full);
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .doodle__btn { color: var(--icon-secondary); }
  /* Icons scale up alongside the bigger 40px hitbox so a stroked pencil
     or trash glyph carries the same visual weight as the 22px color
     disk next to it. The SVGs still ship at width=16 in markup, but CSS
     wins on rendered size. */
  .doodle__btn svg {
    width: 22px;
    height: 22px;
  }
  .doodle__btn:hover,
  .doodle__color-trigger:hover { background: var(--bg-sunken); }
  .doodle__btn:hover { color: var(--icon-primary); }
  .doodle__btn.is-active {
    background: var(--brand-wash);
    color: var(--text-primary);
  }
  /* When the draw button is on, fill the pencil icon so the toolbar
     mirrors the cursor: same filled silhouette, same visual language. */
  .doodle__btn[data-tool="draw"].is-active svg {
    fill: currentColor;
    stroke: none;
  }
  .doodle__btn:focus-visible,
  .doodle__color-trigger:focus-visible {
    outline: 2px solid var(--brand-primary-2);
    outline-offset: 2px;
  }

  .doodle__divider {
    width: 1px;
    height: 22px;
    background: var(--border-subtle);
    margin: 0 2px;
  }

  /* Active-color trigger: the visitor taps anywhere in the section to
     reveal the full palette. The visible disk is an inner span so the
     entire 40x40 button is the tap target, matching the other sections. */
  .doodle__color {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .doodle__color-dot {
    display: block;
    width: 22px;
    height: 22px;
    border-radius: var(--r-full);
    background: var(--c, #A9C7DC);
    box-shadow:
      inset 0 0 0 1px rgba(20, 22, 28, 0.10),
      0 0 0 1.5px var(--bg-surface);
    transition:
      transform var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease);
    pointer-events: none;
  }
  .doodle__color-trigger:hover .doodle__color-dot {
    transform: scale(1.08);
  }
  .doodle__color-trigger[aria-expanded="true"] .doodle__color-dot {
    transform: scale(1.04);
    box-shadow:
      inset 0 0 0 1px rgba(20, 22, 28, 0.10),
      0 0 0 2px var(--text-primary);
  }

  /* Drop-up palette: vertical column of swatches that floats above the
     trigger when expanded. Centered on the trigger and pinned by the
     bar's bottom-of-viewport anchor. */
  .doodle__palette {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 6px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-full);
    box-shadow: var(--shadow-md);
    animation: doodlePopIn var(--dur-fast) var(--ease-out);
  }
  .doodle__palette[hidden] { display: none; }
  @keyframes doodlePopIn {
    from { opacity: 0; transform: translate(-50%, 6px) scale(0.94); }
    to   { opacity: 1; transform: translate(-50%, 0) scale(1); }
  }

  .doodle__swatch {
    appearance: none;
    border: 1.5px solid transparent;
    background: var(--c, var(--text-primary));
    width: 22px;
    height: 22px;
    border-radius: var(--r-full);
    padding: 0;
    cursor: pointer;
    box-shadow: inset 0 0 0 1px rgba(20, 22, 28, 0.08);
    transition: transform var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .doodle__swatch--ink { background: var(--text-primary); }
  .doodle__swatch:hover { transform: scale(1.12); }
  .doodle__swatch[aria-pressed="true"] {
    border-color: var(--text-primary);
    transform: scale(1.06);
  }
  .doodle__swatch:focus-visible {
    outline: 2px solid var(--brand-primary-2);
    outline-offset: 2px;
  }

  /* Keyboard hints fade in under the bar. Two variants share styling:
       --prompt: "Press D to doodle" — shown while the AI hero column
                 is being hovered, before the tool is armed.
       --esc:    "Press Esc to exit" — shown while draw mode is active.
     Anchored to the same --doodle-bottom as the bar so they follow the
     same hero/footer clearance, and the bar's --doodle-bar-lift creates
     a deterministic gap above. Hidden on mobile via a media query
     below. Active beats prompted: if the tool is on, the prompt hint
     is suppressed even if the AI column is also hovered. */
  .doodle__hint {
    position: fixed;
    z-index: 200;
    left: 50%;
    transform: translateX(-50%) translateY(4px)
      translate3d(var(--doodle-melt-x, 0px), var(--doodle-melt-y, 0px), 0);
    bottom: var(--doodle-bottom, max(env(safe-area-inset-bottom), 24px));
    pointer-events: none;
    display: none;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1;
    color: var(--text-secondary);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-full);
    box-shadow: var(--shadow-sm);
    white-space: nowrap;
    opacity: 0;
    transition:
      opacity var(--dur-normal) var(--ease-out),
      transform var(--dur-normal) var(--ease-out),
      bottom var(--dur-normal) var(--ease-out);
  }
  .doodle__hint kbd {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    padding: 2px 5px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-xs);
    background: var(--bg-sunken);
    color: var(--text-primary);
  }
  .doodle[data-active] .doodle__hint--esc,
  .doodle[data-prompted]:not([data-active]) .doodle__hint--prompt {
    display: inline-flex;
    opacity: 1;
    transform: translateX(-50%) translateY(0)
      translate3d(var(--doodle-melt-x, 0px), var(--doodle-melt-y, 0px), 0);
  }

  /* Mobile: no Esc / D keys, so neither hint nor the bar's lift should
     appear. The bar still gets its halo so the active state still reads.
     Prompted (tap on AI hero column) keeps the scale-up since on touch
     that pulse is the only feedback that the tap registered and is
     pointing at this toolbar. */
  @media (max-width: 720px) {
    .doodle[data-active] .doodle__bar,
    .doodle[data-prompted] .doodle__bar {
      --doodle-bar-lift: 0px;
    }
    .doodle[data-prompted] .doodle__bar {
      --doodle-bar-scale: 1.35;
      border-color: var(--doodle-brush-color, var(--brand-primary-2));
      box-shadow:
        var(--shadow-md),
        0 0 0 5px rgba(169, 199, 220, 0.45);
    }
    .doodle__hint--esc,
    .doodle__hint--prompt {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .doodle__btn,
    .doodle__color-trigger,
    .doodle__color-dot,
    .doodle__swatch { transition: none; }
    .doodle__hint { transition: opacity var(--dur-fast) linear; }
  }

  @media print {
    .doodle { display: none; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector("[data-doodle]");
    if (!root) return;
    var svg = root.querySelector("[data-doodle-canvas]");
    var bar = root.querySelector(".doodle__bar");
    var SVG_NS = "http://www.w3.org/2000/svg";

    function resolveColor(value) {
      // "ink" tracks the live theme: dark text in light mode, cream in dark.
      if (value === "ink") {
        return getComputedStyle(document.documentElement)
          .getPropertyValue("--text-primary").trim() || "#15171C";
      }
      return value;
    }

    var state = {
      tool: null,
      // Powder blue is the brand accent and reads well as a pencil tint
      // on both light and dark canvases.
      color: "#A9C7DC",
      drawing: false,
      currentPath: null,
      points: [],
    };

    var colorTrigger = bar.querySelector("[data-color-trigger]");
    var palette = bar.querySelector("[data-color-palette]");

    function broadcastCursor() {
      // Surface the active draw color + on/off flag on <html> so the
      // CustomCursor component can grow the dot and tint it to the brush
      // while doodle mode is on. Cleared when draw mode is off.
      var html = document.documentElement;
      if (state.tool === "draw") {
        html.setAttribute("data-doodle-active", "");
        html.style.setProperty("--doodle-cursor-color", resolveColor(state.color));
      } else {
        html.removeAttribute("data-doodle-active");
        html.style.removeProperty("--doodle-cursor-color");
      }
    }

    function broadcastBrushColor() {
      // Surface the active brush color regardless of tool state so the
      // toolbar halo, the hover highlight on the AI hero column, and any
      // other downstream styles can tint to match the pen even before
      // the user has armed draw mode.
      document.documentElement.style.setProperty(
        "--doodle-brush-color",
        resolveColor(state.color)
      );
    }
    broadcastBrushColor();

    function setTool(next) {
      state.tool = next;
      if (next) root.setAttribute("data-active", next);
      else root.removeAttribute("data-active");
      bar.querySelectorAll("[data-tool]").forEach(function (b) {
        var on = b.getAttribute("data-tool") === next;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-pressed", on ? "true" : "false");
      });
      broadcastCursor();
    }

    function setColor(hex) {
      state.color = hex;
      // Picking a color also flips into draw mode so it feels direct.
      if (state.tool !== "draw") setTool("draw");
      bar.querySelectorAll(".doodle__swatch").forEach(function (s) {
        var on = s.getAttribute("data-color") === hex;
        s.setAttribute("aria-pressed", on ? "true" : "false");
      });
      // Reflect the selection on the collapsed trigger so the bar shows
      // the active brush at rest.
      if (colorTrigger) {
        colorTrigger.style.setProperty("--c", resolveColor(hex));
      }
      broadcastBrushColor();
      broadcastCursor();
    }

    function setPaletteOpen(open) {
      if (!palette || !colorTrigger) return;
      palette.hidden = !open;
      colorTrigger.setAttribute("aria-expanded", open ? "true" : "false");
    }
    function togglePalette() {
      setPaletteOpen(palette && palette.hidden);
    }

    // Close the palette when clicking anywhere outside it (including the
    // SVG canvas while draw mode is on, which would otherwise leave it
    // dangling open behind a stroke).
    document.addEventListener(
      "pointerdown",
      function (e) {
        if (!palette || palette.hidden) return;
        if (e.target.closest && e.target.closest("[data-doodle-color]")) return;
        setPaletteOpen(false);
      },
      true
    );

    function isTypingTarget(t) {
      // Skip the shortcut when the user is in a text input / textarea /
      // contenteditable so typing the letter "d" inside copy fields
      // doesn't surprise-arm the brush.
      if (!t || !t.matches) return false;
      return t.matches(
        "input, textarea, select, [contenteditable], [contenteditable='true']"
      );
    }

    document.addEventListener("keydown", function (e) {
      // Escape disarms draw mode and closes the palette. Reliable way
      // out when the bottom-corner toolbar feels small to hit.
      if (e.key === "Escape") {
        var didSomething = false;
        if (palette && !palette.hidden) {
          setPaletteOpen(false);
          didSomething = true;
        }
        if (state.tool) {
          setTool(null);
          didSomething = true;
        }
        if (didSomething) e.preventDefault();
        return;
      }

      // D arms draw mode. Bail on modifier combos (Cmd-D bookmarks the
      // page, Ctrl-D in browsers, etc.) and on inputs / contenteditables.
      if ((e.key === "d" || e.key === "D") && !e.metaKey && !e.ctrlKey && !e.altKey) {
        if (isTypingTarget(e.target)) return;
        if (state.tool === "draw") return;
        setTool("draw");
        e.preventDefault();
      }
    });

    function syncStrokeFlag() {
      if (svg.firstChild) root.setAttribute("data-has-strokes", "");
      else root.removeAttribute("data-has-strokes");
    }

    bar.addEventListener("click", function (e) {
      var trigger = e.target.closest("[data-color-trigger]");
      if (trigger) {
        togglePalette();
        return;
      }
      var btn = e.target.closest("[data-tool], [data-action], [data-color]");
      if (!btn) return;
      if (btn.hasAttribute("data-tool")) {
        var t = btn.getAttribute("data-tool");
        setTool(state.tool === t ? null : t);
      } else if (btn.hasAttribute("data-color")) {
        setColor(btn.getAttribute("data-color"));
        setPaletteOpen(false);
      } else if (btn.getAttribute("data-action") === "clear") {
        while (svg.firstChild) svg.removeChild(svg.firstChild);
        syncStrokeFlag();
        // Tapping trash also exits the doodle tool entirely, so the visitor
        // gets a single clean reset instead of a wiped canvas still armed
        // for more strokes.
        setPaletteOpen(false);
        if (state.tool) setTool(null);
      }
    });

    function pt(e) {
      var r = svg.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    }

    function pathD(points) {
      if (!points.length) return "";
      var d = "M " + points[0].x.toFixed(1) + " " + points[0].y.toFixed(1);
      for (var i = 1; i < points.length; i++) {
        d += " L " + points[i].x.toFixed(1) + " " + points[i].y.toFixed(1);
      }
      return d;
    }

    function startDraw(e) {
      if (state.tool !== "draw") return;
      svg.setPointerCapture(e.pointerId);
      state.drawing = true;
      state.points = [pt(e)];
      var path = document.createElementNS(SVG_NS, "path");
      path.setAttribute("stroke", resolveColor(state.color));
      path.setAttribute("stroke-width", "3");
      path.setAttribute("stroke-linecap", "round");
      path.setAttribute("stroke-linejoin", "round");
      path.setAttribute("fill", "none");
      path.setAttribute("d", pathD(state.points));
      svg.appendChild(path);
      state.currentPath = path;
      syncStrokeFlag();
    }

    function moveDraw(e) {
      if (!state.drawing || !state.currentPath) return;
      state.points.push(pt(e));
      state.currentPath.setAttribute("d", pathD(state.points));
    }

    function endDraw() {
      state.drawing = false;
      state.currentPath = null;
      state.points = [];
    }

    // Keep the canvas as tall as the document so doodles drawn far down
    // the page have somewhere to live. Recomputes on resize and after
    // images / fade-ins shift the layout. ResizeObserver picks up the
    // long-tail layout shifts that scroll/resize don't fire for.
    //
    // Measure body.scrollHeight (and viewport) only. The canvas is
    // position: absolute with no positioned ancestor, so it anchors to
    // the initial containing block (html) and its bottom edge counts
    // toward documentElement.scrollHeight but NOT body.scrollHeight.
    // Including documentElement.scrollHeight here created a one-way
    // ratchet: the first time the canvas measured taller than the
    // body content (e.g. a transient layout shift during image / font
    // load), html.scrollHeight reflected the inflated canvas, the next
    // run read that value back, and the canvas locked at a height that
    // sat below the footer as visible empty space (~80px at the tablet
    // breakpoint where the bug surfaced).
    function syncCanvasHeight() {
      var h = Math.max(
        document.body ? document.body.scrollHeight : 0,
        window.innerHeight
      );
      root.style.setProperty("--doodle-canvas-h", h + "px");
    }
    syncCanvasHeight();
    window.addEventListener("resize", syncCanvasHeight);
    window.addEventListener("load", syncCanvasHeight);
    if (window.ResizeObserver) {
      var ro = new ResizeObserver(syncCanvasHeight);
      ro.observe(document.documentElement);
      if (document.body) ro.observe(document.body);
    }

    // Clearance + footer melt share one scroll pass. The hero chevron still
    // lifts the bar when it intrudes; the footer is handled by melting the
    // bar into the footer row instead of floating above it.
    var BASE_GAP = 24;
    var CLEARANCE_GAP = 16;
    var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function barLiftPx() {
      if (root.hasAttribute("data-active") || root.hasAttribute("data-prompted")) {
        if (window.matchMedia("(max-width: 720px)").matches) return 0;
        return 36;
      }
      return 0;
    }

    function stickyAnchorY() {
      var vh = window.innerHeight;
      var bottom = BASE_GAP;
      var custom = getComputedStyle(root).getPropertyValue("--doodle-bottom").trim();
      if (custom) bottom = parseFloat(custom) || bottom;
      return vh - bottom - barLiftPx() - bar.offsetHeight / 2;
    }

    function updateClearance() {
      var vh = window.innerHeight;
      var maxOverlap = 0;
      var scroll = document.querySelector(".v2-hero__scroll");
      if (scroll) {
        var rect = scroll.getBoundingClientRect();
        if (rect.bottom > 0 && rect.width > 0 && rect.height > 0) {
          var overlap = vh - rect.top;
          if (overlap > maxOverlap) maxOverlap = overlap;
        }
      }
      if (maxOverlap > BASE_GAP) {
        root.style.setProperty("--doodle-bottom", (maxOverlap + CLEARANCE_GAP) + "px");
      } else {
        root.style.removeProperty("--doodle-bottom");
      }
    }

    function updateFooterMelt() {
      var footer = document.querySelector(".site-footer");
      var inner = footer && footer.querySelector(".footer-inner");
      if (!footer || !inner) {
        root.style.setProperty("--doodle-melt", "0");
        root.style.setProperty("--doodle-melt-x", "0px");
        root.style.setProperty("--doodle-melt-y", "0px");
        root.removeAttribute("data-melt");
        root.removeAttribute("data-melt-full");
        return;
      }

      var vh = window.innerHeight;
      var vw = window.innerWidth;
      var fr = footer.getBoundingClientRect();
      var ir = inner.getBoundingClientRect();
      if (fr.width === 0 || fr.height === 0) return;

      var meltStart = vh * 0.9;
      var meltEnd = vh * 0.5;
      var t = 0;
      if (fr.top < meltStart) {
        t = (meltStart - fr.top) / (meltStart - meltEnd);
        if (t < 0) t = 0;
        if (t > 1) t = 1;
      }
      if (reduceMotion) t = t > 0.5 ? 1 : 0;

      root.style.setProperty("--doodle-melt", String(t));
      if (t > 0.02) root.setAttribute("data-melt", "");
      else root.removeAttribute("data-melt");
      if (t > 0.98) root.setAttribute("data-melt-full", "");
      else root.removeAttribute("data-melt-full");

      var targetX = ir.left + ir.width / 2;
      var targetY = ir.top + ir.height / 2;
      var anchorY = stickyAnchorY();
      var meltX = (targetX - vw / 2) * t;
      var meltY = (targetY - anchorY) * t;

      root.style.setProperty("--doodle-melt-x", meltX.toFixed(1) + "px");
      root.style.setProperty("--doodle-melt-y", meltY.toFixed(1) + "px");
    }

    function updateBarPosition() {
      updateClearance();
      updateFooterMelt();
    }
    updateBarPosition();
    window.addEventListener("scroll", updateBarPosition, { passive: true });
    window.addEventListener("resize", updateBarPosition);
    if (window.MutationObserver) {
      var meltObs = new MutationObserver(updateBarPosition);
      meltObs.observe(root, {
        attributes: true,
        attributeFilter: ["data-active", "data-prompted"],
      });
    }

    svg.addEventListener("pointerdown", function (e) {
      if (state.tool === "draw") startDraw(e);
    });
    svg.addEventListener("pointermove", function (e) {
      if (state.drawing && state.tool === "draw") moveDraw(e);
    });
    svg.addEventListener("pointerup", endDraw);
    svg.addEventListener("pointercancel", endDraw);
    svg.addEventListener("pointerleave", endDraw);
  })();
</script>
