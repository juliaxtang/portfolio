---
interface Props {
  wide?: boolean;
  gap?: "xs" | "sm" | "md" | "lg";
  centered?: boolean;
  steps?: boolean;
  align?: "start" | "center" | "end";
}

const { wide = false, gap = "md", centered = false, steps = false, align = "start" } = Astro.props;

const gapMap: Record<string, string> = {
  xs: "var(--s-2)",
  sm: "var(--s-4)",
  md: "var(--s-6)",
  lg: "var(--s-10)",
};

const cls = [
  "cs-threeup",
  wide ? "cs-threeup--wide" : "",
  centered ? "cs-threeup--centered" : "",
  steps ? "cs-threeup--steps" : "",
].filter(Boolean).join(" ");
const styleVars = `--cs-threeup-gap:${gapMap[gap]};--cs-threeup-align:${align};`;
---

<div class={cls} style={styleVars}>
  <slot />
</div>

<style>
  .cs-threeup {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--cs-threeup-gap);
    align-items: var(--cs-threeup-align, start);
    margin: var(--s-8) auto;
    max-width: var(--content-narrow);
  }
  .cs-threeup--wide {
    max-width: var(--content-max);
    margin-left: max(var(--s-5), calc((100% - var(--content-narrow)) / 2));
    margin-right: max(var(--s-5), calc((100% - var(--content-max)) / 2));
  }
  /* Centered wide ThreeUp: same max-width as wide, auto-centered on page
     instead of left-aligning with the narrow prose column. Use for rows of
     media that aren't paired with adjacent prose. */
  .cs-threeup--centered.cs-threeup--wide,
  .cs-threeup--centered {
    margin-left: auto;
    margin-right: auto;
  }

  /* Scale up more than Figure's default 1.015 so details are readable at
     small widths. z-index lifts the hovered item above its neighbors. */
  .cs-threeup :global(.cs-figure) {
    margin: 0;
    position: relative;
    z-index: 0;
    transition: transform 0.25s var(--ease-out, cubic-bezier(0.2, 0, 0, 1));
    will-change: transform;
  }
  .cs-threeup :global(.cs-figure:hover) {
    transform: scale(1.02);
    z-index: 1;
  }

  /* Steps mode: number each tile and connect them with arrows so the row
     reads as a sequential flow instead of three parallel exhibits. */
  .cs-threeup--steps { counter-reset: cs-step; }
  .cs-threeup--steps :global(.cs-figure) { counter-increment: cs-step; }
  .cs-threeup--steps :global(.cs-figure)::before {
    content: "Step 0" counter(cs-step);
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    text-align: center;
    margin-bottom: var(--s-3);
  }
  .cs-threeup--steps :global(.cs-figure):not(:first-child)::after {
    content: "→";
    position: absolute;
    left: calc(var(--cs-threeup-gap) / -2);
    top: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-mono);
    font-size: 22px;
    color: var(--text-tertiary);
    pointer-events: none;
  }

  @media (max-width: 720px) {
    .cs-threeup { grid-template-columns: 1fr; }
    .cs-threeup--steps :global(.cs-figure):not(:first-child)::after {
      content: "↓";
      left: 50%;
      top: calc(var(--cs-threeup-gap) / -2);
      transform: translate(-50%, -50%);
    }
  }
</style>
