---
/**
 * CaseStudyLayout — wraps a case-study .mdx body.
 *
 * Layout columns (desktop):
 *   ┌──────────┬──────────────────────┐
 *   │ section  │  body (slot)         │
 *   │ nav      │                      │
 *   └──────────┴──────────────────────┘
 *
 * The hero is full-bleed above; "more work" sits below. Below 1100px the
 * section nav collapses into a sticky horizontal pill bar at the top.
 */
import BaseLayout from "./BaseLayout.astro";
import Hero from "../components/case-study/Hero.astro";
import MoreWork from "../components/case-study/MoreWork.astro";
import SectionNav from "../components/case-study/SectionNav.astro";
import FadeIn from "../components/FadeIn.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"projects">;
  slug: string;
}
const { entry, slug } = Astro.props;
const { data } = entry;

const ogImage = data.hero?.src ?? data.cover;
---

<BaseLayout title={data.title} description={data.summary} ogImage={ogImage}>
  <article class="cs">
    <FadeIn>
      <Hero
        title={data.title}
        summary={data.summary}
        company={data.company}
        year={data.year}
        role={data.role}
        tags={data.tags}
        hero={data.hero}
        accent={data.accent}
      />
    </FadeIn>

    <div class="cs__shell">
      <SectionNav />
      <div class="cs__body">
        <slot />
      </div>
    </div>
  </article>

  <MoreWork currentSlug={slug} />
</BaseLayout>

<style>
  .cs { display: block; }

  .cs__shell {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--s-8);
    padding-bottom: var(--s-16);
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--s-6);
  }
  @media (max-width: 1100px) {
    .cs__shell {
      grid-template-columns: 1fr;
      padding: 0;
      gap: 0;
    }
  }
  @media (max-width: 720px) {
    .cs__shell { padding: 0; }
  }

  .cs__body { min-width: 0; }

  /* Restore narrow-section centering inside the body column on desktop —
     the nav rail takes the left margin, so we re-center within the body. */
  @media (min-width: 1101px) {
    .cs__body :global(.cs-section--narrow),
    .cs__body :global(.cs-figure--narrow),
    .cs__body :global(.cs-twoup),
    .cs__body :global(.cs-stats),
    .cs__body :global(.cs-quote),
    .cs__body :global(.cs-video) {
      margin-left: auto;
      margin-right: auto;
    }
  }

  /* Below the nav-collapse breakpoint, restore standard inner padding so
     content doesn't hit the viewport edges. */
  @media (max-width: 1100px) {
    .cs__body { padding: 0 var(--s-8); }
  }
  @media (max-width: 720px) {
    .cs__body { padding: 0 var(--s-5); }
  }
</style>
