---
/**
 * PasswordGate — soft client-side gate for a case study.
 *
 * The page HTML still contains the protected content (this is a static
 * Astro site), so this is "share via password" UX, not real access control.
 * The expected password is embedded in the page; matching is done in JS,
 * and a sessionStorage flag remembers unlock state across navigations.
 */
interface Props {
  password: string;
  slug: string;
  title: string;
}
const { password, slug, title } = Astro.props;
---

<div class="gate" data-password={password} data-slug={slug}>
  <div class="gate__card">
    <div class="gate__eyebrow">Protected case study</div>
    <h1 class="gate__title">{title}</h1>
    <p class="gate__body">
      This case study is password protected. Enter the password to view it,
      or reach out if you don't have one.
    </p>
    <form class="gate__form" novalidate>
      <input
        class="gate__input"
        type="password"
        name="password"
        placeholder="Password"
        autocomplete="off"
        aria-label="Password"
        required
      />
      <button class="gate__submit" type="submit">Unlock</button>
    </form>
    <p class="gate__error" hidden>Incorrect password. Try again.</p>
  </div>
</div>

<style>
  .gate {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-6);
    background: var(--brand-aurora);
  }
  .gate__card {
    max-width: 30rem;
    width: 100%;
    text-align: center;
    padding: var(--s-10) var(--s-8);
    border-radius: var(--r-lg);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-lg);
  }
  .gate__eyebrow {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin-bottom: var(--s-3);
  }
  .gate__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.1;
    color: var(--text-primary);
    margin: 0 0 var(--s-4);
  }
  .gate__body {
    color: var(--text-secondary);
    margin: 0 0 var(--s-6);
  }
  .gate__form {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  @media (min-width: 480px) {
    .gate__form { flex-direction: row; }
  }
  .gate__input {
    flex: 1;
    padding: var(--s-3) var(--s-5);
    border: 1px solid var(--border-default);
    border-radius: var(--r-full);
    font: inherit;
    font-size: 14px;
    background: var(--bg-surface);
    color: var(--text-primary);
  }
  .gate__input:focus {
    outline: 2px solid var(--brand-primary);
    outline-offset: 3px;
    border-color: var(--brand-primary);
  }
  .gate__submit {
    appearance: none;
    cursor: pointer;
    padding: var(--s-3) var(--s-6);
    border: 1px solid var(--text-primary);
    border-radius: var(--r-full);
    background: var(--text-primary);
    color: var(--text-inverse);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.005em;
    transition:
      transform .15s var(--ease),
      background .25s var(--ease),
      color .25s var(--ease),
      border-color .25s var(--ease),
      box-shadow .25s var(--ease);
  }
  .gate__submit:hover {
    background: var(--brand-primary);
    color: var(--text-primary);
    border-color: var(--brand-primary);
    transform: translateY(-2px);
    box-shadow:
      0 0 0 4px var(--brand-wash-soft),
      0 16px 36px var(--brand-wash);
  }
  .gate__submit:active {
    transform: translateY(0);
    box-shadow: 0 0 0 3px var(--brand-wash-soft);
  }
  .gate__error {
    margin: var(--s-4) 0 0;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }
</style>

<script>
  function initGate() {
    const gate = document.querySelector<HTMLElement>(".gate");
    if (!gate) return;
    const slug = gate.dataset.slug || "";
    const expected = gate.dataset.password || "";
    const key = `cs-unlocked:${slug}`;

    if (sessionStorage.getItem(key) === "1") {
      gate.remove();
      document.documentElement.style.overflow = "";
      return;
    }

    document.documentElement.style.overflow = "hidden";

    const form = gate.querySelector<HTMLFormElement>(".gate__form");
    const input = gate.querySelector<HTMLInputElement>(".gate__input");
    const error = gate.querySelector<HTMLElement>(".gate__error");
    input?.focus();

    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      if ((input?.value || "") === expected) {
        sessionStorage.setItem(key, "1");
        gate.remove();
        document.documentElement.style.overflow = "";
      } else if (error) {
        error.hidden = false;
        input?.select();
      }
    });
  }
  initGate();
  document.addEventListener("astro:page-load", initGate);
</script>
