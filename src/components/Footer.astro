---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="page footer-inner">
    <p class="footer-brand__name">Julia Tang</p>
    <nav class="footer-nav-pages" aria-label="Pages">
      <a href={`${base}/`}>Work</a>
      <a href={`${base}/resume.pdf`} target="_blank" rel="noopener">Resume</a>
    </nav>
    <div class="footer-right">
      <nav class="footer-nav-contact" aria-label="Contact">
        <a href="mailto:hello@juliatang.design">Email</a>
        <a href="https://www.linkedin.com/in/juliaxtang/" target="_blank" rel="noopener">LinkedIn</a>
      </nav>
      <p class="t-caption footer-copy">© {year}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--s-2) 0;
    border-top: 1px solid var(--border-default);
    background: var(--bg-canvas);
  }
  .footer-inner {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: nowrap;
    position: relative;
    line-height: 1;
    padding-top: var(--s-6);
    padding-bottom: var(--s-12);
  }
  .footer-brand__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 18px;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .footer-nav-pages {
    display: flex;
    flex-direction: row;
    gap: var(--s-4);
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
  .footer-right {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--s-4);
    margin-left: auto;
  }
  .footer-nav-contact {
    display: flex;
    flex-direction: row;
    gap: var(--s-4);
  }
  .footer-nav-pages a,
  .footer-nav-contact a {
    color: var(--text-secondary);
    font-size: 14px;
    transition: color var(--dur-fast) var(--ease);
    white-space: nowrap;
  }
  .footer-nav-pages a:hover,
  .footer-nav-contact a:hover { color: var(--text-primary); }
  .footer-copy {
    margin: 0;
    white-space: nowrap;
    color: var(--text-tertiary);
  }

  @media (max-width: 600px) {
    .footer-inner { flex-wrap: wrap; gap: var(--s-3); }
    .footer-nav-pages { flex: none; justify-content: flex-start; }
    .footer-right { flex-wrap: wrap; }
  }
</style>
