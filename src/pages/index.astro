---
/**
 * Homepage — one-pager.
 *
 * Each case study is inlined as a `<Showcase>` block (Rina Kang /
 * Aaron James-style mini case studies) instead of linking out to a deep
 * case-study page from a tile grid. Each block has an interactive hero
 * (auto-cycling phone stack or looping GIF) and a CTA to the full case
 * study for anyone who wants the long version.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import FadeIn from "../components/FadeIn.astro";
import HeroGrid from "../components/HeroGrid.astro";
import Showcase from "../components/showcase/Showcase.astro";
import PhoneVideoParallax from "../components/showcase/PhoneVideoParallax.astro";
import VideoStack from "../components/showcase/VideoStack.astro";
import { snapchatGamesStackItems, snapchatGamesStackProps } from "../components/showcase/projects/snapchatGamesStack";
import MediaParallax from "../components/showcase/MediaParallax.astro";
import TappyCloudShowcase from "../components/showcase/projects/TappyCloudShowcase.astro";
import FestivalModeShowcase from "../components/showcase/projects/FestivalModeShowcase.astro";
import { showcaseContent } from "../data/showcases";

const snapchatGames = showcaseContent["snapchat-games"];
const topicChats = showcaseContent["topic-chats"];

const heroStatements = [
  "I design the moments where people connect.",
  "I build products used by millions daily.",
  "I transform ambiguous problem spaces into fully scaled products.",
];

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="Julia Tang | Product Designer">
  <section class="v2-hero" data-home-hero>
    <HeroGrid />
    <div class="v2-hero__grid">
      <div class="v2-hero__text">
        <FadeIn>
          <p class="v2-hero__eyebrow"><span class="v2-hero__wave" aria-hidden="true"><svg
              class="v2-hero__wave-hand"
              viewBox="0 0 32 32"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            ><path d="M9 11 V 7 a 2 2 0 0 1 4 0 v 9"/><path d="M13 7 V 5 a 2 2 0 0 1 4 0 v 11"/><path d="M17 7 V 6 a 2 2 0 0 1 4 0 v 11"/><path d="M21 9 V 8 a 2 2 0 0 1 4 0 v 9 c 0 6.5 -5 10 -10 10 -5.5 0 -10 -3.5 -10 -9 a 2 2 0 0 1 3.4 -1.4 l 1.6 1.4"/></svg></span><span class="v2-hero__hint">Hi, I'm <span class="v2-hero__name">Julia<svg
              class="v2-hero__squiggle"
              viewBox="0 0 120 12"
              preserveAspectRatio="none"
              aria-hidden="true"
              focusable="false"
            ><path d="M2 7 C 14 1, 26 11, 38 6 S 62 1, 74 7 S 98 11, 118 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></span>.</span></p>
        </FadeIn>

        <FadeIn delay={120}>
          <h1 class="v2-hero__headline" aria-label={heroStatements.join(" / ")}>
            {heroStatements.map((statement, i) => {
              const words = statement.split(" ");
              return (
                <span
                  class:list={["v2-hero__rot", { "is-active": i === 0 }]}
                  data-rot-index={i}
                  aria-hidden={i === 0 ? undefined : "true"}
                >
                  {words.flatMap((word, j) => {
                    const span = (
                      <span class="v2-hero__word" style={`--j:${j}`}>{word}</span>
                    );
                    return j === 0 ? [span] : [" ", span];
                  })}
                </span>
              );
            })}
          </h1>
        </FadeIn>

        <FadeIn delay={220}>
          <div class="v2-hero__meta">
            <p>
              Currently building social experiences at <a class="hero-co hero-co--snap" href="#snapchat-games"><img src={`${base}/logos/snapchat.png`} alt="" aria-hidden="true" />Snapchat</a> with Cursor and Claude.
            </p>
            <p>
              Previously led the swipe stack and introduced dynamic profiles at <a class="hero-co hero-co--tinder" href="#tappy-cloud"><img src={`${base}/logos/tinder.png`} alt="" aria-hidden="true" />Tinder</a>.
            </p>
            <p>
              Tinkering with AI on the side. <span class="v2-hero__meta-secondary">(AI projects coming soon!)</span>
            </p>
          </div>
        </FadeIn>
      </div>
    </div>
  </section>

  <script is:inline>
    // Rotate the hero headline through the prepared statements.
    // Statements are positioned in the same cell; we measure each one's
    // height and animate the container so the meta line below moves up
    // for shorter statements (no awkward gap).
    (() => {
      const headline = document.querySelector(".v2-hero__headline");
      const slots = document.querySelectorAll(".v2-hero__rot");
      if (!headline || slots.length < 1) return;

      // Switch layout to absolute-stacking so each statement's measured
      // height is its OWN rendered height (not the grid cell's max).
      headline.classList.add("is-measured");

      // Measure each statement's natural height by promoting it to a
      // normal-flow box one at a time. Pre-measuring while every slot is
      // absolutely positioned at the same coords yields a per-statement
      // height of zero (or the first slot's height) on some browsers, so
      // the longest statement gets clipped. Promoting + restoring is a
      // single layout pass per slot and runs once on load.
      function measure() {
        const out = [];
        for (const s of slots) {
          const prevPos = s.style.position;
          const prevVis = s.style.visibility;
          s.style.position = "static";
          s.style.visibility = "hidden";
          out.push(s.offsetHeight);
          s.style.position = prevPos;
          s.style.visibility = prevVis;
        }
        return out;
      }

      let heights = measure();
      let i = 0;
      headline.style.height = heights[i] + "px";

      // Web fonts (Geist) can land after this script runs; metrics shift
      // enough on the longest statement to clip a line. Remeasure once
      // fonts settle so the headline reserves the right height.
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(() => {
          heights = measure();
          headline.style.height = heights[i] + "px";
        });
      }

      let resizeT;
      window.addEventListener("resize", () => {
        clearTimeout(resizeT);
        resizeT = setTimeout(() => {
          heights = measure();
          headline.style.height = heights[i] + "px";
        }, 120);
      });

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce || slots.length < 2) return;
      setInterval(() => {
        slots[i].classList.remove("is-active");
        slots[i].setAttribute("aria-hidden", "true");
        i = (i + 1) % slots.length;
        slots[i].classList.add("is-active");
        slots[i].removeAttribute("aria-hidden");
        headline.style.height = heights[i] + "px";
      }, 4600);
    })();

    // Replay the greeting flourish on eyebrow hover:
    //   enter → re-run a short wave pendulum + draw squiggle L-to-R
    //   leave → erase squiggle L-to-R (wave pendulum self-resolves to 0°)
    // The first hover takes over from the on-load intro animation by
    // clearing inline `animation` and using transitions for the squiggle.
    (() => {
      const eyebrow = document.querySelector(".v2-hero__eyebrow");
      const path = document.querySelector(".v2-hero__squiggle path");
      const hand = document.querySelector(".v2-hero__wave-hand");
      if (!eyebrow || !path || !hand) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      const DRAW_EASE = "cubic-bezier(0.22, 1, 0.36, 1)";
      const ERASE_EASE = "cubic-bezier(0.4, 0, 0.6, 1)";
      const DRAW_MS = 700;
      const ERASE_MS = 700;

      function drawIn() {
        // Reset to invisible-before-draw, then transition to drawn.
        path.style.animation = "none";
        path.style.transition = "none";
        path.style.strokeDashoffset = "120";
        // Force reflow so the next transition picks up the reset.
        void path.getBoundingClientRect();
        path.style.transition = "stroke-dashoffset " + DRAW_MS + "ms " + DRAW_EASE;
        path.style.strokeDashoffset = "0";
      }

      function eraseOut() {
        path.style.animation = "none";
        path.style.transition = "stroke-dashoffset " + ERASE_MS + "ms " + ERASE_EASE;
        path.style.strokeDashoffset = "-120";
      }

      function replayWave() {
        hand.style.animation = "none";
        void hand.getBoundingClientRect();
        hand.style.animation =
          "hero-wave-pendulum-hover 1800ms cubic-bezier(0.36, 0, 0.64, 1) 1 both";
      }

      eyebrow.addEventListener("mouseenter", () => {
        drawIn();
        replayWave();
      });
      eyebrow.addEventListener("mouseleave", () => {
        eraseOut();
      });
    })();
  </script>

  <span id="work" aria-hidden="true"></span>
  <FadeIn>
    <Showcase
      companyLogo={snapchatGames.companyLogo}
      companyName={snapchatGames.companyName}
      role={snapchatGames.role}
      title={snapchatGames.title}
      tagline={snapchatGames.tagline}
      stats={snapchatGames.stats}
      statsGap="var(--s-3)"
      statsMaxWidth="36ch"
      ctaHref="/product-design/snapchat-games"
      ctaLabel="See how it scaled"
      accent={snapchatGames.accent}
      reverse
      id="snapchat-games"
    >
      <div data-cursor-bg="light">
        <VideoStack
          items={[...snapchatGamesStackItems]}
          {...snapchatGamesStackProps}
        />
      </div>
    </Showcase>
  </FadeIn>

  <FadeIn>
    <Showcase
      companyLogo={topicChats.companyLogo}
      companyName={topicChats.companyName}
      role={topicChats.role}
      title={topicChats.title}
      tagline={topicChats.tagline}
      stats={topicChats.stats}
      ctaHref="/product-design/topic-chats"
      ctaLabel="Read the case study"
      press={topicChats.press}
      accent={topicChats.accent}
      id="topic-chats"
    >
      <div data-cursor-bg="dark">
        <MediaParallax
          src="/projects/topic-chats/topic-chat-sizzle.mp4"
          aspect="9 / 16"
          maxWidth="324px"
          label="Topic Chats feature sizzle reel"
        />
      </div>
    </Showcase>
  </FadeIn>

  <div id="tappy-cloud" data-cursor-bg="dark">
    <FadeIn>
      <TappyCloudShowcase reverse />
    </FadeIn>
  </div>

  <FadeIn>
    <Showcase
      companyLogo="/logos/tinder.png"
      companyName="Tinder"
      role="Senior Product Designer"
      title="App Redesign"
      tagline={[
        "Tinder's profile had been a single photo and bio for over a decade.",
        "I designed Sparks, the new profile system of Prompts, Quizzes, and refreshed match interactions that gave people more to talk about. It started as a 2022 Hackathon win, then shipped globally in 2023.",
      ]}
      stats={[
        { value: "↑ 0.8%", label: "Subscription Cash" },
        { value: "↑ 0.3%", label: "Days Active" },
        { value: "↑ 0.9%", label: "Likes Sent" },
      ]}
      statsGap="var(--s-3)"
      statsMaxWidth="36ch"
      ctaHref="https://techcrunch.com/2023/11/20/tinder-redesigns-profile-pages-with-prompts-info-tags-and-quiz/"
      ctaLabel="See press coverage"
      press={[
        {
          src: "/projects/festival-mode/techcrunch-dark-logo.png",
          alt: "TechCrunch",
          height: 15,
          href: "https://techcrunch.com/2023/11/20/tinder-redesigns-profile-pages-with-prompts-info-tags-and-quiz/",
        },
      ]}
      accent="#FD297C"
      id="app-redesign"
    >
      <PhoneVideoParallax
        videoSrc="/projects/tinder-app-redesign/sparks-recording.mp4"
        frameSrc="/projects/tinder-app-redesign/phone-frame.png"
        badgeSrc="/projects/tinder-app-redesign/Hackathon_winner_badge.png"
        videoLabel="Tinder Sparks profile redesign in motion"
        badgeAlt="2022 Tinder Hackathon Winner badge"
      />
    </Showcase>
  </FadeIn>

  <FadeIn>
    <div data-cursor-bg="dark">
      <FestivalModeShowcase reverse />
    </div>
  </FadeIn>

  <div class="home-footer-spacer" aria-hidden="true"></div>

</BaseLayout>

<style>
  .home-footer-spacer {
    height: var(--s-16);
  }
  @media (max-width: 720px) {
    .home-footer-spacer { height: var(--s-10); }
  }

  .v2-hero {
    position: relative;
    overflow: visible;
    padding-top: 0;
    padding-bottom: var(--s-16);
    /* Locked so the dot background never reflows when the rotating headline
       changes line count. Sized so the right text block sits visually centered
       with the left rail's nav and the rotating 100px display headline has
       room to land 2 or 3 lines without clipping. */
    min-height: 820px;
  }
  @media (max-width: 1023px) {
    .v2-hero { min-height: 640px; padding-top: var(--s-12); }
  }
  @media (max-width: 720px) {
    .v2-hero { min-height: 560px; padding-top: var(--s-8); }
  }
  @media (max-width: 420px) {
    .v2-hero { min-height: 460px; padding-top: var(--s-6); padding-bottom: var(--s-6); }
  }

  /* The global SideRail handles wordmark + nav on desktop; on smaller
     widths the rail collapses and the sticky Header takes over (rule
     lives in global.css so it applies to every page, not just home). */

  /* Anchor scroll targets sit below the (restored on scroll) sticky header. */
  :global(#snapchat-games),
  :global(#topic-chats),
  :global(#tappy-cloud),
  :global(#app-redesign) {
    scroll-margin-top: 80px;
  }

  /* 12-col grid container — desktop.
     Row 1 (auto): wordmark pinned at the top-left, no other content
     Row 2 (1fr):  nav + text block vertically centered within remaining space
     Drops to a single column under 1024 so the right-side text fills the
     width and the left rail dissolves into the (restored) sticky header. */
  .v2-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto 1fr;
    column-gap: var(--s-6);
    /* Wider than the standard .page container so the wordmark sits close
       to the viewport edge per the Figma; padding stays a touch generous on
       very-wide displays via clamp. */
    max-width: 1640px;
    margin: 0 auto;
    padding: var(--s-10) clamp(var(--s-6), 3vw, var(--s-12)) 0;
    min-height: 820px;
  }
  @media (max-width: 1023px) {
    .v2-hero__grid {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      grid-template-rows: auto;
      padding: 0 var(--s-6);
      min-height: 0;
    }
  }
  @media (max-width: 720px) {
    .v2-hero__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding: 0 var(--s-5);
    }
  }

  /* Wordmark + nav live in the global <SideRail> now; the hero just
     reserves cols 1-3 visually so the right text block aligns to col 5
     under the same 12-col rhythm. */
  /* Right text block: eyebrow → headline → 2-col meta.
     Vertically centered in row 2 so it visually balances the left-rail nav. */
  .v2-hero__text {
    grid-column: 3 / span 8;
    grid-row: 2;
    align-self: center;
    display: grid;
    row-gap: var(--s-5);
  }
  .v2-hero__text > :nth-child(2) {
    /* breathy gap below the headline before the meta cols */
    margin-bottom: var(--s-6);
  }
  @media (max-width: 1023px) {
    .v2-hero__text {
      grid-column: 1 / -1;
      grid-row: auto;
      align-self: auto;
      padding-top: var(--s-6);
    }
  }

  .v2-hero__eyebrow {
    font-family: var(--font-mono);
    font-size: clamp(15px, 1.4vw, 20px);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0;
    display: inline-flex;
    align-items: center;
  }
  .v2-hero__wave-hand {
    width: 1.4em;
    height: 1.4em;
    color: currentColor;
    overflow: visible;
    transform-origin: 70% 80%;
  }

  /* One-shot greeting flourish on page load. Wave + squiggle finish at
     the same absolute time (both end at 5400ms after page load).
     Squiggle exits left-to-right so it reads as the line continuing on.

     Wave uses two stacked animations on nested spans so the pendulum
     rotation runs the FULL duration (starts immediately during slide-in)
     while the slide-in/out is symmetric (same easing, same 600ms each). */
  .v2-hero__hint { display: inline-block; }
  .v2-hero__wave {
    display: inline-block;
    width: 0;
    margin-right: 0;
    opacity: 0;
    /* outer: slides in once and stays — wave is a permanent fixture. */
    animation: hero-wave-slide 600ms cubic-bezier(0.22, 1, 0.36, 1) 600ms 1 both;
    will-change: transform, opacity, width;
  }
  .v2-hero__wave-hand {
    transform-origin: 70% 80%;
    /* inner: pendulum runs through the slide-in and the next few
       seconds, then settles to rest at 0°. */
    animation: hero-wave-pendulum 4200ms cubic-bezier(0.36, 0, 0.64, 1) 600ms 1 both;
  }
  .v2-hero__name {
    position: relative;
    display: inline-block;
    color: inherit;
  }
  .v2-hero__squiggle {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.22em;
    width: 100%;
    height: 0.4em;
    color: var(--brand-primary, currentColor);
    pointer-events: none;
    overflow: visible;
  }
  .v2-hero__squiggle path {
    stroke-dasharray: 120;
    stroke-dashoffset: 120;
    /* Delay 900ms → draw in 900ms → hold → erase L-to-R, ends at 4500ms total. */
    animation: hero-squiggle-intro 3600ms linear 900ms 1 both;
  }

  /* Slide in once on load and stay — no exit. */
  @keyframes hero-wave-slide {
    0%   { width: 0;      margin-right: 0;     opacity: 0; transform: translateX(-6px) scale(0.85); }
    100% { width: 1.25em; margin-right: 1em;   opacity: 1; transform: translateX(0) scale(1); }
  }

  /* Shorter pendulum used on hover replay — fits in ~1.8s and settles at 0°.
     scaleX(-1) on every frame so the hand stays mirrored throughout the swing. */
  @keyframes hero-wave-pendulum-hover {
    0%   { transform: scaleX(-1) rotate(0deg); }
    10%  { transform: scaleX(-1) rotate(22deg); }
    20%  { transform: scaleX(-1) rotate(-16deg); }
    30%  { transform: scaleX(-1) rotate(18deg); }
    40%  { transform: scaleX(-1) rotate(-12deg); }
    50%  { transform: scaleX(-1) rotate(14deg); }
    60%  { transform: scaleX(-1) rotate(-8deg); }
    72%  { transform: scaleX(-1) rotate(8deg); }
    84%  { transform: scaleX(-1) rotate(-3deg); }
    100% { transform: scaleX(-1) rotate(0deg); }
  }

  /* Pendulum: starts swinging at 0% so the wave is already mid-wave as
     it slides in. Five decaying swings, then settles at 0° before exit.
     scaleX(-1) on every frame so the hand stays mirrored throughout the swing. */
  @keyframes hero-wave-pendulum {
    0%    { transform: scaleX(-1) rotate(0deg); }
    6.25% { transform: scaleX(-1) rotate(22deg); }
    12.5% { transform: scaleX(-1) rotate(-16deg); }
    20%   { transform: scaleX(-1) rotate(18deg); }
    27.5% { transform: scaleX(-1) rotate(-12deg); }
    35%   { transform: scaleX(-1) rotate(14deg); }
    42.5% { transform: scaleX(-1) rotate(-8deg); }
    50%   { transform: scaleX(-1) rotate(10deg); }
    57.5% { transform: scaleX(-1) rotate(-4deg); }
    65%   { transform: scaleX(-1) rotate(6deg); }
    72.5% { transform: scaleX(-1) rotate(-2deg); }
    80%   { transform: scaleX(-1) rotate(0deg); }
    100%  { transform: scaleX(-1) rotate(0deg); }
  }

  /* Squiggle: draws in L-to-R (0→25%), holds (25→75%), then erases
     L-to-R (75→100%) so the line reads as continuing on rather than
     rewinding. Total active duration = 3600ms; with the 900ms delay
     the whole sequence ends at 4500ms. */
  @keyframes hero-squiggle-intro {
    0%   { stroke-dashoffset: 120;  animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1); }
    25%  { stroke-dashoffset: 0;    animation-timing-function: linear; }
    75%  { stroke-dashoffset: 0;    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); }
    100% { stroke-dashoffset: -120; }
  }

  @media (prefers-reduced-motion: reduce) {
    .v2-hero__wave,
    .v2-hero__wave-hand,
    .v2-hero__squiggle path {
      animation: none;
    }
  }

  /* Rotating headline. Statements are stacked in the same grid cell so the
     tallest one reserves the height and the layout never jumps. */
  .v2-hero__headline {
    margin: 0;
    /* Display serif (Instrument Serif, not italic) for editorial weight
       on the rotating hero statements; sans elsewhere keeps the rest of
       the page utilitarian. */
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(44px, 7.6vw, 100px);
    line-height: 1.1;
    letter-spacing: -0.005em;
    color: var(--text-primary);
    /* Reserve a hair of room below the baseline so serif descenders
       (e.g. `p`, `y`, `g`) don't clip against the headline's
       overflow:hidden during the height transition. */
    padding-bottom: 0.12em;
    display: grid;
    transition: height 620ms var(--ease-out);
    overflow: hidden;
  }
  /* Pre-JS / no-JS fallback: grid stacking, max child reserves height. */
  .v2-hero__rot {
    grid-area: 1 / 1;
    pointer-events: none;
  }
  .v2-hero__rot.is-active {
    pointer-events: auto;
  }
  /* After JS measures each statement, children switch to absolute so the
     container's height can be sized to the ACTIVE statement only (not the
     tallest one). This is what lets the meta line move up for shorter copy. */
  .v2-hero__headline.is-measured {
    display: block;
    position: relative;
  }
  .v2-hero__headline.is-measured .v2-hero__rot {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: auto;
    height: auto;
    grid-area: auto;
  }

  /* Per-word stagger: each word rises into view with a small delay,
     creating a soft wave on rotation. Exit is uniform (no stagger). */
  .v2-hero__word {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.4em);
    filter: blur(6px);
    transition:
      opacity 540ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 720ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 540ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0ms;
    will-change: opacity, transform, filter;
  }
  .v2-hero__rot.is-active .v2-hero__word {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    transition-delay: calc(var(--j, 0) * 45ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .v2-hero__word {
      transition: opacity 200ms ease;
      transform: none;
      filter: none;
    }
    .v2-hero__rot.is-active .v2-hero__word {
      transform: none;
      filter: none;
      transition-delay: 0ms;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .v2-hero__rot { transition: none; transform: none; }
  }

  .v2-hero__meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(var(--s-8), 6vw, var(--s-20));
    row-gap: var(--s-5);
    margin: 0;
  }
  .v2-hero__meta p {
    font-family: var(--font-sans);
