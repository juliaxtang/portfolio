---
/**
 * CursorAurora — soft brand-color gradient blobs that follow the cursor.
 * Sits behind everything (z-index: -1). Runs once globally via BaseLayout.
 */
---

<div class="cursor-aurora" id="cursor-aurora" aria-hidden="true"></div>

<script is:inline>
  (function () {
    const blob = document.getElementById("cursor-aurora");
    if (!blob) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) return;

    let tx = 0.5, ty = 0.3, x = 0.5, y = 0.3;
    function move(e) {
      const w = window.innerWidth || 1;
      const h = window.innerHeight || 1;
      tx = e.clientX / w;
      ty = e.clientY / h;
    }
    window.addEventListener("mousemove", move, { passive: true });

    // Fade aurora out as user scrolls past the hero so it stops competing
    // with the showcases below. Fully opaque at top, gone by ~80vh down.
    function updateScrollFade() {
      const y = window.scrollY || 0;
      const vh = window.innerHeight || 1;
      const t = Math.max(0, Math.min(1, 1 - y / (vh * 0.8)));
      blob.style.setProperty("--aurora-opacity", t.toFixed(3));
    }
    window.addEventListener("scroll", updateScrollFade, { passive: true });
    updateScrollFade();

    // Three soft brand stops; the cloud morphs through them on a slow loop.
    const stops = [
      [244, 217, 204], // peach
      [220, 210, 232], // lavender
      [170, 205, 228], // powder blue
    ];
    const CYCLE_MS = 14000;
    const ALPHA = 0.5;
    const t0 = performance.now();
    function mix(a, b, t) { return Math.round(a + (b - a) * t); }

    function loop() {
      if (!isFinite(x) || !isFinite(y)) { x = 0.5; y = 0.3; }
      if (!isFinite(tx) || !isFinite(ty)) { tx = x; ty = y; }
      x += (tx - x) * 0.06;
      y += (ty - y) * 0.06;
      blob.style.setProperty("--mx", (x * 100).toFixed(2) + "%");
      blob.style.setProperty("--my", (y * 100).toFixed(2) + "%");

      const phase = ((performance.now() - t0) % CYCLE_MS) / CYCLE_MS; // 0..1
      const f = phase * stops.length;
      const i = Math.floor(f) % stops.length;
      const j = (i + 1) % stops.length;
      const lt = f - Math.floor(f);
      // ease in/out so the dwell on each color feels intentional
      const ease = lt < 0.5 ? 2 * lt * lt : 1 - Math.pow(-2 * lt + 2, 2) / 2;
      const r = mix(stops[i][0], stops[j][0], ease);
      const g = mix(stops[i][1], stops[j][1], ease);
      const b = mix(stops[i][2], stops[j][2], ease);
      blob.style.setProperty("--aurora-color", `rgba(${r}, ${g}, ${b}, ${ALPHA})`);

      requestAnimationFrame(loop);
    }
    loop();
  })();
</script>

<style>
  /* Single soft cloud that follows the cursor. Its core color cycles slowly
     through peach → lavender → powder-blue so the hero feels alive without
     showing distinct color blobs. */
  .cursor-aurora {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: var(--aurora-opacity, 1);
    transition: opacity 180ms linear;
    background:
      radial-gradient(
        46% 56% at var(--mx, 50%) var(--my, 30%),
        var(--aurora-color, rgba(244, 217, 204, 0.48)) 0%,
        transparent 70%
      );
    filter: blur(36px);
  }
</style>
