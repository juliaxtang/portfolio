---
/**
 * Callout — a single tile in a `<Callouts>` grid.
 *
 * Renders an optional eyebrow (e.g. "Design Principle 1"), a title in the
 * sans display weight, and freeform body content via the default slot.
 *
 * `tone` shifts the surface treatment:
 *   - "soft" (default) — pastel wash on light surface
 *   - "outline"        — surface card with a subtle border
 *   - "accent"         — uses --cs-accent (set on the page hero)
 */
interface Props {
  eyebrow?: string;
  title?: string;
  number?: string | number;
  tone?: "soft" | "outline" | "accent";
  logo?: string;
  logoAlt?: string;
  /** "brand" (default) renders the logo at full color. "icon" treats the
   *  logo as a monochrome glyph and tints it to match the title color. */
  logoMode?: "brand" | "icon";
}
const { eyebrow, title, number, tone = "soft", logo, logoAlt, logoMode = "brand" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolvedLogo = logo
  ? logo.startsWith("http") || logo.startsWith(base)
    ? logo
    : `${base}${logo.startsWith("/") ? "" : "/"}${logo}`
  : undefined;
const cls = [
  "cs-callout",
  `cs-callout--${tone}`,
  logoMode === "icon" ? "cs-callout--icon-logo" : "",
].filter(Boolean).join(" ");
---

<div class={cls}>
  {(number !== undefined || eyebrow) && (
    <div class="cs-callout__head">
      {number !== undefined && <span class="cs-callout__num">{number}</span>}
      {eyebrow && <p class="cs-callout__eyebrow t-eyebrow">{eyebrow}</p>}
    </div>
  )}
  {(resolvedLogo || title) && (
    <div class="cs-callout__title-row">
      {resolvedLogo && (
        <img class="cs-callout__logo" src={resolvedLogo} alt={logoAlt ?? ""} loading="lazy" />
      )}
      {title && <h3 class="cs-callout__title">{title}</h3>}
    </div>
  )}
  <div class="cs-callout__body">
    <slot />
  </div>
</div>

<style>
  .cs-callout {
    --cs-callout-bg: var(--brand-wash-soft);
    --cs-callout-border: var(--border-subtle);
    display: grid;
    gap: var(--s-3);
    padding: var(--s-6);
    border-radius: var(--r-lg);
    background: var(--cs-callout-bg);
    border: 1px solid var(--cs-callout-border);
  }

  .cs-callout--soft {
    --cs-callout-bg: var(--bg-surface);
    --cs-callout-border: var(--border-default);
  }

  .cs-callout--outline {
    --cs-callout-bg: var(--bg-surface);
    --cs-callout-border: var(--border-default);
  }

  .cs-callout--accent {
    --cs-callout-bg: var(--bg-surface);
    --cs-callout-border: var(--border-default);
  }

  .cs-callout__title-row {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }
  .cs-callout__logo {
    width: 28px;
    height: 28px;
    object-fit: contain;
    display: block;
    flex-shrink: 0;
  }
  /* For monochrome icon-style logos (SVGs designed as glyphs, not brand
     marks): tint the artwork to match the title text color. */
  .cs-callout--icon-logo .cs-callout__logo {
    filter: brightness(0) saturate(100%);
  }

  .cs-callout__head {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .cs-callout__num {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: var(--r-full);
    /* Style-guide accent (lavender mist) with dark on-brand text for
       legibility. Not the case-study accent, that's reserved for
       page-level hero treatments. */
    background: var(--brand-accent);
    color: var(--text-on-brand);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    flex-shrink: 0;
  }

  .cs-callout__eyebrow { margin: 0 !important; font-size: 12px !important; color: var(--text-tertiary) !important; }

  .cs-callout__title {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.012em;
    line-height: 1.25;
    color: var(--text-primary);
    margin: 0;
  }

  .cs-callout__body {
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .cs-callout__body :global(p) {
    margin: 0 0 var(--s-3);
    font-size: 15px;
    line-height: 1.55;
  }
  .cs-callout__body :global(p:last-child) { margin: 0; }
  .cs-callout__body :global(ul) {
    margin: 0;
    padding-left: var(--s-5);
    font-size: 15px;
  }
  .cs-callout__body :global(li) { margin-bottom: var(--s-1); }
  .cs-callout__body :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }
</style>
