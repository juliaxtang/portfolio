---
/**
 * Arrow — a hand-drawn-style arrow that points from one element to
 * another. The shaft is a single cubic bezier (or straight line) with
 * endpoints pinned via getBoundingClientRect(), recomputed on scroll,
 * resize, and font-load. The SVG is portaled to <body> on init.
 *
 * Path modes:
 *   vertical-s (default) — S-curve, vertical tangents at both ends
 *   straight — line between anchors
 *   straight-horizontal — same Y as the from anchor; tip X from the to
 *     anchor (level line between two elements)
 *   horizontal-left — level line from the from anchor straight left; tip
 *     is not pinned to `to`. Optional `length` (px) and `boundTo` + `boundGap`
 *     stop the tip before a graphic (e.g. games deck)
 *   vertical-down — plumb line: tail at from anchor, tip at `to`; tip X
 *     matches tail X (centered under the from box when using bottom-center)
 *   curve-drag-phone — cubic tuned to match the App Redesign drag-to-move
 *     PNG (masked arrow on PhoneVideoParallax)
 *   curve-drag-media — cubic tuned to match the Topic Chats drag hint
 *     (masked arrow on MediaParallax, curve points up toward cells)
 *
 * Visibility:
 *   With `trigger`, hover shows the arrow (default doodle pattern).
 *   With `persistent`, the arrow is shown whenever hide rules allow.
 *   `watchRoot` + `hideWhen` mirror existing CSS affordance hide logic.
 */

interface Props {
  from: string;
  /** Omit when using horizontal-left (tip is computed, not anchored). */
  to?: string;
  trigger?: string;
  /** Anchor on the from element. Default bottom-center. */
  fromAnchor?: string;
  /** Anchor on the to element. Default top-center. */
  toAnchor?: string;
  /** vertical-s | straight | straight-horizontal | horizontal-left | vertical-down | curve-drag-phone | curve-drag-media */
  path?: string;
  /** horizontal-left: max shaft length in px (default 160). */
  length?: number;
  /** horizontal-left: do not draw past this element's right edge + boundGap. */
  boundTo?: string;
  boundGap?: number;
  padding?: number;
  /** Offset for the tail only; defaults to `padding`. */
  fromPadding?: number;
  /** Inset for the tip only; defaults to `padding`. */
  toPadding?: number;
  color?: string;
  thickness?: number;
  liftCompensation?: number;
  liftActiveSelector?: string;
  /** When true, arrow is visible (drawn) without a hover trigger. */
  persistent?: boolean;
  /** Root element for hide-rule listeners (e.g. ".card-stack"). */
  watchRoot?: string;
  /** Comma-separated hide rules: deck-hover, root-class:is-advanced, root-class:is-interacted, cell-hover */
  hideWhen?: string;
  /** Hide arrow below this viewport width (matches showcase pill breakpoints). */
  hideBelowWidth?: number;
  /** Opt out of the default ≤720px arrow hide (e.g. for the doodle hint
   *  which is the only entry point on touch). */
  mobileVisible?: boolean;
  id?: string;
}

const {
  from,
  to,
  trigger,
  fromAnchor = "bottom-center",
  toAnchor = "top-center",
  path = "vertical-s",
  length = 160,
  boundTo = "",
  boundGap = 16,
  padding = 12,
  fromPadding,
  toPadding,
  color = "var(--text-secondary)",
  thickness = 2,
  liftCompensation = 0,
  liftActiveSelector,
  persistent = false,
  watchRoot = "",
  hideWhen = "",
  hideBelowWidth = 0,
  mobileVisible = false,
  id,
} = Astro.props;

const arrowId = id ?? `arrow-${Math.random().toString(36).slice(2, 9)}`;
const inlineStyle = `color: ${color}; --hand-arrow-stroke-width: ${thickness}px;`;
---

<svg
  class:list={["hand-arrow", persistent && "hand-arrow--persistent", mobileVisible && "hand-arrow--mobile-visible"]}
  style={inlineStyle}
  data-arrow-id={arrowId}
  data-from={from}
  data-to={to ?? ""}
  data-length={length}
  data-bound-to={boundTo}
  data-bound-gap={boundGap}
  data-trigger={trigger ?? ""}
  data-from-anchor={fromAnchor}
  data-to-anchor={toAnchor}
  data-path={path}
  data-padding={padding}
  data-from-padding={fromPadding ?? padding}
  data-to-padding={toPadding ?? padding}
  data-lift-px={liftCompensation}
  data-lift-sel={liftActiveSelector ?? ""}
  data-persistent={persistent ? "true" : ""}
  data-watch-root={watchRoot}
  data-hide-when={hideWhen}
  data-hide-below={hideBelowWidth || ""}
  aria-hidden="true"
  focusable="false"
>
  <path
    class="hand-arrow__shaft"
    pathLength="100"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path
    class="hand-arrow__head"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path
    class="hand-arrow__head"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>

<style is:global>
  .hand-arrow {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 200;
    opacity: 0;
    overflow: visible;
    transition: opacity 240ms var(--ease-out);
  }
  .hand-arrow path {
    stroke-width: var(--hand-arrow-stroke-width, 2px);
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }
  .hand-arrow__shaft {
    transition: stroke-dashoffset 720ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hand-arrow__head {
    /* Natural length (no pathLength attr) so chevron tips meet the shaft. */
    stroke-dasharray: 24;
    stroke-dashoffset: 24;
    transition: stroke-dashoffset 200ms cubic-bezier(0.22, 1, 0.36, 1) 720ms;
  }
  .hand-arrow.is-pointing {
    opacity: 1;
  }
  .hand-arrow.is-pointing path {
    stroke-dashoffset: 0;
  }
  /* Persistent showcase hints start visible once path is ready. */
  .hand-arrow.hand-arrow--persistent.is-pointing path {
    stroke-dashoffset: 0;
  }

  @media (max-width: 720px) {
    .hand-arrow:not(.hand-arrow--persistent):not(.hand-arrow--mobile-visible) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hand-arrow path {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    function anchorPoint(rect, anchor, pad, isEnd) {
      const a = anchor || "bottom-center";
      const p = pad || 0;
      const parts = a.split("-");
      let x = rect.left + rect.width / 2;
      let y = rect.top + rect.height / 2;
      /* Tail (isEnd false): pad outside the box. Tip (isEnd true): pad
         outside on top/bottom; on left/right use inward offset so the
         arrowhead clears the edge (e.g. deck right face, toolbar top). */
      const outside = parts.indexOf("outside") >= 0;
      if (parts.indexOf("left") >= 0) {
        x = isEnd
          ? outside
            ? rect.left - p
            : rect.left + p
          : rect.left - p;
      } else if (parts.indexOf("right") >= 0) {
        x = isEnd
          ? outside
            ? rect.right + p
            : rect.right - p
          : rect.right + p;
      }
      if (parts.indexOf("top") >= 0) {
        y = rect.top - p;
      } else if (parts.indexOf("bottom") >= 0) {
        y = rect.bottom + p;
      }
      return { x: x, y: y };
    }

    function setHeads(heads, tx, ty, backX, backY) {
      const bdx = backX - tx;
      const bdy = backY - ty;
      const blen = Math.hypot(bdx, bdy);
      if (blen === 0) return;
      const ux = bdx / blen;
      const uy = bdy / blen;
      const wlen = 18;
      const ang = (25 * Math.PI) / 180;
      const ca = Math.cos(ang);
      const sa = Math.sin(ang);
      const w1x = tx + wlen * (ux * ca - uy * sa);
      const w1y = ty + wlen * (ux * sa + uy * ca);
      const w2x = tx + wlen * (ux * ca + uy * sa);
      const w2y = ty + wlen * (-ux * sa + uy * ca);
      heads[0].setAttribute(
        "d",
        "M " + tx.toFixed(1) + " " + ty.toFixed(1) +
        " L " + w1x.toFixed(1) + " " + w1y.toFixed(1)
      );
      heads[1].setAttribute(
        "d",
        "M " + tx.toFixed(1) + " " + ty.toFixed(1) +
        " L " + w2x.toFixed(1) + " " + w2y.toFixed(1)
      );
    }

    /* Tip + tangent from the drawn shaft so the chevron meets the curve
       (layout anchors can disagree with the last pixel of a cubic). */
    function alignHeadToShaft(shaft, heads) {
      const len = shaft.getTotalLength();
      if (len < 2) return;
      const tangentSpan = Math.min(42, Math.max(16, len * 0.09));
      const endLen = len;
      const backLen = Math.max(0, endLen - tangentSpan);
      const tip = shaft.getPointAtLength(endLen);
      const back = shaft.getPointAtLength(backLen);
      setHeads(heads, tip.x, tip.y, back.x, back.y);
    }

    function init() {
      document
        .querySelectorAll("[data-arrow-id]:not([data-arrow-ready])")
        .forEach(setupArrow);
    }

    function setupArrow(arrow) {
      arrow.setAttribute("data-arrow-ready", "");

      const fromSel = arrow.dataset.from;
      const toSel = arrow.dataset.to;
      const triggerSel = arrow.dataset.trigger;
      const fromAnchor = arrow.dataset.fromAnchor || "bottom-center";
      const toAnchor = arrow.dataset.toAnchor || "top-center";
      const padding = parseFloat(arrow.dataset.padding) || 0;
      /* `|| padding` would clobber an explicit 0 (falsy), so guard with
         Number.isFinite — needed when a caller wants zero horizontal
         offset on a bottom-left tail but still wants vertical padding via
         the main `padding` prop. */
      const fpRaw = parseFloat(arrow.dataset.fromPadding);
      const fromPadding = Number.isFinite(fpRaw) ? fpRaw : padding;
      const tpRaw = parseFloat(arrow.dataset.toPadding);
      const toPadding = Number.isFinite(tpRaw) ? tpRaw : padding;
      const liftPx = parseFloat(arrow.dataset.liftPx) || 0;
      const liftActiveSel = arrow.dataset.liftSel;
      const persistent = arrow.dataset.persistent === "true";
      const watchRootSel = arrow.dataset.watchRoot || "";
      const hideRules = (arrow.dataset.hideWhen || "")
        .split(",")
        .map((s) => s.trim())
        .filter(Boolean);
      const hideBelow = parseInt(arrow.dataset.hideBelow || "0", 10);

      /* Scope anchors to this showcase instance before portaling to body. */
      const scopeRoot =
        arrow.closest("[data-card-stack]") ||
        arrow.closest(".phone-video") ||
        arrow.closest(".media-parallax");
      const watchRoot =
        scopeRoot ||
        (watchRootSel ? document.querySelector(watchRootSel) : null);

      function resolveTarget(sel) {
        if (!sel) return null;
        if (scopeRoot) {
          /* ID selectors (#pvp-…) still need document scope. */
          if (sel.charAt(0) === "#") {
            const id = sel.match(/^#([^\s.#>+~[,]+)/);
            if (id && scopeRoot.id === id[1]) {
              const rest = sel.slice(id[0].length).trim();
              if (!rest) return scopeRoot;
              const inner = scopeRoot.querySelector(rest);
              if (inner) return inner;
            }
          } else {
            const inner = scopeRoot.querySelector(sel);
            if (inner) return inner;
          }
        }
        return document.querySelector(sel);
      }

      const pathMode = arrow.dataset.path || "vertical-s";
      const boundToSel = arrow.dataset.boundTo || "";
      const boundGap = parseFloat(arrow.dataset.boundGap) || 0;
      const horizLength = parseFloat(arrow.dataset.length) || 160;

      const fromEl = resolveTarget(fromSel);
      const toEl = toSel ? resolveTarget(toSel) : null;
      const boundEl = boundToSel ? resolveTarget(boundToSel) : null;
      const triggerEl = triggerSel
        ? document.querySelector(triggerSel)
        : null;
      const shaft = arrow.querySelector(".hand-arrow__shaft");
      const heads = arrow.querySelectorAll(".hand-arrow__head");

      if (!fromEl || !shaft || heads.length < 2) return;
      if (
        pathMode !== "horizontal-left" &&
        pathMode !== "vertical-down" &&
        !toEl
      ) {
        return;
      }
      if (pathMode === "vertical-down" && !toEl) return;

      if (arrow.parentElement !== document.body) {
        document.body.appendChild(arrow);
      }

      function updatePath() {
        if (hideBelow && window.matchMedia("(max-width: " + hideBelow + "px)").matches) {
          arrow.classList.remove("is-pointing");
          return;
        }

        const fr = fromEl.getBoundingClientRect();
        const fromGone =
          fr.width === 0 && fr.height === 0 && fr.left === 0 && fr.top === 0;
        if (fromGone) {
          /* Anchor is display:none (e.g. drag-hint hidden at narrow desktop).
             Without this, a path drawn earlier — when the anchor was visible
             at a wider viewport — stays at its last viewport coords, fixed
             inset:0, and drifts into view as the user scrolls. Clear both
             the shaft and the head paths and drop is-pointing so the SVG
             goes back to opacity 0. */
          shaft.removeAttribute("d");
          heads[0].removeAttribute("d");
          heads[1].removeAttribute("d");
          arrow.classList.remove("is-pointing");
          return;
        }

        const start = anchorPoint(fr, fromAnchor, fromPadding, false);
        let sx = start.x;
        let sy = start.y;

        let tx;
        let ty;
        let dx;
        let dy;
        let c1x, c1y, c2x, c2y;
        let backX, backY;

        if (pathMode === "horizontal-left") {
          /* Tail at from (e.g. left of label); tip extends straight left. */
          ty = sy;
          tx = sx - horizLength;
          if (boundEl) {
            const br = boundEl.getBoundingClientRect();
            const cap = br.right + boundGap;
            if (tx < cap) tx = cap;
          }
          if (tx >= sx - 8) return;
          dx = tx - sx;
          shaft.setAttribute(
            "d",
            "M " + sx.toFixed(1) + " " + sy.toFixed(1) +
            " L " + tx.toFixed(1) + " " + ty.toFixed(1)
          );
          alignHeadToShaft(shaft, heads);
          return;
        }

        if (pathMode === "vertical-down") {
          const tr = toEl.getBoundingClientRect();
          const toGone =
            tr.width === 0 && tr.height === 0 && tr.left === 0 && tr.top === 0;
          if (toGone) return;
          /* Plumb line under the hint; tip lands on the target edge below
             the tail (Topic Chats scoreboard under the label). */
          tx = sx;
          const top = anchorPoint(tr, "top-center", padding, true);
          const bottom = anchorPoint(tr, "bottom-center", padding, true);
          let ty = top.y;
          if (top.y <= sy + 8) {
            if (bottom.y > sy + 8) ty = bottom.y;
            else ty = sy + Math.max(48, tr.height * 0.35);
          }
          if (Math.abs(ty - sy) < 8) return;
          shaft.setAttribute(
            "d",
            "M " + sx.toFixed(1) + " " + sy.toFixed(1) +
            " L " + tx.toFixed(1) + " " + ty.toFixed(1)
          );
          alignHeadToShaft(shaft, heads);
          return;
        }

        const tr = toEl.getBoundingClientRect();
        const toGone =
          tr.width === 0 && tr.height === 0 && tr.left === 0 && tr.top === 0;
        if (toGone) return;

        let lift = 0;
        if (liftPx > 0) {
          if (liftActiveSel) {
            const lifted = toEl.closest(liftActiveSel);
            lift = lifted ? 0 : liftPx;
          } else {
            lift = liftPx;
          }
        }
        const end = anchorPoint(tr, toAnchor, toPadding, true);
        tx = end.x;
        ty = end.y - lift;

        dx = tx - sx;
        dy = ty - sy;

        if (pathMode === "straight-horizontal") {
          ty = sy;
          tx = end.x;
          dx = tx - sx;
          shaft.setAttribute(
            "d",
            "M " + sx.toFixed(1) + " " + sy.toFixed(1) +
            " L " + tx.toFixed(1) + " " + ty.toFixed(1)
          );
          backX = sx + 0.85 * dx;
          backY = sy;
        } else if (pathMode === "straight") {
          c1x = sx;
          c1y = sy;
          c2x = tx;
          c2y = ty;
          shaft.setAttribute(
            "d",
            "M " + sx.toFixed(1) + " " + sy.toFixed(1) +
            " L " + tx.toFixed(1) + " " + ty.toFixed(1)
          );
          backX = sx + 0.85 * dx;
          backY = sy + 0.85 * dy;
        } else if (pathMode === "curve-drag-phone") {
          /* App Redesign: bow to the right; when tail and tip share x,
             use a modest east bulge + vertical sweep (not off-screen). */
          const span = Math.hypot(dx, dy) || 1;
          const horiz = Math.abs(dx);
          const bowOut = Math.min(
            92,
            Math.max(58, span * 0.26, horiz * 1.6)
          );
          const midX = (sx + tx) * 0.5;
          const peakX = midX + bowOut;
          const peakY = sy + dy * 0.42;
          const lead = Math.max(56, span * 0.12);
          const ax = tx + Math.max(44, span * 0.08);
          const ay = ty - Math.min(20, Math.abs(dy) * 0.1);
          const d =
            "M " + sx.toFixed(1) + " " + sy.toFixed(1) +
            " C " + (sx + lead).toFixed(1) + " " + (sy + dy * 0.02).toFixed(1) +
            ", " + peakX.toFixed(1) + " " + (peakY - bowOut * 0.35).toFixed(1) +
            ", " + peakX.toFixed(1) + " " + peakY.toFixed(1) +
            " C " + peakX.toFixed(1) + " " + (peakY + bowOut * 0.4).toFixed(1) +
            ", " + ax.toFixed(1) + " " + ay.toFixed(1) +
            ", " + tx.toFixed(1) + " " + ty.toFixed(1);
          shaft.setAttribute("d", d);
          backX = ax;
          backY = ay;
        } else if (pathMode === "curve-drag-media") {
          /* Topic Chats hint: curve rises from label toward upper-left cell. */
          c1x = sx + 0.42 * dx;
          c1y = sy + 0.02 * dy;
          c2x = tx - 0.08 * Math.abs(dx);
          c2y = sy + 0.38 * dy;
          shaft.setAttribute(
            "d",
            "M " + sx.toFixed(1) + " " + sy.toFixed(1) +
            " C " + c1x.toFixed(1) + " " + c1y.toFixed(1) +
            ", " + c2x.toFixed(1) + " " + c2y.toFixed(1) +
            ", " + tx.toFixed(1) + " " + ty.toFixed(1)
          );
          backX = c2x;
          backY = c2y;
        } else {
          c1x = sx;
          c1y = sy + 0.5 * dy;
          c2x = tx;
          c2y = ty - 0.5 * dy;
          shaft.setAttribute(
            "d",
            "M " + sx.toFixed(1) + " " + sy.toFixed(1) +
            " C " + c1x.toFixed(1) + " " + c1y.toFixed(1) +
            ", " + c2x.toFixed(1) + " " + c2y.toFixed(1) +
            ", " + tx.toFixed(1) + " " + ty.toFixed(1)
          );
          backX = c2x;
          backY = c2y;
        }

        alignHeadToShaft(shaft, heads);
      }

      function shouldHide() {
        if (hideBelow && window.matchMedia("(max-width: " + hideBelow + "px)").matches) {
          return true;
        }
        if (!watchRoot) return false;
        for (let i = 0; i < hideRules.length; i++) {
          const rule = hideRules[i];
          if (rule === "deck-hover") {
            const deck = watchRoot.querySelector("[data-deck]");
            if (deck && deck.matches(":hover")) return true;
          } else if (rule === "cell-hover") {
            if (watchRoot.querySelector(".phone-video__cell:hover, .media-parallax__cell:hover")) {
              return true;
            }
          } else if (rule === "cell-active") {
            if (
              watchRoot.querySelector(
                ".phone-video__cell.is-grabbing, .phone-video__cell.is-focused, .media-parallax__cell.is-grabbing, .media-parallax__cell.is-focused"
              )
            ) {
              return true;
            }
          } else if (rule.indexOf("root-class:") === 0) {
            const cls = rule.slice("root-class:".length);
            if (cls && watchRoot.classList.contains(cls)) return true;
          }
        }
        return false;
      }

      let triggerActive = false;

      function syncVisible() {
        if (shouldHide()) {
          arrow.classList.remove("is-pointing");
          return;
        }
        updatePath();
        if (persistent || triggerActive) {
          arrow.classList.add("is-pointing");
        } else {
          arrow.classList.remove("is-pointing");
        }
      }

      let pathRaf = 0;
      const schedulePath = () => {
        if (pathRaf) return;
        pathRaf = requestAnimationFrame(() => {
          pathRaf = 0;
          syncVisible();
        });
      };

      syncVisible();
      window.addEventListener("resize", schedulePath);
      window.addEventListener("scroll", schedulePath, { passive: true });
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(syncVisible);
      }
      window.addEventListener("load", syncVisible);

      if (watchRoot) {
        watchRoot.querySelectorAll("img, video").forEach((media) => {
          if (media.tagName === "VIDEO") {
            if (media.readyState < 2) {
              media.addEventListener("loadeddata", schedulePath, { once: true });
            }
          } else if (!media.complete) {
            media.addEventListener("load", schedulePath, { once: true });
          }
        });
        if (typeof ResizeObserver !== "undefined") {
          const ro = new ResizeObserver(schedulePath);
          ro.observe(watchRoot);
        }
      }

      if (watchRoot && hideRules.length) {
        const deck = watchRoot.querySelector("[data-deck]");
        if (deck) {
          deck.addEventListener("mouseenter", schedulePath);
          deck.addEventListener("mouseleave", schedulePath);
        }
        watchRoot.querySelectorAll(
          ".phone-video__cell, .media-parallax__cell"
        ).forEach((cell) => {
          cell.addEventListener("mouseenter", schedulePath);
          cell.addEventListener("mouseleave", schedulePath);
          cell.addEventListener("pointerdown", schedulePath);
        });
        const mo = new MutationObserver(schedulePath);
        mo.observe(watchRoot, {
          attributes: true,
          attributeFilter: ["class"],
          subtree: true,
        });
      }

      if (triggerEl) {
        const onEnter = () => {
          triggerActive = true;
          syncVisible();
        };
        const onLeave = () => {
          triggerActive = false;
          if (!persistent) syncVisible();
        };
        triggerEl.addEventListener("mouseenter", onEnter);
        triggerEl.addEventListener("mouseleave", onLeave);
        triggerEl.addEventListener("focusin", onEnter);
        triggerEl.addEventListener("focusout", (e) => {
          if (!triggerEl.contains(e.relatedTarget)) onLeave();
        });

        let scrollRaf = 0;
        const checkOnScroll = () => {
          scrollRaf = 0;
          if (!arrow.classList.contains("is-pointing")) return;
          const html = document.documentElement;
          const cx = parseFloat(html.style.getPropertyValue("--cursor-x"));
          const cy = parseFloat(html.style.getPropertyValue("--cursor-y"));
          if (Number.isFinite(cx) && Number.isFinite(cy)) {
            const r = triggerEl.getBoundingClientRect();
            const inside =
              cx >= r.left && cx <= r.right && cy >= r.top && cy <= r.bottom;
            if (inside) return;
          }
          if (!persistent) onLeave();
        };
        window.addEventListener(
          "scroll",
          () => {
            if (scrollRaf) return;
            scrollRaf = requestAnimationFrame(checkOnScroll);
          },
          { passive: true }
        );
      } else if (!persistent) {
        arrow.classList.remove("is-pointing");
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
    document.addEventListener("hand-arrow:refresh", init);
  })();
</script>
