---
/**
 * Strip — horizontal-scroll row for a sequence of images (e.g. phone
 * screenshots showing an onboarding flow). All images share a fixed height;
 * widths scale naturally. Scrollable on overflow so narrow viewports can
 * still reach every image.
 *
 * Props:
 *   images  — array of { src, alt, caption? }
 *   height  — CSS length for every image (default "480px")
 *   wide    — if true, container expands to content-max instead of narrow
 */
interface ImageItem {
  src: string;
  alt: string;
  caption?: string;
}
interface Props {
  images: ImageItem[];
  height?: string;
  wide?: boolean;
}

const { images, height = "480px", wide = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

function resolve(src: string): string {
  if (src.startsWith("http") || src.startsWith(base)) return src;
  return `${base}${src.startsWith("/") ? "" : "/"}${src}`;
}

const cls = ["cs-strip", wide ? "cs-strip--wide" : ""].filter(Boolean).join(" ");
---

<div class={cls} style={`--strip-h:${height}`}>
  <ul class="cs-strip__track" role="list">
    {images.map(img => (
      <li class="cs-strip__item">
        <img src={resolve(img.src)} alt={img.alt} loading="lazy" />
        {img.caption && <p class="cs-strip__caption">{img.caption}</p>}
      </li>
    ))}
  </ul>
</div>

<style>
  .cs-strip {
    margin: var(--s-8) auto;
    max-width: var(--content-narrow);
  }
  .cs-strip--wide {
    max-width: var(--content-max);
    margin-left: max(var(--s-5), calc((100% - var(--content-narrow)) / 2));
    margin-right: max(var(--s-5), calc((100% - var(--content-max)) / 2));
  }

  .cs-strip__track {
    display: flex;
    gap: var(--s-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--border-default) transparent;
    align-items: flex-start;
    list-style: none;
    padding: 0 0 var(--s-2) 0;
    margin: 0;
  }
  .cs-strip__track::-webkit-scrollbar {
    height: 4px;
  }
  .cs-strip__track::-webkit-scrollbar-track {
    background: transparent;
  }
  .cs-strip__track::-webkit-scrollbar-thumb {
    background: var(--border-default);
    border-radius: 2px;
  }

  .cs-strip__item {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .cs-strip__item img {
    height: var(--strip-h);
    width: auto;
    max-width: none;
    display: block;
    border-radius: var(--r-md);
  }

  .cs-strip__caption {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    color: var(--text-tertiary);
    text-align: center;
    margin-top: var(--s-2);
    max-width: 220px;
  }
</style>
