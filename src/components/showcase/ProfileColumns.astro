---
/**
 * ProfileColumns — two parallax columns of profile cards.
 *
 * Used on the Tappy Cloud showcase to mimic Tinder's profile feed: two tall
 * columns of profile mockups that scroll faster than the page as the user
 * scrolls past the section, so it feels like more profiles are streaming
 * into view. Top and bottom of each column fade into the page so the edges
 * don't read as hard cutoffs.
 *
 * Pass two tall PNG/JPG strips. Aspect ratio of each strip should be tall
 * (~1:6+ ideally) so there's enough content to parallax through.
 */
interface Props {
  left: string;
  right: string;
  /** Fraction of the right column's available scroll range that gets
   *  traversed as the section travels through the viewport. Both columns
   *  move the same pixel distance, so 1.0 means the right column hits the
   *  bottom of its strip exactly when the section exits — and the left
   *  column tracks the same speed. Lower for slower, more readable scroll. */
  speed?: number;
  /** Starting offset (0–1) for the right column so the two columns aren't
   *  perfectly aligned at rest. Larger value = right column starts further
   *  down its strip. */
  rightOffset?: number;
  /** Fallback aspect ratio of the visible window — used for the initial
   *  paint before JS measures the sibling text column. Once measured,
   *  the height is locked to the text column height. */
  aspect?: string;
  /** Max width of the whole component. The visual asset shrinks
   *  proportionally inside this cap, so more profiles fit per column. */
  maxWidth?: string;
  altLeft?: string;
  altRight?: string;
  /** Floor on the visible window height (CSS length). When the sibling
   *  text column is shorter than this, the cluster keeps this height
   *  so adjacent showcase heroes can be roughly the same vertical size. */
  minHeight?: string;
  /** Number of evenly-sized profile cards stacked in each strip image.
   *  When set, the visible window height is snapped down to an integer
   *  multiple of cardH so the top and bottom edges always land on a card
   *  boundary — no half-card slivers show. The columns become static
   *  (no parallax) so the alignment holds throughout the entire scroll. */
  cards?: number;
  /** Vertical offset between the two columns (CSS length). Implements a
   *  masonry-style stagger: the right column sits this far lower than
   *  the left, so the two columns' card rows don't line up. Only honored
   *  when `cards` is set; ignored otherwise. */
  offsetRight?: string;
  /** Number of cards to show per column. When set, each column locks to
   *  this many cards regardless of available height (the section grows
   *  to fit). When omitted, snaps down to the largest whole-card
   *  multiple that fits inside the matched/min height. */
  showCards?: number;
}
const {
  left,
  right,
  speed = 1.0,
  rightOffset = 0.32,
  aspect = "0.78 / 1",
  maxWidth = "360px",
  altLeft = "",
  altRight = "",
  minHeight,
  cards,
  offsetRight: offsetRightPx,
  showCards,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolve = (p: string) =>
  p.startsWith("http") || p.startsWith(base)
    ? p
    : `${base}${p.startsWith("/") ? "" : "/"}${p}`;

const id = "pc-" + Math.random().toString(36).slice(2, 9);
---

<div
  class="profile-cols"
  id={id}
  data-speed={speed}
  data-right-offset={rightOffset}
  data-cards={cards}
  data-show-cards={showCards}
  data-offset-right={offsetRightPx}
  style={`--pc-aspect:${aspect};--pc-max-w:${maxWidth};${minHeight ? `--pc-min-h:${minHeight};` : ""}${offsetRightPx ? `--pc-offset-right:${offsetRightPx};` : ""}`}
  data-min-height={minHeight}
>
  <div class="profile-cols__col">
    <div class="profile-cols__strip">
      <img src={resolve(left)} alt={altLeft} loading="eager" draggable="false" data-img />
    </div>
    <div class="profile-cols__cards" data-cards-layer></div>
  </div>
  <div class="profile-cols__col">
    <div class="profile-cols__strip">
      <img src={resolve(right)} alt={altRight} loading="eager" draggable="false" data-img />
    </div>
    <div class="profile-cols__cards" data-cards-layer></div>
  </div>
</div>

<script is:inline>
  (function () {
    if (typeof window === "undefined") return;
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
    function init() {
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.querySelectorAll(".profile-cols").forEach((root) => {
        const speed = parseFloat(root.dataset.speed || "1.0");
        const rightOffset = parseFloat(root.dataset.rightOffset || "0.32");
        const cards = parseInt(root.dataset.cards || "0", 10);
        const showCards = parseInt(root.dataset.showCards || "0", 10);
        const offsetRight = root.dataset.offsetRight || "";
        const cols = Array.from(root.querySelectorAll(".profile-cols__col"));
        const imgs = cols.map((c) => c.querySelector("[data-img]"));
        const cardLayers = cols.map((c) => c.querySelector("[data-cards-layer]"));
        // Compute the right-column vertical stagger in pixels. Accepts
        // raw numbers (interpreted as px) and px-suffixed strings. When
        // `cards` and `offsetRight` are both set, the section grows by
        // this amount and each column locks to N*cardH, staggered.
        function offsetRightPx() {
          if (!offsetRight) return 0;
          const n = parseFloat(offsetRight);
          return isFinite(n) ? n : 0;
        }

        // When `cards` is set, snap the column height down to an integer
        // multiple of the per-card height so the visible edges always
        // land on a card boundary. Computed from the first img once it
        // has a measurable clientHeight (post-load).
        function cardHeight() {
          if (!cards || cards < 2) return 0;
          const img = imgs[0];
          if (!img || img.clientHeight <= 0) return 0;
          return img.clientHeight / cards;
        }

        // Lock height to the sibling text column so the asset sits flush
        // with the case-study info on the desktop two-column layout.
        const showcase = root.closest(".showcase");
        const text = showcase ? showcase.querySelector(".showcase__text") : null;
        const minHeight = parseFloat(root.dataset.minHeight || "0");
        // Build (or rebuild) the per-card overlay layer for both columns.
        // Each visible card slot in the strip gets a transparent div sized
        // and background-positioned to mirror the underlying card. CSS
        // hover on the overlay scales the slot up smoothly without
        // touching the strip image, which keeps the parallax math simple
        // and lets adjacent overlays stay put. Called from matchHeight()
        // every time card geometry changes (resize, font-load, image
        // load) so the overlays stay aligned.
        //
        // Card geometry constants derived from the source strip image
        // (Tappy Cloud profile strips: 4 cards in a 375x2504 PNG, each
        // card body 604px tall starting at y=4 and spaced 628px apart;
        // card corner radius ~28px in the source). Expressed as
        // fractions of the slot height (stripH/cards = 626 in source)
        // so they survive any rendering scale. Without this, the
        // overlay covers the slot's entire 626px height and exposes
        // the 25px gap between cards as a visible "border" on hover.
        const TOP_OFFSET_FRAC = 4 / 626;     // 0.00639
        const BODY_FRAC = 604 / 626;         // 0.96485
        const SPACING_FRAC = 628 / 626;      // 1.00319
        const RADIUS_FRAC = 28 / 604;        // ~0.0464 of body height
        function rebuildCardOverlays() {
          const ch = cardHeight();
          if (ch <= 0 || !cards) return;
          const showN = showCards > 0
            ? Math.min(showCards, cards || showCards)
            : cards;
          const extraCards = Math.max(cards - showN, 0);
          const bodyH = BODY_FRAC * ch;
          const radius = bodyH * RADIUS_FRAC;
          cols.forEach((col, i) => {
            const layer = cardLayers[i];
            const img = imgs[i];
            if (!layer || !img) return;
            // Total strip height (all N cards stacked).
            const stripH = cards * ch;
            // Left col anchors at the top of the strip → shows cards
            // 0..showN-1. Right col anchors at the bottom → shows cards
            // extraCards..cards-1.
            const startCardIdx = i === 0 ? 0 : extraCards;
            // Clear any prior overlays.
            while (layer.firstChild) layer.removeChild(layer.firstChild);
            for (let k = 0; k < showN; k++) {
              const cardIdx = startCardIdx + k;
              // Exact y of this card's body in the rendered strip.
              const bodyTopInStrip = TOP_OFFSET_FRAC * ch + cardIdx * SPACING_FRAC * ch;
              // Convert to column coords. Right column has the strip
              // translated up by extraCards*ch so card 0..extraCards-1
              // are off the top of the column window.
              const bodyTopInCol = i === 0
                ? bodyTopInStrip
                : bodyTopInStrip - extraCards * ch;
              const overlay = document.createElement("div");
              overlay.className = "profile-cols__card";
              overlay.style.top = bodyTopInCol + "px";
              overlay.style.height = bodyH + "px";
              overlay.style.borderRadius = radius + "px";
              overlay.style.backgroundImage = "url('" + img.src + "')";
              overlay.style.backgroundSize = "100% " + stripH + "px";
              // Match the bg-image's painted region to the card body
              // exactly: the overlay's (0,0) corresponds to bodyTopInStrip
              // in the source, so the rounded card content lines up
              // with the overlay's rounded clip without any gap area
              // bleeding into the visible region.
              overlay.style.backgroundPosition = "0 " + (-bodyTopInStrip) + "px";
              layer.appendChild(overlay);
            }
          });
        }

        const matchHeight = () => {
          // On desktop the cluster height is matched to the sibling text
          // column; when stacked (mobile) there's no sibling to match, so
          // we just lock to the configured number of whole cards.
          const twoCol = window.matchMedia("(min-width: 901px)").matches;
          const ch = cardHeight();
          const off = offsetRightPx();
          if (ch > 0) {
            // When `showCards` is set, lock each column to exactly that many
            // cards. On desktop, when it isn't set, snap down to the largest
            // whole-card multiple that fits the matched/min height.
            let n;
            if (twoCol && text && text.clientHeight > 0) {
              const h = Math.max(text.clientHeight, minHeight);
              n = showCards > 0
                ? Math.min(showCards, cards || showCards)
                : Math.max(2, Math.floor((h - off) / ch));
            } else {
              // Stacked (mobile): give the columns a real height. Without it
              // the absolutely-positioned strip images leave the grid rows
              // at 0 height and the whole cluster renders blank.
              n = showCards > 0 ? Math.min(showCards, cards || showCards) : (cards || 3);
            }
            const colH = n * ch;
            cols.forEach((c) => (c.style.height = colH + "px"));
            if (twoCol) {
              // Desktop two-column layout adds the masonry offset to the
              // root height; the column drift breathes inside that buffer.
              root.style.height = (colH + off) + "px";
              root.style.alignContent = "";
            } else {
              // Stacked (mobile): reserve a drift buffer above and below the
              // cards (equal to the max column drift) and center the row
              // inside it, so the parallax can still run without the bottom
              // card pushing over the title below. Zero when motion reduced.
              const drift = reduced ? 0 : ch * 0.2;
              root.style.height = (colH + drift * 2) + "px";
              root.style.alignContent = "center";
            }
            root.dataset.matched = "true";
          } else {
            root.style.height = "";
            cols.forEach((c) => (c.style.height = ""));
            root.dataset.matched = "false";
          }
          rebuildCardOverlays();
        };
        matchHeight();
        if (text) {
          const ro = new ResizeObserver(matchHeight);
          ro.observe(text);
        }
        window.addEventListener("resize", matchHeight);
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(matchHeight);
        }

        if (reduced) return;

        let raf = 0;
        const update = () => {
          raf = 0;
          const rect = root.getBoundingClientRect();
          const vh = window.innerHeight || document.documentElement.clientHeight;
          const total = vh + rect.height;
          if (total <= 0) return;
          // 0 when the section's top reaches the bottom of the viewport
          // (just entering), 1 when the section's bottom reaches the top
          // (just leaving).
          const traveled = vh - rect.top;
          const progress = Math.min(Math.max(traveled / total, 0), 1);

          // When `cards` is set: image strips are anchored at the top
          // (left col) or bottom (right col) of their column window so
          // that exactly `showCards` whole cards are visible at all
          // times — no half-card slivers at the edges. The parallax is
          // applied to the WHOLE COLUMN boxes (not the images inside),
          // so the cluster gently drifts past the page as it scrolls
          // through the viewport. Left and right columns drift in
          // opposite directions, so they breathe past each other while
          // both keeping their 3-card composition intact. The pc root
          // wrapper has overflow:visible so this column drift can extend
          // a few px past the section bounds without clipping.
          const ch = cardHeight();
          // Column-box parallax drift runs on both layouts. On the stacked
          // (mobile) layout matchHeight reserves a buffer above/below the
          // cards (and centers the row in it) so a downward drift can't push
          // the bottom card over the title below; mobile also uses a gentler
          // drift magnitude that fits inside that buffer.
          const twoCol = window.matchMedia("(min-width: 901px)").matches;
          cols.forEach((col, i) => {
            const img = imgs[i];
            if (img && ch > 0) {
              const showN = showCards > 0
                ? Math.min(showCards, cards || showCards)
                : Math.max(2, Math.floor(col.clientHeight / ch));
              const totalCards = cards || showN;
              const extraCards = Math.max(totalCards - showN, 0);
              const overflow = extraCards * ch;
              // Left col image anchors at top → shows cards 1..showN.
              // Right col image anchors at bottom → shows the LAST showN
              // cards (e.g. cards extra+1..total). This gives the
              // two-column mosaic a different card mix without ever
              // exposing a half-card.
              const imgY = i === 0 ? 0 : -overflow;
              img.style.transform = `translate3d(0, ${imgY.toFixed(2)}px, 0)`;

              // Column parallax: drift the whole column box up/down by a
              // fraction of one card height as the section travels
              // through the viewport. Left col drifts up, right drifts
              // down, so they slide past each other. Cosine ease so the
              // motion lingers near its midpoint instead of racing
              // edge-to-edge.
              // Desktop drifts a full 0.35 card-height; mobile uses a gentler
              // 0.2 that fits inside the buffer reserved by matchHeight.
              const driftRange = ch * (twoCol ? 0.35 : 0.2);
              const eased = 0.5 - 0.5 * Math.cos(Math.PI * progress);
              const direction = i === 0 ? -1 : 1;
              const colY = (eased - 0.5) * 2 * driftRange * direction;
              col.style.transform = `translate3d(0, ${colY.toFixed(2)}px, 0)`;
              return;
            }
            col.style.transform = "";
            if (!img) return;
            const colH = col.clientHeight;
            const imgH = img.clientHeight;
            const extra = Math.max(imgH - colH, 0);
            const startOffset = i === 1 ? -rightOffset * extra : 0;
            const travel = (1 - rightOffset) * extra * speed;
            const y = startOffset - progress * travel;
            img.style.transform = `translate3d(0, ${y}px, 0)`;
          });
        };

        const onScroll = () => {
          if (!raf) raf = requestAnimationFrame(update);
        };
        // Recompute on image load too — clientHeight is 0 until then,
        // which also means cardHeight() returns 0 and the initial
        // matchHeight() call had no card data to snap against.
        imgs.forEach((img) => {
          if (img && !img.complete) {
            img.addEventListener("load", () => { matchHeight(); update(); }, { once: true });
          }
        });
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
        update();
      });
    }
  })();
</script>

<style>
  .profile-cols {
    position: relative;
    width: 100%;
    max-width: var(--pc-max-w, 360px);
    margin: 0 auto;
    /* Fallback height for initial paint; JS overrides to match the text
       column height once measured. */
    aspect-ratio: var(--pc-aspect, 0.78 / 1);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(10px, 2%, 18px);
    isolation: isolate;
  }
  .profile-cols[data-matched="true"] {
    aspect-ratio: auto;
  }

  .profile-cols__col {
    position: relative;
    border-radius: var(--r-lg);
    /* Column itself stays overflow-visible so a card overlay scaled up
       on hover can extend a few px past the column bounds without being
       clipped. The strip image inside is wrapped in .profile-cols__strip
       which DOES clip — that wrapper carries the rounded corners + clip
       that used to live on the column. */
  }
  /* Masonry stagger: when an offset is set on the root, the left column
     anchors to the top of the section and the right column anchors to
     the bottom — the section's extra height equals the offset, so the
     two columns end up vertically displaced by exactly that amount. */
  .profile-cols[style*="--pc-offset-right"] .profile-cols__col:first-child {
    align-self: start;
  }
  .profile-cols[style*="--pc-offset-right"] .profile-cols__col:last-child {
    align-self: end;
  }

  .profile-cols__strip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
  }
  .profile-cols__strip img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    display: block;
    will-change: transform;
    transform: translate3d(0, 0, 0);
    /* Only the leading transform is JS-driven; this keeps a smooth feel
       while images load before the first scroll handler fires. */
  }

  /* Hover layer: per-card transparent overlays generated in JS once the
     card height is measured. Each overlay shows the same strip clipped
     to its card's slot via background-position, so at rest the overlay
     is visually identical to the underlying strip card. On hover the
     overlay alone scales up, lifting the card above its neighbors.
     Note: the .profile-cols__card rules below use :global() so they
     match the dynamically-injected overlay divs (which don't carry
     Astro's scope attribute). pointer-events on the layer stays the
     default (`auto`) so hover hits the cards inside; the cards cover
     the layer fully, so the layer never intercepts events itself. */
  .profile-cols__cards {
    position: absolute;
    inset: 0;
  }
  :global(.profile-cols__card) {
    position: absolute;
    left: 0;
    width: 100%;
    background-repeat: no-repeat;
    background-color: transparent;
    /* border-radius is set inline by JS to match the source card's
       natural corner radius proportional to the rendered card body
       height, so the overlay's clip aligns with the visible card. */
    /* No cursor:pointer — the cards aren't navigation targets, the
       hover scale is a passive interactive flourish. */
    cursor: default;
    pointer-events: auto;
    transform-origin: 50% 50%;
    will-change: transform;
    transition:
      transform 380ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 380ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.profile-cols__card:hover) {
    transform: scale(1.16);
    box-shadow:
      0 36px 64px -18px rgba(20, 22, 28, 0.34),
      0 14px 24px -10px rgba(20, 22, 28, 0.18);
    z-index: 5;
  }
  /* When a sibling overlay is being hovered, the others slightly recede
     so the lifted card reads cleanly. Subtle, not jarring. */
  :global(.profile-cols__cards:hover .profile-cols__card:not(:hover)) {
    transform: scale(0.985);
    transition:
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-cols__strip img { transform: none !important; }
    :global(.profile-cols__card),
    :global(.profile-cols__cards:hover .profile-cols__card:not(:hover)) {
      transition: none;
      transform: none !important;
    }
  }
  /* Mobile / touch: hover transforms are noisy on touch since the
     "hover" briefly fires on tap. Disable the hover lift below the
     two-column breakpoint so the section feels stable on phone. */
  @media (max-width: 900px) {
    :global(.profile-cols__card:hover) {
      transform: none;
      box-shadow: none;
    }
    :global(.profile-cols__cards:hover .profile-cols__card:not(:hover)) {
      transform: none;
    }
  }
</style>
