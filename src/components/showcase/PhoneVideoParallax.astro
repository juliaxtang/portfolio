---
/**
 * PhoneVideoParallax — looping video inside a phone frame, plus a circular
 * badge in the corner. Both phone and badge ease vertically on scroll so the
 * composition has a gentle parallax as the section passes through the
 * viewport (matches the Tinder block on the original Framer site).
 *
 * The video sits behind the phone-frame PNG. The PNG has a transparent
 * "screen" area, so the video shows through and the purple bezel sits over
 * the top. The video is inset slightly from the container edges so it
 * doesn't bleed into the transparent corners of the PNG.
 */
import Arrow from "../Arrow.astro";

interface Props {
  /** Looping video shown inside the phone screen. */
  videoSrc: string;
  /** Transparent phone-frame PNG that overlays the video. */
  frameSrc: string;
  /** Badge PNG floated in the upper-right corner. */
  badgeSrc: string;
  /** Optional floating "evidence" cell PNG, anchored to the upper-left
   *  of the phone (e.g. a Prompts feature snippet). */
  promptSrc?: string;
  /** Optional floating "evidence" cell PNG, anchored to the lower-right
   *  of the phone (e.g. a Quiz feature snippet). */
  quizSrc?: string;
  /** Optional alt-text-equivalent (used as aria-label on the video). */
  videoLabel?: string;
  badgeAlt?: string;
  promptAlt?: string;
  quizAlt?: string;
  /** How far (in px) the phone translates as the section moves through
   *  the viewport. Positive value = phone drifts upward on scroll. */
  phoneRange?: number;
  /** Badge drift (in px). Same direction as the phone, but a smaller
   *  magnitude so it feels lighter than the device — gives a layered
   *  parallax instead of badge-locked-to-page. */
  badgeRange?: number;
}

const {
  videoSrc,
  frameSrc,
  badgeSrc,
  promptSrc,
  quizSrc,
  videoLabel = "",
  badgeAlt = "",
  promptAlt = "",
  quizAlt = "",
  phoneRange = 120,
  badgeRange = 70,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolve = (p: string) =>
  p.startsWith("http") || p.startsWith(base)
    ? p
    : `${base}${p.startsWith("/") ? "" : "/"}${p}`;

const id = "pvp-" + Math.random().toString(36).slice(2, 9);
---

<div
  class="phone-video"
  id={id}
  data-phone-range={phoneRange}
  data-badge-range={badgeRange}
  data-floating-cell-group
>
  <div class="phone-video__phone">
    <div class="phone-video__screen">
      <video
        class="phone-video__video"
        src={resolve(videoSrc)}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-label={videoLabel}
      />
    </div>
    <img
      class="phone-video__frame"
      src={resolve(frameSrc)}
      alt=""
      aria-hidden="true"
      draggable="false"
      loading="lazy"
    />
  </div>
  <span class="phone-video__badge-wrap" aria-hidden="true">
    <img
      class="phone-video__badge"
      src={resolve(badgeSrc)}
      alt={badgeAlt}
      draggable="false"
      loading="lazy"
    />
  </span>
  {promptSrc && (
    <img
      class="phone-video__cell phone-video__cell--prompt"
      src={resolve(promptSrc)}
      alt={promptAlt}
      draggable="false"
      loading="lazy"
      data-floating-cell
      data-cursor="drag-pill"
      data-anchor-x="left"
      data-anchor-y="top"
    />
  )}
  {quizSrc && (
    <img
      class="phone-video__cell phone-video__cell--quiz"
      src={resolve(quizSrc)}
      alt={quizAlt}
      draggable="false"
      loading="lazy"
      data-floating-cell
      data-cursor="drag-pill"
      data-anchor-x="right"
      data-anchor-y="bottom"
    />
  )}
  {(promptSrc || quizSrc) && (
    <span class="phone-video__drag-hint" aria-hidden="true">
      <span class="phone-video__drag-hint-label">drag to move<br />or click to expand</span>
      <span class="phone-video__drag-hint-arrow" aria-hidden="true"></span>
    </span>
  )}
  {quizSrc && (
    <Arrow
      id={`${id}-drag-arrow`}
      from={`#${id} .phone-video__drag-hint-label`}
      to={`#${id} .phone-video__cell--quiz`}
      fromAnchor="right-center"
      toAnchor="outside-right-center"
      path="curve-drag-phone"
      padding={12}
      fromPadding={22}
      toPadding={12}
      thickness={2.5}
      color="var(--text-tertiary, #6b6b72)"
      persistent
      watchRoot={`#${id}`}
      hideWhen="cell-hover,cell-active,root-class:is-interacted"
      hideBelowWidth={1440}
    />
  )}
</div>

<script is:inline>
  (function () {
    if (typeof window === "undefined") return;
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
    function init() {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) e.target.play().catch(() => {});
          });
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll(".phone-video video").forEach((v) => {
        v.muted = true;
        v.playsInline = true;
        v.play().catch(() => {});
        observer.observe(v);
      });

      // First-interaction flag — once any floating cell receives a
      // pointerdown / click / touchstart, mark the .phone-video root
      // so the "drag to move" hint stays hidden going forward.
      document.querySelectorAll(".phone-video").forEach((root) => {
        function flag() {
          root.classList.add("is-interacted");
        }
        root.querySelectorAll(".phone-video__cell").forEach((cell) => {
          cell.addEventListener("pointerdown", flag, { once: true });
          cell.addEventListener("touchstart", flag, { once: true, passive: true });
          cell.addEventListener("click", flag, { once: true });
        });
      });

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduced) return;
      document.querySelectorAll(".phone-video").forEach((root) => {
        const phoneRange = parseFloat(root.dataset.phoneRange || "60");
        const badgeRange = parseFloat(root.dataset.badgeRange || "30");
        let raf = 0;
        const update = () => {
          raf = 0;
          const rect = root.getBoundingClientRect();
          const vh = window.innerHeight || document.documentElement.clientHeight;
          const total = vh + rect.height;
          if (total <= 0) return;
          const traveled = vh - rect.top;
          const progress = Math.min(Math.max(traveled / total, 0), 1);
          // Map 0..1 to -0.5..+0.5 so the element is at rest mid-passage
          // and drifts symmetrically before/after.
          const centered = progress - 0.5;
          const phoneY = -centered * phoneRange;
          const badgeY = -centered * badgeRange;
          // CSS custom properties so the hover transform can compose with
          // the scroll-driven Y offset without one overwriting the other.
          root.style.setProperty("--phone-y", phoneY.toFixed(1) + "px");
          root.style.setProperty("--badge-y", badgeY.toFixed(1) + "px");
          // Float cells in counter-phase to the phone for an organic feel.
          root.style.setProperty("--prompt-y", (centered * 40).toFixed(1) + "px");
          root.style.setProperty("--quiz-y", (-centered * 55).toFixed(1) + "px");
        };

        const onScroll = () => {
          if (!raf) raf = requestAnimationFrame(update);
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
        update();
      });
    }
  })();
</script>

<style>
  .phone-video {
    position: relative;
    width: 100%;
    /* Small bump over the prior 324px so the App Redesign composition
       reads with a touch more presence next to the showcase copy. */
    max-width: 348px;
    margin: 0 auto;
    /* Reserve room for the (now larger) badge that floats outside the
       phone frame's upper-right. */
    padding-top: clamp(48px, 12%, 88px);
    padding-right: clamp(32px, 8%, 70px);
    isolation: isolate;
    --phone-y: 0px;
    --badge-y: 0px;
    --phone-lift: 0px;
    --phone-scale: 1;
    --phone-tilt: 0deg;
    --badge-spin: 0deg;
    --badge-scale: 1;
    --prompt-y: 0px;
    --quiz-y: 0px;
  }

  .phone-video__phone {
    position: relative;
    width: 100%;
    /* Match the source phone-frame.png aspect ratio (1114 x 2268). */
    aspect-ratio: 1114 / 2268;
    will-change: transform;
    transform: translate3d(0, calc(var(--phone-y) + var(--phone-lift)), 0)
               rotate(var(--phone-tilt))
               scale(var(--phone-scale));
    transform-origin: 50% 60%;
    transition:
      transform 520ms var(--ease-out),
      filter 520ms var(--ease-out);
    cursor: pointer;
  }
  .phone-video:hover .phone-video__phone,
  .phone-video:focus-within .phone-video__phone {
    --phone-lift: -10px;
    --phone-scale: 1.035;
    --phone-tilt: -1.2deg;
  }

  /* The screen sits inside the bezel's transparent inner cutout. Inset
     values measured straight off the source PNG (1114×2268, cutout
     starts at x=50 / y=44): top/bottom 1.94%, left/right 4.49%. The
     rounded corners match the cutout's 150px corner radius. The frame
     image overlays on top, so the visible video edge ends up flush
     with the inside of the bezel. */
  .phone-video__screen {
    position: absolute;
    top: 1.94%;
    bottom: 1.94%;
    left: 4.49%;
    right: 4.49%;
    overflow: hidden;
    border-radius: 13.46% / 6.61%;
    background: #000;
    z-index: 0;
  }

  .phone-video__video {
    width: 100%;
    height: 100%;
    object-fit: fill;
    display: block;
  }

  .phone-video__frame {
    position: absolute;
    /* Frame is rendered ~2px shorter (height only, same width). The
       trim comes off the TOP — the bezel slides down a couple px so
       its inner edge no longer leaves a sliver above the video. */
    inset: 2px 0 0 0;
    width: 100%;
    height: calc(100% - 2px);
    object-fit: fill;
    pointer-events: none;
    z-index: 1;
    /* Subtle soft shadow so the device sits on the page. */
    filter: drop-shadow(0 18px 30px rgba(60, 30, 120, 0.18));
  }

  .phone-video__badge-wrap {
    position: absolute;
    top: clamp(20px, 5%, 44px);
    right: 0;
    width: clamp(128px, 37%, 190px);
    height: auto;
    z-index: 2;
    display: block;
    pointer-events: none;
  }
  .phone-video__badge-wrap .phone-video__badge {
    position: static;
    top: auto;
    right: auto;
    width: 100%;
  }

  .phone-video__badge {
    position: absolute;
    /* Dropped down a bit so it overlaps the phone's upper-right edge
       instead of floating in space above it. */
    top: clamp(20px, 5%, 44px);
    right: 0;
    /* +10% from the previous size. */
    width: clamp(128px, 37%, 190px);
    height: auto;
    z-index: 2;
    border-radius: 50%;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
    will-change: transform;
    transform: translate3d(0, var(--badge-y), 0)
               rotate(var(--badge-spin))
               scale(var(--badge-scale));
    transition:
      transform 620ms var(--ease-out),
      box-shadow 620ms var(--ease-out);
  }
  .phone-video:hover .phone-video__badge,
  .phone-video:focus-within .phone-video__badge {
    /* Spin opposite to the phone's -1.2deg tilt for a wind-up feel. */
    --badge-spin: 10deg;
    --badge-scale: 1.08;
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.28);
  }

  .phone-video__cell {
    position: absolute;
    height: auto;
    z-index: 2;
    /* Rounded edges clip the source asset so each cell reads as its own
       card regardless of whether the PNG has its own corner rounding. */
    border-radius: 18px;
    /* Drop-shadow follows the rounded edges. */
    filter: drop-shadow(0 18px 36px rgba(60, 30, 120, 0.18))
            drop-shadow(0 4px 10px rgba(60, 30, 120, 0.10));
    will-change: transform;
    transition: var(--drag-transition,
                  transform 620ms var(--ease-out)),
                filter 620ms var(--ease-out);
    pointer-events: auto;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-drag: none;
  }
  .phone-video__cell.is-grabbing { cursor: grabbing; }
  .phone-video__cell--prompt {
    /* Tucked into the phone's upper-left corner: card's right edge sits
       inside the phone's left edge so the prompt reads as a Tinder
       comment bubble sticking out of the profile's edge. The desktop
       leftward bleed (-140 to -200px) only fits when the Showcase has a
       wide gutter between the text and phone columns — at narrow desktop
       widths a separate media query below repositions the cell. */
    top: clamp(10px, 4%, 50px);
    left: clamp(-110px, -30%, -70px);
    width: clamp(200px, 64%, 270px);
    --rot: -5deg;
    transform: translate3d(var(--drag-x, 0px),
                           calc(var(--prompt-y) + var(--drag-y, 0px)),
                           0)
               rotate(var(--rot));
  }
  .phone-video__cell--quiz {
    /* Anchored lower-right, mostly outside the phone's right edge. The
       narrow-desktop media query below tightens this so the quiz never
       overflows the viewport at typical laptop widths (1024-1280px). */
    bottom: clamp(50px, 12%, 110px);
    right: clamp(-100px, -26%, -60px);
    width: clamp(220px, 68%, 290px);
    --rot: 6deg;
    transform: translate3d(var(--drag-x, 0px),
                           calc(var(--quiz-y) + var(--drag-y, 0px)),
                           0)
               rotate(var(--rot));
  }

  /* Focused (click-to-zoom) state: width inflates so the source PNG
     re-rasters at the larger size (avoids GPU-upscaling blur from
     transform: scale). Transform stays at scale 1; rotateX / rotateY
     drive the 3D parallax tilt on mouse-move. */
  .phone-video__cell.is-focused {
    /* !important here guarantees the focused state wins against the
       per-modifier rules (.phone-video__cell--prompt / --quiz) AND
       lets CSS transition animate width/transform on both enter and
       exit (when the class is added or removed). Without it the
       global `img { max-width: 100% }` clamps the width and the cell
       can't grow past its container's max-width. */
    width: var(--focus-width, 100%) !important;
    max-width: none !important;
    max-height: none !important;
    transform: perspective(1200px)
               translate3d(var(--focus-dx, 0px), var(--focus-dy, 0px), 0)
               rotateX(var(--tilt-x, 0deg))
               rotateY(var(--tilt-y, 0deg)) !important;
    transform-style: flat;
    backface-visibility: hidden;
    transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1),
                width 520ms cubic-bezier(0.22, 1, 0.36, 1),
                filter 520ms var(--ease-out);
    z-index: 50;
    filter: drop-shadow(0 22px 44px rgba(20, 16, 40, 0.18))
            drop-shadow(0 4px 10px rgba(20, 16, 40, 0.10));
    cursor: zoom-out;
  }
  /* During active tilt, fast linear transition for real-time tracking. */
  .phone-video__cell.is-tilting {
    transition: transform 80ms linear,
                filter 520ms var(--ease-out) !important;
  }

  /* Narrow desktop / tablet (721–1440px): preserve the reference layout
     where the prompt card hugs the phone's upper-left (mostly outside the
     phone but with its bottom-right corner overlapping the screen) and the
     quiz card hugs the lower-right (mostly outside, with its top-left
     corner overlapping the screen). Bleed values are tightened versus the
     wide-desktop variant so the cards stay within the (narrower) gutter
     without clipping at the viewport edges. */
  @media (max-width: 1440px) and (min-width: 721px) {
    .phone-video {
      padding-top: clamp(56px, 9vw, 100px);
      padding-bottom: clamp(40px, 7vw, 80px);
      padding-right: clamp(28px, 6%, 60px);
    }
    .phone-video__cell--prompt {
      top: clamp(-28px, -6%, -8px);
      left: clamp(-70px, -18%, -32px);
      width: clamp(190px, 58%, 240px);
      --rot: -5deg;
    }
    .phone-video__cell--quiz {
      bottom: clamp(-40px, -8%, -16px);
      right: clamp(-70px, -18%, -36px);
      width: clamp(190px, 58%, 240px);
      --rot: 6deg;
    }
  }

  /* Mobile (≤720px): same overlap pattern as the desktop reference. Cells
     hug the phone's upper-left / lower-right corners with their majority
     outside the phone but a meaningful corner crossing onto the screen.
     Padding-top/bottom are tightened versus the prior "above/below" rule
     so the cell's negative `top`/`bottom` lands close to the phone edge
     and yields actual overlap (a deep padding pushes the cell fully off
     the phone). Container `top` is the reference for the cell's
     `top: <neg>`, so we keep padding small enough that prompt.bottom
     crosses phone.top instead of falling above it. */
  @media (max-width: 720px) {
    .phone-video {
      padding-top: clamp(36px, 10vw, 88px);
      padding-bottom: clamp(32px, 8vw, 72px);
      padding-right: clamp(16px, 5%, 44px);
    }
    .phone-video__cell--prompt {
      top: clamp(-20px, -2vw, -4px);
      left: clamp(-40px, -10%, -12px);
      width: clamp(165px, 56%, 215px);
      --rot: -5deg;
    }
    .phone-video__cell--quiz {
      bottom: clamp(-24px, -2.5vw, -8px);
      right: clamp(-40px, -10%, -12px);
      width: clamp(170px, 58%, 220px);
      --rot: 6deg;
    }
  }

  /* Small viewports: shrink the phone so the project copy stays visible in
     one screen, and pull the bleeds inward proportionally so the cards
     don't clip against the viewport edge. The overlap pattern (corner
     crossing onto the phone, majority outside) is preserved. */
  @media (max-width: 520px) {
    .phone-video { max-width: min(348px, 80%); }
    .phone-video__badge-wrap,
    .phone-video__badge {
      width: clamp(82px, 38%, 150px);
    }
    .phone-video__cell--prompt {
      top: clamp(-10px, -1vw, 4px);
      left: -8%;
      width: clamp(150px, 60%, 200px);
    }
    .phone-video__cell--quiz {
      bottom: clamp(-14px, -1.5vw, 2px);
      right: -8%;
      width: clamp(150px, 60%, 200px);
    }
  }
  @media (max-width: 380px) {
    .phone-video { max-width: min(348px, 80%); }
    .phone-video__cell--prompt {
      left: -6%;
      width: clamp(140px, 56%, 180px);
    }
    .phone-video__cell--quiz {
      right: -6%;
      width: clamp(140px, 56%, 180px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phone-video__phone,
    .phone-video__badge,
    .phone-video__cell {
      transform: none !important;
      transition: none !important;
    }
    .phone-video:hover .phone-video__phone,
    .phone-video:hover .phone-video__badge,
    .phone-video:hover .phone-video__cell {
      transform: none !important;
    }
  }

  /* "drag to move" affordance — uses the purpose-made drag-to-move.png
     curved arrow on the right of the phone, with the label nestled in
     the arrow's upper-right curve. Fades out while a cell is hovered
     and permanently hides via .is-interacted after first interaction. */
  .phone-video__drag-hint {
    position: absolute;
    top: calc(32% + 60px);
    right: -232px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    pointer-events: none;
    color: var(--text-tertiary, #6b6b72);
    z-index: 3;
    transition: opacity 220ms var(--ease-out, ease-out);
  }
  .phone-video__drag-hint-label {
    font-family: var(--font-hand);
    font-size: 24px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-align: left;
    color: var(--text-secondary, #5A5D66);
    white-space: nowrap;
  }
  /* Invisible sizing box — same footprint as the old drag-to-move.png so
     the SVG tail lands where the raster arrow used to start. */
  .phone-video__drag-hint-arrow {
    display: block;
    width: 80px;
    aspect-ratio: 1 / 1.1;
    flex-shrink: 0;
    opacity: 0;
    pointer-events: none;
    transform: translate(-20px, 52px) rotate(25deg) scaleX(-1);
    transform-origin: 50% 50%;
  }
  /* Hide while hovering any floating cell — the cursor pill replaces it. */
  .phone-video:has(.phone-video__cell:hover) .phone-video__drag-hint,
  .phone-video:has(.phone-video__cell.is-grabbing) .phone-video__drag-hint,
  .phone-video:has(.phone-video__cell.is-focused) .phone-video__drag-hint {
    opacity: 0;
  }
  /* Permanent hide after first interaction (set in JS via .is-interacted). */
  .phone-video.is-interacted .phone-video__drag-hint {
    opacity: 0;
    pointer-events: none;
  }
  /* Narrow desktop / tablet (721–1440px): the desktop side-text variant
     sits at right: -232px outside the phone container and would clip
     against the body's overflow-x: clip. Fall back to a compact pill
     positioned just below the phone. Hide the invisible arrow sizing box
     so the pill sizes to its label content instead of the 80px arrow
     footprint, and hide the curved SVG arrow at the same breakpoint via
     the Arrow component's hideBelowWidth={1440}. */
  @media (max-width: 1440px) and (min-width: 721px) {
    .phone-video__drag-hint {
      left: 50%;
      top: auto;
      bottom: -36px;
      right: auto;
      transform: translateX(-50%);
      width: max-content;
      max-width: calc(100% - var(--s-4));
      flex-direction: row;
      align-items: center;
      gap: 0;
      background: rgba(255, 255, 255, 0.72);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid rgba(20, 22, 28, 0.08);
      border-radius: 999px;
      padding: 7px 14px;
      color: var(--text-secondary, #2a2a2f);
      box-shadow: 0 8px 18px rgba(20, 22, 28, 0.08);
    }
    .phone-video__drag-hint-label {
      font-family: var(--font-mono, inherit);
      font-size: 0;
      line-height: 1;
      white-space: nowrap;
      letter-spacing: 0.04em;
    }
    .phone-video__drag-hint-label::before {
      content: "↕ drag cards to move, click to expand";
      font-size: 11px;
    }
    /* Pill mode hides the invisible 80px sizing box that the arrow uses
       in desktop mode — without this the pill stretches to label + 80px
       rather than fitting its content. */
    .phone-video__drag-hint-arrow {
      display: none;
    }
  }

  /* Stacked layout (≤900px, still above the mobile cutoff): the showcase
     column collapses so the phone sits stacked above the text. Pill moves
     above the phone so it doesn't collide with the copy that now flows
     directly underneath. */
  @media (max-width: 900px) and (min-width: 721px) {
    .phone-video__drag-hint {
      top: -36px;
      bottom: auto;
    }
  }
  /* Touch / mobile (≤ 720px): no drag affordance at all — cells are tap
     to focus and the pill / arrow would only add clutter. */
  @media (max-width: 720px) {
    .phone-video__drag-hint { display: none !important; }
  }
</style>
