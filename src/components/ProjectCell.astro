---
/**
 * ProjectCell — one tile in the home grid (horizontal layout).
 *
 * Image on the left, body on the right. All cards in the grid get the same
 * height regardless of how much subtitle text each one has, because the
 * media is a fixed-aspect block and the body uses flex with margin-auto on
 * the tag row.
 *
 * Destination shapes (one of):
 *   - `slug`         full /product-design/<slug> case study
 *   - `embedSlug`    internal page that embeds a Figma deck
 *   - `externalUrl`  external article (opens in new tab)
 *   - (none)         placeholder mode: non-clickable, "Coming soon" badge.
 */
interface Props {
  title: string;
  subtitle: string;
  cover?: string;
  alt?: string;
  tags?: string[];
  slug?: string;
  embedSlug?: string;
  externalUrl?: string;
  badge?: string;
}

const {
  title,
  subtitle,
  cover,
  alt,
  tags = [],
  slug,
  embedSlug,
  externalUrl,
  badge,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const hasDestination = !!(slug || embedSlug || externalUrl);

let href: string | undefined;
let isExternal = false;
if (slug) href = `${base}/product-design/${slug}`;
else if (embedSlug) href = `${base}/product-design/${embedSlug}`;
else if (externalUrl) {
  href = externalUrl;
  isExternal = true;
}

// Prepend the configured base so absolute /projects/... paths resolve under
// the site's GitHub Pages base path.
const resolvedCover = cover && (cover.startsWith("http") || cover.startsWith(base)
  ? cover
  : `${base}${cover.startsWith("/") ? "" : "/"}${cover}`);

const finalBadge = badge ?? (!hasDestination ? "Coming soon" : undefined);
const cellClass = `cell ${hasDestination ? "" : "cell--placeholder"}`.trim();
const linkAttrs = isExternal
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
---

{hasDestination ? (
  <a class={cellClass} href={href} {...linkAttrs} aria-label={`${title}: ${subtitle}`}>
    <div class="cell__media">
      {resolvedCover ? <img src={resolvedCover} alt={alt ?? ""} loading="lazy" /> : <div class="cell__placeholder" />}
      {finalBadge && <span class="cell__badge">{finalBadge}</span>}
    </div>
    <div class="cell__body">
      <div class="cell__head">
        <h3 class="cell__title">
          {title}
          <span class="cell__arrow" aria-hidden="true">→</span>
        </h3>
        <p class="cell__subtitle">{subtitle}</p>
      </div>
      {tags.length > 0 && (
        <ul class="cell__tags">
          {tags.map((t) => <li>{t}</li>)}
        </ul>
      )}
    </div>
  </a>
) : (
  <div class={cellClass} aria-label={`${title}: ${subtitle}`}>
    <div class="cell__media">
      {resolvedCover ? <img src={resolvedCover} alt={alt ?? ""} loading="lazy" /> : <div class="cell__placeholder" />}
      {finalBadge && <span class="cell__badge cell__badge--coming">{finalBadge}</span>}
    </div>
    <div class="cell__body">
      <div class="cell__head">
        <h3 class="cell__title">{title}</h3>
        <p class="cell__subtitle">{subtitle}</p>
      </div>
      {tags.length > 0 && (
        <ul class="cell__tags">
          {tags.map((t) => <li>{t}</li>)}
        </ul>
      )}
    </div>
  </div>
)}

<style>
  .cell {
    display: grid;
    /* Horizontal layout: image left, body right. */
    grid-template-columns: minmax(220px, 38%) 1fr;
    gap: var(--s-5);
    padding: var(--s-4);
    border-radius: var(--r-lg);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    transition: transform var(--dur-normal) var(--ease-out),
                box-shadow var(--dur-normal) var(--ease-out),
                border-color var(--dur-normal) var(--ease-out);
    color: var(--text-primary);
    text-decoration: none;
    will-change: transform;
  }
  a.cell:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--brand-primary-2);
  }

  .cell--placeholder {
    cursor: default;
    border-style: dashed;
  }

  .cell__media {
    position: relative;
    border-radius: var(--r-md);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--brand-aurora);
  }
  .cell__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  a.cell:hover .cell__media img { transform: scale(1.03); }

  .cell__placeholder {
    width: 100%;
    height: 100%;
    background: var(--brand-gradient-soft);
  }

  .cell__badge {
    position: absolute;
    top: var(--s-3);
    right: var(--s-3);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-primary);
    background: rgba(253, 252, 250, 0.92);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-full);
    border: 1px solid var(--border-subtle);
  }
  .cell__badge--coming {
    color: var(--text-secondary);
    background: rgba(253, 252, 250, 0.85);
  }

  /* Body fills its column with flex so the tag row hugs the bottom and the
     card height stays uniform regardless of subtitle length. */
  .cell__body {
    display: flex;
    flex-direction: column;
    padding: var(--s-3) var(--s-4) var(--s-3) 0;
    min-width: 0;
  }
  .cell__head { display: flex; flex-direction: column; gap: var(--s-2); }

  .cell__title {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.018em;
    line-height: 1.2;
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
  }
  .cell__arrow {
    display: inline-block;
    font-size: 18px;
    color: var(--text-tertiary);
    transition: transform var(--dur-normal) var(--ease-out),
                color var(--dur-normal) var(--ease-out);
  }
  a.cell:hover .cell__arrow {
    transform: translateX(4px);
    color: var(--text-primary);
  }

  .cell__subtitle {
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
  }

  .cell__tags {
    list-style: none;
    margin: var(--s-5) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    /* Push to the bottom of the body column so card heights match. */
    margin-top: auto;
    padding-top: var(--s-4);
  }
  .cell__tags li {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    background: var(--brand-wash-soft);
    padding: var(--s-1) var(--s-3);
    border-radius: var(--r-full);
  }

  /* Mobile: stack image on top, body below. */
  @media (max-width: 720px) {
    .cell {
      grid-template-columns: 1fr;
      gap: var(--s-4);
    }
    .cell__body {
      padding: 0 var(--s-2) var(--s-2);
    }
  }
</style>
