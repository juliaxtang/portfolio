---
/**
 * MobileGamesLandscape: case-study-specific diagram visualizing where Snap
 * sat in the mobile games market when the Going Big with Games strategy
 * work started, and where the industry was actually moving. Recreated from
 * the deck slide rather than dropped in as a screenshot so the type, color,
 * and rhythm align with the rest of the case study.
 *
 * Read order (top to bottom):
 *   1. Axis up top. Inward-converging arrows at the ends of the line. Three
 *      pins below: category name leads (Hyper-casual / Hybrid-casual /
 *      Mid-core), with the strategic position underneath (We're here /
 *      Sweet spot / Out of reach). The middle pin uses the italic display
 *      serif so the strategic answer still dominates the read.
 *   2. Three evidence cards floating directly on the page background (no
 *      sunken outer panel, no inner media-well backdrop). Cards stay equal
 *      width and height so the row aligns cleanly.
 *   3. Per-card trait micro-grid: same three dimensions in the same order
 *      across all cards (Retention / Monetization / Build cost).
 *
 * Interactivity: hover any card to lift it and gently zoom its media. The
 * diagram's job is side-by-side comparison, so no click-to-focus dimming.
 *
 * No props: the diagram IS the content for this case study. If a future
 * case study needs a similar spectrum, fork this file.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const img = (p: string) => `${base}${p}`;

interface ZoneTrait {
  label: string;
  value: string;
}
interface Zone {
  variant: "current" | "target" | "out";
  name: string;
  position: string;
  positionStyle: "eyebrow" | "serif";
  game: string;
  meta: string;
  traits: ZoneTrait[];
}

const zones: Zone[] = [
  {
    variant: "current",
    name: "Hyper-casual",
    position: "We're here",
    positionStyle: "eyebrow",
    game: "Helix Jump",
    meta: "800M downloads",
    traits: [
      { label: "Retention", value: "Low, one and done" },
      { label: "Monetization", value: "Hard, just 0.4% of US gaming revenue" },
      { label: "Build cost", value: "Cheap, fast" },
    ],
  },
  {
    variant: "target",
    name: "Hybrid-casual",
    position: "Sweet spot",
    positionStyle: "serif",
    game: "Merge Mansion",
    meta: "60M downloads · $600M lifetime revenue",
    traits: [
      { label: "Retention", value: "High, growing 30%+ YoY" },
      { label: "Monetization", value: "Meta systems unlock IAP and ads" },
      { label: "Build cost", value: "Moderate" },
    ],
  },
  {
    variant: "out",
    name: "Mid-core / core",
    position: "Out of reach",
    positionStyle: "eyebrow",
    game: "Genshin Impact · Call of Duty Mobile",
    meta: "Top-grossing AAA mobile titles",
    traits: [
      { label: "Retention", value: "Highest, narrow audience" },
      { label: "Monetization", value: "Strong IAP, high UA cost" },
      { label: "Build cost", value: "AAA-scale builds, beyond Snap's scope" },
    ],
  },
];
---

<figure class="mgl">
  <div class="mgl__axis" aria-hidden="true">
    <div class="mgl__axis-line">
      <span class="mgl__axis-arrow mgl__axis-arrow--left"></span>
      <span class="mgl__axis-arrow mgl__axis-arrow--right"></span>
    </div>
    <div class="mgl__axis-pins">
      {zones.map((z) => (
        <span class={`mgl__axis-pin mgl__axis-pin--${z.variant}`}>
          <span class="mgl__axis-pin-name">{z.name}</span>
          {z.positionStyle === "serif" ? (
            <em class="mgl__axis-pin-sweet">{z.position}</em>
          ) : (
            <span class="mgl__axis-pin-position">{z.position}</span>
          )}
        </span>
      ))}
    </div>
  </div>

  <div class="mgl__zones">
    {zones.map((z, i) => (
      <div class={`mgl__zone mgl__zone--${z.variant}`} data-zone-idx={i}>
        <div class="mgl__media">
          {z.variant === "current" && (
            <img
              src={img("/projects/snapchat-games/helix-jump.gif")}
              alt="Helix Jump, a representative hyper-casual mobile game"
              loading="lazy"
            />
          )}
          {z.variant === "target" && (
            <img
              src={img("/projects/snapchat-games/merge-mansion1.png")}
              alt="Merge Mansion, a hybrid-casual mobile game blending merge puzzle mechanics with mansion-renovation progression"
              loading="lazy"
            />
          )}
          {z.variant === "out" && (
            <div class="mgl__media-diptych">
              <img
                src={img("/projects/snapchat-games/genshin-impact.png")}
                alt="Genshin Impact gameplay"
                loading="lazy"
              />
              <img
                src={img("/projects/snapchat-games/callofduty-mobile.png")}
                alt="Call of Duty Mobile gameplay"
                loading="lazy"
              />
            </div>
          )}
        </div>
        <p class="mgl__game">{z.game}</p>
        <p class="mgl__game-meta">{z.meta}</p>
        <dl class="mgl__traits">
          {z.traits.map((t) => (
            <div class="mgl__trait">
              <dt class="mgl__trait-label">{t.label}</dt>
              <dd class="mgl__trait-value">{t.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    ))}
  </div>
</figure>

<style>
  .mgl {
    margin: var(--s-10) auto;
    /* Slightly narrower than the case study's full content max so all three
       cards fit on the page at a glance without needing to scan side to
       side. */
    width: min(100%, 1040px);
    display: grid;
    gap: var(--s-8);
  }

  /* Axis on top. Line spans the full diagram width; arrows sit at the
     literal ends and point inward. */
  .mgl__axis {
    display: grid;
    gap: var(--s-5);
  }
  .mgl__axis-line {
    height: 2px;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--text-primary) 12%, transparent) 0%,
      color-mix(in srgb, var(--brand-secondary-2) 70%, transparent) 50%,
      color-mix(in srgb, var(--text-primary) 12%, transparent) 100%
    );
    border-radius: 2px;
    position: relative;
  }
  /* Arrow color matches the axis line gradient at its respective end. Both
     ends of the line use the same 12% text-primary mix, so both arrows
     pull the same value: the arrowhead and the line literally share a
     stroke color where they meet. */
  .mgl__axis-arrow {
    position: absolute;
    top: 50%;
    width: 10px;
    height: 10px;
    border-top: 1.75px solid color-mix(in srgb, var(--text-primary) 12%, transparent);
    border-right: 1.75px solid color-mix(in srgb, var(--text-primary) 12%, transparent);
  }
  .mgl__axis-arrow--left {
    left: 0;
    transform: translateY(-50%) rotate(-135deg);
  }
  .mgl__axis-arrow--right {
    right: 0;
    transform: translateY(-50%) rotate(45deg);
  }

  .mgl__axis-pins {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--s-5);
    align-items: start;
  }
  .mgl__axis-pin {
    display: grid;
    gap: var(--s-1);
    justify-items: center;
    text-align: center;
    font-family: var(--font-sans);
  }
  /* Category name leads the read. */
  .mgl__axis-pin-name {
    font-size: clamp(15px, 1.25vw, 18px);
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.005em;
    line-height: 1.2;
  }
  /* Strategic-position clarification below the category name. */
  .mgl__axis-pin-position {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    margin-top: 2px;
  }
  /* Middle pin uses italic display serif so the answer still dominates,
     even though "Hybrid-casual" leads. */
  .mgl__axis-pin-sweet {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(20px, 1.9vw, 26px);
    font-weight: 400;
    line-height: 1;
    color: var(--text-primary);
    margin-top: 2px;
  }
  .mgl__axis-pin--out .mgl__axis-pin-position { color: var(--text-tertiary); }

  /* Three equal-width cards floating on the page background, no outer
     panel. Cards align to the top: if one card's traits wrap to more
     lines than another's, the cards naturally end at different heights
     rather than introducing a gap between meta and traits to fake parity. */
  .mgl__zones {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-5);
    align-items: start;
  }
  .mgl__zone {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-5);
    border-radius: var(--r-md);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    position: relative;
    transition:
      transform var(--dur-normal, 240ms) var(--ease-out, ease),
      box-shadow var(--dur-normal, 240ms) var(--ease-out, ease);
  }
  .mgl__zone--current {
    border-color: color-mix(in srgb, var(--brand-primary) 65%, var(--border-default));
    background: color-mix(in srgb, var(--brand-primary) 14%, var(--bg-surface));
  }
  .mgl__zone--target {
    background: color-mix(in srgb, var(--brand-secondary) 26%, var(--bg-surface));
    border-color: color-mix(in srgb, var(--brand-secondary-2) 70%, var(--border-default));
    box-shadow: var(--shadow-md);
  }
  .mgl__zone--out {
    opacity: 0.82;
  }

  /* Hover: subtle lift on the card you're pointing at. */
  .mgl__zone:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .mgl__zone--target:hover {
    box-shadow: var(--shadow-lg);
  }

  @media (prefers-reduced-motion: reduce) {
    .mgl__zone,
    .mgl__zone:hover {
      transition: none;
      transform: none;
    }
  }

  /* Uniform portrait media region. No backdrop / no border / no padding so
     the image sits directly on the card surface, not in a box inside a box.
     Aspect-ratio still locks heights across the row. */
  .mgl__media {
    aspect-ratio: 3 / 4;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* Single-image cells (hyper-casual, hybrid-casual): the rounding lives on
     the image itself so the corners are visible against the card surface,
     not on a container that the contained image doesn't reach. */
  .mgl__media > img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    display: block;
    object-fit: contain;
    border-radius: 24px;
    transition: transform var(--dur-slow, 360ms) var(--ease-out, ease);
  }
  .mgl__zone:hover .mgl__media > img {
    transform: scale(1.03);
  }
  /* Diptych: two landscape screenshots stacked 50/50 in the same well so
     the mid-core card still shows Genshin and Call of Duty Mobile. Each
     image gets its own 24px rounding, the container has no rounding. */
  .mgl__media-diptych {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: var(--s-2);
    width: 100%;
    height: 100%;
  }
  /* Cover (not contain) so each landscape screenshot fills its half of the
     diptych and the 24px corners actually meet image content. With contain
     these letterbox horizontally inside a portrait slot, and the rounded
     corners end up wrapping empty space. */
  .mgl__media-diptych img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 24px;
    transition: transform var(--dur-slow, 360ms) var(--ease-out, ease);
  }
  .mgl__zone:hover .mgl__media-diptych img {
    transform: scale(1.03);
  }

  .mgl__game {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.005em;
  }
  .mgl__game-meta {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
    color: var(--text-tertiary);
    margin: 0;
    line-height: 1.4;
    letter-spacing: 0;
    /* Reserve two lines of vertical space so single-line metas (cells 1, 2)
       sit at the same height as the wrapping meta in cell 3. Without this,
       cards are equal height via the 1fr trait row, which collapses the
       gap on cell 3 only and creates uneven whitespace across the row. */
    min-height: 2.8em;
  }

  /* Per-card trait grid: dimension label left, value right. Same three
     dimensions, same order across all cards. */
  .mgl__traits {
    margin: var(--s-2) 0 0;
    padding: var(--s-3) 0 0;
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 8%, transparent);
    display: grid;
    gap: var(--s-2);
  }
  .mgl__trait {
    display: grid;
    grid-template-columns: 84px 1fr;
    gap: var(--s-3);
    align-items: baseline;
  }
  .mgl__trait-label {
    margin: 0;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    line-height: 1.4;
  }
  .mgl__trait-value {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
    color: var(--text-secondary);
  }
  .mgl__zone--target .mgl__trait-value {
    color: var(--text-primary);
    font-weight: 500;
  }
  .mgl__zone--out .mgl__trait-value {
    color: var(--text-tertiary);
  }

  @media (max-width: 860px) {
    .mgl__zones,
    .mgl__axis-pins {
      grid-template-columns: 1fr;
      gap: var(--s-4);
    }
    .mgl__axis-line { display: none; }
    .mgl__axis-pin { justify-items: start; text-align: left; }
    .mgl__zone--target { order: -1; }
    .mgl__trait { grid-template-columns: 96px 1fr; }
    /* On mobile, focus state without scale (avoid layout shift inside a
       narrow column). */
  }
</style>
