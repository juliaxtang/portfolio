---
/**
 * HeroTwoPhones — two floating phone images for case-study heroes.
 *
 * Phone 2 sits slightly higher and behind. Phone 1 is slightly lower,
 * overlaps phone 2 from the left, and sits in front. Both shift upward
 * on scroll with a subtle depth difference.
 */
interface Props {
  phone1: string;
  phone2: string;
  alt1?: string;
  alt2?: string;
}
const { phone1, phone2, alt1 = "", alt2 = "" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolve = (p: string) =>
  p.startsWith("http") || p.startsWith(base) ? p : `${base}${p.startsWith("/") ? "" : "/"}${p}`;
const id = "htp-" + Math.random().toString(36).slice(2, 8);
---

<div class="htp" id={id} aria-hidden="true">
  <img class="htp__phone htp__phone--2" src={resolve(phone2)} alt={alt2} draggable="false" />
  <img class="htp__phone htp__phone--1" src={resolve(phone1)} alt={alt1} draggable="false" />
</div>

<script is:inline>
  (function () {
    if (typeof window === "undefined") return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    function init() {
      document.querySelectorAll(".htp").forEach(function (root) {
        const phones = root.querySelectorAll(".htp__phone");
        let raf = 0;
        function update() {
          raf = 0;
          const hero = root.closest(".cs-hero");
          if (!hero) return;
          const rect = hero.getBoundingClientRect();
          const vh = window.innerHeight || document.documentElement.clientHeight;
          const total = vh + rect.height;
          if (total <= 0) return;
          // centered: 0 at mid-passage, -0.5 entering, +0.5 exiting — symmetric drift
          const centered = (vh - rect.top) / total - 0.5;
          phones.forEach(function (phone) {
            const range = phone.classList.contains("htp__phone--1") ? 100 : 70;
            const y = -centered * range;
            phone.style.transform = "translate3d(0," + y + "px,0)";
          });
        }
        window.addEventListener("scroll", function () {
          if (!raf) raf = requestAnimationFrame(update);
        }, { passive: true });
        window.addEventListener("resize", update);
        update();
      });
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
  })();
</script>

<style>
  .htp {
    position: relative;
    width: 100%;
    height: 100%;
    /* let phones overflow the hero top edge for the floating look */
    overflow: visible;
    pointer-events: none;
  }

  .htp__phone {
    position: absolute;
    bottom: 0;
    width: 46%;
    height: auto;
    display: block;
    object-fit: contain;
    will-change: transform;
    filter: drop-shadow(0 32px 64px rgba(0,0,0,0.22));
    transform-origin: bottom center;
    transition: filter 0.3s;
  }

  /* Phone 2: right side, raised, behind */
  .htp__phone--2 {
    right: 4%;
    bottom: 6%;
    z-index: 1;
  }

  /* Phone 1: left of phone 2, lower, in front, slight overlap */
  .htp__phone--1 {
    left: 6%;
    bottom: 0;
    z-index: 2;
  }
</style>
