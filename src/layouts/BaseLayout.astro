---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import SideRail from "../components/SideRail.astro";
import Footer from "../components/Footer.astro";
import CursorAurora from "../components/CursorAurora.astro";
import CustomCursor from "../components/CustomCursor.astro";
import SiteGate from "../components/SiteGate.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const siteName = "Julia Tang | Product Designer";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const desc =
  description ??
  "Staff Product Designer at Snapchat. Visual storytelling, motion, and UX for delightful product experiences.";
const ogImageUrl = new URL(ogImage ?? "/favicon.png", Astro.site).toString();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />

    <!-- OG / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).toString()} />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Phosphor Icons (free, MIT) — single source of truth for glyphs.
         Mirrors style-guide.html so prod and the spec stay in lock-step. -->
    <script src="https://unpkg.com/@phosphor-icons/web@2.1.1" is:inline></script>
    <ClientRouter />
  </head>
  <body>
    <CursorAurora />
    <Header />
    <SideRail />
    <main>
      <slot />
    </main>
    <Footer />
    <SiteGate />
    <CustomCursor />

    <!-- Fade-in observer. Re-run after every ClientRouter view transition
         (astro:page-load fires on initial load AND after each swap) so
         .fade-in elements on the next page get observed too. Without
         this, soft-navigating between routes (e.g. / -> /about) left
         every wrapped block stuck at opacity: 0 and the page rendered
         blank. A setTimeout safety net forcibly reveals anything still
         hidden after 1.2s, so a view-transition hiccup can never strand
         a page invisible. -->
    <script is:inline>
      function revealAllFadeIns() {
        var els = document.querySelectorAll(".fade-in:not(.is-visible)");
        els.forEach(function (el) { el.classList.add("is-visible"); });
      }
      function initFadeInObserver() {
        if (typeof window === "undefined") return;
        var els = document.querySelectorAll(".fade-in:not(.is-visible)");
        if (!els.length) return;
        if (!("IntersectionObserver" in window)) {
          revealAllFadeIns();
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15 }
        );
        els.forEach(function (el) { io.observe(el); });
        setTimeout(revealAllFadeIns, 1200);
      }
      document.addEventListener("astro:page-load", initFadeInObserver);
      if (document.readyState !== "loading") initFadeInObserver();
      else document.addEventListener("DOMContentLoaded", initFadeInObserver);
    </script>
  </body>
</html>
