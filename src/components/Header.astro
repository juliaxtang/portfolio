---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const links = [
  { href: `${base}/`, label: "Work" },
  { href: `${base}/about`, label: "About" },
  { href: `${base}/resume.pdf`, label: "Resume", external: true },
];
---

<header class="site-header" id="site-header">
  <a class="brand" href={`${base}/`} id="site-brand" aria-label="Julia Tang, home">
    <span class="brand__mark">Julia Tang</span>
  </a>
  <nav aria-label="Primary">
    <ul class="nav-links">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              {...(l.external
                ? { target: "_blank", rel: "noopener" }
                : {})}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script is:inline>
  (function () {
    const header = document.getElementById("site-header");
    if (header) {
      const threshold = 24;
      function onScroll() {
        if (window.scrollY > threshold) header.classList.add("is-scrolled");
        else header.classList.remove("is-scrolled");
      }
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    }

    // Brand click burst — emojis pop out radially from the name.
    const brand = document.getElementById("site-brand");
    if (brand) {
      const EMOJIS = ["✨", "🎉", "⭐", "💫", "🌟", "💖", "🪄"];
      const COUNT = 10;

      function burst() {
        const rect = brand.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        for (let i = 0; i < COUNT; i++) {
          const sprite = document.createElement("span");
          sprite.className = "brand-confetti";
          sprite.textContent = EMOJIS[Math.floor(Math.random() * EMOJIS.length)];
          // Radial spread, biased upward
          const angle = (Math.PI * 2 * i) / COUNT + (Math.random() - 0.5) * 0.6;
          const distance = 70 + Math.random() * 50;
          const dx = Math.cos(angle) * distance;
          const dy = Math.sin(angle) * distance - 30; // upward bias
          sprite.style.left = cx + "px";
          sprite.style.top = cy + "px";
          sprite.style.setProperty("--dx", dx.toFixed(1) + "px");
          sprite.style.setProperty("--dy", dy.toFixed(1) + "px");
          sprite.style.setProperty(
            "--rot",
            (Math.random() * 240 - 120).toFixed(0) + "deg"
          );
          document.body.appendChild(sprite);
          setTimeout(() => sprite.remove(), 1300);
        }
      }

      brand.addEventListener("click", (e) => {
        burst();
        // If we're already on the home page, suppress the navigation
        // (re-render would wipe the burst). Otherwise let the link follow.
        const target = brand.getAttribute("href") || "/";
        const here = window.location.pathname.replace(/\/$/, "");
        const dest = target.replace(/\/$/, "");
        if (here === dest) {
          e.preventDefault();
        } else {
          // Delay navigation slightly so the burst is visible.
          e.preventDefault();
          setTimeout(() => { window.location.href = target; }, 380);
        }
      });
    }
  })();
</script>

<style is:global>
  /* Confetti is appended to <body> so its styles must be global. */
  .brand-confetti {
    position: fixed;
    font-size: 22px;
    line-height: 1;
    pointer-events: none;
    z-index: 1000;
    transform: translate(-50%, -50%) scale(0.4);
    will-change: transform, opacity;
    animation: brand-confetti-pop 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes brand-confetti-pop {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.4) rotate(0);
    }
    15% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform:
        translate(calc(-50% + var(--dx, 0px)),
                  calc(-50% + var(--dy, -100px)))
        scale(1.15)
        rotate(var(--rot, 90deg));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .brand-confetti {
      animation: brand-confetti-pop-reduced 600ms ease-out forwards;
    }
    @keyframes brand-confetti-pop-reduced {
      0%   { opacity: 0; }
      30%  { opacity: 1; }
      100% { opacity: 0; }
    }
  }
</style>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
    padding: var(--s-5) var(--s-8);
    background: transparent;
    transition:
      background-color var(--dur-normal) var(--ease),
      backdrop-filter var(--dur-normal) var(--ease),
      border-color var(--dur-normal) var(--ease),
      box-shadow var(--dur-normal) var(--ease);
    border-bottom: 1px solid transparent;
  }
  .site-header.is-scrolled {
    background: rgba(253, 252, 250, 0.8);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom-color: var(--border-subtle);
  }

  /* Brand: subtle highlight fill on hover (matches the lede pop pattern). */
  .brand {
    position: relative;
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    padding: 2px 6px;
    margin: -2px -6px;
    border-radius: var(--r-xs);
    background-image: linear-gradient(var(--brand-wash-soft), var(--brand-wash-soft));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 100%;
    transition: background-size var(--dur-normal) var(--ease-out);
  }
  .brand:hover,
  .brand:focus-visible {
    background-size: 100% 100%;
    outline: none;
  }
  .brand:active {
    transform: scale(0.97);
    transition: transform 120ms var(--ease-out);
  }

  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--s-6);
  }
  .nav-links a {
    position: relative;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    padding: var(--s-2) 0;
    transition: color var(--dur-fast) var(--ease);
  }
  .nav-links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--text-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease);
  }
  .nav-links a:hover { color: var(--text-primary); }
  .nav-links a:hover::after { transform: scaleX(1); }

  @media (max-width: 540px) {
    .site-header { padding: var(--s-4) var(--s-5); }
    .nav-links { gap: var(--s-4); }
    .brand { font-size: 18px; }
  }
</style>
