---
/**
 * Homepage — one-pager.
 *
 * Each case study is inlined as a `<Showcase>` block (Rina Kang /
 * Aaron James-style mini case studies) instead of linking out to a deep
 * case-study page from a tile grid. Each block has an interactive hero
 * (auto-cycling phone stack or looping GIF) and a CTA to the full case
 * study for anyone who wants the long version.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import FadeIn from "../components/FadeIn.astro";
import HeroGrid from "../components/HeroGrid.astro";
import Showcase from "../components/showcase/Showcase.astro";
import PhoneVideoParallax from "../components/showcase/PhoneVideoParallax.astro";
import VideoCardStack from "../components/showcase/VideoCardStack.astro";
import { snapchatGamesStackItems } from "../components/showcase/projects/snapchatGamesStack";
import MediaParallax from "../components/showcase/MediaParallax.astro";
import TappyCloudShowcase from "../components/showcase/projects/TappyCloudShowcase.astro";
import FestivalModeShowcase from "../components/showcase/projects/FestivalModeShowcase.astro";
import { showcaseContent } from "../data/showcases";

const snapchatGames = showcaseContent["snapchat-games"];
const topicChats = showcaseContent["topic-chats"];

const heroStatements = [
  "I design the moments where people connect.",
  "I build products used by millions daily.",
  "I turn ambiguous problems into shipped products.",
];

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="Julia Tang | Product Designer">
  <section class="v2-hero" data-home-hero>
    <HeroGrid />

    <div class="hero-reveal hero-reveal--snap" aria-hidden="true">
      <div class="hero-reveal__item hero-reveal__item--snap-chat">
        <div class="hero-reveal__chat-crop">
          <img src={`${base}/projects/hero/snap-chat.gif`} alt="" />
        </div>
      </div>
      <div class="hero-reveal__item hero-reveal__item--snap-envelope">
        <img src={`${base}/projects/hero/snap-envelope.png`} alt="" />
      </div>
      <div class="hero-reveal__item hero-reveal__item--snap-valentine">
        <img src={`${base}/projects/hero/valentinesday.png`} alt="" />
      </div>
    </div>

    <div class="hero-reveal hero-reveal--tinder" aria-hidden="true">
      <div class="hero-reveal__item hero-reveal__item--tinder-superlike">
        <img src={`${base}/projects/hero/superlike.gif`} alt="" />
      </div>
      <div class="hero-reveal__item hero-reveal__item--tinder-phone">
        <img src={`${base}/projects/hero/tinder-phone.gif`} alt="" />
      </div>
      <div class="hero-reveal__item hero-reveal__item--tinder-festival">
        <img src={`${base}/projects/hero/festival-mode-hero.gif`} alt="" />
      </div>
    </div>

    <div class="v2-hero__grid">
      <div class="v2-hero__text">
        <FadeIn>
          <p class="v2-hero__eyebrow"><span class="v2-hero__wave" aria-hidden="true"><svg
              class="v2-hero__wave-hand"
              viewBox="0 0 32 32"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            ><path d="M9 11 V 7 a 2 2 0 0 1 4 0 v 9"/><path d="M13 7 V 5 a 2 2 0 0 1 4 0 v 11"/><path d="M17 7 V 6 a 2 2 0 0 1 4 0 v 11"/><path d="M21 9 V 8 a 2 2 0 0 1 4 0 v 9 c 0 6.5 -5 10 -10 10 -5.5 0 -10 -3.5 -10 -9 a 2 2 0 0 1 3.4 -1.4 l 1.6 1.4"/></svg></span><span class="v2-hero__hint"><span class="v2-hero__tight">Hi</span>, <span class="v2-hero__tight">I'm</span> <span class="v2-hero__name"><span class="v2-hero__kern-j">J</span>ulia<svg
              class="v2-hero__squiggle"
              viewBox="0 0 120 12"
              preserveAspectRatio="none"
              aria-hidden="true"
              focusable="false"
            ><path d="M2 7 C 14 1, 26 11, 38 6 S 62 1, 74 7 S 98 11, 118 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></span>.<span class="v2-hero__avatar" aria-hidden="true"><img src={`${base}/julia-avatar.png`} alt="" class="v2-hero__avatar-img" /><span class="v2-hero__avatar-wave v2-hero__avatar-wave--1"><svg viewBox="0 0 100 16" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" focusable="false"><path d="M2 8 C 12 0, 22 16, 32 8 S 52 0, 62 8 S 82 16, 98 8" /></svg></span><span class="v2-hero__avatar-wave v2-hero__avatar-wave--2"><svg viewBox="0 0 100 16" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" focusable="false"><path d="M2 8 C 12 0, 22 16, 32 8 S 52 0, 62 8 S 82 16, 98 8" /></svg></span><span class="v2-hero__avatar-wave v2-hero__avatar-wave--3"><svg viewBox="0 0 100 16" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" focusable="false"><path d="M2 8 C 12 0, 22 16, 32 8 S 52 0, 62 8 S 82 16, 98 8" /></svg></span></span></span></p>
        </FadeIn>

        <FadeIn delay={120}>
          <h1 class="v2-hero__headline" aria-label={heroStatements.join(" / ")}>
            {heroStatements.map((statement, i) => {
              const words = statement.split(" ");
              return (
                <span
                  class:list={["v2-hero__rot", { "is-active": i === 0 }]}
                  data-rot-index={i}
                  aria-hidden={i === 0 ? undefined : "true"}
                >
                  {words.flatMap((word, j) => {
                    const span = (
                      <span class="v2-hero__word" style={`--j:${j}`}>{word}</span>
                    );
                    return j === 0 ? [span] : [" ", span];
                  })}
                </span>
              );
            })}
          </h1>
        </FadeIn>

        <FadeIn delay={220}>
          <div class="v2-hero__meta" data-cursor="scroll-pill" data-meta-scroll>
            <p class="v2-hero__meta-col v2-hero__meta-col--snap">
              Currently building social experiences at <a class="hero-co hero-co--snap" href="#snapchat-games"><img src={`${base}/logos/snapchat.png`} alt="" aria-hidden="true" />Snapchat</a> with Cursor and Claude.
            </p>
            <p class="v2-hero__meta-col v2-hero__meta-col--tinder">
              Previously led the swipe stack and introduced dynamic profiles at <a class="hero-co hero-co--tinder" href="#tappy-cloud"><img src={`${base}/logos/tinder.png`} alt="" aria-hidden="true" />Tinder</a>.
            </p>
            <p class="v2-hero__meta-col v2-hero__meta-col--ai">
              Tinkering with AI on the side. <span class="v2-hero__meta-secondary">AI projects coming soon. In the meantime, have some fun with this doodle tool!</span>
            </p>
          </div>
        </FadeIn>
      </div>
    </div>
  </section>

  <script is:inline>
    // Rotate the hero headline through the prepared statements.
    // Statements are positioned in the same cell; we measure each one's
    // height and animate the container so the meta line below moves up
    // for shorter statements (no awkward gap).
    (() => {
      const headline = document.querySelector(".v2-hero__headline");
      const slots = document.querySelectorAll(".v2-hero__rot");
      if (!headline || slots.length < 1) return;

      // Switch layout to absolute-stacking so each statement's measured
      // height is its OWN rendered height (not the grid cell's max).
      headline.classList.add("is-measured");

      // Measure each statement's natural height by promoting it to a
      // normal-flow box one at a time. Pre-measuring while every slot is
      // absolutely positioned at the same coords yields a per-statement
      // height of zero (or the first slot's height) on some browsers, so
      // the longest statement gets clipped. Promoting + restoring is a
      // single layout pass per slot and runs once on load.
      function measure() {
        const out = [];
        for (const s of slots) {
          const prevPos = s.style.position;
          const prevVis = s.style.visibility;
          s.style.position = "static";
          s.style.visibility = "hidden";
          out.push(s.offsetHeight);
          s.style.position = prevPos;
          s.style.visibility = prevVis;
        }
        return out;
      }

      let heights = measure();
      let i = 0;
      headline.style.height = heights[i] + "px";

      // Web fonts (Geist) can land after this script runs; metrics shift
      // enough on the longest statement to clip a line. Remeasure once
      // fonts settle so the headline reserves the right height.
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(() => {
          heights = measure();
          headline.style.height = heights[i] + "px";
        });
      }

      let resizeT;
      window.addEventListener("resize", () => {
        clearTimeout(resizeT);
        resizeT = setTimeout(() => {
          heights = measure();
          headline.style.height = heights[i] + "px";
        }, 120);
      });

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce || slots.length < 2) return;
      setInterval(() => {
        slots[i].classList.remove("is-active");
        slots[i].setAttribute("aria-hidden", "true");
        i = (i + 1) % slots.length;
        slots[i].classList.add("is-active");
        slots[i].removeAttribute("aria-hidden");
        headline.style.height = heights[i] + "px";
      }, 4600);
    })();

    // Replay the greeting flourish on eyebrow hover:
    //   enter → re-run a short wave pendulum + draw squiggle L-to-R
    //   leave → erase squiggle L-to-R (wave pendulum self-resolves to 0°)
    // The first hover takes over from the on-load intro animation by
    // clearing inline `animation` and using transitions for the squiggle.
    (() => {
      const eyebrow = document.querySelector(".v2-hero__eyebrow");
      const path = document.querySelector(".v2-hero__squiggle path");
      const hand = document.querySelector(".v2-hero__wave-hand");
      if (!eyebrow || !path || !hand) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      const DRAW_EASE = "cubic-bezier(0.22, 1, 0.36, 1)";
      const ERASE_EASE = "cubic-bezier(0.4, 0, 0.6, 1)";
      const DRAW_MS = 700;
      const ERASE_MS = 700;

      function drawIn() {
        // Reset to invisible-before-draw, then transition to drawn.
        path.style.animation = "none";
        path.style.transition = "none";
        path.style.strokeDashoffset = "120";
        // Force reflow so the next transition picks up the reset.
        void path.getBoundingClientRect();
        path.style.transition = "stroke-dashoffset " + DRAW_MS + "ms " + DRAW_EASE;
        path.style.strokeDashoffset = "0";
      }

      function eraseOut() {
        path.style.animation = "none";
        path.style.transition = "stroke-dashoffset " + ERASE_MS + "ms " + ERASE_EASE;
        path.style.strokeDashoffset = "-120";
      }

      function replayWave() {
        hand.style.animation = "none";
        void hand.getBoundingClientRect();
        hand.style.animation =
          "hero-wave-pendulum-hover 1800ms cubic-bezier(0.36, 0, 0.64, 1) 1 both";
      }

      eyebrow.addEventListener("mouseenter", () => {
        drawIn();
        replayWave();
      });
      eyebrow.addEventListener("mouseleave", () => {
        eraseOut();
      });
    })();

    // Meta-column → case-study scroll. Clicking anywhere in the
    // .v2-hero__meta-col--snap or .v2-hero__meta-col--tinder column
    // (away from the inner company link) jumps to that company's
    // first case study on the page — same behavior the "See my work"
    // cursor pill is advertising. Inner <a> clicks pass through to
    // their own href so the existing scroll targets still work.
    (() => {
      const targets = [
        { sel: ".v2-hero__meta-col--snap", href: "#snapchat-games" },
        { sel: ".v2-hero__meta-col--tinder", href: "#tappy-cloud" },
      ];
      for (const { sel, href } of targets) {
        const col = document.querySelector(sel);
        if (!col) continue;
        col.style.cursor = "pointer";
        col.addEventListener("click", (e) => {
          // If the click already landed on a link, let it handle itself.
          if (e.target.closest && e.target.closest("a")) return;
          const target = document.querySelector(href);
          if (target) target.scrollIntoView({ behavior: "smooth", block: "center" });
        });
      }
    })();
  </script>

  <span id="work" aria-hidden="true"></span>
  <FadeIn class="fade-in--showcase">
    <Showcase
      companyLogo={snapchatGames.companyLogo}
      companyName={snapchatGames.companyName}
      role={snapchatGames.role}
      title={snapchatGames.title}
      tagline={snapchatGames.tagline}
      stats={snapchatGames.stats}
      statsGap="var(--s-3)"
      statsMaxWidth="36ch"
      ctaHref="/product-design/snapchat-games"
      ctaLabel="See how it scaled"
      accent={snapchatGames.accent}
      reverse
      tightHero
      id="snapchat-games"
    >
      <div data-cursor-bg="light">
        <VideoCardStack
          items={[...snapchatGamesStackItems]}
          hintTarget="#snapchat-games .showcase__text"
          autoShuffle
          autoShuffleMs={4000}
        />
      </div>
    </Showcase>
  </FadeIn>

  <FadeIn class="fade-in--showcase">
    <Showcase
      companyLogo={topicChats.companyLogo}
      companyName={topicChats.companyName}
      role={topicChats.role}
      title={topicChats.title}
      tagline={topicChats.tagline}
      stats={topicChats.stats}
      ctaHref="/product-design/topic-chats"
      ctaLabel="Read the case study"
      press={topicChats.press}
      accent={topicChats.accent}
      tightHero
      id="topic-chats"
    >
      <div data-cursor-bg="dark" style="transform: rotate(2deg); transform-origin: 50% 50%;">
        <MediaParallax
          src="/projects/topic-chats/topic-chat-sizzle.mp4"
          aspect="9 / 16"
          maxWidth="396px"
          label="Topic Chats feature sizzle reel"
          cellLeftSrc="/projects/topic-chats/Scoreboard.png"
          cellLeftAlt="Real-time sports scoreboard pinned inside a Topic Chat"
          cellLeftWidth="clamp(280px, 88%, 380px)"
          cellRightSrc="/projects/topic-chats/liveactivitywidget-detail.png"
          cellRightAlt="Topic Chats live activity widget detail"
          cellRightWidth="clamp(260px, 82%, 360px)"
        />
      </div>
    </Showcase>
  </FadeIn>

  <div id="tappy-cloud" data-cursor-bg="dark" style="transform: translateX(-40px);">
    <FadeIn class="fade-in--showcase">
      <TappyCloudShowcase reverse />
    </FadeIn>
  </div>

  <FadeIn class="fade-in--showcase">
    <Showcase
      companyLogo="/logos/tinder.png"
      companyName="Tinder"
      role="Senior Product Designer"
      title="App Redesign"
      tagline={[
        "Tinder's design language and profile system had barely changed since the app's inception. Profiles felt shallow because the content was shallow, and the app felt outdated because we hadn't invested in refreshed visuals or new interactions in years.",
        "I designed Sparks: Prompts, Quizzes, and refreshed swipe and match animations that gave people more to react to. Started as a 2022 Hackathon win, shipped globally in 2023.",
      ]}
      stats={[
        { value: "↑ 0.8%", label: "Subscription Cash" },
        { value: "↑ 0.3%", label: "Days Active" },
        { value: "↑ 0.9%", label: "Likes Sent" },
      ]}
      statsGap="var(--s-3)"
      statsMaxWidth="36ch"
      ctaHref="https://techcrunch.com/2023/11/20/tinder-redesigns-profile-pages-with-prompts-info-tags-and-quiz/"
      ctaLabel="See press coverage"
      press={[
        {
          src: "/projects/festival-mode/techcrunch-dark-logo.png",
          alt: "TechCrunch",
          href: "https://techcrunch.com/2023/11/20/tinder-redesigns-profile-pages-with-prompts-info-tags-and-quiz/",
        },
      ]}
      accent="#FD297C"
      id="app-redesign"
    >
      <PhoneVideoParallax
        videoSrc="/projects/tinder-app-redesign/sparks-recording.mp4"
        frameSrc="/projects/tinder-app-redesign/phone-frame.png"
        badgeSrc="/projects/tinder-app-redesign/Hackathon_winner_badge.png"
        promptSrc="/projects/tinder-app-redesign/Prompt.png"
        quizSrc="/projects/tinder-app-redesign/quiz.png"
        videoLabel="Tinder Sparks profile redesign in motion"
        badgeAlt="2022 Tinder Hackathon Winner badge"
        promptAlt="Tinder Prompts feature example"
        quizAlt="Tinder Quizzes feature example"
      />
    </Showcase>
  </FadeIn>

  <FadeIn class="fade-in--showcase">
    <div data-cursor-bg="dark">
      <FestivalModeShowcase reverse />
    </div>
  </FadeIn>

  <div class="home-footer-spacer" aria-hidden="true"></div>

</BaseLayout>

<style>
  .home-footer-spacer {
    height: var(--s-24);
  }
  @media (max-width: 720px) {
    .home-footer-spacer { height: var(--s-16); }
  }

  /* Tappy Cloud's staggered columns make the section visually taller
     than the others, so give it extra breathing room from the topic-chats
     section above and the app-redesign section below. */
  :global(#tappy-cloud) :global(.showcase) {
    padding-block: var(--s-32);
  }
  @media (max-width: 720px) {
    :global(#tappy-cloud) :global(.showcase) {
      padding-block: var(--s-16);
    }
  }

  .v2-hero {
    position: relative;
    overflow: visible;
    padding-top: 0;
    padding-bottom: var(--s-16);
    /* Locked so the dot background never reflows when the rotating headline
       changes line count. Sized so the right text block sits visually centered
       with the left rail's nav and the rotating 100px display headline has
       room to land 2 or 3 lines without clipping. Capped to viewport height
       on shorter laptops so the scroll chevron at the bottom never falls
       below the fold. */
    min-height: min(820px, 100vh);
  }
  @media (max-width: 1023px) {
    /* Off-desktop the SideRail collapses into the sticky Header, so the hero
       no longer needs to reserve the desktop rail's full ~820px height —
       size it to roughly the tallest 3-line headline + 3-paragraph meta
       block + paddings, then let content flow. The old 640px floor left
       ~280px of empty dot field below the meta on tablet. */
    .v2-hero { min-height: 0; padding-top: var(--s-12); padding-bottom: var(--s-12); }
  }
  @media (max-width: 720px) {
    .v2-hero { padding-top: var(--s-8); padding-bottom: var(--s-10); }
  }
  @media (max-width: 420px) {
    .v2-hero { padding-top: var(--s-6); padding-bottom: var(--s-8); }
  }

  /* The global SideRail handles wordmark + nav on desktop; on smaller
     widths the rail collapses and the sticky Header takes over (rule
     lives in global.css so it applies to every page, not just home). */

  /* Anchor scroll targets sit below the (restored on scroll) sticky header. */
  :global(#snapchat-games),
  :global(#topic-chats),
  :global(#tappy-cloud),
  :global(#app-redesign) {
    scroll-margin-top: 80px;
  }

  /* 12-col grid container — desktop.
     Row 1 (auto): wordmark pinned at the top-left, no other content
     Row 2 (1fr):  nav + text block vertically centered within remaining space
     Drops to a single column under 1024 so the right-side text fills the
     width and the left rail dissolves into the (restored) sticky header. */
  .v2-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto 1fr;
    column-gap: var(--s-6);
    /* Wider than the standard .page container so the wordmark sits close
       to the viewport edge per the Figma; padding stays a touch generous on
       very-wide displays via clamp. */
    max-width: 1640px;
    margin: 0 auto;
    padding: var(--s-10) clamp(var(--s-6), 3vw, var(--s-12)) 0;
    /* Grid is inside .v2-hero which already has --s-16 bottom padding, so
       subtract that from the cap so the outer hero never exceeds the
       viewport (otherwise the scroll chevron falls off-screen). */
    min-height: min(820px, calc(100vh - var(--s-16)));
  }
  @media (max-width: 1023px) {
    .v2-hero__grid {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      grid-template-rows: auto;
      padding: 0 var(--s-6);
      min-height: 0;
    }
  }
  @media (max-width: 720px) {
    .v2-hero__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding: 0 var(--s-5);
    }
  }

  /* Wordmark + nav live in the global <SideRail> now; the hero just
     reserves cols 1-3 visually so the right text block aligns to col 5
     under the same 12-col rhythm. */
  /* Right text block: eyebrow → headline → 2-col meta.
     Vertically centered in row 2 so it visually balances the left-rail nav. */
  .v2-hero__text {
    grid-column: 3 / span 8;
    grid-row: 2;
    align-self: center;
    display: grid;
    row-gap: var(--s-5);
  }
  .v2-hero__text > :nth-child(2) {
    /* breathy gap below the headline before the meta cols */
    margin-bottom: var(--s-6);
  }
  @media (max-width: 1023px) {
    .v2-hero__text {
      grid-column: 1 / -1;
      grid-row: auto;
      align-self: auto;
      padding-top: var(--s-6);
    }
  }

  .v2-hero__eyebrow {
    font-family: var(--font-hand);
    font-size: clamp(28px, 2.6vw, 40px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.05em;
    text-transform: none;
    color: var(--text-secondary);
    margin: 0;
    display: inline-flex;
    align-items: baseline;
    font-feature-settings: "calt" 0, "liga" 0, "dlig" 0;
  }
  .v2-hero__hint {
    vertical-align: baseline;
  }
  .v2-hero__tight {
    letter-spacing: -0.05em;
  }
  .v2-hero__kern-j {
    margin-right: -0.08em;
  }
  .v2-hero__wave-hand {
    width: 0.78em;
    height: 0.78em;
    color: currentColor;
    overflow: visible;
    transform-origin: 70% 80%;
  }

  /* One-shot greeting flourish on page load. Wave + squiggle finish at
     the same absolute time (both end at 5400ms after page load).
     Squiggle exits left-to-right so it reads as the line continuing on.

     Wave uses two stacked animations on nested spans so the pendulum
     rotation runs the FULL duration (starts immediately during slide-in)
     while the slide-in/out is symmetric (same easing, same 600ms each). */
  .v2-hero__hint { display: inline-block; position: relative; }

  /* Easter egg: hover "Hi, I'm Julia." to reveal Julia's avatar + squiggles
     drifting to the right of the line. */
  .v2-hero__avatar {
    position: absolute;
    left: calc(100% + 0.15em);
    top: 50%;
    width: 4.1em;
    height: 4.1em;
    transform: translateY(-50%) translateX(-6px) scale(0.85);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 280ms var(--ease-out),
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .v2-hero__avatar-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
  }
  /* Three sine-wave squiggles, each anchored at the avatar center and
     rotated outward so they read as radiating from the portrait. */
  .v2-hero__avatar-wave {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2.6em;
    height: 0.8em;
    transform-origin: 0 50%;
    color: var(--brand-primary, currentColor);
    pointer-events: none;
  }
  .v2-hero__avatar-wave svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .v2-hero__avatar-wave path {
    stroke-dasharray: 110;
    stroke-dashoffset: 110;
  }
  /* Translate outward past the avatar edge with breathing room. */
  .v2-hero__avatar-wave--1 { transform: rotate(-60deg) translateX(3em); }
