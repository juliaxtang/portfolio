---
const EMAIL = "juliaxtang@gmail.com";
---

<footer class="site-footer">
  <div class="page footer-inner">
    <p class="footer-brand__name">
      Made with
      <svg
        class="footer-heart"
        viewBox="0 0 24 22"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M2.6 5.1 C 3.4 2.9, 6.1 1.7, 8.6 2.7 C 10.4 3.4, 11.3 5.0, 12.0 6.6 C 12.8 4.8, 14.0 3.1, 16.1 2.5 C 18.7 1.9, 21.5 3.6, 21.9 6.3 C 22.3 8.9, 20.7 11.2, 19.0 13.0 C 16.9 15.3, 14.5 17.2, 12.3 19.3 C 12.0 19.6, 11.8 19.4, 11.6 19.2 C 9.3 16.9, 6.5 14.9, 4.4 12.3 C 2.9 10.4, 1.8 7.7, 2.6 5.1 Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
          stroke-linecap="round"
        />
      </svg>
      <span class="footer-brand__tokens">(and tokens!)</span>
    </p>
    <div class="footer-right">
      <span class="footer-chat-lede">Let's chat!</span>
      <button
        type="button"
        class="footer-email"
        data-cursor="copy-email"
        data-email={EMAIL}
        aria-label={`Copy email address ${EMAIL}`}
      >
        {EMAIL}
      </button>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--s-2) 0;
    border-top: 1px solid var(--border-default);
    background: var(--bg-canvas);
  }
  .footer-inner {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: nowrap;
    justify-content: space-between;
    line-height: 1;
    padding-top: var(--s-6);
    padding-bottom: var(--s-12);
  }
  .footer-brand__name {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 14px;
    letter-spacing: -0.005em;
    color: var(--text-secondary);
    white-space: nowrap;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
  }
  .footer-brand__tokens {
    color: var(--text-secondary);
    font-family: var(--font-hand);
    letter-spacing: -0.02em;
    font-size: 1.3em;
  }
  .footer-heart {
    width: 1.15em;
    height: 1.15em;
    color: var(--text-secondary);
    transform: translateY(0.05em) rotate(-6deg);
    overflow: visible;
  }
  .footer-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--s-1);
    line-height: 1.2;
  }
  .footer-chat-lede {
    font-family: var(--font-hand);
    color: var(--text-secondary);
    font-size: 18px;
    letter-spacing: -0.02em;
  }
  .footer-email {
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    font-family: var(--font-sans);
    font-size: 14px;
    letter-spacing: -0.005em;
    color: var(--text-secondary);
    transition: color var(--dur-fast) var(--ease);
  }
  .footer-email:hover,
  .footer-email:focus-visible {
    color: var(--text-primary);
    outline: none;
  }
  @media (max-width: 768px) {
    .footer-inner {
      align-items: start;
      padding-bottom: var(--s-8);
    }
    .footer-brand__name,
    .footer-email {
      font-size: clamp(10px, 2.5vw, 14px);
    }
    .footer-chat-lede {
      font-size: clamp(12px, 3.2vw, 18px);
    }
  }
  @media (max-width: 420px) {
    .footer-inner { gap: var(--s-2); }
  }
</style>
