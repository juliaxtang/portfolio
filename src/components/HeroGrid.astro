---
/**
 * HeroGrid — a whisper-quiet dot grid that distorts toward the cursor.
 * Layered over the page-wide CursorAurora inside the hero section only.
 * Dots within ~160px of the cursor nudge toward it with smooth falloff.
 * Clicking anywhere over the hero sends an expanding ring pulse that
 * pushes dots outward as it passes through.
 */
---

<canvas class="hero-grid" id="hero-grid" aria-hidden="true"></canvas>

<script is:inline>
  (function () {
    const canvas = document.getElementById("hero-grid");
    if (!canvas) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const ctx = canvas.getContext("2d");
    const SPACING = 28;
    const RADIUS = 160;
    const MAX_PULL = 6;
    const DOT_R = 1.6;

    const PULSE_SPEED = 3.5;      // px per frame the ring expands (slower = more visible)
    const PULSE_DECAY = 0.006;    // life drained per frame (≈170 frames ≈ 2.8s)
    const PULSE_BAND  = 80;       // ring band width (wider = softer)
    const PULSE_FORCE = 24;       // peak displacement at ring center

    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    let w = 0, h = 0;
    let mx = -9999, my = -9999;
    let tmx = -9999, tmy = -9999;
    let raf = 0;
    let active = false;
    let pulses = [];

    function resize() {
      const rect = canvas.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      canvas.width = Math.floor(w * dpr);
      canvas.height = Math.floor(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw();
    }

    function draw() {
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = "rgba(20, 20, 30, 0.20)";
      const cols = Math.ceil(w / SPACING) + 1;
      const rows = Math.ceil(h / SPACING) + 1;
      for (let i = 0; i < cols; i++) {
        for (let j = 0; j < rows; j++) {
          const px = i * SPACING;
          const py = j * SPACING;
          let dx = 0, dy = 0;
          if (mx > -9000) {
            const ox = px - mx;
            const oy = py - my;
            const dist = Math.sqrt(ox * ox + oy * oy);
            if (dist < RADIUS && dist > 0.001) {
              // Cosine falloff — softer edge, no perceived jitter when
              // the cursor enters/leaves a dot's range.
              const fall = Math.cos((dist / RADIUS) * Math.PI * 0.5);
              const pull = MAX_PULL * fall;
              dx = -(ox / dist) * pull;
              dy = -(oy / dist) * pull;
            }
          }
          for (let k = 0; k < pulses.length; k++) {
            const p = pulses[k];
            const ox = px - p.x;
            const oy = py - p.y;
            const dist = Math.sqrt(ox * ox + oy * oy);
            const ring = Math.abs(dist - p.r);
            if (ring < PULSE_BAND && dist > 0.001) {
              // Cosine band profile (smooth in and out) × eased life (ease-out cubic).
              const band = Math.cos((ring / PULSE_BAND) * Math.PI * 0.5);
              const lifeEase = p.life * p.life;
              const push = PULSE_FORCE * band * lifeEase;
              dx += (ox / dist) * push;
              dy += (oy / dist) * push;
            }
          }
          ctx.beginPath();
          ctx.arc(px + dx, py + dy, DOT_R, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    }

    function loop() {
      // Heavier smoothing on the cursor tracker — fast flicks no longer
      // teleport the pull origin frame-to-frame, which read as jitter.
      mx += (tmx - mx) * 0.10;
      my += (tmy - my) * 0.10;
      for (let i = pulses.length - 1; i >= 0; i--) {
        const p = pulses[i];
        p.r += PULSE_SPEED;
        p.life -= PULSE_DECAY;
        if (p.life <= 0) pulses.splice(i, 1);
      }
      draw();
      // Keep the loop alive while pulses or cursor pull are still settling.
      const cursorSettled = !active
        && Math.abs(tmx - mx) < 0.5
        && Math.abs(tmy - my) < 0.5;
      if (cursorSettled && pulses.length === 0) {
        raf = 0;
        return;
      }
      raf = requestAnimationFrame(loop);
    }

    function kick() {
      if (!raf) raf = requestAnimationFrame(loop);
    }

    function onMove(e) {
      const rect = canvas.getBoundingClientRect();
      tmx = e.clientX - rect.left;
      tmy = e.clientY - rect.top;
      active = tmx >= 0 && tmy >= 0 && tmx <= w && tmy <= h;
      if (mx < -9000) { mx = tmx; my = tmy; }
      kick();
    }

    function onLeave() {
      active = false;
      tmx = -9999;
      tmy = -9999;
      kick();
    }

    function onClick(e) {
      const rect = canvas.getBoundingClientRect();
      const px = e.clientX - rect.left;
      const py = e.clientY - rect.top;
      if (px < 0 || py < 0 || px > w || py > h) return;
      pulses.push({ x: px, y: py, r: 0, life: 1 });
      kick();
    }

    resize();
    window.addEventListener("resize", resize, { passive: true });
    window.addEventListener("load", resize);
    if (typeof ResizeObserver !== "undefined") {
      const ro = new ResizeObserver(() => resize());
      ro.observe(canvas);
      if (canvas.parentElement) ro.observe(canvas.parentElement);
    }
    if (!reduce) {
      window.addEventListener("mousemove", onMove, { passive: true });
      window.addEventListener("mouseout", (e) => { if (!e.relatedTarget) onLeave(); });
      window.addEventListener("click", onClick);
    }
  })();
</script>

<style>
  .hero-grid {
    position: absolute;
    left: 0;
    right: 0;
    top: -90px;
    bottom: 0;
    width: 100%;
    height: calc(100% + 90px);
    pointer-events: none;
    z-index: 0;
    opacity: 0.75;
    mix-blend-mode: multiply;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 16%, #000 60%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 16%, #000 60%, transparent 100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-grid { opacity: 0.4; }
  }
</style>
