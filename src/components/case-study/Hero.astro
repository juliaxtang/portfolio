---
/**
 * Hero — case-study hero block. Renders the eyebrow row (company / year /
 * role), the title, the summary, and an optional hero media (image or video).
 *
 * The case-study layout calls this automatically from the frontmatter, so
 * .mdx files don't import it themselves.
 */
interface Props {
  title: string;
  summary: string;
  company?: string;
  year?: number;
  role?: string;
  tags?: string[];
  hero?: { src: string; alt: string; poster?: string; isVideo?: boolean };
  accent?: string;
}

const { title, summary, company, year, role, tags = [], hero, accent } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolve = (p?: string) =>
  !p ? undefined : p.startsWith("http") || p.startsWith(base)
    ? p
    : `${base}${p.startsWith("/") ? "" : "/"}${p}`;

const heroSrc = resolve(hero?.src);
const heroPoster = resolve(hero?.poster);

const meta = [
  company && { label: "Company", value: company },
  role && { label: "Role", value: role },
  year && { label: "Year", value: String(year) },
].filter(Boolean) as { label: string; value: string }[];

const accentStyle = accent ? `--cs-accent:${accent};` : "";
---

<section class="cs-hero" style={accentStyle}>
  <div class="cs-hero__inner">
    {tags.length > 0 && (
      <p class="cs-hero__tags">
        {tags.map((t, i) => (
          <>
            <span class="cs-hero__tag">{t}</span>
            {i < tags.length - 1 && <span class="cs-hero__tag-sep" aria-hidden="true">·</span>}
          </>
        ))}
      </p>
    )}

    <h1 class="cs-hero__title">{title}</h1>
    <p class="cs-hero__summary">{summary}</p>

    {meta.length > 0 && (
      <dl class="cs-hero__meta">
        {meta.map((m) => (
          <div class="cs-hero__meta-item">
            <dt class="t-eyebrow">{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>

  {hero && heroSrc && (
    <div class="cs-hero__media-wrap">
      <div class="cs-hero__media">
        {hero.isVideo ? (
          <video src={heroSrc} poster={heroPoster} autoplay muted playsinline loop preload="metadata"></video>
        ) : (
          <img src={heroSrc} alt={hero.alt} />
        )}
      </div>
    </div>
  )}
</section>

<style>
  .cs-hero {
    --cs-accent: var(--brand-primary);
    padding-top: var(--s-12);
    padding-bottom: var(--s-12);
    background:
      radial-gradient(60% 80% at 20% 10%, color-mix(in srgb, var(--cs-accent) 35%, transparent) 0%, transparent 60%),
      radial-gradient(50% 60% at 90% 0%, color-mix(in srgb, var(--brand-secondary) 30%, transparent) 0%, transparent 60%),
      var(--bg-canvas);
  }

  .cs-hero__inner {
    max-width: var(--content-narrow);
    margin: 0 auto;
    padding: 0 var(--s-8);
    display: grid;
    gap: var(--s-5);
  }
  @media (max-width: 720px) {
    .cs-hero__inner { padding: 0 var(--s-5); }
  }

  .cs-hero__tags {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
  }
  .cs-hero__tag-sep { color: var(--text-disabled); }

  .cs-hero__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(48px, 7vw, 96px);
    line-height: 1.0;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0;
  }

  .cs-hero__summary {
    font-size: clamp(18px, 1.7vw, 22px);
    line-height: 1.55;
    color: var(--text-primary);
    margin: 0;
    max-width: 60ch;
  }

  .cs-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-8);
    margin: var(--s-4) 0 0;
    padding: var(--s-5) 0 0;
    border-top: 1px solid var(--border-subtle);
  }
  .cs-hero__meta-item { display: grid; gap: var(--s-1); }
  .cs-hero__meta dt { margin: 0; }
  .cs-hero__meta dd {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
    color: var(--text-primary);
  }

  .cs-hero__media-wrap {
    max-width: var(--content-max);
    margin: var(--s-12) auto 0;
    padding: 0 var(--s-8);
  }
  @media (max-width: 720px) {
    .cs-hero__media-wrap { padding: 0 var(--s-5); }
  }

  .cs-hero__media {
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--bg-sunken);
    aspect-ratio: 16 / 9;
    box-shadow: var(--shadow-md);
  }
  .cs-hero__media img,
  .cs-hero__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
