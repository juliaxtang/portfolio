---
/**
 * Section — the basic vertical block used inside a case-study body.
 *
 * Defaults to a centered narrow column for prose. Pass `wide` to fill the
 * standard content max width (good for grids of media).
 *
 * `banner` renders the section's eyebrow + title in a full-bleed colored
 * band that uses the case-study accent wash. Use it for major section
 * dividers (Research and Analysis, Ideation, Testing and Iterating, etc).
 *
 * `icon="warning"` prepends a small inline glyph next to the title — used
 * for pain-point callouts.
 */
interface Props {
  eyebrow?: string;
  title?: string;
  wide?: boolean;
  banner?: boolean;
  icon?: "warning" | "info" | "success";
  size?: "lg" | "sub";
  id?: string;
  stage?: string;
  hideFromNav?: boolean;
  class?: string;
}

const {
  eyebrow,
  title,
  wide = false,
  banner = false,
  icon,
  size = "lg",
  id,
  stage,
  hideFromNav = false,
  class: className = "",
} = Astro.props;

const slugify = (s: string) =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const finalId = id ?? (title ? slugify(title) : undefined);

const navLabel = stage ?? eyebrow ?? title;

const cls = ["cs-section", wide ? "cs-section--wide" : "cs-section--narrow", banner ? "cs-section--banner" : "", size === "sub" ? "cs-section--sub" : "", className]
  .filter(Boolean)
  .join(" ");
---

<section
  class={cls}
  id={finalId}
  data-cs-section={hideFromNav || !title ? undefined : ""}
  data-cs-nav-label={navLabel}
  data-cs-stage={stage ?? eyebrow ?? ""}
>
  {(eyebrow || title) && (
    banner ? (
      <div class="cs-banner">
        <div class="cs-banner__inner">
          {eyebrow && <p class="t-eyebrow cs-banner__eyebrow">{eyebrow}</p>}
          {title && (
            <h2 class="cs-banner__title">
              {icon === "warning" && (
                <span class="cs-icon cs-icon--warning" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M12 3.5 21 19.5H3L12 3.5Z" fill="currentColor" />
                    <path d="M12 10v4" stroke="#1A1A1A" stroke-width="2" stroke-linecap="round" />
                    <circle cx="12" cy="17" r="1.2" fill="#1A1A1A" />
                  </svg>
                </span>
              )}
              {icon === "success" && (
                <span class="cs-icon cs-icon--success" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="10" fill="currentColor" />
                    <path d="M7.5 12.5l3 3 6-6.5" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              )}
              <span>{title}</span>
            </h2>
          )}
        </div>
      </div>
    ) : (
      <header class="cs-section__head">
        {eyebrow && <p class="t-eyebrow cs-section__eyebrow">{eyebrow}</p>}
        {title && (
          <h2 class="cs-section__title t-h2">
            {icon === "warning" && (
              <span class="cs-icon cs-icon--warning" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 3.5 21 19.5H3L12 3.5Z" fill="currentColor" />
                  <path d="M12 10v4" stroke="#1A1A1A" stroke-width="2" stroke-linecap="round" />
                  <circle cx="12" cy="17" r="1.2" fill="#1A1A1A" />
                </svg>
              </span>
            )}
            {icon === "success" && (
              <span class="cs-icon cs-icon--success" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="10" fill="currentColor" />
                  <path d="M7.5 12.5l3 3 6-6.5" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            )}
            <span>{title}</span>
          </h2>
        )}
      </header>
    )
  )}
  <div class={banner ? "cs-section__body cs-section__body--banner" : "cs-section__body"}>
    <slot />
  </div>
</section>

<style>
  .cs-section {
    margin: 0 auto;
    padding-block: var(--s-12);
  }
  .cs-section--narrow { max-width: var(--content-narrow); }
  /* Wide sections left-align with narrow text, same margin formula. */
  .cs-section--wide {
    max-width: var(--content-max);
    margin-left: max(var(--s-5), calc((100% - var(--content-narrow)) / 2));
    margin-right: max(var(--s-5), calc((100% - var(--content-max)) / 2));
  }

  /* Banner sections are full-bleed: reset width and inner padding. */
  .cs-section--banner {
    max-width: none;
    padding-block: 0;
    margin-block: var(--s-12);
  }
  /* The first banner (typically Background) sits flush against the hero;
     no top margin. */
  .cs-section--banner:first-of-type { margin-top: 0; }
  /* A banner immediately followed by an OverlayBanner sits flush with
     the overlay below it. */
  .cs-section--banner:has(+ section.cs-overlay) { margin-bottom: 0; }

  @media (max-width: 720px) {
    .cs-section { padding-block: var(--s-10); }
  }

  .cs-section__head {
    display: grid;
    gap: var(--s-3);
    margin-bottom: var(--s-6);
  }
  .cs-section__eyebrow { margin: 0; }
  .cs-section__title   { margin: 0; display: inline-flex; align-items: center; gap: var(--s-3); flex-wrap: wrap; }

  /* Sub-section title: smaller, sans bold — for in-page subsections that
     aren't a major banner divider (e.g. pain-point callouts). */
  .cs-section--sub { padding-block: var(--s-8); }
  .cs-section--sub .cs-section__head { margin-bottom: var(--s-4); }
  .cs-section--sub .cs-section__title {
    font-family: var(--font-sans);
    font-size: clamp(22px, 2.2vw, 28px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.014em;
  }
  .cs-section--sub .cs-icon {
    width: 28px;
    height: 28px;
  }

  .cs-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
  }
  .cs-icon svg { width: 100%; height: 100%; display: block; }
  .cs-icon--warning { color: #F4B400; }
  .cs-icon--success { color: #1FA463; }

  /* ===== Full-bleed banner ===== */
  .cs-banner {
    background: var(--brand-gradient-soft);
    padding-block: clamp(var(--s-6), 2.4vw, var(--s-10));
  }
  .cs-banner__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    /* Align banner title left edge with centered narrow-column text.
       100% resolves to the viewport-wide parent (.cs-banner), so:
         - When viewport ≤ 1240px: need (viewport − 760) / 2 = (100% − 760px) / 2
         - When viewport > 1240px: need fixed (1240 − 760) / 2 = 240px
       min() picks the smaller value, which is correct in both cases. */
    padding-inline: min(
      calc((var(--content-max) - var(--content-narrow)) / 2),
      calc((100% - var(--content-narrow)) / 2)
    );
    display: grid;
    gap: var(--s-2);
  }
  .cs-banner__eyebrow { margin: 0; color: var(--text-secondary); }
  .cs-banner__title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(28px, 3.6vw, 44px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    flex-wrap: wrap;
  }

  .cs-section__body--banner {
    max-width: var(--content-max);
    margin: var(--s-10) auto 0;
    padding-inline: min(
      calc((var(--content-max) - var(--content-narrow)) / 2),
      calc((100% - var(--content-narrow)) / 2)
    );
  }
  /* When a banner section has no body content (e.g. <Section banner />
     used purely as a divider), the empty body div leaves a 40px ghost gap.
     Collapse it so the next section sits flush against the banner. */
  .cs-section__body--banner:empty { margin: 0; }

  /* Default body typography. */
  .cs-section__body :global(p) {
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-primary);
    margin: 0 0 var(--s-5);
  }
  .cs-section__body :global(p:last-child) { margin-bottom: 0; }

  .cs-section__body :global(h3) {
    font-family: var(--font-sans);
    font-size: clamp(16px, 1.3vw, 19px);
    font-weight: 600;
    letter-spacing: -0.012em;
    line-height: 1.3;
    color: var(--text-primary);
    margin: var(--s-8) 0 var(--s-3);
  }
  .cs-section__body :global(h3:first-child) { margin-top: 0; }

  .cs-section__body :global(h4) {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.012em;
    color: var(--text-primary);
    margin: var(--s-6) 0 var(--s-3);
  }

  .cs-section__body :global(ul),
  .cs-section__body :global(ol) {
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-primary);
    margin: 0 0 var(--s-5);
    padding-left: var(--s-5);
  }
  .cs-section__body :global(li) { margin-bottom: var(--s-2); }

  .cs-section__body :global(a) {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--brand-underline);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    transition: text-decoration-color .25s var(--ease);
  }
  .cs-section__body :global(a:hover) { text-decoration-color: var(--text-primary); }

  .cs-section__body :global(strong) {
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Page-specific overrides */
  .cs-section.cs-festival-2019,
  .cs-section.cs-relaunch-2019 { padding-top: var(--s-24); }

  /* Why-Explore stat tiles: oversized display value so the number reads
     as the headline of each tile when stacked in a narrow column. */
  .cs-section.cs-explore-stats :global(.cs-stat) {
    padding: var(--s-5);
    gap: var(--s-1);
  }
  .cs-section.cs-explore-stats :global(.cs-stat__value) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(36px, 3.6vw, 48px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .cs-section.cs-explore-stats :global(.cs-stat__label) {
    font-size: 13px;
    color: var(--text-secondary);
  }
</style>
