---
import BaseLayout from "../layouts/BaseLayout.astro";
import FadeIn from "../components/FadeIn.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Hi, in five languages. Auto-rotates with a width-animated container so
// the comma after the ticker glides instead of jumping.
const greetings = [
  { lang: "English",  hi: "Hi" },
  { lang: "Mandarin", hi: "你好" },
  { lang: "French",   hi: "Bonjour" },
  { lang: "Spanish",  hi: "Hola" },
  { lang: "Japanese", hi: "こんにちは" },
];

const hobbies = [
  {
    emoji: "🐈‍⬛",
    label: "Cat mom",
    photo: `${base}/about/cat-mom.JPG`,
    tilt: 5,
  },
  {
    emoji: "🤿",
    label: "Scuba diver",
    photo: `${base}/about/scuba-diving.JPG`,
    tilt: -5,
  },
  {
    emoji: "🏂",
    label: "Snowboarder",
    photo: `${base}/about/snowboarding.JPG`,
    tilt: 4,
  },
  {
    emoji: "🌐",
    label: "Language learner",
    captionList: ["Mandarin", "French", "Spanish", "Japanese", "English"],
  },
];
---

<BaseLayout title="About">
  <div class="about-canvas" id="about-canvas">
    <article class="page-narrow about">
      <FadeIn>
        <p class="t-eyebrow about-eyebrow">About</p>
      </FadeIn>

      <FadeIn delay={80}>
        <h1 class="about-title">
          <span class="hi-ticker" aria-live="polite">
            <span class="hi-ghost" aria-hidden="true">&nbsp;</span>
            {greetings.map((g, i) => (
              <span class={`hi-word ${i === 0 ? "is-active" : ""}`} data-lang={g.lang}>{g.hi}</span>
            ))}
          </span><span class="title-rest">, I'm Julia.</span>
        </h1>
      </FadeIn>

      <FadeIn delay={160}>
        <ul class="pill-row" aria-label="Outside of work">
          {hobbies.map((h) => (
            <li>
              <span class="pill" tabindex="0">
                {h.photo && (
                  <span
                    class="pill-photo"
                    style={`--tilt:${h.tilt}deg`}
                    aria-hidden="true"
                  >
                    <img src={h.photo} alt="" loading="lazy" />
                  </span>
                )}
                {h.captionList && (
                  <ul class="pill-caption" aria-hidden="true">
                    {h.captionList.map((item) => <li>{item}</li>)}
                  </ul>
                )}
                <span class="pill-emoji" aria-hidden="true">{h.emoji}</span>
                <span class="pill-label">{h.label}</span>
              </span>
            </li>
          ))}
        </ul>
      </FadeIn>

      <div class="about-body-stack">
        <div class="fade-in portrait-wrap" style="transition-delay: 240ms">
          <div class="portrait portrait--inline">
            <img src={`${base}/about/julia.jpg`} alt="Portrait of Julia Tang" loading="eager" />
          </div>
        </div>

        <FadeIn delay={240}>
          <p class="about-body">
            I'm a Staff Product Designer at <strong class="co co--snap"><img src={`${base}/logos/snapchat.png`} alt="" aria-hidden="true" />Snap</strong>, where I scaled Snapchat Games to 30M+ DAU and
            present product strategy to the CEO weekly.
          </p>
        </FadeIn>

        <FadeIn delay={240}>
          <p class="about-body">
            At <strong class="co co--tinder"><img src={`${base}/logos/tinder.png`} alt="" aria-hidden="true" />Tinder</strong>, I shipped Tappy Cloud, the backend-driven
            platform behind relationship intent and profile customization
            at scale. At <strong class="co co--tvtime"><img src={`${base}/logos/tv time.png`} alt="" aria-hidden="true" />TV Time</strong>, I doubled the user base from 10M to
            20M during my time there, and I won a <a
              class="prose-out prose-out--preview"
              href="https://winners.webbyawards.com/2021/apps-software/general-apps/entertainment-sports/167683/tv-time"
              target="_blank"
              rel="noopener noreferrer"
            ><span
              class="prose-out__preview prose-out__preview--round"
              style="--tilt:-3deg"
              aria-hidden="true"
            ><img src={`${base}/about/webby-tv-time.png`} alt="" loading="lazy" /></span>Webby</a> for my work.
            At <strong class="co co--whip"><img src={`${base}/logos/whip media.png`} alt="" aria-hidden="true" />Whip Media</strong>, I built a B2B content licensing
            marketplace, used by NBCUniversal, Warner Bros., and HBO.
          </p>
        </FadeIn>

        <FadeIn delay={240}>
          <p class="about-body">
            Before product design, I studied <span class="fx fx--film"
              ><span class="fx-photo" style="--tilt:-5deg" aria-hidden="true"><img
                src={`${base}/about/film.png`} alt="" loading="lazy" /></span
              >film</span> at USC. I got my start in design working at an
            agency on major film marketing campaigns, including my award-winning work on <a
              class="prose-out prose-out--preview"
              href="https://www.thetangentagency.com/projects/lego-movie-2"
              target="_blank"
              rel="noopener noreferrer"
            ><span
              class="prose-out__preview prose-out__preview--bare prose-out__preview--wide"
              style="--tilt:4deg"
              aria-hidden="true"
            ><img src={`${base}/about/lego-movie-2.gif`} alt="" loading="lazy" /></span><em>The
              Lego Movie 2</em></a>.
          </p>
        </FadeIn>

        <FadeIn delay={240}>
          <p class="about-body">
            I've always been drawn to technology as a tool to <b>connect us</b>. COVID made that visceral: being forced apart showed how much digital products could either bridge that distance or fail to, and it shaped the moves I made after.
          </p>
        </FadeIn>

        <FadeIn delay={240}>
          <p class="about-body about-highlight">
            As AI reshapes how we engage with the world, designing
            experiences that feel genuinely human matters more than ever.
          </p>
        </FadeIn>

        <FadeIn delay={240}>
          <p class="about-body">
            Designing for that, in this moment, is a <b>systems problem</b>. Each feature is a piece of a whole, and the
            question is always how the pieces work together toward something
            greater. That's the space I work in: <b>strategic</b> enough to define what to build, <b>systems-minded</b> enough to connect the pieces, and <b>obsessive about craft</b> to make sure none of it gets lost in execution.
          </p>
        </FadeIn>
      </div>

      <FadeIn delay={320}>
        <p class="about-body">Want to see it in practice?</p>
      </FadeIn>

      <FadeIn delay={320}>
        <div class="about-cta">
          <a href={`${base}/`} class="cta-btn">
            Check out my work!
            <span class="cta-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </FadeIn>

    </article>
  </div>
</BaseLayout>

<script is:inline>
  // Polyglot ticker — width-animated container + cross-fade so the comma
  // after the ticker glides smoothly instead of snapping.
  (async function () {
    const ticker = document.querySelector(".hi-ticker");
    if (!ticker) return;
    const words = Array.from(ticker.querySelectorAll(".hi-word"));
    if (words.length < 2) return;

    if (document.fonts && document.fonts.ready) {
      try { await document.fonts.ready; } catch (e) {}
    }

    function measure() {
      return words.map((w) => {
        const clone = w.cloneNode(true);
        clone.removeAttribute("class");
        clone.style.cssText =
          "position:absolute;visibility:hidden;opacity:1;transform:none;" +
          "white-space:nowrap;left:0;top:0;";
        ticker.appendChild(clone);
        const width = Math.ceil(clone.getBoundingClientRect().width);
        clone.remove();
        return width;
      });
    }

    let widths = measure();
    let i = 0;
    ticker.style.setProperty("--w", widths[i] + "px");

    const HOLD = 2400;
    const FADE = 700;

    setInterval(() => {
      const current = words[i];
      i = (i + 1) % words.length;
      const next = words[i];

      current.classList.remove("is-active");
      current.classList.add("is-leaving");
      next.classList.add("is-active");
      ticker.style.setProperty("--w", widths[i] + "px");

      setTimeout(() => {
        current.classList.remove("is-leaving");
      }, FADE);
    }, HOLD);

    let resizeT;
    window.addEventListener("resize", () => {
      clearTimeout(resizeT);
      resizeT = setTimeout(() => {
        widths = measure();
        ticker.style.setProperty("--w", widths[i] + "px");
      }, 120);
    });
  })();
</script>

<style>
  .about-canvas {
    position: relative;
    isolation: isolate;
  }

  .about { padding-top: var(--s-16); position: relative; }
  .about-eyebrow { margin-bottom: var(--s-3); color: var(--text-tertiary); }

  /* Body stack — paragraphs flush-left at the same edge as the title and
     pills. Portrait floats inside so body wraps next to it, then continues
     full-width below the float (no empty space under the portrait). */
  .about-body-stack {
    margin-top: var(--s-4);
  }
  .about-body-stack::after {
    content: "";
    display: block;
    clear: both;
  }

  .portrait-wrap {
    float: left;
    width: 308px;
    margin: 4px var(--s-6) var(--s-3) 0;
    position: relative;
    z-index: 1;
  }
  .portrait {
    /* polaroid card — natural aspect ratio image, generous bottom matte. */
    background: var(--bg-surface);
    padding: 12px 12px 38px;
    border-radius: var(--r-sm);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-subtle);
  }
  .portrait--inline {
    transform: rotate(-2deg);
    transform-origin: 50% 50%;
    transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .portrait--inline:hover {
    transform: rotate(-0.5deg);
  }
  .portrait img {
    width: 100%;
    height: auto;
    display: block;
  }
  @media (max-width: 600px) {
    .portrait-wrap {
      float: none;
      width: 200px;
      margin: 0 0 var(--s-4) 0;
    }
  }

  .about-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: normal;
    font-size: clamp(48px, 6.4vw, 88px);
    line-height: 1.0;
    letter-spacing: -0.01em;
    margin: 0 0 var(--s-10);
    color: var(--text-primary);
    white-space: nowrap;
  }
  @media (max-width: 720px) {
    .about-title { white-space: normal; }
  }

  .hi-ticker {
    position: relative;
    display: inline-block;
    vertical-align: baseline;
    width: var(--w, auto);
    height: 1em;
    line-height: 1;
    transition: width 600ms cubic-bezier(0.16, 1, 0.3, 1);
    overflow: visible;
  }
  .hi-ghost {
    display: inline-block;
    width: 0;
    visibility: hidden;
  }
  .hi-word {
    position: absolute;
    top: 0;
    left: 0;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-0.32em);
    transition:
      opacity 480ms var(--ease-out),
      transform 700ms var(--ease-out);
    will-change: opacity, transform;
  }
  .hi-word.is-active {
    opacity: 1;
    transform: translateY(0);
    transition-duration: 700ms;
  }
  .hi-word.is-leaving {
    opacity: 0;
    transform: translateY(0.32em);
    transition-duration: 380ms;
  }
  .title-rest { color: var(--text-primary); }

  /* All about-page body paragraphs share the same type so the page reads
     as a single voice, not a resume summary + body. */
  .about-body {
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-primary);
    margin: 0 0 var(--s-5);
  }
  .about-body strong {
    font-weight: 600;
    color: var(--text-primary);
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    padding-bottom: 1px;
  }

  /* Interactive company callouts — small logo to the left, brand underline
     at rest, company-colored wash on hover. Matches the homepage hero pattern. */
  .about-body .co {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    line-height: inherit;
    white-space: nowrap;
    gap: 0.32em;
    padding: 0 0.18em;
    cursor: default;
    border-radius: var(--r-xs);
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    transition:
      background-size 280ms var(--ease-out),
      background-image 280ms var(--ease-out);
  }
  .about-body .co img {
    height: 0.95em;
    width: auto;
    max-width: 1.4em;
    display: inline-block;
    object-fit: contain;
    position: relative;
    z-index: 1;
  }
  .about-body .co:hover {
    background-size: 100% 100%;
  }
  .about-body .co--snap:hover {
    background-image: linear-gradient(var(--co-wash-snap), var(--co-wash-snap));
  }
  .about-body .co--tinder:hover {
    background-image: linear-gradient(var(--co-wash-tinder), var(--co-wash-tinder));
  }
  .about-body .co--tvtime:hover {
    background-image: linear-gradient(var(--co-wash-tvtime), var(--co-wash-tvtime));
  }
  .about-body .co--whip:hover {
    background-image: linear-gradient(var(--co-wash-whip), var(--co-wash-whip));
  }

  .fx {
    position: relative;
    display: inline-block;
    cursor: default;
  }

  /* Polaroid photo that appears above an .fx word on hover. Image renders
     at natural aspect (no crop). Each .fx-photo can set its own --tilt. */
  .fx-photo {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    width: 240px;
    pointer-events: none;
    opacity: 0;
    transform: translateX(-50%) translateY(8px) rotate(var(--tilt, -4deg)) scale(0.94);
    transform-origin: 50% 100%;
    transition:
      opacity 240ms var(--ease-out),
      transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 5;
    background: var(--bg-surface);
    padding: 6px 6px 32px;
    border-radius: var(--r-sm);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-subtle);
  }
  .fx-photo img {
    width: 100%;
    height: auto;
    display: block;
  }
  .fx:hover .fx-photo {
    opacity: 1;
    transform: translateX(-50%) translateY(0) rotate(var(--tilt, -4deg)) scale(1);
  }

  .fx--film,
  .fx--clio {
    font-weight: 600;
    color: var(--text-primary);
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    padding-bottom: 1px;
    border-radius: var(--r-xs);
    transition:
      background-size 280ms var(--ease-out),
      background-image 280ms var(--ease-out);
  }
  .fx--film:hover,
  .fx--clio:hover {
    background-image: linear-gradient(var(--brand-wash-soft), var(--brand-wash-soft));
    background-size: 100% 100%;
  }

  .about-highlight {
    position: relative;
    background-color: var(--bg-surface);
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.62), rgba(255, 255, 255, 0.62)),
      linear-gradient(
        135deg,
        #F8E4D9 0%,
        #EAE2F0 45%,
        #F8E4D9 75%,
        #DDEAF2 100%
      );
    background-size: 100% 100%, 260% 260%;
    background-position: 0 0, 0% 50%;
    background-repeat: no-repeat, no-repeat;
    border-radius: var(--r-sm);
    padding: var(--s-4) var(--s-5);
    text-align: center;
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(20px, 2.2vw, 24px);
    line-height: 1.35;
    transition: background-color 600ms var(--ease-out);
  }
  .about-highlight::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1.5px;
    background: conic-gradient(
      from var(--shine-angle, 0deg),
      transparent 0deg,
      rgba(197, 220, 234, 0.9) 60deg,
      rgba(220, 210, 232, 0.9) 110deg,
      rgba(244, 217, 204, 0.9) 160deg,
      transparent 220deg,
      transparent 360deg
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
            mask-composite: exclude;
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
    pointer-events: none;
  }
  .about-highlight:hover {
    animation: about-highlight-drift 8s ease-in-out infinite;
  }
  .about-highlight:hover::before {
    opacity: 1;
    animation: about-highlight-shine 6s linear infinite;
  }
  @keyframes about-highlight-drift {
    0%   { background-position: 0 0, 0% 50%; }
    50%  { background-position: 0 0, 100% 50%; }
    100% { background-position: 0 0, 0% 50%; }
  }
  @property --shine-angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }
  @keyframes about-highlight-shine {
    to { --shine-angle: 360deg; }
  }
  @media (prefers-reduced-motion: reduce) {
    .about-highlight,
    .about-highlight:hover,
    .about-highlight:hover::before { animation: none; transition: none; }
  }

  .about-body b {
    font-weight: 600;
    color: var(--text-primary);
  }

  .fx--key {
    font-weight: 600;
    color: var(--text-primary);
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    padding-bottom: 1px;
    border-radius: var(--r-xs);
    transition:
      background-size 280ms var(--ease-out),
      background-image 280ms var(--ease-out);
  }
  .fx--key:hover {
    background-image: linear-gradient(var(--brand-wash-soft), var(--brand-wash-soft));
    background-size: 100% 100%;
  }

  /* Outbound prose links — match the fx-- words: brand underline fills to a
     full wash on hover so the whole word highlights. */
  .prose-out {
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    padding-bottom: 1px;
    border-radius: var(--r-xs);
    transition:
      background-size 280ms var(--ease-out),
      background-image 280ms var(--ease-out);
  }
  .prose-out:hover {
    background-image: linear-gradient(var(--brand-wash-soft), var(--brand-wash-soft));
    background-size: 100% 100%;
  }

  /* Image preview that floats above the link on hover. Default has a
     polaroid frame; the --bare modifier drops the frame for actual work
     images (Webby, Lego Movie 2). Each preview can set its own --tilt. */
  .prose-out--preview {
    position: relative;
  }
  .prose-out__preview {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    width: 220px;
    pointer-events: none;
    opacity: 0;
    transform: translateX(-50%) translateY(8px) rotate(var(--tilt, -3deg)) scale(0.94);
    transform-origin: 50% 100%;
    transition:
      opacity 240ms var(--ease-out),
      transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 5;
    background: var(--bg-surface);
    padding: 10px 10px 40px;
    border-radius: var(--r-sm);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-subtle);
  }
  .prose-out__preview--bare {
    background: none;
    padding: 0;
    border: none;
    border-radius: var(--r-xs);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  .prose-out__preview--round {
    width: 162px;
    aspect-ratio: 1 / 1;
    background: none;
    padding: 0;
    border: none;
    border-radius: 50%;
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  .prose-out__preview--round img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.18);
    transform-origin: center;
  }
  .prose-out__preview--wide { width: 320px; }
  .prose-out__preview img {
    width: 100%;
    height: auto;
    display: block;
  }
  .prose-out--preview:hover .prose-out__preview,
  .prose-out--preview:focus-visible .prose-out__preview {
    opacity: 1;
    transform: translateX(-50%) translateY(0) rotate(var(--tilt, -3deg)) scale(1);
  }

  /* === Hobby pills === */
  .pill-row {
    list-style: none;
    margin: 0 0 var(--s-8);
    padding: 0;
    display: flex;
    flex-wrap: nowrap;
    gap: var(--s-3);
  }
  @media (max-width: 720px) {
    .pill-row { flex-wrap: wrap; }
  }

  .pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-5);
    border-radius: var(--r-full);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    font-size: 14px;
    color: var(--text-primary);
    line-height: 1;
    cursor: default;
    user-select: none;
    flex-shrink: 0;
    transition:
      background-color 280ms var(--ease-out),
      border-color 280ms var(--ease-out),
      transform 280ms var(--ease-out),
      box-shadow 280ms var(--ease-out);
  }
  .pill:hover,
  .pill:focus-visible {
    background: var(--bg-surface);
    border-color: var(--text-tertiary);
    transform: translateY(-1px);
    box-shadow: 0 12px 28px -14px rgba(20, 22, 28, 0.22);
    outline: none;
  }

  .pill-emoji {
    display: inline-block;
    font-size: 18px;
    line-height: 1;
  }

  .pill-label { font-weight: 500; white-space: nowrap; }

  /* Vertical bullet list to the right of the pill on hover (used for
     Language learning to surface the actual languages). */
  .pill-caption {
    position: absolute;
    left: calc(100% + var(--s-4));
    top: 50%;
    pointer-events: none;
    opacity: 0;
    transform: translateY(-50%) translateX(-8px);
    transition:
      opacity 240ms var(--ease-out),
      transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 5;
    list-style: disc;
    padding: 0 0 0 18px;
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-secondary);
    white-space: nowrap;
  }
  .pill-caption li::marker {
    color: var(--text-tertiary);
  }
  .pill:hover .pill-caption,
  .pill:focus-visible .pill-caption {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

