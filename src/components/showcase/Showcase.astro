---
/**
 * Showcase — one project block on the v2 home page.
 *
 * Layout (desktop):
 *   ┌──────────────────┬──────────────────┐
 *   │ eyebrow / title  │  hero (slot)     │
 *   │ tagline          │                  │
 *   │ stats            │                  │
 *   │ CTA              │                  │
 *   └──────────────────┴──────────────────┘
 *
 * On mobile, the hero stacks above the text.
 *
 * Stats are passed as a small array; pass an interactive hero via the slot.
 */
interface StatProps {
  value: string;
  label: string;
}
interface PressLogo {
  src: string;
  alt: string;
  /** Per-logo rendered height in px to optically balance wordmarks of
   *  different cap-heights / tagline depths. Defaults to the base CSS height. */
  height?: number;
  /** External press article URL. When set, the logo links out in a new tab. */
  href?: string;
  /** Per-logo vertical nudge (px) to align the visible wordmark baseline
   *  across logos whose internal composition isn't centered (e.g. logos with
   *  a crest or icon above the wordmark). Negative = up. */
  nudgeY?: number;
  /** Optional text rendered to the right of the logo as part of the same
   *  clickable unit (e.g. "Newsroom" next to the Snap Inc. logo so the
   *  pair reads as "Snap, Inc. Newsroom"). */
  suffix?: string;
  /** Vertical nudge (px) applied to the whole logo+suffix unit (the <li>).
   *  Use this to optically lift or drop the entire item relative to its row
   *  siblings. Negative = up. */
  wrapNudgeY?: number;
}
interface Props {
  /** Path to a company logo PNG/SVG. Rendered as a height-locked img next
   *  to the company name so the brand is the strongest signal in the row. */
  companyLogo?: string;
  companyName?: string;
  year?: string | number;
  role?: string;
  title: string;
  /** A single string renders as one paragraph; an array renders each item
   *  as its own paragraph so the body text reads as two beats (context →
   *  what I did) rather than one dense block. */
  tagline?: string | string[];
  stats?: StatProps[];
  /** Optional bullet list rendered between tagline and CTA (e.g. "Featuring:"). */
  features?: string[];
  ctaHref?: string;
  ctaLabel?: string;
  /** Optional press logos rendered as a small "As seen on" row just above
   *  the CTA button. */
  press?: PressLogo[];
  accent?: string;
  reverse?: boolean;
  /** Optional anchor id so a sticky nav can deep-link to this section. */
  id?: string;
  /** When true, render as a placeholder block — no case study link, a
   *  disabled "Case study coming soon" button instead of the CTA, and the
   *  title/hero are not clickable. Hovering anywhere on the showcase swaps
   *  the button label to "Ask me about it!" (still in disabled style). */
  comingSoon?: boolean;
  /** Optional full-bleed decorative background image (e.g. a wave) that
   *  spans the full width of the showcase band behind everything else.
   *  Used to give a single card a stronger brand backdrop without changing
   *  the rest of the page rhythm. */
  bgImage?: string;
  /** Optional override for the gap between stat columns. CSS length
   *  (e.g. "20px" or "var(--s-5)"). Defaults to var(--s-8). */
  statsGap?: string;
  /** Optional override for the stats grid max-width. CSS length
   *  (e.g. "32ch"). Defaults to 46ch. Narrowing this shrinks every
   *  column proportionally. */
  statsMaxWidth?: string;
  /** When true, pull the text column toward the hero column instead of
   *  centering each inside its grid cell. Useful when the hero artwork
   *  is visually heavy and the gap reads too wide. */
  tightHero?: boolean;
  /** Inverse of tightHero: pushes the text column away from the hero,
   *  hugging the outer edge of its grid cell. Useful when the gap reads
   *  too tight and centering doesn't give enough breathing room. */
  pushTextOut?: boolean;
  /** Optional override for the text column max-width. CSS length
   *  (e.g. "500px"). Defaults to 440px. */
  textMaxWidth?: string;
  /** Optional override for the gap between the text column and the hero
   *  column inside .showcase__inner. CSS length (e.g. "var(--s-10)").
   *  Defaults to var(--s-6). */
  innerGap?: string;
  /** Optional override for the stat value font-size. CSS length
   *  (e.g. "24px"). Defaults to clamp(22px, 2vw, 28px). */
  statsValueFontSize?: string;
}
const {
  companyLogo,
  companyName,
  year,
  role,
  title,
  tagline,
  stats = [],
  features = [],
  ctaHref,
  ctaLabel = "Read case study",
  press = [],
  accent,
  reverse = false,
  id,
  comingSoon = false,
  bgImage,
  statsGap,
  statsMaxWidth,
  tightHero = false,
  pushTextOut = false,
  textMaxWidth,
  innerGap,
  statsValueFontSize,
} = Astro.props;
const resolvedBgImage = bgImage && (bgImage.startsWith("http")
  ? bgImage
  : `${import.meta.env.BASE_URL.replace(/\/$/, "")}${bgImage.startsWith("/") ? "" : "/"}${bgImage}`);
// v2 (Rina Kang style): the homepage IS the case study. No link-outs,
// no CTA, no clickable title or hero. ctaHref/ctaLabel are accepted on
// the API for compatibility but intentionally not rendered.
const isLinked = false;
const isExternal = !!ctaHref && /^https?:\/\//.test(ctaHref);

const accentStyle = accent ? `--cs-accent:${accent};` : "";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolvedLogo = companyLogo && (companyLogo.startsWith("http") || companyLogo.startsWith(base)
  ? companyLogo
  : `${base}${companyLogo.startsWith("/") ? "" : "/"}${companyLogo}`);
const meta = [role].filter(Boolean) as string[];
---

<section class={"showcase" + (reverse ? " showcase--reverse" : "") + (resolvedBgImage ? " showcase--has-bg-image" : "") + (tightHero ? " showcase--tight-hero" : "") + (pushTextOut ? " showcase--push-text-out" : "")} style={accentStyle} id={id}>
  {resolvedBgImage && (
    <div class="showcase__bg" aria-hidden="true">
      <img src={resolvedBgImage} alt="" loading="lazy" />
    </div>
  )}
  <div class="showcase__inner" style={innerGap ? `gap:${innerGap};` : undefined}>
    <div class="showcase__text" style={textMaxWidth ? `max-width:${textMaxWidth};` : undefined}>
      {(resolvedLogo || companyName) && (
        <div class="showcase__brand">
          {resolvedLogo && (
            <img
              class={"showcase__logo " + (companyName ? "showcase__logo--has-name" : "")}
              src={resolvedLogo}
              alt={companyName ? "" : (companyName || "")}
              loading="lazy"
            />
          )}
          {companyName && <span class="showcase__company">{companyName}</span>}
        </div>
      )}
      <h2 class="showcase__title">{title}</h2>
      {tagline && (
        Array.isArray(tagline)
          ? <div class="showcase__tagline">{tagline.map((para) => <p>{para}</p>)}</div>
          : <p class="showcase__tagline">{tagline}</p>
      )}
      {features.length > 0 && (
        <div class="showcase__features">
          <p class="showcase__features-label">Featuring:</p>
          <ul class="showcase__features-list">
            {features.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      )}
      {stats.length > 0 && (
        <ul class="showcase__stats-grid" style={`--stat-cols:${stats.map(s => `minmax(0, ${(s as any).colFr ?? 1}fr)`).join(" ")};${statsGap ? `--stat-gap:${statsGap};` : ""}${statsMaxWidth ? `--stats-max-width:${statsMaxWidth};` : ""}${statsValueFontSize ? `--stat-value-fs:${statsValueFontSize};` : ""}`}>
          {stats.map((s) => (
            <li class="showcase__stat-cell">
              <span class="showcase__stat-value">{s.value}</span>
              <span class="showcase__stat-label">{s.label}</span>
            </li>
          ))}
        </ul>
      )}
      {comingSoon && (
        <p class="showcase__coming-soon">
          <button class="showcase__coming-soon-btn" disabled aria-disabled="true">
            <span class="showcase__cs-default">Case study available for interviews</span>
            <span class="showcase__cs-hover" aria-hidden="true">Ask me about it!</span>
          </button>
        </p>
      )}
      {press.length > 0 && (
        <div class="showcase__press" aria-label="Featured in">
          <ul class="showcase__press-logos" role="list">
            {press.map((logo) => {
              const imgStyle = [
                logo.height ? `height:${logo.height}px` : null,
                logo.nudgeY ? `transform:translateY(${logo.nudgeY}px)` : null,
              ].filter(Boolean).join(";") || undefined;
              const img = (
                <img
                  src={`${base}${logo.src.startsWith("/") ? "" : "/"}${logo.src}`}
                  alt={logo.alt}
                  loading="lazy"
                  style={imgStyle}
                />
              );
              const liStyle = logo.wrapNudgeY
                ? `transform:translateY(${logo.wrapNudgeY}px)`
                : undefined;
              return (
                <li style={liStyle}>
                  {logo.href ? (
                    <a
                      class="showcase__press-link"
                      href={logo.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Read ${logo.alt}${logo.suffix ? " " + logo.suffix : ""} article`}
                    >
                      <span class="showcase__press-content">
                        {img}
                        {logo.suffix && <span class="showcase__press-suffix">{logo.suffix}</span>}
                      </span>
                    </a>
                  ) : (
                    <>
                      {img}
                      {logo.suffix && <span class="showcase__press-suffix">{logo.suffix}</span>}
                    </>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      )}
    </div>
    <div class="showcase__hero">
      <slot />
    </div>
  </div>
</section>

<style>
  .showcase {
    --cs-accent: var(--brand-primary);
    padding-block: var(--s-20);
    position: relative;
  }
  .showcase::before {
    /* Soft brand-color cloud contained within the section so adjacent
       showcases don't produce hard edges where their gradients meet. */
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(55% 65% at 50% 50%, color-mix(in srgb, var(--cs-accent) 18%, transparent) 0%, transparent 50%);
    z-index: 0;
    pointer-events: none;
  }
  @media (max-width: 900px) {
    .showcase { padding-block: var(--s-12); }
  }
  @media (max-width: 480px) {
    .showcase { padding-block: var(--s-10); }
  }

  /* Optional full-bleed decorative background (e.g. wave). Sits behind
     the radial cloud and any content. The image fills width edge-to-edge
     and is vertically anchored to the bottom so the wave reads as a
     ground plane the phones float over. */
  .showcase--has-bg-image::before { display: none; }
  .showcase__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .showcase__bg img {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: auto;
    display: block;
  }

  /* Both columns are equal-width so the two halves carry the same
     amount of negative space; the text and image inside each column
     are then constrained and centered so the whole composition reads
     as one centered band rather than a left-flush text + centered
     image (which made the page feel off-balance). */
  .showcase__inner {
    position: relative;
    z-index: 1;
    /* Match the homepage hero grid so the project text + media sit in the
       same horizontal range as the hero copy above (cols 4 onward of a
       12-col grid spanning the same outer container). */
    max-width: 1640px;
    margin: 0 auto;
    padding: 0 clamp(var(--s-6), 3vw, var(--s-12));
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--s-6);
    gap: var(--s-6);
    align-items: center;
  }
  /* Non-reverse: text on left, hero/media on right — both inside cols 3-11. */
  .showcase__text { grid-column: 3 / span 4; }
  .showcase__hero {
    grid-column: 7 / span 5;
    position: relative;
    z-index: 2;
  }
  /* Reverse: hero on left, text on right — still pinned to cols 3-11. */
  .showcase--reverse .showcase__hero { grid-column: 3 / span 4; }
  .showcase--reverse .showcase__text { grid-column: 7 / span 5; }
  .showcase--reverse .showcase__text { order: 2; }
  .showcase--reverse .showcase__hero { order: 1; }
  /* tightHero: pull the text column toward the hero column. On non-reverse,
     text sits on the left and hero on the right, so we push text to the
     right edge of its cell and hero to the left of its cell. Mirror for
     reverse. */
  .showcase--tight-hero .showcase__inner {
    gap: var(--s-2);
  }
  /* At narrow-desktop / tablet widths (901–1280px) the tight-hero 8px gap
     pulls the hero composition (e.g. a phone-stack) flush against the
     text column with no breathing room. Restore a meaningful gap in that
     band so the two columns visibly separate; the wide-desktop layout
     above 1280px already has enough cell width to absorb the tight gap. */
  @media (max-width: 1280px) and (min-width: 901px) {
    .showcase--tight-hero .showcase__inner {
      gap: var(--s-8);
    }
  }
  .showcase--tight-hero:not(.showcase--reverse) .showcase__text {
    margin-inline: auto 0;
  }
  .showcase--tight-hero:not(.showcase--reverse) .showcase__hero {
    justify-self: start;
  }
  .showcase--tight-hero.showcase--reverse .showcase__text {
    margin-inline: 0 auto;
  }
  .showcase--tight-hero.showcase--reverse .showcase__hero {
    justify-self: end;
  }
  /* pushTextOut: opposite of tightHero — push the text column to the far
     edge of its cell (away from the hero) for more visual breathing room
     without changing the cell positions. */
  .showcase--push-text-out:not(.showcase--reverse) .showcase__text {
    margin-inline: 0 auto;
  }
  .showcase--push-text-out.showcase--reverse .showcase__text {
    margin-inline: auto 0;
  }

  .showcase__text {
    max-width: 440px;
    margin-inline: auto;
    width: 100%;
  }

  @media (max-width: 900px) {
    .showcase__inner { grid-template-columns: 1fr; gap: var(--s-6); padding: 0 var(--s-5); overflow-x: clip; }
    .showcase__text,
    .showcase__hero,
    .showcase--reverse .showcase__text,
    .showcase--reverse .showcase__hero { grid-column: 1 / -1; }
    .showcase__text { max-width: 520px; }
    .showcase--reverse .showcase__text { order: 2; }
    .showcase--reverse .showcase__hero { order: 1; }
    .showcase__inner > .showcase__text { order: 2; }
    .showcase__inner > .showcase__hero { order: 1; }
    /* Drop the desktop 440px hero floor so a short hero (e.g. a 320px
       phone composition) doesn't reserve 100+px of empty space above
       the text column on mobile. */
    .showcase__hero { min-height: 0; }
  }

  .showcase__brand {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin: 0 0 var(--s-4);
  }
  .showcase__logo {
    height: clamp(14px, 1.28vw, 18px);
    width: auto;
    display: block;
    object-fit: contain;
  }
  .showcase__company {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-primary);
  }
  .showcase__meta {
    margin: 0 0 var(--s-3);
    color: var(--text-tertiary);
  }

  .showcase__title {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(32px, 3.96vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin: 0 0 var(--s-5);
  }
  @media (max-width: 480px) {
    .showcase__title { font-size: 30px; margin-bottom: var(--s-4); }
  }
  .showcase__title-link {
    color: inherit;
    text-decoration: none;
    display: inline-block;
  }

  .showcase__tagline {
    font-size: clamp(14px, 1.05vw, 16px);
    line-height: 1.55;
    color: var(--text-secondary);
    margin: 0 0 var(--s-8);
    max-width: 42ch;
  }
  @media (max-width: 900px) {
    .showcase__tagline { margin-bottom: var(--s-6); }
  }
  .showcase__tagline p {
    margin: 0 0 var(--s-4);
  }
  .showcase__tagline p:last-child {
    margin-bottom: 0;
  }

  /* Stats sit directly under the title as the project's impact proof.
     Equal-width columns so a long label never pushes a sibling onto a
     new line; on narrow widths the grid collapses to a stack. Max-width
     is matched to the tagline measure so the divider line above the
     metrics aligns with the prose block, not the full text column. */
  .showcase__stats-grid {
    list-style: none;
    margin: 0 0 var(--s-6);
    padding: 0 0 var(--s-6);
    position: relative;
    display: grid;
    grid-template-columns: var(--stat-cols, minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr));
    gap: var(--stat-gap, var(--s-8));
    /* font-size and max-width match the tagline so the 40ch measure
       resolves to the same pixel width and the divider line above the
       metrics aligns exactly with the prose block edge. The value/label
       children set their own font-size so this only affects ch math. */
    font-size: clamp(14px, 1.05vw, 16px);
    max-width: var(--stats-max-width, 46ch);
  }
  .showcase__stats-grid:has(~ .showcase__press)::before {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 0.5px;
    background: linear-gradient(
      90deg,
      #C5DCEA 0%,
      #DCD2E8 25%,
      #F4D9CC 50%,
      #DCD2E8 75%,
      #C5DCEA 100%
    );
    background-size: 200% 100%;
    animation: showcase-stats-border-shimmer 9s linear infinite;
    border-radius: 1px;
    opacity: 0.55;
    pointer-events: none;
  }
  @keyframes showcase-stats-border-shimmer {
    from { background-position: 0% 50%; }
    to { background-position: 200% 50%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .showcase__stats-grid::before { animation: none; }
  }
  .showcase__stat-cell {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .showcase__stat-value {
    font-family: var(--font-sans);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
    font-size: var(--stat-value-fs, clamp(24px, 2.1vw, 28px));
    letter-spacing: -0.014em;
    line-height: 1.1;
    white-space: nowrap;
  }
  .showcase__stat-label {
    color: var(--text-tertiary);
    font-size: 13px;
    line-height: 1.35;
    /* Reserve 2 label lines per cell so 1-line and 2-line labels in the
       same row occupy the same vertical band. Short labels center inside
       that band so they don't read as "top-stuck with empty space below."
       text-wrap: pretty discourages orphans on modern browsers; labels
       themselves also glue their final two words with NBSP as a fallback. */
    min-height: calc(1.35em * 2);
    display: flex;
    align-items: flex-start;
    text-wrap: pretty;
  }
  @media (max-width: 520px) {
    /* Keep the metrics as N columns side by side on small viewports
       (don't collapse to a stack) — just tighten the gap, drop the desktop
       width cap so the columns use the full text width, and scale the
       values down so each fits its narrower column. */
    .showcase__stats-grid {
      gap: var(--s-2);
      max-width: 100%;
      padding-bottom: var(--s-5);
      margin-bottom: var(--s-5);
    }
    .showcase__stat-cell { gap: 4px; }
    .showcase__stat-value { font-size: clamp(15px, 4.6vw, 22px); }
  }
  /* Smallest phones: tighten further so 3 columns + their labels still fit. */
  @media (max-width: 360px) {
    .showcase__stats-grid { gap: var(--s-1); }
    .showcase__stat-value { font-size: clamp(14px, 4.4vw, 18px); }
  }
  .showcase__stats-sep {
    color: var(--text-tertiary);
    opacity: 0.55;
    user-select: none;
  }

  /* Press: no label, smaller logos, quieter row. Reads as a caption. */
  .showcase__press {
    margin: var(--s-4) 0 0;
  }
  .showcase__press-logos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--s-2) var(--s-3);
  }
  #festival-mode .showcase__press-logos {
    gap: var(--s-3) var(--s-6);
  }
  .showcase__press-logos li {
    display: flex;
    align-items: flex-end;
  }
  .showcase__press-suffix {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-tertiary);
    line-height: 1;
    margin-left: 3px;
    opacity: 0.7;
    transform: translateY(-1px);
    transition: opacity 200ms var(--ease-out);
  }
  .showcase__press-link:hover .showcase__press-suffix,
  .showcase__press-link:focus-visible .showcase__press-suffix {
    opacity: 1;
  }
  .showcase__press-logos img {
    height: 17.6px;
    width: auto;
    object-fit: contain;
    display: block;
    opacity: 0.55;
    transition: opacity 200ms var(--ease-out);
  }
  /* The press logos ship as dark-ink PNGs sized for the light canvas, so
     in dark mode they're effectively invisible. Invert the bitmaps and
     lift the resting opacity so they read as light marks on dark. */
  :global([data-theme="dark"]) .showcase__press-logos img {
    filter: invert(1) hue-rotate(180deg);
    opacity: 0.7;
  }
  .showcase__press-logos img:hover { opacity: 1; }
  .showcase__press-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    line-height: 0;
    transition: transform var(--dur-normal) var(--ease-out);
  }
  .showcase__press-content {
    display: inline-flex;
    align-items: center;
  }
  .showcase__press-link:hover img,
  .showcase__press-link:focus-visible img {
    opacity: 1;
  }
  .showcase__press-link:hover,
  .showcase__press-link:focus-visible {
    transform: translateY(-1px);
  }
  /* Touch devices: the 16px logo + 0.55 opacity hover-brighten reads as a
     too-small, too-faint tap target (and the hover lift never fires).
     Lift the rest opacity to 0.85 and expand the hit area with vertical
     padding so each logo gets a comfortable ~36px tap zone without
     visually growing the logo itself. */
  @media (hover: none), (pointer: coarse) {
    .showcase__press-logos img { opacity: 0.85; }
    .showcase__press-link {
      padding: 10px 4px;
      margin: -10px -4px;
    }
    .showcase__press-link:active {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .showcase__cta {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
  }
  .showcase__cta-btn {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--text-primary);
    text-decoration: none;
    padding: 10px 18px;
    border-radius: var(--r-full);
    border: 1.5px solid var(--border-default);
    background: var(--bg-surface);
    transition:
      border-color var(--dur-normal) var(--ease-out),
      gap var(--dur-normal) var(--ease-out),
      transform var(--dur-normal) var(--ease-out),
      box-shadow var(--dur-normal) var(--ease-out);
  }
  /* Liquid fill — soft brand wash rises from below on hover with a
     curved leading edge that flattens as the fill rises. */
  .showcase__cta-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--brand-wash);
    transform: translateY(101%);
    border-radius: 50% 50% 0 0 / 16px 16px 0 0;
    transition:
      transform 720ms cubic-bezier(0.45, 0, 0.15, 1),
      border-radius 720ms cubic-bezier(0.45, 0, 0.15, 1);
    pointer-events: none;
    z-index: 0;
  }
  .showcase__cta-btn > * { position: relative; z-index: 1; }
  .showcase__cta-arrow {
    font-size: 1.05em;
    line-height: 0;
    transition: transform var(--dur-normal) var(--ease-out);
  }
  /* Hover state triggers on button itself, OR when hovering the title link
     or the hero asset — so the whole project card reads as one interactive
     unit. */
  .showcase__cta-btn:hover,
  .showcase__cta-btn:focus-visible,
  .showcase:has(.showcase__title-link:hover) .showcase__cta-btn,
  .showcase:has(.showcase__title-link:focus-visible) .showcase__cta-btn,
  .showcase:has(.showcase__hero-link:hover) .showcase__cta-btn,
  .showcase:has(.showcase__hero-link:focus-visible) .showcase__cta-btn {
    gap: var(--s-3);
    border-color: var(--text-tertiary);
    transform: translateY(-1px);
    box-shadow: 0 12px 28px -14px rgba(20, 22, 28, 0.22);
  }
  .showcase__cta-btn:hover::before,
  .showcase__cta-btn:focus-visible::before,
  .showcase:has(.showcase__title-link:hover) .showcase__cta-btn::before,
  .showcase:has(.showcase__title-link:focus-visible) .showcase__cta-btn::before,
  .showcase:has(.showcase__hero-link:hover) .showcase__cta-btn::before,
  .showcase:has(.showcase__hero-link:focus-visible) .showcase__cta-btn::before {
    transform: translateY(0);
    border-radius: 0;
  }
  .showcase__cta-btn:hover .showcase__cta-arrow,
  .showcase__cta-btn:focus-visible .showcase__cta-arrow,
  .showcase:has(.showcase__title-link:hover) .showcase__cta-arrow,
  .showcase:has(.showcase__title-link:focus-visible) .showcase__cta-arrow,
  .showcase:has(.showcase__hero-link:hover) .showcase__cta-arrow,
  .showcase:has(.showcase__hero-link:focus-visible) .showcase__cta-arrow {
    transform: translate(2px, -2px);
  }

  @media (min-width: 901px) {
    /* Drag hints and curved arrows bleed past the phone frame. */
    .showcase__hero { overflow: visible; }
  }
  .showcase__hero {
    position: relative;
    min-height: 440px;
    /* Wider than the previous 440 cap so heroes that want to match the
       App Redesign phone's ~659px visual height (Custom Lists cluster,
       TV Time hero-2.webp) can do so without being clipped by the column.
       Smaller heroes still cap themselves via their own max-width. */
    max-width: 540px;
    margin-inline: auto;
    width: 100%;
  }
  /* Pin every known hero component to the OUTER edge of its grid cell so
     the graphic's outer edge falls on the same vertical line as the body
     copy on the opposite side of the page. Each hero component sets its
     own `margin: 0 auto` (centered in cell) internally; this override
     replaces that centering based on which side of the page the hero
     lives on, so the whole project list reads as one grid system with
     two consistent vertical gutters instead of every cell having its own
     centered island of content.

     The list of inner classes below MUST stay in sync with the homepage
     hero components — if a new hero type is added under .showcase__hero,
     add its outermost class here. */
  @media (min-width: 901px) {
    /* Non-reverse projects: hero lives in the wide (5-col) cell on the
       right. The reverse projects' text on the opposite side sits in a
       5-col cell with max-width 440 centered, so its right edge falls
       (cell_width - 440)/2 in from the cell's right boundary. Match that
       offset here so this hero's right edge lands on the same vertical
       line as those texts' right edges. */
    :global(.showcase:not(.showcase--reverse) :is(.media-parallax, .phone-video, .profile-cols, .phone-pair, .phone-cluster, .phone-columns, .phone-stack, .video-card-stack, .compare-slider, [data-card-stack])) {
      margin-inline: auto max(0px, calc((100% - 440px) / 2)) !important;
    }
    /* Reverse projects: hero lives in the narrow (4-col) cell on the
       left. The non-reverse projects' text on the opposite side sits in
       the same-width 4-col cell with max-width 440 (cap doesn't bind, so
       text fills the cell starting at cell left). Pin this hero's left
       edge to the same cell-left line. */
    :global(.showcase--reverse :is(.media-parallax, .phone-video, .profile-cols, .phone-pair, .phone-cluster, .phone-columns, .phone-stack, .video-card-stack, .compare-slider, [data-card-stack])) {
      margin-inline: 0 auto !important;
    }
  }
  @media (max-width: 900px) {
    /* Drop the desktop 440px hero floor on mobile so a shorter hero
       composition doesn't reserve 100+px of dead space above the text
       column when the two columns stack. */
    .showcase__hero { min-height: 0; }
  }
  .showcase__hero-link {
    display: block;
    color: inherit;
    text-decoration: none;
    outline: none;
    transition: transform var(--dur-normal) var(--ease-out);
  }
  .showcase__hero--linked:hover .showcase__hero-link {
    transform: translateY(-3px);
  }

  /* Features list (e.g. "Featuring: Dark Mode, Prompts…") */
  .showcase__features {
    margin-bottom: var(--s-4);
  }
  .showcase__features-label {
    font-size: 13px;
    color: var(--text-secondary);
    margin: 0 0 var(--s-1);
    font-weight: 500;
  }
  .showcase__features-list {
    list-style: disc;
    padding-left: var(--s-4);
    margin: 0;
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  /* Coming-soon disabled button */
  .showcase__coming-soon { margin: 0; }
  .showcase__coming-soon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 18px;
    border-radius: var(--r-full);
    background: transparent;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    border: 1.5px solid var(--border-default);
    cursor: default;
    position: relative;
    overflow: hidden;
    /* width set by JS after font measurement */
    transition: width 220ms var(--ease-out);
  }

  .showcase__cs-default {
    white-space: nowrap;
    transition: opacity 160ms var(--ease-out), transform 160ms var(--ease-out);
  }
  .showcase__cs-hover {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 160ms var(--ease-out), transform 160ms var(--ease-out);
  }

  /* JS adds .cs-hovered to the button on hover of title / hero / button */
  .showcase__coming-soon-btn.cs-hovered .showcase__cs-default {
    opacity: 0;
    transform: translateY(-6px);
  }
  .showcase__coming-soon-btn.cs-hovered .showcase__cs-hover {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase__coming-soon-btn { transition: none; }
    .showcase__cs-default,
    .showcase__cs-hover { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    function initComingSoon() {
      document.querySelectorAll(".showcase__coming-soon-btn").forEach(function (btn) {
        var showcase = btn.closest(".showcase");
        if (!showcase) return;
        var defaultEl = btn.querySelector(".showcase__cs-default");
        var hoverEl   = btn.querySelector(".showcase__cs-hover");
        if (!defaultEl || !hoverEl) return;

        // Measure default width
        var defaultW = btn.offsetWidth;

        // Briefly swap to hover state (no transition) to measure its width
        btn.style.transition   = "none";
        defaultEl.style.opacity    = "0";
        defaultEl.style.visibility = "hidden";
        hoverEl.style.position  = "static";
        hoverEl.style.opacity   = "1";
        hoverEl.style.transform = "none";
        var hoverW = btn.offsetWidth;

        // Restore
        defaultEl.style.opacity    = "";
        defaultEl.style.visibility = "";
        hoverEl.style.position  = "";
        hoverEl.style.opacity   = "";
        hoverEl.style.transform = "";

        // Lock initial width, then re-enable the width transition
        btn.style.width = defaultW + "px";
        void btn.offsetWidth; // force reflow
        btn.style.transition = "";

        var title = showcase.querySelector(".showcase__title");
        var hero  = showcase.querySelector(".showcase__hero");
        var triggers = [btn, title, hero].filter(Boolean);

        var leaveTimer;
        function activate() {
          clearTimeout(leaveTimer);
          btn.style.width = hoverW + "px";
          btn.classList.add("cs-hovered");
        }
        function deactivate() {
          leaveTimer = setTimeout(function () {
            btn.style.width = defaultW + "px";
            btn.classList.remove("cs-hovered");
          }, 40);
        }

        triggers.forEach(function (el) {
          el.addEventListener("mouseenter", activate);
          el.addEventListener("mouseleave", deactivate);
        });
      });
    }

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(initComingSoon);
    } else if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initComingSoon, { once: true });
    } else {
      initComingSoon();
    }
  })();
</script>
