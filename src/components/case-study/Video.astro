---
/**
 * Video — autoplaying, muted, looping inline video. Accessible (no audio).
 *
 * Width modifiers mirror <Figure>: narrow / wide / bleed.
 */
interface Props {
  src: string;
  poster?: string;
  caption?: string;
  width?: "narrow" | "wide" | "bleed";
  aspect?: string;
  device?: "phone" | "auto";
  loop?: boolean;
  controls?: boolean;
}

const {
  src,
  poster,
  caption,
  width = "narrow",
  aspect,
  device = "auto",
  loop = true,
  controls = false,
} = Astro.props;

const finalAspect = aspect ?? (device === "phone" ? "9 / 19.5" : undefined);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolve = (p: string) =>
  p.startsWith("http") || p.startsWith(base)
    ? p
    : `${base}${p.startsWith("/") ? "" : "/"}${p}`;

const resolvedSrc = resolve(src);
const resolvedPoster = poster ? resolve(poster) : undefined;
const cls = [
  "cs-video",
  `cs-figure--${width}`,
  device === "phone" ? "cs-video--device-phone" : "",
].filter(Boolean).join(" ");
---

<figure class={cls}>
  <div class="cs-video__media" style={finalAspect ? `aspect-ratio:${finalAspect}` : undefined}>
    <video
      src={resolvedSrc}
      poster={resolvedPoster}
      autoplay
      muted
      playsinline
      loop={loop}
      controls={controls}
      preload="metadata"
    ></video>
  </div>
  {caption && <figcaption class="cs-figure__caption">{caption}</figcaption>}
</figure>

<style>
  .cs-video { margin: var(--s-8) auto; }
  .cs-figure--narrow { max-width: var(--content-narrow); }
  .cs-figure--wide   { max-width: var(--content-max); }
  .cs-figure--bleed  {
    max-width: none;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }
  .cs-video__media {
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--bg-sunken);
  }
  /* Phone-shaped videos cap their width like Figure does for phone screens. */
  .cs-video--device-phone .cs-video__media { max-width: 320px; margin-inline: auto; }
  .cs-video--device-phone.cs-figure--wide .cs-video__media { max-width: 360px; }
  .cs-figure--bleed .cs-video__media { border-radius: 0; }
  .cs-video__media video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  .cs-figure__caption {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-tertiary);
    text-align: center;
    margin-top: var(--s-3);
    padding-inline: var(--s-4);
  }
</style>
