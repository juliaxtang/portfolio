---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="page footer-grid">
    <div class="footer-brand">
      <p class="t-display-md italic">Julia Tang</p>
      <p class="t-caption">© {year}</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <div class="footer-col">
        <p class="t-eyebrow">Work</p>
        <ul>
          <li><a href={`${base}/`}>Selected projects</a></li>
          <li><a href={`${base}/about`}>About</a></li>
          <li><a href={`${base}/resume.pdf`} download>Resume</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <p class="t-eyebrow">Contact</p>
        <ul>
          <li><a href="mailto:hello@juliatang.design">Email</a></li>
          <li><a href="https://www.linkedin.com/in/juliaxtang/" target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--s-32);
    padding: var(--s-16) 0 var(--s-12);
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-canvas);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: var(--s-12);
    align-items: start;
  }
  .footer-brand .italic { font-style: italic; }
  .footer-brand .t-caption { margin-top: var(--s-3); }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-8);
  }
  .footer-col p { margin: 0 0 var(--s-4); }
  .footer-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-2); }
  .footer-col a {
    color: var(--text-secondary);
    transition: color var(--dur-fast) var(--ease);
    font-size: 15px;
  }
  .footer-col a:hover { color: var(--text-primary); }

  @media (max-width: 720px) {
    .footer-grid { grid-template-columns: 1fr; gap: var(--s-8); }
    .footer-nav { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
