---
/**
 * HeroProfileColumns — three parallax columns of profile cards for the
 * Tappy Cloud hero. Columns 1 and 3 drift upward on scroll; column 2
 * drifts downward, creating an alternating parallax rhythm that mirrors
 * the homepage showcase.
 *
 * Each column image is a full-height strip. On load the columns are
 * centered in their available height; the scroll listener shifts them
 * by a fraction of their overflow.
 */
interface Props {
  col1: string;
  col2: string;
  col3: string;
  alt1?: string;
  alt2?: string;
  alt3?: string;
  /** Speed multiplier — 1.0 = full overflow travel across the hero. */
  speed?: number;
}
const { col1, col2, col3, alt1 = "", alt2 = "", alt3 = "", speed = 0.7 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolve = (p: string) =>
  p.startsWith("http") || p.startsWith(base) ? p : `${base}${p.startsWith("/") ? "" : "/"}${p}`;
const id = "hpc-" + Math.random().toString(36).slice(2, 8);
---

<div class="hpc" id={id} data-speed={speed} aria-hidden="true">
  <div class="hpc__col"><img src={resolve(col1)} alt={alt1} draggable="false" data-dir="-1" /></div>
  <div class="hpc__col"><img src={resolve(col2)} alt={alt2} draggable="false" data-dir="1" /></div>
  <div class="hpc__col"><img src={resolve(col3)} alt={alt3} draggable="false" data-dir="-1" /></div>
</div>

<script is:inline>
  (function () {
    if (typeof window === "undefined") return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    function init() {
      document.querySelectorAll(".hpc").forEach(function (root) {
        const speed = parseFloat(root.dataset.speed || "0.7");
        const cols = Array.from(root.querySelectorAll(".hpc__col"));
        const imgs = cols.map(function (c) { return c.querySelector("img"); });
        let raf = 0;

        // Set initial positions: odd columns start at top (show upper part),
        // even column starts at bottom (show lower part) so they diverge.
        function setInitial() {
          cols.forEach(function (col, i) {
            const img = imgs[i];
            if (!img) return;
            const colH = col.clientHeight;
            const imgH = img.clientHeight;
            const extra = Math.max(imgH - colH, 0);
            const dir = parseInt(img.dataset.dir || "-1");
            // dir=-1 (up): start centered-ish near top; dir=1 (down): start near bottom
            const startY = dir === 1 ? -extra : 0;
            img.dataset.startY = String(startY);
            img.dataset.extra = String(extra);
            img.style.transform = "translate3d(0," + startY + "px,0)";
          });
        }

        function update() {
          raf = 0;
          const hero = root.closest(".cs-hero");
          if (!hero) return;
          const rect = hero.getBoundingClientRect();
          const progress = Math.min(Math.max(-rect.top / (rect.height || 1), 0), 1);
          cols.forEach(function (col, i) {
            const img = imgs[i];
            if (!img) return;
            const extra = parseFloat(img.dataset.extra || "0");
            const startY = parseFloat(img.dataset.startY || "0");
            const dir = parseInt(img.dataset.dir || "-1");
            const travel = extra * speed;
            const y = startY + dir * progress * travel;
            img.style.transform = "translate3d(0," + y + "px,0)";
          });
        }

        // Re-init on image load since clientHeight is 0 until images render.
        imgs.forEach(function (img) {
          if (img) {
            if (!img.complete) {
              img.addEventListener("load", function () { setInitial(); update(); }, { once: true });
            }
          }
        });

        window.addEventListener("scroll", function () {
          if (!raf) raf = requestAnimationFrame(update);
        }, { passive: true });
        window.addEventListener("resize", function () { setInitial(); update(); });
        setInitial();
        update();
      });
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
  })();
</script>

<style>
  .hpc {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(6px, 1.2vw, 12px);
    width: 100%;
    height: 100%;
    overflow: visible;
    padding: 0 var(--s-3);
  }

  .hpc__col {
    position: relative;
    overflow: hidden;
    height: 100%;
  }

  .hpc__col img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    display: block;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }
</style>
