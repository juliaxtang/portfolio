---
/**
 * HeroTwoPhones — two phones for case-study heroes, mirroring the
 * homepage PhonePair sizing, positioning, and scroll parallax so a case
 * study's hero matches the corresponding showcase card.
 *
 * Hardcoded to the homepage Festival Mode card layout (the only current
 * consumer). If another case study adopts two-phones, accept positioning
 * props instead of hardcoding here.
 */
interface Props {
  phone1: string;
  phone2: string;
  alt1?: string;
  alt2?: string;
}
const { phone1, phone2, alt1 = "", alt2 = "" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolve = (p: string) =>
  p.startsWith("http") || p.startsWith(base) ? p : `${base}${p.startsWith("/") ? "" : "/"}${p}`;

/* Top offsets are shifted up vs the homepage card so both phones fit
   fully inside the (shorter) case-study hero band. The relative ordering
   (phone 2 slightly higher than phone 1) is preserved. */
const phones = [
  {
    src: resolve(phone1),
    alt: alt1,
    left: -0.04,
    top: -0.04,
    width: 0.66,
    aspect: "1408 / 2356",
    drift: 64,
    hoverLift: 10,
    z: 2,
  },
  {
    src: resolve(phone2),
    alt: alt2,
    left: 0.42,
    top: -0.06,
    width: 0.56,
    aspect: "1288 / 2344",
    drift: -28,
    hoverLift: 6,
    z: 1,
  },
];
---

<div class="htp" aria-hidden="true">
  {phones.map((p) => (
    <div
      class="htp__phone"
      style={`
        --x:${(p.left * 100).toFixed(2)}%;
        --y:${(p.top * 100).toFixed(2)}%;
        --w:${(p.width * 100).toFixed(2)}%;
        --aspect:${p.aspect};
        --drift:${p.drift}px;
        --hover-lift:${p.hoverLift}px;
        z-index:${p.z};
      `}
      data-drift={p.drift}
    >
      <img src={p.src} alt={p.alt} draggable="false" />
    </div>
  ))}
</div>

<script is:inline>
  (function () {
    if (typeof window === "undefined") return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    function init() {
      document.querySelectorAll(".htp").forEach(function (root) {
        const phones = Array.from(root.querySelectorAll(".htp__phone"));
        let raf = 0;
        function update() {
          raf = 0;
          const rect = root.getBoundingClientRect();
          const vh = window.innerHeight || document.documentElement.clientHeight;
          const total = vh + rect.height;
          if (total <= 0) return;
          const traveled = vh - rect.top;
          const progress = Math.min(Math.max(traveled / total, 0), 1);
          const centered = progress - 0.5;
          phones.forEach(function (phone) {
            const drift = parseFloat(phone.dataset.drift || "30");
            const y = -centered * drift;
            phone.style.setProperty("--scroll-y", y.toFixed(1) + "px");
          });
        }
        function onScroll() {
          if (!raf) raf = requestAnimationFrame(update);
        }
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
        update();
      });
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
  })();
</script>

<style>
  /* Absolutely positioned so phones float over the visual column
     without pushing the hero band taller. Sized to match the homepage
     PhonePair (500×500) and centered in the visual column. */
  .htp {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(100%, 500px);
    aspect-ratio: 1 / 1;
    isolation: isolate;
    pointer-events: none;
  }

  .htp__phone {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    aspect-ratio: var(--aspect, 9 / 19.5);
    --scroll-y: 0px;
    --hover-y: 0px;
    --hover-scale: 1;
    will-change: transform, filter;
    transform: translate3d(0, calc(var(--scroll-y) + var(--hover-y)), 0)
               scale(var(--hover-scale));
    transition: transform 520ms var(--ease-out),
                filter 320ms var(--ease-out);
    pointer-events: auto;
  }
  .htp__phone:hover {
    --hover-y: calc(-1 * var(--hover-lift));
    --hover-scale: 1.05;
    z-index: 50;
  }
  .htp__phone:hover img {
    filter: drop-shadow(0 30px 48px rgba(40, 30, 80, 0.30));
  }
  .htp__phone img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 20px 36px rgba(40, 30, 80, 0.20));
    pointer-events: none;
    transition: filter 320ms var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .htp__phone { transition: none !important; transform: none !important; }
  }
</style>
