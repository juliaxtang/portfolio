---
/**
 * HeroGrid — a whisper-quiet dot grid that distorts toward the cursor.
 * Layered over the page-wide CursorAurora inside the hero section only.
 * Dots within ~160px of the cursor nudge toward it with smooth falloff.
 */
---

<canvas class="hero-grid" id="hero-grid" aria-hidden="true"></canvas>

<script is:inline>
  (function () {
    const canvas = document.getElementById("hero-grid");
    if (!canvas) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const ctx = canvas.getContext("2d");
    const SPACING = 28;
    const RADIUS = 160;
    const MAX_PULL = 6;
    const DOT_R = 1.1;

    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    let w = 0, h = 0;
    let mx = -9999, my = -9999;
    let tmx = -9999, tmy = -9999;
    let raf = 0;
    let active = false;

    function resize() {
      const rect = canvas.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      canvas.width = Math.floor(w * dpr);
      canvas.height = Math.floor(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw();
    }

    function draw() {
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = "rgba(20, 20, 30, 0.085)";
      const cols = Math.ceil(w / SPACING) + 1;
      const rows = Math.ceil(h / SPACING) + 1;
      for (let i = 0; i < cols; i++) {
        for (let j = 0; j < rows; j++) {
          const px = i * SPACING;
          const py = j * SPACING;
          let dx = 0, dy = 0;
          if (mx > -9000) {
            const ox = px - mx;
            const oy = py - my;
            const dist = Math.sqrt(ox * ox + oy * oy);
            if (dist < RADIUS && dist > 0.001) {
              const fall = 1 - dist / RADIUS;
              const pull = MAX_PULL * fall * fall;
              dx = -(ox / dist) * pull;
              dy = -(oy / dist) * pull;
            }
          }
          ctx.beginPath();
          ctx.arc(px + dx, py + dy, DOT_R, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    }

    function loop() {
      mx += (tmx - mx) * 0.18;
      my += (tmy - my) * 0.18;
      draw();
      // Stop the loop once the cursor has fully decayed away.
      if (!active && Math.abs(tmx - mx) < 0.5 && Math.abs(tmy - my) < 0.5) {
        raf = 0;
        return;
      }
      raf = requestAnimationFrame(loop);
    }

    function kick() {
      if (!raf) raf = requestAnimationFrame(loop);
    }

    function onMove(e) {
      const rect = canvas.getBoundingClientRect();
      tmx = e.clientX - rect.left;
      tmy = e.clientY - rect.top;
      active = tmx >= 0 && tmy >= 0 && tmx <= w && tmy <= h;
      if (mx < -9000) { mx = tmx; my = tmy; }
      kick();
    }

    function onLeave() {
      active = false;
      tmx = -9999;
      tmy = -9999;
      kick();
    }

    resize();
    window.addEventListener("resize", resize, { passive: true });
    if (!reduce) {
      window.addEventListener("mousemove", onMove, { passive: true });
      window.addEventListener("mouseout", (e) => { if (!e.relatedTarget) onLeave(); });
    }
  })();
</script>

<style>
  .hero-grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    opacity: 0.55;
    mix-blend-mode: multiply;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-grid { opacity: 0.4; }
  }
</style>
