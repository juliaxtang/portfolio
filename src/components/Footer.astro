---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const EMAIL = "juliaxtang@gmail.com";
---

<footer class="site-footer">
  <div class="page footer-inner">
    <p class="footer-brand__name">
      Made with
      <svg
        class="footer-heart"
        viewBox="0 0 24 22"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M2.6 5.1 C 3.4 2.9, 6.1 1.7, 8.6 2.7 C 10.4 3.4, 11.3 5.0, 12.0 6.6 C 12.8 4.8, 14.0 3.1, 16.1 2.5 C 18.7 1.9, 21.5 3.6, 21.9 6.3 C 22.3 8.9, 20.7 11.2, 19.0 13.0 C 16.9 15.3, 14.5 17.2, 12.3 19.3 C 12.0 19.6, 11.8 19.4, 11.6 19.2 C 9.3 16.9, 6.5 14.9, 4.4 12.3 C 2.9 10.4, 1.8 7.7, 2.6 5.1 Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
          stroke-linecap="round"
        />
      </svg>
      <span class="footer-brand__tokens">(and tokens!)</span>
    </p>
    <nav class="footer-nav-pages" aria-label="Pages">
      <a href={`${base}/`}>Work</a>
      <a href={`${base}/about`}>About</a>
      <a href={`${base}/resume.pdf`} target="_blank" rel="noopener">Resume</a>
    </nav>
    <div class="footer-right">
      <span class="footer-chat-lede">Let's chat!</span>
      <button
        type="button"
        class="footer-email"
        data-cursor="copy-email"
        data-email={EMAIL}
        aria-label={`Copy email address ${EMAIL}`}
      >
        {EMAIL}
      </button>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--s-2) 0;
    border-top: 1px solid var(--border-default);
    background: var(--bg-canvas);
  }
  .footer-inner {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: nowrap;
    position: relative;
    line-height: 1;
    padding-top: var(--s-6);
    padding-bottom: var(--s-12);
  }
  .footer-brand__name {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 14px;
    letter-spacing: -0.005em;
    color: var(--text-secondary);
    white-space: nowrap;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
  }
  .footer-brand__tokens {
    color: var(--text-secondary);
    font-family: var(--font-hand);
    letter-spacing: -0.02em;
    font-size: 1.3em;
  }
  .footer-heart {
    width: 1.15em;
    height: 1.15em;
    color: var(--text-secondary);
    transform: translateY(0.05em) rotate(-6deg);
    overflow: visible;
  }
  .footer-nav-pages {
    display: flex;
    flex-direction: row;
    gap: var(--s-4);
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
  .footer-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--s-1);
    margin-left: auto;
    line-height: 1.2;
  }
  .footer-chat-lede {
    font-family: var(--font-hand);
    color: var(--text-secondary);
    font-size: 18px;
    letter-spacing: -0.02em;
  }
  .footer-email {
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    font-family: var(--font-sans);
    font-size: 14px;
    letter-spacing: -0.005em;
    color: var(--text-secondary);
    transition: color var(--dur-fast) var(--ease);
  }
  .footer-email:hover,
  .footer-email:focus-visible {
    color: var(--text-primary);
    outline: none;
  }
  .footer-nav-contact {
    display: flex;
    flex-direction: row;
    gap: var(--s-4);
  }
  .footer-nav-pages a,
  .footer-nav-contact a {
    color: var(--text-secondary);
    font-size: 14px;
    transition: color var(--dur-fast) var(--ease);
    white-space: nowrap;
  }
  .footer-nav-pages a:hover,
  .footer-nav-contact a:hover { color: var(--text-primary); }
  @media (max-width: 768px) {
    /* Two columns: brand stacked over the page nav on the left, the contact
       block (Let's chat! + email) on the right. The grid row-gap matches the
       contact column's internal gap (--s-1) so "Made with..." → nav sits the
       same distance apart as "Let's chat!" → email. Pulling the nav into
       normal flow also stops the absolute-centered nav overlapping. */
    .footer-inner {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: start;
      row-gap: var(--s-1);
      column-gap: var(--s-4);
      padding-bottom: var(--s-8);
    }
    .footer-brand__name { grid-column: 1; grid-row: 1; }
    .footer-nav-pages {
      position: static;
      left: auto;
      transform: none;
      grid-column: 1;
      grid-row: 2;
      justify-content: flex-start;
    }
    .footer-right {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: start;
      margin-left: 0;
      align-items: flex-end;
      text-align: right;
    }
    /* Shrink the footer type as the viewport narrows so the left (brand +
       nav) and right (contact) columns stay side by side and top-aligned
       instead of wrapping/stacking. clamp() max matches the desktop size,
       so this only kicks in once the columns would otherwise collide. */
    .footer-brand__name,
    .footer-nav-pages a,
    .footer-email {
      font-size: clamp(10px, 2.5vw, 14px);
    }
    .footer-chat-lede {
      font-size: clamp(12px, 3.2vw, 18px);
    }
  }
  @media (max-width: 420px) {
    /* Pull the columns a touch closer at the very bottom of the range. */
    .footer-inner { column-gap: var(--s-2); }
    .footer-nav-pages { gap: var(--s-3); }
  }
</style>
