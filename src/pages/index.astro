---
/**
 * Homepage — one-pager.
 *
 * Each case study is inlined as a `<Showcase>` block (Rina Kang /
 * Aaron James-style mini case studies) instead of linking out to a deep
 * case-study page from a tile grid. Each block has an interactive hero
 * (auto-cycling phone stack or looping GIF) and a CTA to the full case
 * study for anyone who wants the long version.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import FadeIn from "../components/FadeIn.astro";
import PearlField from "../components/PearlField.astro";
import CompanyPills from "../components/CompanyPills.astro";
import Showcase from "../components/showcase/Showcase.astro";
import PhoneVideoParallax from "../components/showcase/PhoneVideoParallax.astro";
import VideoStack from "../components/showcase/VideoStack.astro";
import { snapchatGamesStackItems, snapchatGamesStackProps } from "../components/showcase/projects/snapchatGamesStack";
import MediaParallax from "../components/showcase/MediaParallax.astro";
import TappyCloudShowcase from "../components/showcase/projects/TappyCloudShowcase.astro";
import FestivalModeShowcase from "../components/showcase/projects/FestivalModeShowcase.astro";
import CustomListsShowcase from "../components/showcase/projects/CustomListsShowcase.astro";

// "Julia" rendered letter-by-letter so each can bob on greeting hover.
const juliaHtml = ["J", "u", "l", "i", "a"]
  .map((c, i) => `<span class="julia-letter" style="--i:${i}">${c}</span>`)
  .join("");

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="Julia Tang | Design">
  <section class="v2-hero">
    <PearlField />
    <div class="page v2-hero__grid">
      <div class="v2-hero__text">
        <FadeIn>
          <p class="v2-hero__greeting">
            <span class="v2-hero__greeting-text">Hi, I'm <span class="julia-name" set:html={juliaHtml} />.</span>
            <span class="v2-hero__wave" aria-hidden="true">👋</span>
          </p>
        </FadeIn>

        <FadeIn delay={140}>
          <p class="v2-hero__lede">
            Product designer who turns ambiguous
            <span class="fx fx--launch">
              <span class="v2-hero__pop">0-to-1</span>
              <span class="fx-icon fx-icon--up" aria-hidden="true">🚀</span>
            </span>
            bets into
            <span class="fx fx--build">
              <span class="v2-hero__pop">systems</span>
              <span class="fx-icon fx-icon--puzzle" aria-hidden="true">🧩</span>
            </span>
            that scale.
          </p>
        </FadeIn>

        <FadeIn delay={240}>
          <p class="v2-hero__lede">
            Currently building social experiences on <span class="hero-co"><img src={`${base}/logos/snapchat.png`} alt="" aria-hidden="true" /><span class="v2-hero__pop">Snapchat</span></span>. Previously, the platform behind <span class="hero-co"><img src={`${base}/logos/tinder.png`} alt="" aria-hidden="true" /><span class="v2-hero__pop">Tinder</span></span>'s profile.
          </p>
        </FadeIn>

        <FadeIn delay={340}>
          <div class="co-pills-wrap">
            <p class="t-eyebrow co-pills-label">Jump to</p>
            <CompanyPills />
          </div>
        </FadeIn>
      </div>
    </div>
  </section>

  <script is:inline>
    // Re-trigger the Julia bob animation on every greeting hover-in.
    // Using a class toggle (instead of relying on `:hover`) so the
    // animation restarts cleanly even on fast hover-out/in cycles.
    (() => {
      const greeting = document.querySelector(".v2-hero__greeting");
      if (!greeting) return;
      let resetTimer;
      greeting.addEventListener("mouseenter", () => {
        greeting.classList.remove("is-waving");
        // Force a reflow so the class re-application starts a fresh animation.
        void greeting.offsetWidth;
        greeting.classList.add("is-waving");
        clearTimeout(resetTimer);
        // 800ms keyframe + max delay (75ms × 4 letters) ≈ 1.1s total.
        resetTimer = setTimeout(() => greeting.classList.remove("is-waving"), 1200);
      });
    })();
  </script>

  <FadeIn>
    <Showcase
      companyLogo="/logos/snapchat.png"
      companyName="Snapchat"
      role="Staff Product Designer"
      title="Snapchat Games"
      tagline="Defined product strategy and ecosystem direction for Snapchat Games, scaling it from an early-stage bet into a 30M+ DAU platform built on multiplayer, friend loops, and bi-directional communication."
      stats={[
        { value: "30M", label: "Games DAU" },
        { value: "↑ 2.9M", label: "Estimated Snap sends daily" },
        { value: "↑ 120%", label: "Game Video Posts on iOS" },
      ]}
      accent="#FFFC00"
      reverse
      id="snapchat-games"
      comingSoon
    >
      <VideoStack
        items={[...snapchatGamesStackItems]}
        {...snapchatGamesStackProps}
      />
    </Showcase>
  </FadeIn>

  <FadeIn>
    <Showcase
      companyLogo="/logos/snapchat.png"
      companyName="Snapchat"
      role="Staff Product Designer"
      title="Topic Chats"
      tagline="Scaled Topic Chats into a meaningful new engagement surface for Snapchat, driving roughly 71K incremental US DAU through live-event conversation, discovery, notifications, and sharing loops."
      stats={[
        { value: "↑ 71K", label: "Incremental US DAU" },
        { value: "40k", label: "Simultaneously active in chat during peak times" },
        { value: "208k", label: "Messages sent a week and counting" },
      ]}
      ctaHref="https://techcrunch.com/2025/11/18/snapchat-rolls-out-topic-chats-for-public-conversations/"
      ctaLabel="See press coverage"
      accent="#FFFC00"
      id="topic-chats"
    >
      <MediaParallax
        src="/projects/topic-chats/topic-chat-sizzle.mp4"
        aspect="9 / 16"
        maxWidth="324px"
        label="Topic Chats feature sizzle reel"
      />
    </Showcase>
  </FadeIn>

  <div id="tappy-cloud">
    <FadeIn>
      <TappyCloudShowcase reverse />
    </FadeIn>
  </div>

  <FadeIn>
    <FestivalModeShowcase />
  </FadeIn>

  <FadeIn>
    <Showcase
      companyLogo="/logos/tinder.png"
      companyName="Tinder"
      role="Senior Product Designer"
      title="App Redesign"
      tagline="Led Tinder's global redesign of profile and interaction systems, introducing richer self-expression formats across the app."
      features={[
        "Dark Mode",
        "Profile Prompts",
        "Quizzes",
        "New Swipe and Match Animations",
      ]}
      ctaHref="https://techcrunch.com/2023/11/20/tinder-redesigns-profile-pages-with-prompts-info-tags-and-quiz/"
      ctaLabel="See press coverage"
      accent="#FD297C"
      id="app-redesign"
      reverse
    >
      <PhoneVideoParallax
        videoSrc="/projects/tinder-app-redesign/sparks-recording.mp4"
        frameSrc="/projects/tinder-app-redesign/phone-frame.png"
        badgeSrc="/projects/tinder-app-redesign/Hackathon_winner_badge.png"
        videoLabel="Tinder Sparks profile redesign in motion"
        badgeAlt="2022 Tinder Hackathon Winner badge"
      />
    </Showcase>
  </FadeIn>

  <FadeIn>
    <CustomListsShowcase />
  </FadeIn>

</BaseLayout>

<style>
  .v2-hero {
    position: relative;
    overflow: hidden;
    padding-top: var(--s-8);
    padding-bottom: var(--s-8);
    /* Give the pearl cloud room to breathe even on tall viewports. */
    min-height: 440px;
  }

  .v2-hero__grid {
    position: relative;
    z-index: 1;
    display: block;
  }

  .v2-hero__text {
    display: grid;
    gap: var(--s-6);
    max-width: 620px;
    padding-left: 6vw;
  }
  @media (max-width: 720px) {
    .v2-hero__text { padding-left: 0; }
  }

  .v2-hero__greeting {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(44px, 6vw, 72px);
    line-height: 1.0;
    letter-spacing: -0.012em;
    color: var(--text-primary);
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-4);
  }
  .v2-hero__greeting-text { display: inline-block; }
  .v2-hero__wave {
    display: inline-block;
    font-style: normal;
    font-size: 0.7em;
    transform-origin: 70% 70%;
    cursor: default;
  }
  /* Wave when hovering the emoji itself, or anywhere on the greeting line. */
  .v2-hero__wave:hover,
  .v2-hero__greeting:hover .v2-hero__wave {
    animation: hero-wave 1.4s var(--ease-out) 0s 1 normal both;
  }
  @keyframes hero-wave {
    0%   { transform: rotate(0); }
    10%  { transform: rotate(16deg); }
    20%  { transform: rotate(-10deg); }
    30%  { transform: rotate(16deg); }
    50%  { transform: rotate(12deg); }
    60%, 100% { transform: rotate(0); }
  }

  /* Each letter of "Julia" bobs in a wave on greeting hover. The
     `.is-waving` class is toggled in JS so the animation restarts cleanly
     every time the user re-enters the greeting (CSS `:hover` alone can
     skip the restart on rapid hover-out/in cycles). */
  .julia-name { display: inline-block; }
  :global(.julia-letter) {
    display: inline-block;
    will-change: transform;
  }
  .v2-hero__greeting.is-waving :global(.julia-letter) {
    animation: julia-bob 800ms var(--ease-out);
    animation-delay: calc(var(--i, 0) * 75ms);
  }
  @keyframes julia-bob {
    0%, 100% { transform: translateY(0) rotate(0); }
    40%      { transform: translateY(-6px) rotate(4deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .v2-hero__greeting.is-waving :global(.julia-letter) { animation: none; }
  }

  .v2-hero__lede {
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.55;
    color: var(--text-primary);
    max-width: 560px;
    margin: 0;
    font-weight: 400;
  }

  .v2-hero__pop {
    display: inline-block;
    color: var(--text-primary);
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 2px;
    padding-bottom: 1px;
    border-radius: var(--r-xs);
  }

  .v2-hero__pop {
    transition:
      background-size 280ms var(--ease-out),
      background-image 280ms var(--ease-out),
      transform 220ms var(--ease-out);
  }

  /* Wrapping span that hosts a floating emoji which arcs out on hover.
     Pairs with v2-hero__pop on the inner text for the underline → wash
     highlight. */
  .fx { position: relative; display: inline-block; cursor: default; }
  .fx-icon {
    position: absolute;
    font-style: normal;
    font-size: 0.7em;
    line-height: 1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 240ms var(--ease-out), transform 540ms var(--ease-out);
  }
  /* Rocket on "0-to-1": tucked below-right at rest, arcs up-left on hover. */
  .fx-icon--up {
    top: -0.05em; right: -1em;
    transform: translateY(0.5em) rotate(40deg) scale(0.6);
  }
  .fx:hover .fx-icon--up {
    opacity: 1;
    transform: translateY(-0.65em) rotate(-25deg) scale(1.05);
  }
  /* Puzzle piece on "systems": placed on the LEFT so it doesn't collide
     with the trailing "that scale" copy. Peeks in from below-left, arcs
     up-left on hover. */
  .fx-icon--puzzle {
    bottom: -0.1em; left: -1.3em;
    transform: translateY(0.4em) scale(0.7) rotate(-12deg);
  }
  .fx:hover .fx-icon--puzzle {
    opacity: 1;
    transform: translateY(-0.55em) scale(1.05) rotate(8deg);
  }
  /* On hover, the inner pop word's underline grows into a wash and the
     word subtly lifts (matches the prior fx--launch/fx--reach treatment). */
  .fx:hover .v2-hero__pop {
    background-image: linear-gradient(var(--brand-wash-soft), var(--brand-wash-soft));
    background-size: 100% 100%;
    transform: translateY(-1px) scale(1.04);
  }

  /* Inline brand mark: logo is hidden at rest and slides in on hover.
     The name carries v2-hero__pop for the same underline → wash highlight
     as the other pop words, and the wash grows in sync. */
  .hero-co {
    display: inline-flex;
    align-items: baseline;
    line-height: inherit;
    white-space: nowrap;
    cursor: default;
  }
  .hero-co img {
    height: 0.95em;
    width: auto;
    max-width: 0;
    opacity: 0;
    margin-right: 0;
    display: inline-block;
    object-fit: contain;
    transition:
      max-width 320ms var(--ease-out),
      margin-right 320ms var(--ease-out),
      opacity 240ms var(--ease-out),
      transform 320ms var(--ease-out);
    transform: translateX(-0.2em) scale(0.6) rotate(-8deg);
  }
  .hero-co:hover img {
    max-width: 1.4em;
    opacity: 1;
    margin-right: 0.32em;
    transform: translateX(0) scale(1) rotate(0);
  }
  .hero-co:hover .v2-hero__pop {
    background-image: linear-gradient(var(--brand-wash-soft), var(--brand-wash-soft));
    background-size: 100% 100%;
    transform: translateY(-1px) scale(1.04);
    padding-inline: 0.15em;
  }

  .co-pills-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .co-pills-label {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .v2-hero__wave { animation: none; }
  }
</style>
