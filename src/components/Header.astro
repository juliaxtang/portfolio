---
import SocialIcons from "./SocialIcons.astro";
import ThemeToggle from "./ThemeToggle.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: `${base}/`, label: "Work" },
  { href: `${base}/about`, label: "About" },
  { href: `${base}/resume.pdf`, label: "Resume", external: true },
];
function isActive(href: string) {
  if (href.endsWith(".pdf")) return false;
  const normalized = href.replace(/\/$/, "") || "/";
  if (normalized === base || normalized === `${base}/` || normalized === "/") {
    return pathname === base || pathname === "/" || pathname === "";
  }
  return pathname.startsWith(normalized);
}
---

<header class="site-header" id="site-header">
  <div class="brand-row">
    <a class="brand" href={`${base}/`} id="site-brand" aria-label="Julia Tang, home">
      <span class="brand__mark">Julia Tang</span>
    </a>
    <ThemeToggle variant="inline" />
  </div>
  <nav aria-label="Primary">
    <ul class="nav-links">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              {...(l.external
                ? { target: "_blank", rel: "noopener" }
                : {})}
              {...(isActive(l.href)
                ? { "aria-current": "page" }
                : {})}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <SocialIcons variant="inline" />
</header>

<script is:inline>
  (function () {
    const header = document.getElementById("site-header");
    if (!header) return;
    const threshold = 24;
    function onScroll() {
      if (window.scrollY > threshold) header.classList.add("is-scrolled");
      else header.classList.remove("is-scrolled");
    }
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
    padding: var(--s-5) var(--s-8);
    background: transparent;
    transition:
      background-color var(--dur-normal) var(--ease),
      backdrop-filter var(--dur-normal) var(--ease),
      border-color var(--dur-normal) var(--ease),
      box-shadow var(--dur-normal) var(--ease);
    border-bottom: 1px solid transparent;
  }
  /* Desktop: the persistent <SideRail> is the brand + nav, so the
     horizontal sticky header is hidden. Below 1024px the rail collapses
     and this header reappears so nav is always reachable. */
  @media (min-width: 1024px) {
    .site-header { display: none; }
  }
  /* Tablet / large-phone band (720–1023px): the SideRail has dissolved
     but the viewport is still wide. Snap the header onto the same 12-col
     grid the hero and project showcases use below so the brand wordmark,
     nav, and icons land on the same vertical lines as the rest of the
     page (brand at col 3, icons at col 11 end). */
  @media (min-width: 720px) and (max-width: 1023px) {
    .site-header {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--s-6);
      align-items: center;
      max-width: 1640px;
      margin-inline: auto;
      padding: var(--s-5) clamp(var(--s-6), 3vw, var(--s-12));
    }
    .site-header > .brand-row { grid-column: 3 / span 3; justify-self: start; }
    .site-header > nav { grid-column: 6 / span 4; justify-self: center; }
    /* Icons span cols 10-11 so their right edge lands on col 11's right
       boundary, matching where the reverse-mode project text ends below
       (text max-width 440 centered in the 5-col cell sits flush against
       the cell's right edge once the cell narrows below 440 + margins). */
    .site-header > :global(.social-icons) { grid-column: 10 / span 2; justify-self: end; }
  }
  .site-header.is-scrolled {
    background: rgba(253, 252, 250, 0.8);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom-color: var(--border-subtle);
  }
  :global([data-theme="dark"]) .site-header.is-scrolled {
    background: rgba(12, 13, 17, 0.72);
  }

  .brand-row {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
  }

  /* At the narrowest mobile widths the wordmark + toggle + nav + social
     icons fight for the same row. Drop the inline toggle on viewports
     under 540px so the brand mark and primary nav have room to breathe;
     the toggle is still reachable from the desktop SideRail and from
     the mobile menu surfaces on larger phone widths. */
  @media (max-width: 540px) {
    /* :global — the toggle is a child component, so its `.theme-toggle`
       class doesn't carry this file's scope hash. Without :global the
       hide silently never matched and the toggle kept crowding the row. */
    .brand-row :global(.theme-toggle) { display: none; }
  }

  /* Brand: subtle highlight fill on hover (matches the lede pop pattern). */
  .brand {
    position: relative;
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--text-primary);
    padding: 2px 6px;
    margin: -2px -6px;
    border-radius: var(--r-xs);
    background-image: linear-gradient(var(--brand-wash-soft), var(--brand-wash-soft));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 100%;
    transition: background-size var(--dur-normal) var(--ease-out);
  }
  .brand:hover,
  .brand:focus-visible {
    background-size: 100% 100%;
    outline: none;
  }
  .brand:active {
    transform: scale(0.97);
    transition: transform 120ms var(--ease-out);
  }

  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--s-6);
  }
  .nav-links a {
    position: relative;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    padding: 2px 6px;
    margin: -2px -6px;
    border-radius: var(--r-xs);
    background-image: linear-gradient(var(--brand-wash-soft), var(--brand-wash-soft));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 100%;
    transition:
      color var(--dur-fast) var(--ease),
      background-size var(--dur-normal) var(--ease-out);
  }
  .nav-links a::after {
    content: "";
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: 0;
    height: 1px;
    background: var(--brand-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease);
  }
  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: var(--text-primary);
    background-size: 100% 100%;
    outline: none;
  }
  .nav-links a[aria-current="page"] {
    color: var(--text-primary);
    background-size: 0% 100%;
  }
  .nav-links a[aria-current="page"]::after {
    transform: scaleX(1);
  }

  /* Touch devices: expand the nav-link hit area to ~44px (iOS thumb
     threshold) without growing the visible text. Padding + matching
     negative margin keeps the row's layout box unchanged. Also wire a
     :active press state since :hover sticks awkwardly on touch. */
  @media (hover: none), (pointer: coarse) {
    .nav-links a {
      padding: 12px 10px;
      margin: -12px -10px;
    }
    .nav-links a:active {
      color: var(--text-primary);
      background-size: 100% 100%;
    }
  }

  @media (max-width: 540px) {
    .site-header { padding: var(--s-4) var(--s-5); }
    .nav-links { gap: var(--s-4); }
    .brand { font-size: 18px; }
    /* Shrink the nav labels in step with the tightening row so Work /
       About / Resume never get pushed off-canvas on the smallest phones.
       clamp() max matches the desktop 14px, so larger widths are untouched. */
    .nav-links a { font-size: clamp(11px, 3.2vw, 14px); }
  }
  /* Smallest phones: tighten the row so the wordmark + nav never collide
     or push content off-canvas. (The contact icons drop out below 440px
     via SocialIcons — they stay reachable in the footer.) */
  @media (max-width: 400px) {
    .site-header { padding: var(--s-4) var(--s-4); gap: var(--s-4); }
    .nav-links { gap: var(--s-3); }
  }
</style>
