---
/**
 * CursorAurora — soft brand-color gradient blobs that follow the cursor.
 * Sits behind everything (z-index: -1). Runs once globally via BaseLayout.
 */
---

<div class="cursor-aurora" id="cursor-aurora" aria-hidden="true"></div>

<script is:inline>
  (function () {
    const blob = document.getElementById("cursor-aurora");
    if (!blob) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) return;

    let tx = 0.5, ty = 0.3, x = 0.5, y = 0.3;
    function move(e) {
      const w = window.innerWidth || 1;
      const h = window.innerHeight || 1;
      tx = e.clientX / w;
      ty = e.clientY / h;
    }
    window.addEventListener("mousemove", move, { passive: true });

    function loop() {
      // Recover if state ever gets poisoned (e.g. NaN from a 0-sized viewport).
      if (!isFinite(x) || !isFinite(y)) { x = 0.5; y = 0.3; }
      if (!isFinite(tx) || !isFinite(ty)) { tx = x; ty = y; }
      x += (tx - x) * 0.06;
      y += (ty - y) * 0.06;
      blob.style.setProperty("--mx", (x * 100).toFixed(2) + "%");
      blob.style.setProperty("--my", (y * 100).toFixed(2) + "%");
      requestAnimationFrame(loop);
    }
    loop();
  })();
</script>

<style>
  .cursor-aurora {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    /* Peach is the dominant blob at the cursor so the powder-blue underlines
       beneath interactive words read clearly (no blue-on-blue collision).
       Lavender holds the brand mix in the near-offset; powder-blue is pushed
       far into the periphery so it doesn't compete with the warm core. */
    background:
      radial-gradient(48% 58% at var(--mx, 50%) var(--my, 30%), rgba(244,217,204,0.42) 0%, transparent 65%),
      radial-gradient(36% 48% at calc(var(--mx, 50%) + 16%) calc(var(--my, 30%) + 6%), rgba(220,210,232,0.32) 0%, transparent 65%),
      radial-gradient(40% 56% at calc(var(--mx, 50%) - 28%) calc(var(--my, 30%) + 24%), rgba(197,220,234,0.22) 0%, transparent 70%);
    filter: blur(24px);
  }
</style>
