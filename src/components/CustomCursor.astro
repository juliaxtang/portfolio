---
/**
 * CustomCursor — a smooth lerping cursor for desktop pointers.
 *
 * Visual:
 *   - At rest: a small filled dot.
 *   - Over interactive elements: an outlined ring fades in around the
 *     dot, and the dot scales down (ring becomes the focal mark).
 *   - On click / press: the ring scales up smoothly (responds to hold).
 *   - On release: a brand-color ripple expands outward and fades.
 *
 * Mounted globally from BaseLayout. Disabled on touch/no-hover devices
 * and when prefers-reduced-motion is set.
 */
---

<div class="cursor" id="cursor" aria-hidden="true">
  <div class="cursor__dot"></div>
  <div class="cursor__ring"></div>
  <div class="cursor__media" id="cursor-media" aria-hidden="true"></div>
  <div class="cursor__pill" aria-hidden="true">
    <span class="cursor__pill-label">Read about it</span>
    <svg class="cursor__pill-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 11L11 5" />
      <path d="M6 5h5v5" />
    </svg>
  </div>
</div>

<script is:inline>
  (function () {
    if (typeof window === "undefined") return;
    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const cursor = document.getElementById("cursor");
    if (!cursor) return;

    document.documentElement.classList.add("has-custom-cursor");

    // Lerped follow — cursor eases toward the actual mouse position so
    // it lags slightly, which is what reads as "smoothness."
    //
    // The lag also drives a comet-tail effect: when the residual
    // (target - current) grows past a threshold, the cursor stretches
    // along the motion axis and squishes perpendicular to it, easing
    // back to a circle as it catches up.
    // Restore the last known pointer position from sessionStorage so the
    // cursor doesn't snap back to viewport-center on every internal nav.
    // Falls back to the viewport center if we don't have a stored value
    // yet (first page of the session).
    let mx = window.innerWidth / 2;
    let my = window.innerHeight / 2;
    try {
      const stored = sessionStorage.getItem("cursor-pos");
      if (stored) {
        const parts = stored.split(",");
        const sx = parseFloat(parts[0]);
        const sy = parseFloat(parts[1]);
        if (isFinite(sx) && isFinite(sy)) {
          // Only clamp if the viewport has a real size — when the script
          // runs before layout reports a size, skip the clamp rather than
          // collapsing the restored position to 0.
          const iw = window.innerWidth || Infinity;
          const ih = window.innerHeight || Infinity;
          mx = Math.max(0, Math.min(iw, sx));
          my = Math.max(0, Math.min(ih, sy));
        }
      }
    } catch (_) {}
    let cx = mx;
    let cy = my;
    // Apply the initial transform so the cursor renders at the restored
    // position immediately, instead of flashing at (0,0) until the first
    // mousemove.
    cursor.style.transform =
      "translate3d(" + cx.toFixed(2) + "px," + cy.toFixed(2) + "px,0)";
    const EASE = 0.22;
    // Tail tuning: below MIN_SPEED nothing stretches; the full stretch
    // is reached at MAX_SPEED. MAX_STRETCH is the X axis stretch at max
    // speed, MAX_SQUISH is the Y axis compression.
    const TAIL_MIN_SPEED = 8;
    const TAIL_MAX_SPEED = 80;
    const TAIL_MAX_STRETCH = 0.6;
    const TAIL_MAX_SQUISH = 0.28;
    let lastAngle = 0;
    let rafId = 0;

    function onMove(e) {
      mx = e.clientX;
      my = e.clientY;
      document.documentElement.style.setProperty("--cursor-x", mx + "px");
      document.documentElement.style.setProperty("--cursor-y", my + "px");
      if (!rafId) tick();
    }

    function tick() {
      const dx = mx - cx;
      const dy = my - cy;
      const speed = Math.sqrt(dx * dx + dy * dy);

      // Update the motion angle only when actually moving — at rest the
      // direction is undefined, so we hold the last one and ease the
      // stretch to zero rather than flicker the rotation.
      let stretch = 0;
      if (speed > TAIL_MIN_SPEED) {
        const t = Math.min(1, (speed - TAIL_MIN_SPEED) / (TAIL_MAX_SPEED - TAIL_MIN_SPEED));
        stretch = t;
        lastAngle = Math.atan2(dy, dx);
      }
      const sx = 1 + stretch * TAIL_MAX_STRETCH;
      const sy = 1 - stretch * TAIL_MAX_SQUISH;

      cx += dx * EASE;
      cy += dy * EASE;
      // While carrying a hover-revealed image, snap the cursor to the
      // raw mouse position (no lerp) and drop the comet-tail
      // rotation/stretch so the artwork rides upright with the mouse
      // instead of swaying behind the lerped position.
      const carryingMedia = cursor.classList.contains("is-media")
        || cursor.classList.contains("is-press-pill");
      if (carryingMedia) {
        cx = mx;
        cy = my;
        cursor.style.transform =
          "translate3d(" + cx.toFixed(2) + "px," + cy.toFixed(2) + "px,0)";
      } else {
        cursor.style.transform =
          "translate3d(" + cx.toFixed(2) + "px," + cy.toFixed(2) + "px,0) " +
          "rotate(" + lastAngle.toFixed(4) + "rad) " +
          "scale(" + sx.toFixed(3) + "," + sy.toFixed(3) + ")";
      }
      // Expose the cursor position as CSS variables so hover-revealed
      // images can attach themselves to the cursor (the image becomes
      // the cursor while it's over the trigger).
      document.documentElement.style.setProperty("--cursor-x", cx.toFixed(2) + "px");
      document.documentElement.style.setProperty("--cursor-y", cy.toFixed(2) + "px");

      if (Math.abs(dx) > 0.1 || Math.abs(dy) > 0.1) {
        rafId = requestAnimationFrame(tick);
      } else {
        rafId = 0;
      }
    }

    window.addEventListener("mousemove", onMove, { passive: true });

    // Persist the last pointer position so it survives internal navigation.
    // pagehide fires on both unload and bfcache stash, which is what we
    // want; visibilitychange covers tab switches as a belt-and-suspenders.
    function persistPos() {
      try { sessionStorage.setItem("cursor-pos", mx + "," + my); } catch (_) {}
    }
    window.addEventListener("pagehide", persistPos);
    document.addEventListener("visibilitychange", function () {
      if (document.visibilityState === "hidden") persistPos();
    });

    // Hide the cursor when the pointer leaves the viewport so it doesn't
    // appear stuck at the edge. `mouseleave` on the documentElement is
    // the reliable signal (window doesn't fire it consistently). Also
    // catch `mouseout` with no relatedTarget as a belt-and-suspenders.
    function hide() { cursor.style.opacity = "0"; }
    function show() { cursor.style.opacity = ""; }
    document.documentElement.addEventListener("mouseleave", hide);
    document.documentElement.addEventListener("mouseenter", show);
    document.addEventListener("mouseout", function (e) {
      if (!e.relatedTarget && !e.toElement) hide();
    });
    // Also hide when the window loses focus (alt-tab, switching apps).
    window.addEventListener("blur", hide);
    window.addEventListener("focus", show);

    // Interactive detection — when the cursor enters any clickable
    // element, the ring fades in.
    // Only true actionable affordances expand the cursor into a ring:
    // links with an actual href, buttons, role=button, summary, and
    // form fields. Bare tabindex spans (hover-reveal pills) and labels
    // stay in the resting dot state because clicking them does nothing.
    const INTERACTIVE = "a[href], button, [role='button'], summary, input, textarea, select, [data-cursor='interactive']";

    function isInteractive(el) {
      return el && el.closest && el.closest(INTERACTIVE);
    }

    // Contrast-aware bg detection. On mouseover, walk up from the target
    // looking for the first opaque background color (text elements have
    // transparent bg so the walk naturally skips them — even dark text
    // won't flip the cursor). Compute relative luminance; if dark, flip
    // the dot/ring to the light text-inverse color.
    //
    // Authors can force a mode by adding data-cursor-bg="dark" (or
    // "light") to any container, e.g. phone-mockup wrappers where the
    // dark content lives inside an <img>/<video> with transparent CSS bg.
    function parseRGB(str) {
      if (!str) return null;
      const m = str.match(/^rgba?\(([^)]+)\)$/);
      if (!m) return null;
      const parts = m[1].split(",").map(function (s) { return parseFloat(s.trim()); });
      if (parts.length < 3 || parts.some(isNaN)) return null;
      const a = parts.length === 4 ? parts[3] : 1;
      return { r: parts[0], g: parts[1], b: parts[2], a: a };
    }
    function isDarkColor(c) {
      if (!c || c.a < 0.5) return false;
      // Perceived luminance (Rec. 601 weights).
      const lum = (0.299 * c.r + 0.587 * c.g + 0.114 * c.b) / 255;
      return lum < 0.42;
    }
    function findCursorMode(el) {
      // First check for an explicit data-cursor-bg override on the
      // element or any ancestor.
      let cur = el;
      while (cur && cur.nodeType === 1 && cur !== document.documentElement) {
        const explicit = cur.getAttribute && cur.getAttribute("data-cursor-bg");
        if (explicit === "dark") return "dark";
        if (explicit === "light") return "light";
        cur = cur.parentNode;
      }
      // Otherwise walk up looking for the first opaque background color.
      cur = el;
      while (cur && cur.nodeType === 1 && cur !== document.documentElement) {
        const bg = parseRGB(getComputedStyle(cur).backgroundColor);
        if (bg && bg.a >= 0.5) {
          return isDarkColor(bg) ? "dark" : "light";
        }
        cur = cur.parentNode;
      }
      return "light";
    }
    function updateMode(target) {
      const mode = findCursorMode(target);
      cursor.classList.toggle("on-dark", mode === "dark");
    }

    // Elements that own a hover-revealed visual (a polaroid photo, a
     // preview image, a caption list, etc.) hide the cursor so the
     // reveal IS the cursor — no double-stamp of a dot over the artwork.
     function ownsHoverReveal(el) {
       return el && el.closest && el.closest("[data-cursor='hide'], .pill, .prose-out--preview, .fx");
     }

    function isPressPill(el) {
      return el && el.closest && el.closest(".showcase__press-link");
    }

    // The cursor carries the hover-revealed artwork itself. Cloning into
    // .cursor__media sidesteps the stacking-context / containing-block
    // traps caused by ancestor transforms (e.g. .fade-in) that prevent
    // the original art from escaping to the viewport.
    const media = document.getElementById("cursor-media");
    const MEDIA_SOURCE_SEL = ".pill-photo, .fx-photo, .prose-out__preview";
    function getMediaSource(trigger) {
      return trigger && trigger.querySelector
        ? trigger.querySelector(MEDIA_SOURCE_SEL)
        : null;
    }
    let mediaSourceKey = null;
    function showMedia(trigger) {
      if (!media) return;
      const src = getMediaSource(trigger);
      // If the new trigger has no clonable artwork (e.g. the Language
      // learner pill — captionList only), drop whatever was showing so a
      // previous pill's image doesn't linger.
      if (!src) {
        clearMedia();
        return;
      }
      // Use the trigger element itself as the cache key — same trigger
      // re-entered should not rebuild the clone.
      if (mediaSourceKey === trigger) return;
      mediaSourceKey = trigger;
      media.innerHTML = "";
      const clone = src.cloneNode(true);
      clone.removeAttribute("id");
      clone.classList.add("cursor__media-art");
      media.appendChild(clone);
      cursor.classList.add("is-media");
    }
    function clearMedia() {
      if (!media) return;
      mediaSourceKey = null;
      media.innerHTML = "";
      cursor.classList.remove("is-media");
    }

    document.addEventListener("mouseover", function (e) {
      if (isInteractive(e.target)) cursor.classList.add("is-interactive");
      const reveal = e.target && e.target.closest
        ? e.target.closest("[data-cursor='hide'], .pill, .prose-out--preview, .fx")
        : null;
      // Only hide the cursor if this trigger actually owns a clonable
      // graphic — otherwise (e.g. the Language learner pill, which has
      // a caption list but no photo) we'd be hiding the cursor for no
      // visible replacement.
      const hasArtwork = reveal && getMediaSource(reveal);
      if (hasArtwork) {
        cursor.classList.add("is-hidden");
        // Seed cursor coords from the entry event so the revealed image
        // attaches at the actual entry point instead of the stale last
        // position (which can be far away after a sessionStorage restore
        // or a still pointer).
        if (typeof e.clientX === "number") {
          mx = e.clientX;
          my = e.clientY;
          cx = mx;
          cy = my;
          cursor.style.transform =
            "translate3d(" + cx.toFixed(2) + "px," + cy.toFixed(2) + "px,0)";
          document.documentElement.style.setProperty("--cursor-x", mx + "px");
          document.documentElement.style.setProperty("--cursor-y", my + "px");
        }
        showMedia(reveal);
      }
      if (isPressPill(e.target)) cursor.classList.add("is-press-pill");
      updateMode(e.target);
    });
    document.addEventListener("mouseout", function (e) {
      // Only drop the state if we've fully left interactive territory.
      if (!isInteractive(e.relatedTarget)) cursor.classList.remove("is-interactive");
      const stillIn = e.relatedTarget && e.relatedTarget.closest
        ? e.relatedTarget.closest("[data-cursor='hide'], .pill, .prose-out--preview, .fx")
        : null;
      const stillHasArtwork = stillIn && getMediaSource(stillIn);
      if (!stillHasArtwork) {
        cursor.classList.remove("is-hidden");
        clearMedia();
      } else {
        // Moved into a different reveal trigger that owns artwork —
        // rebuild the clone for the new source if the trigger changed.
        showMedia(stillIn);
      }
      if (!isPressPill(e.relatedTarget)) cursor.classList.remove("is-press-pill");
    });

    // Click ripple + hold-to-expand. On press the ring scales up
    // smoothly; on release the current ring snapshots a ripple that
    // expands outward and fades. Holding longer = bigger pre-ripple ring.
    document.addEventListener("mousedown", function () {
      cursor.classList.add("is-pressed");
    });

    document.addEventListener("mouseup", function () {
      if (!cursor.classList.contains("is-pressed")) return;
      cursor.classList.remove("is-pressed");
      spawnRipple();
    });

    // Astro scopes component CSS via a data-astro-cid-* attribute. Copy
    // that attribute onto dynamically-created children so the scoped
    // ripple animation rule matches them.
    let scopeAttr = null;
    for (let i = 0; i < cursor.attributes.length; i++) {
      const n = cursor.attributes[i].name;
      if (n.indexOf("data-astro-cid") === 0) { scopeAttr = n; break; }
    }

    function spawnRipple() {
      const ripple = document.createElement("div");
      ripple.className = "cursor__ripple";
      if (scopeAttr) ripple.setAttribute(scopeAttr, "");
      cursor.appendChild(ripple);
      // Force a reflow so the animation always plays.
      void ripple.offsetWidth;
      ripple.classList.add("is-running");
      ripple.addEventListener("animationend", function () { ripple.remove(); });
    }
  })();
</script>

<style is:global>
  /* Hide the native cursor everywhere when the custom one is active. */
  html.has-custom-cursor,
  html.has-custom-cursor * {
    cursor: none !important;
  }

  /* Cursor-portal media — the cursor's .cursor__media slot holds a deep
     clone of the hover-revealed artwork. Override the source's at-rest
     positioning so the clone renders at the cursor regardless of where
     its original sits in the document (the source can be trapped inside
     a transformed ancestor; the clone is not). */
  .cursor__media {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.94);
    transform-origin: 50% 50%;
    transition:
      opacity 220ms var(--ease-out),
      transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cursor.is-media .cursor__media {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  /* Cloned art carries its source page's scope-attribute, so we live in
     a global stylesheet block. Compound selector bumps the specificity
     past the source's scoped `.fx-photo` / `.pill-photo` /
     `.prose-out__preview { opacity: 0 !important }` rules. */
  .cursor.is-media .cursor__media .cursor__media-art {
    position: static !important;
    left: auto !important;
    top: auto !important;
    bottom: auto !important;
    right: auto !important;
    display: block !important;
    opacity: 1 !important;
    transform: rotate(var(--tilt, 0deg)) !important;
    transition: none !important;
    pointer-events: none !important;
  }
</style>

<style>
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    pointer-events: none;
    z-index: 10000;
    will-change: transform;
    /* Disable on touch / no-hover devices. */
    transition: opacity 200ms var(--ease-out);
  }

  /* Hide on touch / coarse-pointer environments even if the script
     somehow mounts the element. */
  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    .cursor { display: none; }
  }

  .cursor__dot,
  .cursor__ring {
    position: absolute;
    left: 0;
    top: 0;
    border-radius: 50%;
    pointer-events: none;
  }

  /* Filled dot at rest — small, neutral. */
  .cursor__dot {
    width: 13px;
    height: 13px;
    margin-left: -6.5px;
    margin-top: -6.5px;
    background: var(--text-primary);
    opacity: 0.9;
    transition:
      transform 220ms var(--ease-out),
      opacity 220ms var(--ease-out),
      background-color 220ms var(--ease-out);
  }

  /* Outlined ring — appears over interactive targets. */
  .cursor__ring {
    width: 32px;
    height: 32px;
    margin-left: -16px;
    margin-top: -16px;
    border: 1.5px solid var(--text-primary);
    opacity: 0;
    transform: scale(0.55);
    transition:
      transform 320ms var(--ease-out),
      opacity 240ms var(--ease-out),
      border-color 240ms var(--ease-out);
  }

  /* Contrast flip — when the cursor is over a dark background, the dot
     and ring switch to the inverse text color (cream) so they stay
     visible. Triggered by JS via .on-dark on the parent. */
  .cursor.on-dark .cursor__dot { background: var(--text-inverse, #FDFCFA); }
  .cursor.on-dark .cursor__ring { border-color: var(--text-inverse, #FDFCFA); }

  .cursor.is-interactive .cursor__dot {
    transform: scale(0);
    opacity: 0;
  }
  .cursor.is-interactive .cursor__ring {
    opacity: 1;
    transform: scale(1);
  }

  /* Hover-reveal areas — fade the cursor out so the revealed image or
     graphic stands in for it. Children inherit the fade. */
  .cursor.is-hidden .cursor__dot,
  .cursor.is-hidden .cursor__ring {
    opacity: 0;
    transform: scale(0);
  }

  /* Held — ring grows smoothly while pressed. The longer the hold,
     the more the eased ramp keeps pulling toward the larger scale,
     so the visual responds to hold duration. */
  .cursor.is-pressed .cursor__ring {
    transform: scale(1.55);
    border-color: var(--brand-primary-2, var(--text-primary));
    transition:
      transform 900ms var(--ease-out),
      border-color 240ms var(--ease-out),
      opacity 240ms var(--ease-out);
    opacity: 1;
  }
  /* When pressed without being over interactive, still show the ring. */
  .cursor.is-pressed:not(.is-interactive) .cursor__dot {
    transform: scale(0);
    opacity: 0;
  }
  .cursor.is-pressed:not(.is-interactive) .cursor__ring {
    opacity: 1;
  }

  /* Cursor-morphed "Read about it" pill — replaces the dot/ring when
     hovering a press logo. Centered on the cursor position, slides up
     just slightly so the cursor visually grows out of the dot. */
  /* Cursor-morphed "Read about it" pill.
     The pill is always rendered at its content size, but at rest it's
     squashed down to a thin horizontal sliver the height of the dot.
     On is-press-pill the scale releases (with an overshoot bezier) so
     the dot reads as physically stretching outward into a full pill.
     Label + arrow fade in once the shape has finished its expansion. */
  .cursor__pill {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(-50%, -50%) scale(0.05, 0.55);
    transform-origin: 50% 50%;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--text-primary);
    color: var(--text-inverse, #FDFCFA);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    will-change: transform, opacity;
    transition:
      opacity 180ms var(--ease-out),
      transform 640ms cubic-bezier(0.34, 1.45, 0.64, 1);
  }
  .cursor__pill-label {
    display: inline-block;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 220ms var(--ease-out) 260ms,
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1) 260ms;
  }
  .cursor__pill-arrow {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 220ms var(--ease-out) 320ms,
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1) 320ms;
  }
  .cursor.is-press-pill .cursor__dot,
  .cursor.is-press-pill .cursor__ring {
    opacity: 0;
    transform: scale(0);
    transition:
      opacity 160ms var(--ease-out),
      transform 240ms var(--ease-out);
  }
  .cursor.is-press-pill .cursor__pill {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1, 1);
  }
  .cursor.is-press-pill .cursor__pill-label,
  .cursor.is-press-pill .cursor__pill-arrow {
    opacity: 1;
    transform: translateX(0);
  }
  .cursor.on-dark.is-press-pill .cursor__pill {
    background: var(--text-inverse, #FDFCFA);
    color: var(--text-primary);
  }

  /* Ripple — spawned on mouseup, expands and fades. */
  .cursor__ripple {
    position: absolute;
    left: 0;
    top: 0;
    width: 32px;
    height: 32px;
    margin-left: -16px;
    margin-top: -16px;
    border-radius: 50%;
    border: 1.5px solid var(--brand-primary);
    pointer-events: none;
    opacity: 0;
    transform: scale(1);
  }
  .cursor__ripple.is-running {
    animation: cursor-ripple 400ms var(--ease-out) forwards;
  }
  @keyframes cursor-ripple {
    0% {
      opacity: 0.85;
      transform: scale(1);
      border-width: 2px;
    }
    100% {
      opacity: 0;
      transform: scale(3);
      border-width: 0.4px;
    }
  }
</style>
