---
/**
 * MediaParallax — a single piece of media (video or image) with the same
 * scroll-driven vertical parallax and hover lift/scale/tilt as the App
 * Redesign hero (PhoneVideoParallax). An optional circular badge floats
 * over the upper-right with the same wind-up spin on hover.
 *
 * Used by Festival Mode (FMSizzle9-16.mp4, no badge) and TV Time Onboarding
 * (hero-2.webp + Webby Honoree badge) so the three Tinder/TV-Time hero blocks
 * share one visual language without per-case-study one-off implementations.
 */
import Arrow from "../Arrow.astro";

interface Props {
  /** Source path. .mp4/.webm/.mov render as <video>; everything else as <img>. */
  src: string;
  /** Native aspect ratio of the asset (CSS aspect-ratio string, e.g. "9 / 16"). */
  aspect: string;
  /** Max width of the media element. Tune to match App Redesign visual
   *  height: ~324px at 1114/2268 → ~659px tall. */
  maxWidth?: string;
  /** Alt / aria-label for the media. */
  label?: string;
  /** Optional circular badge (e.g., Webby Honoree). */
  badgeSrc?: string;
  badgeAlt?: string;
  /** Phone parallax range (px). Positive = drifts up as section scrolls past. */
  phoneRange?: number;
  /** Badge parallax range (px), typically smaller than phoneRange. */
  badgeRange?: number;
  /** Override the default rounded-corner radius on the media. */
  radius?: string;
  /** Force <video> or <img> rendering instead of inferring from extension. */
  as?: "video" | "image";
  /** Override the badge width (CSS value). Defaults to clamp(128px, 37%, 190px). */
  badgeWidth?: string;
  /** Floating "evidence" cell anchored to the upper-left of the media. */
  cellLeftSrc?: string;
  cellLeftAlt?: string;
  /** Optional CSS width override for the left cell. */
  cellLeftWidth?: string;
  /** Floating "evidence" cell anchored to the lower-right of the media. */
  cellRightSrc?: string;
  cellRightAlt?: string;
  cellRightWidth?: string;
}

const {
  src,
  aspect,
  maxWidth = "324px",
  label = "",
  badgeSrc,
  badgeAlt = "",
  phoneRange = 120,
  badgeRange = 70,
  radius = "var(--r-lg)",
  as,
  badgeWidth,
  cellLeftSrc,
  cellLeftAlt = "",
  cellLeftWidth,
  cellRightSrc,
  cellRightAlt = "",
  cellRightWidth,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolve = (p: string) =>
  p.startsWith("http") || p.startsWith(base)
    ? p
    : `${base}${p.startsWith("/") ? "" : "/"}${p}`;

const isVideo =
  as === "video" ||
  (as !== "image" && /\.(mp4|webm|mov)(\?|$)/i.test(src));

const id = "mp-" + Math.random().toString(36).slice(2, 9);
---

<div
  class="media-parallax"
  id={id}
  data-phone-range={phoneRange}
  data-badge-range={badgeRange}
  data-floating-cell-group={cellLeftSrc || cellRightSrc ? "" : undefined}
  style={`--mp-max-w:${maxWidth};--mp-aspect:${aspect};--mp-radius:${radius};${badgeWidth ? `--mp-badge-w:${badgeWidth};` : ""}${cellLeftWidth ? `--mp-cell-l-w:${cellLeftWidth};` : ""}${cellRightWidth ? `--mp-cell-r-w:${cellRightWidth};` : ""}`}
>
  <div class={"media-parallax__media" + (isVideo ? " media-parallax__media--clip" : " media-parallax__media--free")}>
    {isVideo ? (
      <video
        class="media-parallax__video"
        src={resolve(src)}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-label={label}
      />
    ) : (
      <img
        class="media-parallax__img"
        src={resolve(src)}
        alt={label}
        draggable="false"
        loading="lazy"
      />
    )}
  </div>
  {badgeSrc && (
    <img
      class="media-parallax__badge"
      src={resolve(badgeSrc)}
      alt={badgeAlt}
      draggable="false"
      loading="lazy"
    />
  )}
  {cellLeftSrc && (
    <img
      class="media-parallax__cell media-parallax__cell--left"
      src={resolve(cellLeftSrc)}
      alt={cellLeftAlt}
      draggable="false"
      loading="lazy"
      data-floating-cell
      data-cursor="drag-pill"
      data-cursor-bg="light"
      data-anchor-x="left"
      data-anchor-y="top"
    />
  )}
  {cellRightSrc && (
    <img
      class="media-parallax__cell media-parallax__cell--right"
      src={resolve(cellRightSrc)}
      alt={cellRightAlt}
      draggable="false"
      loading="lazy"
      data-floating-cell
      data-cursor="drag-pill"
      data-anchor-x="right"
      data-anchor-y="bottom"
    />
  )}
  {(cellLeftSrc || cellRightSrc) && (
    <>
      <span class="media-parallax__drag-hint" aria-hidden="true">
        <span class="media-parallax__drag-hint-label">drag to move<br />or click to expand</span>
      </span>
      <Arrow
        id={`${id}-drag-arrow`}
        from={`#${id} .media-parallax__drag-hint`}
        to={`#${id} .media-parallax__cell--left`}
        fromAnchor="bottom-center"
        toAnchor="top-center"
        path="vertical-down"
        padding={10}
        thickness={2.5}
        color="var(--text-tertiary, #6b6b72)"
        persistent
        watchRoot={`#${id}`}
        hideWhen="cell-hover,cell-active,root-class:is-interacted"
        hideBelowWidth={1100}
      />
    </>
  )}
</div>

<script is:inline>
  (function () {
    if (typeof window === "undefined") return;
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
    function init() {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) e.target.play().catch(() => {});
          });
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll(".media-parallax video").forEach((v) => {
        v.muted = true;
        v.playsInline = true;
        v.play().catch(() => {});
        observer.observe(v);
      });

      // Flag root as .is-interacted once any floating cell receives a
      // pointer / touch / click — permanently hides the drag-to-move hint.
      document.querySelectorAll(".media-parallax").forEach((root) => {
        function flag() { root.classList.add("is-interacted"); }
        root.querySelectorAll(".media-parallax__cell").forEach((cell) => {
          cell.addEventListener("pointerdown", flag, { once: true });
          cell.addEventListener("touchstart", flag, { once: true, passive: true });
          cell.addEventListener("click", flag, { once: true });
        });
      });

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduced) return;
      // Smaller-viewport scale: cells overlap the video corners on
      // ≤1340px, and the counter-phase drift between media and cells at
      // scroll extremes (up to ~80px combined) breaks visual contact
      // and leaves the cell floating above/below the video with a gap.
      // Scale all ranges to 0 below the breakpoint so media + cells
      // move together as one composition.
      const PARALLAX_OFF_MQ = window.matchMedia("(max-width: 1340px)");
      document.querySelectorAll(".media-parallax").forEach((root) => {
        const phoneRangeBase = parseFloat(root.dataset.phoneRange || "60");
        const badgeRangeBase = parseFloat(root.dataset.badgeRange || "30");
        let raf = 0;
        const update = () => {
          raf = 0;
          const rect = root.getBoundingClientRect();
          const vh = window.innerHeight || document.documentElement.clientHeight;
          const total = vh + rect.height;
          if (total <= 0) return;
          const traveled = vh - rect.top;
          const progress = Math.min(Math.max(traveled / total, 0), 1);
          const centered = progress - 0.5;
          const off = PARALLAX_OFF_MQ.matches ? 0 : 1;
          root.style.setProperty("--phone-y", (-centered * phoneRangeBase * off).toFixed(1) + "px");
          root.style.setProperty("--badge-y", (-centered * badgeRangeBase * off).toFixed(1) + "px");
          root.style.setProperty("--cell-l-y", (centered * 40 * off).toFixed(1) + "px");
          root.style.setProperty("--cell-r-y", (-centered * 55 * off).toFixed(1) + "px");
        };
        const onScroll = () => {
          if (!raf) raf = requestAnimationFrame(update);
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
        update();
      });
    }
  })();
</script>

<style>
  .media-parallax {
    position: relative;
    width: 100%;
    max-width: var(--mp-max-w, 324px);
    margin: 0 auto;
    /* Same top padding rhythm as PhoneVideoParallax so badge has room
       to float and the overall vertical extent matches App Redesign. */
    padding-top: clamp(48px, 12%, 88px);
    padding-right: clamp(32px, 8%, 70px);
    isolation: isolate;
    --phone-y: 0px;
    --badge-y: 0px;
    --phone-lift: 0px;
    --phone-scale: 1;
    --phone-tilt: 0deg;
    --badge-spin: 0deg;
    --badge-scale: 1;
    --cell-l-y: 0px;
    --cell-r-y: 0px;
  }

  .media-parallax__media {
    position: relative;
    width: 100%;
    aspect-ratio: var(--mp-aspect);
    background: transparent;
    will-change: transform;
    transform: translate3d(0, calc(var(--phone-y) + var(--phone-lift)), 0)
               rotate(var(--phone-tilt))
               scale(var(--phone-scale));
    transform-origin: 50% 60%;
    transition:
      transform 520ms var(--ease-out),
      filter 520ms var(--ease-out);
    cursor: pointer;
  }
  /* Videos: rounded-corner mask. Images: free-form so transparent
     edges in the source don't get clipped to a rectangle on hover. */
  .media-parallax__media--clip {
    border-radius: var(--mp-radius);
    overflow: hidden;
  }
  .media-parallax__media--free {
    border-radius: 0;
    overflow: visible;
  }
  /* Drop shadows live on the media itself so transparent-bg images
     (like hero-2.webp where the phones are already cut out) don't
     render a rectangular box behind them. Videos get a soft shadow
     via filter so it follows the rounded corners. */
  .media-parallax__video {
    filter: drop-shadow(0 18px 30px rgba(60, 30, 120, 0.18));
  }
  .media-parallax__img {
    filter: drop-shadow(0 10px 20px rgba(40, 30, 80, 0.12));
  }
  .media-parallax:hover .media-parallax__media,
  .media-parallax:focus-within .media-parallax__media {
    --phone-lift: -10px;
    --phone-scale: 1.035;
    --phone-tilt: -1.2deg;
  }
  .media-parallax:hover .media-parallax__video,
  .media-parallax:focus-within .media-parallax__video {
    filter: drop-shadow(0 28px 44px rgba(60, 30, 120, 0.28));
  }
  .media-parallax:hover .media-parallax__img,
  .media-parallax:focus-within .media-parallax__img {
    filter: drop-shadow(0 18px 32px rgba(40, 30, 80, 0.22));
  }

  .media-parallax__video,
  .media-parallax__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .media-parallax__badge {
    position: absolute;
    top: clamp(20px, 5%, 44px);
    right: 0;
    width: var(--mp-badge-w, clamp(128px, 37%, 190px));
    height: auto;
    z-index: 2;
    border-radius: 50%;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
    will-change: transform;
    transform: translate3d(0, var(--badge-y), 0)
               rotate(var(--badge-spin))
               scale(var(--badge-scale));
    transition:
      transform 620ms var(--ease-out),
      box-shadow 620ms var(--ease-out);
  }
  .media-parallax:hover .media-parallax__badge,
  .media-parallax:focus-within .media-parallax__badge {
    --badge-spin: 10deg;
    --badge-scale: 1.08;
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.28);
  }

  .media-parallax__cell {
    position: absolute;
    height: auto;
    z-index: 2;
    /* Rounded edges clip the source asset so each cell reads as its own
       card regardless of whether the PNG has its own corner rounding. */
    border-radius: 18px;
    filter: drop-shadow(0 18px 36px rgba(60, 30, 120, 0.18))
            drop-shadow(0 4px 10px rgba(60, 30, 120, 0.10));
    will-change: transform;
    transition: var(--drag-transition,
                  transform 620ms var(--ease-out)),
                filter 620ms var(--ease-out);
    pointer-events: auto;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-drag: none;
  }
  .media-parallax__cell.is-grabbing { cursor: grabbing; }
  .media-parallax__cell--left {
    /* Tucked into the media's upper-left corner: most of the cell sits
       outside the video frame with a small overlap into the corner so
       the scoreboard reads as bumping the video's edge. Leftward bleed
       capped at ~100px because the Showcase grid with tightHero only
       opens ~90–120px of gutter between the text column and the media
       column on a 1640px inner; anything beyond crashes into the copy. */
    top: clamp(10px, 4%, 50px);
    left: clamp(-80px, -18%, -50px);
    width: var(--mp-cell-l-w, clamp(220px, 64%, 290px));
    --rot: -5deg;
    transform: translate3d(var(--drag-x, 0px),
                           calc(var(--cell-l-y) + var(--drag-y, 0px)),
                           0)
               rotate(var(--rot));
  }
  .media-parallax__cell--right {
    /* Anchored lower-right, mostly outside the media's right edge. Same
       constraint as the left cell so the live-activity card never sweeps
       past the viewport edge at typical laptop widths. */
    bottom: clamp(40px, 9%, 80px);
    right: clamp(-75px, -16%, -40px);
    width: var(--mp-cell-r-w, clamp(180px, 52%, 230px));
    --rot: 6deg;
    transform: translate3d(var(--drag-x, 0px),
                           calc(var(--cell-r-y) + var(--drag-y, 0px)),
                           0)
               rotate(var(--rot));
  }

  /* Focused (click-to-zoom) state — width inflates for crisp raster,
     rotateX/rotateY drive 3D tilt on mouse-move. */
  .media-parallax__cell.is-focused {
    /* !important — see PhoneVideoParallax.astro for the rationale. */
    width: var(--focus-width, 100%) !important;
    max-width: none !important;
    max-height: none !important;
    transform: perspective(1200px)
               translate3d(var(--focus-dx, 0px), var(--focus-dy, 0px), 0)
               rotateX(var(--tilt-x, 0deg))
               rotateY(var(--tilt-y, 0deg)) !important;
    transform-style: flat;
    backface-visibility: hidden;
    transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1),
                width 520ms cubic-bezier(0.22, 1, 0.36, 1),
                filter 520ms var(--ease-out);
    z-index: 50;
    filter: drop-shadow(0 22px 44px rgba(20, 16, 40, 0.18))
            drop-shadow(0 4px 10px rgba(20, 16, 40, 0.10));
    cursor: zoom-out;
  }
  .media-parallax__cell.is-tilting {
    transition: transform 80ms linear,
                filter 520ms var(--ease-out) !important;
  }

  /* Narrow desktop / tablet (721–1340px): the gutter between the text
     column and the media column drops to 10–77px at these viewports, far
     too tight for the full desktop side bleed. Switch to the same corner-
     overlap pattern as the App Redesign reference: the scoreboard anchors
     to the media's upper-left corner (mostly above and to the left, with
     its bottom-right corner crossing into the video), and the live-
     activity widget anchors to the media's lower-right corner (mostly
     below and to the right, with its top-left corner crossing into the
     video). No detached floating above or below the phone. Headroom +
     footroom padding still reserved so the surrounding eyebrow + copy
     don't get crowded. */
  @media (min-width: 721px) and (max-width: 1340px) {
    .media-parallax[data-floating-cell-group] {
      /* Zero vertical padding — the cell's negative top/bottom must
         land inside the phone (overlap), so any padding pushes the
         cell out by exactly that amount and reintroduces the gap. */
      padding-top: 0;
      padding-bottom: 0;
    }
    .media-parallax__cell--left {
      top: clamp(-48px, -6vw, -24px);
      left: clamp(-40px, -10%, -16px);
      bottom: auto;
      margin-bottom: 0;
      width: var(--mp-cell-l-w, clamp(190px, 56%, 240px));
      --rot: -4deg;
    }
    .media-parallax__cell--right {
      top: auto;
      bottom: clamp(-48px, -6vw, -24px);
      right: clamp(-40px, -10%, -16px);
      margin-top: 0;
      width: var(--mp-cell-r-w, clamp(180px, 54%, 230px));
      --rot: 5deg;
    }
  }

  @media (max-width: 720px) {
    /* Mobile: same corner-overlap pattern. Zero vertical padding so the
       cells' negative top/bottom land inside the phone instead of being
       pushed off it. The Showcase row's own gap handles separation
       from the surrounding eyebrow + copy. */
    .media-parallax[data-floating-cell-group] {
      padding-top: 0;
      padding-bottom: 0;
    }
    .media-parallax__cell--left {
      top: clamp(-32px, -6vw, -12px);
      left: clamp(-32px, -8%, -12px);
      bottom: auto;
      margin-bottom: 0;
      width: var(--mp-cell-l-w, clamp(170px, 58%, 230px));
      --rot: -4deg;
    }
    .media-parallax__cell--right {
      top: auto;
      bottom: clamp(-32px, -6vw, -12px);
      right: clamp(-32px, -8%, -12px);
      margin-top: 0;
      width: var(--mp-cell-r-w, clamp(170px, 58%, 220px));
      --rot: 5deg;
    }
  }

  /* Super-small viewports: shrink the media so the corner-overlapped
     cells stay on-screen, and pull the bleed inward proportionally. The
     corner-overlap pattern is preserved. */
  @media (max-width: 520px) {
    .media-parallax[data-floating-cell-group] {
      max-width: min(var(--mp-max-w, 396px), 82%);
    }
    .media-parallax__cell--left {
      left: -6%;
      width: var(--mp-cell-l-w, clamp(160px, 60%, 220px));
    }
    .media-parallax__cell--right {
      right: -6%;
      width: var(--mp-cell-r-w, clamp(160px, 60%, 210px));
    }
  }
  @media (max-width: 380px) {
    .media-parallax[data-floating-cell-group] {
      max-width: min(var(--mp-max-w, 396px), 80%);
    }
    .media-parallax__cell--left {
      left: -4%;
      width: var(--mp-cell-l-w, clamp(150px, 58%, 200px));
    }
    .media-parallax__cell--right {
      right: -4%;
      width: var(--mp-cell-r-w, clamp(150px, 56%, 200px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .media-parallax__media,
    .media-parallax__badge,
    .media-parallax__cell {
      transform: none !important;
      transition: none !important;
    }
    .media-parallax:hover .media-parallax__media,
    .media-parallax:hover .media-parallax__badge,
    .media-parallax:hover .media-parallax__cell {
      transform: none !important;
    }
  }

  /* "drag to move" affordance — text on the left, arrow curving up on the
     right, both anchored below the video. Mirrors the App Redesign hint
     but rotated so the curve reads as pointing up toward the floating
     cells above. */
  .media-parallax__drag-hint {
    position: absolute;
    left: calc(8% + 350px);
    bottom: 320px;
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    gap: 12px;
    pointer-events: none;
    color: var(--text-tertiary, #6b6b72);
    z-index: 3;
    transition: opacity 220ms var(--ease-out, ease-out);
  }
  .media-parallax__drag-hint-label {
    font-family: var(--font-hand);
    font-size: 24px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text-secondary, #5A5D66);
    white-space: nowrap;
  }
  .media-parallax__drag-path-from {
    display: none;
  }
  /* Hide while hovering any floating cell — cursor pill takes over. */
  .media-parallax:has(.media-parallax__cell:hover) .media-parallax__drag-hint,
  .media-parallax:has(.media-parallax__cell.is-grabbing) .media-parallax__drag-hint,
  .media-parallax:has(.media-parallax__cell.is-focused) .media-parallax__drag-hint {
    opacity: 0;
  }
  /* Permanent hide after first interaction (flagged via JS). */
  .media-parallax.is-interacted .media-parallax__drag-hint {
    opacity: 0;
    pointer-events: none;
  }
  /* Smaller viewports (≤1340px): hide the drag-to-move affordance
     entirely. The handwritten label + curved SVG arrow positioned to the
     right of the video only fits when the media has ~350px of side
     gutter (above 1340px). Below that the previous fallback was a
     compact pill anchored above the video, but the cells in this band
     now overlap the phone corners (no detached floating above/below the
     phone), so the pill ends up overlapping the scoreboard cell and
     adds clutter without earning its keep. Cells are still tap-to-focus
     on touch and drag-to-move on mouse; the cursor pill on hover still
     surfaces the affordance for users who explore the cells directly. */
  @media (max-width: 1340px) {
    .media-parallax__drag-hint { display: none !important; }
  }
</style>
