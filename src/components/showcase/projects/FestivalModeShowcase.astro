---
import Showcase from "../Showcase.astro";
import PhonePair from "../PhonePair.astro";
import { showcaseContent } from "../../../data/showcases";

interface Props {
  reverse?: boolean;
  id?: string;
}
const { reverse = false, id = "festival-mode" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const data = showcaseContent["festival-mode"];
---

<Showcase
  companyLogo={data.companyLogo}
  companyName={data.companyName}
  year={data.year}
  role={data.role}
  title={data.title}
  tagline={data.tagline}
  stats={data.stats}
  press={data.press}
  ctaHref={`${base}/product-design/festival-mode`}
  accent={data.accent}
  reverse={reverse}
  id={id}
>
  <PhonePair
    phones={[
      {
        src: "/projects/festival-mode/phone-1-front.png",
        alt: "Add festivals screen with EDC Las Vegas, Stagecoach, and Festivalgoers options",
        left: -0.04,
        top: 0.04,
        width: 0.62,
        aspect: "1541 / 3081",
        drift: 64,
        hoverLift: 10,
        z: 2,
        /* Rest pose approximates the original baked-in angle: top tilts
           slightly away, left side leans forward (positive ry), small
           counter-clockwise in-plane tilt. Click flips all three to 0
           for a true head-on view. */
        restPose: { rx: -4, ry: 18, rz: -6 },
        /* Nudge right when promoted so the enlarged phone overlaps the
           back phone slightly instead of floating with a gap. */
        activeShiftX: 48,
      },
      {
        src: "/projects/festival-mode/phone-2-front.png",
        alt: "Festival Mode profile for Liz, 25, at EDC Las Vegas",
        left: 0.46,
        top: -0.02,
        width: 0.52,
        aspect: "1541 / 3081",
        drift: -28,
        hoverLift: 6,
        z: 1,
        /* Mirror tilt of phone 1 so the two phones lean toward each
           other in the rest composition. */
        restPose: { rx: -4, ry: -18, rz: 6 },
        /* Shift left enough to miss the copy column but not so far that
           the back phone disappears entirely. */
        activeShiftX: -56,
      },
    ]}
    maxWidth="660px"
    aspect="1 / 1.4"
    perspective="1800px"
  />
</Showcase>
