---
/**
 * Light/dark theme toggle. Rendered as a pill-shaped track with a sun
 * icon on the left and a moon on the right. A circular thumb slides
 * between them to indicate the active mode. Theme persists in
 * localStorage; the pre-paint script in BaseLayout applies the saved
 * value before the document renders so there is no flash on nav.
 */
interface Props {
  variant?: "inline" | "rail";
}
const { variant = "inline" } = Astro.props;
---

<button
  type="button"
  class={`theme-toggle theme-toggle--${variant}`}
  data-theme-toggle
  role="switch"
  aria-label="Toggle dark mode"
  aria-checked="false"
>
  <span class="theme-toggle__track" aria-hidden="true">
    <svg class="theme-toggle__icon theme-toggle__sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4"/>
      <path d="M12 3v2"/><path d="M12 19v2"/>
      <path d="M3 12h2"/><path d="M19 12h2"/>
      <path d="m5.6 5.6 1.4 1.4"/><path d="m17 17 1.4 1.4"/>
      <path d="m5.6 18.4 1.4-1.4"/><path d="m17 7 1.4-1.4"/>
    </svg>
    <svg class="theme-toggle__icon theme-toggle__moon" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" stroke="none">
      <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/>
    </svg>
    <span class="theme-toggle__thumb"></span>
  </span>
</button>

<style>
  .theme-toggle {
    appearance: none;
    border: 0;
    background: transparent;
    padding: 0;
    margin: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }
  .theme-toggle:focus-visible {
    outline: none;
  }
  .theme-toggle:focus-visible .theme-toggle__track {
    box-shadow: 0 0 0 2px var(--brand-primary-2);
  }

  /* The track is the visible pill. Two icons sit on either end of it;
     a circular thumb is layered above and slides between them. */
  .theme-toggle__track {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 60px;
    height: 32px;
    padding: 0 8px;
    background: var(--bg-sunken);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-full);
    box-sizing: border-box;
    transition:
      background var(--dur-normal) var(--ease),
      border-color var(--dur-normal) var(--ease);
  }
  .theme-toggle:hover .theme-toggle__track {
    border-color: var(--border-default);
  }
  :global([data-theme="dark"]) .theme-toggle__track {
    background: var(--bg-sunken);
    border-color: var(--border-default);
  }

  .theme-toggle__icon {
    position: relative;
    z-index: 1;
    color: var(--icon-tertiary);
    transition: color var(--dur-fast) var(--ease);
  }
  /* The icon under the thumb gets the active brand tint; the other
     fades to the muted tertiary so the active state reads clearly. */
  .theme-toggle__sun  { color: #F4A93C; }
  .theme-toggle__moon { color: var(--icon-tertiary); }
  :global([data-theme="dark"]) .theme-toggle__sun  { color: var(--icon-tertiary); }
  :global([data-theme="dark"]) .theme-toggle__moon { color: #C5B6E8; }

  /* The thumb is the circular puck. In light mode it sits over the sun;
     in dark mode it slides to sit over the moon. */
  .theme-toggle__thumb {
    position: absolute;
    top: 50%;
    left: 3px;
    width: 24px;
    height: 24px;
    background: var(--bg-surface);
    border-radius: 50%;
    box-shadow: 0 1px 2px rgba(20, 22, 28, 0.18), 0 0 0 1px var(--border-subtle);
    transform: translateY(-50%);
    transition: transform var(--dur-normal) var(--ease-out);
  }
  :global([data-theme="dark"]) .theme-toggle__thumb {
    transform: translate(26px, -50%);
    background: var(--bg-surface);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 0 0 1px var(--border-default);
  }

  .theme-toggle--rail,
  .theme-toggle--inline { margin: 0; }

  /* The inline variant ships in the mobile <Header>, where it shares a
     row with the wordmark + nav + social icons. Shrink the whole pill
     so it doesn't crowd those neighbours. (The rail variant on desktop
     has its own row and keeps the full size above.) */
  .theme-toggle--inline .theme-toggle__track {
    width: 44px;
    height: 24px;
    padding: 0 5px;
  }
  .theme-toggle--inline .theme-toggle__thumb {
    width: 18px;
    height: 18px;
    left: 2px;
  }
  :global([data-theme="dark"]) .theme-toggle--inline .theme-toggle__thumb {
    transform: translate(20px, -50%);
  }
  .theme-toggle--inline .theme-toggle__sun  { width: 12px; height: 12px; }
  .theme-toggle--inline .theme-toggle__moon { width: 11px; height: 11px; }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle__thumb,
    .theme-toggle__track,
    .theme-toggle__icon {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    // The component mounts in both <Header> and <SideRail>, so this inline
    // script runs twice on every page in document order. Use a
    // document-level delegated click so it doesn't matter when buttons
    // enter the DOM.
    if (window.__themeToggleInit) return;
    window.__themeToggleInit = true;
    var root = document.documentElement;

    function sync() {
      var dark = root.getAttribute("data-theme") === "dark";
      document.querySelectorAll("[data-theme-toggle]").forEach(function (b) {
        b.setAttribute("aria-checked", dark ? "true" : "false");
        b.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
      });
    }

    document.addEventListener("click", function (e) {
      var btn = e.target && e.target.closest && e.target.closest("[data-theme-toggle]");
      if (!btn) return;
      var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try { localStorage.setItem("theme", next); } catch (err) {}
      sync();
    });

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", sync);
    } else {
      sync();
    }
  })();
</script>
