---
/**
 * TradeoffSet, a row of design options shown side by side. Each option
 * is a phone screen with the option name above and a pros/cons bullet
 * list below. One option can be marked as the chosen direction with
 * the festival-mode winner sticker.
 *
 * Use when comparing 2 to 4 layout candidates that share the same
 * decision frame. For a horizontal scrolling carousel of test variants,
 * reach for LayoutTestCarousel instead.
 */
interface Annotation {
  type?: "point" | "bracket" | "ring";
  x: number;
  y?: number;
  yStart?: number;
  yEnd?: number;
  label?: string;
  side?: "left" | "right";
  arm?: number;
  labelWidth?: number;
  width?: number;   // ring: width in px
  height?: number;  // ring: height in px
}
interface Option {
  name?: string;
  image: string;
  alt?: string;
  pros?: string[];
  cons?: string[];
  winner?: boolean;
  labels?: Annotation[];
}
interface Props {
  options: Option[];
}

const { options } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolve = (p: string) =>
  p.startsWith("http") || p.startsWith(base)
    ? p
    : `${base}${p.startsWith("/") ? "" : "/"}${p}`;
---

<div class="cs-tradeoffs" data-count={options.length}>
  {options.map((opt) => (
    <div class={"cs-tradeoff" + (opt.winner ? " cs-tradeoff--winner" : "")}>
      <div class="cs-tradeoff__media">
        <div class="cs-tradeoff__img-wrap">
          <img
            class="cs-tradeoff__img"
            src={resolve(opt.image)}
            alt={opt.alt ?? opt.name ?? ""}
            loading="lazy"
          />
          {(opt.labels ?? []).map((ann) => {
            if (ann.type === "ring") {
              const w = ann.width ?? 40;
              const h = ann.height ?? w;
              return (
                <span
                  class="cs-annotation cs-annotation--ring"
                  style={`left:${ann.x}%;top:${ann.y ?? 50}%;width:${w}px;height:${h}px`}
                  aria-hidden="true"
                />
              );
            }
            if (ann.type === "bracket") {
              const yS = ann.yStart ?? 50;
              const yE = ann.yEnd ?? 60;
              const armLen = ann.arm ?? 20;
              const side = ann.side ?? "right";
              const posStyle = side === "left"
                ? `right:${100 - ann.x}%;top:${yS}%;height:calc(${yE - yS}%);--arm:${armLen}px`
                : `left:${ann.x}%;top:${yS}%;height:calc(${yE - yS}%);--arm:${armLen}px`;
              return (
                <div
                  class={`cs-annotation cs-annotation--bracket${side === "left" ? " cs-annotation--bracket-left" : ""}`}
                  style={posStyle}
                >
                  <span class="cs-annotation__bracket-rail" />
                  <span class="cs-annotation__bracket-stub cs-annotation__bracket-stub--top" />
                  <span class="cs-annotation__bracket-stub cs-annotation__bracket-stub--bot" />
                  {ann.label && (
                    <span class="cs-annotation__bracket-mid">
                      <span class="cs-annotation__arm" />
                      <span
                        class="cs-annotation__label"
                        style={ann.labelWidth ? `width:${ann.labelWidth}px;white-space:normal` : ""}
                      >{ann.label}</span>
                    </span>
                  )}
                </div>
              );
            }
            return (
              <div
                class={`cs-annotation cs-annotation--point cs-annotation--${ann.side ?? "right"}`}
                style={`left:${ann.x}%;top:${ann.y ?? 50}%;--arm:${ann.arm ?? 36}px`}
              >
                <span class="cs-annotation__dot" />
                {ann.label && <span class="cs-annotation__arm" />}
                {ann.label && (
                  <span
                    class="cs-annotation__label"
                    style={ann.labelWidth ? `width:${ann.labelWidth}px;white-space:normal` : ""}
                  >{ann.label}</span>
                )}
              </div>
            );
          })}
          {opt.winner && (
            <img
              class="cs-tradeoff__winner-badge"
              src={resolve("/projects/festival-mode/winner.png")}
              alt="Winner"
              aria-hidden="true"
            />
          )}
        </div>
      </div>
      {opt.name && <p class="cs-tradeoff__name">{opt.name}</p>}
      {(opt.pros?.length || opt.cons?.length) && (
        <ul class="cs-tradeoff__list" role="list">
          {(opt.pros ?? []).map((p) => (
            <li class="cs-tradeoff__item cs-tradeoff__item--pro">
              <span class="cs-tradeoff__glyph" aria-hidden="true">+</span>
              <span>{p}</span>
            </li>
          ))}
          {(opt.cons ?? []).map((c) => (
            <li class="cs-tradeoff__item cs-tradeoff__item--con">
              <span class="cs-tradeoff__glyph" aria-hidden="true">−</span>
              <span>{c}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  ))}
</div>

<style>
  .cs-tradeoffs {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: flex-start;
    gap: var(--s-3);
    max-width: var(--content-max);
    margin: var(--s-10) auto;
    padding-inline: var(--s-5);
  }

  @media (max-width: 720px) {
    .cs-tradeoffs {
      flex-wrap: wrap;
      gap: var(--s-12);
    }
  }

  .cs-tradeoff {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-4);
    /* Column width matches the rendered phone image width so the bullet
       list below doesn't span wider than the screen above it. */
    width: 240px;
    max-width: 100%;
  }
  .cs-tradeoff--winner {
    width: 252px;
  }

  .cs-tradeoff__media {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    min-height: 504px;
  }
  .cs-tradeoff__img-wrap {
    position: relative;
    display: inline-block;
  }
  .cs-tradeoff__img {
    max-height: 480px;
    width: auto;
    max-width: 100%;
    display: block;
    border-radius: 36px;
  }
  /* Winner card: 5% larger media so the chosen direction reads as the
     hero of the row. */
  .cs-tradeoff--winner .cs-tradeoff__img {
    max-height: 504px;
  }

  /* Winner sticker, pinned just above the phone's top-right shoulder.
     Sits relative to the image wrapper so it tracks the phone, not the
     full media column. */
  .cs-tradeoff__winner-badge {
    position: absolute;
    top: -16px;
    right: -20px;
    width: clamp(72px, 8vw, 96px);
    height: auto;
    z-index: 3;
    transform: rotate(8deg);
    filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.18));
    pointer-events: none;
    border-radius: 0;
  }

  /* ── Annotations: bracket + point, mirroring AnnotatedFigure ────────── */
  .cs-annotation--point {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0;
    transform: translateY(-50%);
    pointer-events: none;
    white-space: nowrap;
    z-index: 2;
  }
  .cs-annotation--left {
    flex-direction: row-reverse;
    transform: translate(-100%, -50%);
  }
  .cs-annotation__dot {
    flex-shrink: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--text-primary);
    opacity: 0.85;
    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.85);
  }

  .cs-annotation--bracket {
    position: absolute;
    pointer-events: none;
    white-space: nowrap;
    transform: translateX(10px);
    z-index: 2;
  }
  .cs-annotation--bracket-left {
    transform: translateX(-10px);
  }
  .cs-annotation__bracket-rail {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--text-primary);
    opacity: 0.7;
    border-radius: 2px;
  }
  .cs-annotation--bracket-left .cs-annotation__bracket-rail {
    right: 0;
    left: auto;
  }
  .cs-annotation__bracket-stub {
    position: absolute;
    left: -7px;
    width: 9px;
    height: 2px;
    background: var(--text-primary);
    opacity: 0.7;
    border-radius: 2px;
  }
  .cs-annotation--bracket-left .cs-annotation__bracket-stub {
    right: -7px;
    left: auto;
  }
  .cs-annotation__bracket-stub--top { top: 0; }
  .cs-annotation__bracket-stub--bot { bottom: 0; }
  .cs-annotation__bracket-mid {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
  }
  .cs-annotation--bracket-left .cs-annotation__bracket-mid {
    right: 0;
    left: auto;
    flex-direction: row-reverse;
  }
  .cs-annotation__arm {
    flex-shrink: 0;
    width: var(--arm, 24px);
    height: 1px;
    background: var(--text-primary);
    opacity: 0.45;
  }
  .cs-annotation__label {
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-primary);
    background: color-mix(in srgb, var(--bg-canvas) 92%, transparent);
    padding: 4px 10px;
    border-radius: var(--r-sm);
    border: 1px solid var(--border-subtle);
    letter-spacing: 0.01em;
  }

  /* Ring: a circular highlight outline placed at x/y to draw the eye to
     a specific element inside the screen. Sized in px so it stays visually
     consistent regardless of phone aspect. */
  .cs-annotation--ring {
    position: absolute;
    transform: translate(-50%, -50%);
    border: 2px solid var(--text-primary);
    border-radius: 999px;
    background: transparent;
    pointer-events: none;
    z-index: 2;
    box-shadow:
      0 0 0 4px color-mix(in srgb, var(--bg-canvas) 70%, transparent),
      0 6px 16px -6px rgba(0, 0, 0, 0.25);
    animation: cs-tradeoff-ring-pulse 2.4s var(--ease-out) infinite;
  }
  @keyframes cs-tradeoff-ring-pulse {
    0%, 100% { transform: translate(-50%, -50%) scale(1); }
    50%      { transform: translate(-50%, -50%) scale(1.08); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cs-annotation--ring { animation: none; }
  }

  .cs-tradeoff__name {
    margin: 0;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.3;
    color: var(--text-secondary);
  }
  .cs-tradeoff--winner .cs-tradeoff__name {
    color: var(--text-primary);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.012em;
  }

  .cs-tradeoff__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }
  .cs-tradeoff__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-3);
    align-items: baseline;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-secondary);
  }
  .cs-tradeoff__glyph {
    font-weight: 700;
    font-size: 16px;
    line-height: 1;
    width: 14px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .cs-tradeoff__item--pro .cs-tradeoff__glyph {
    color: var(--brand-primary-2);
  }
  .cs-tradeoff__item--con .cs-tradeoff__glyph {
    color: var(--text-tertiary);
  }
</style>
