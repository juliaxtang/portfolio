---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CursorAurora from "../components/CursorAurora.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const siteName = "Julia Tang | Design";
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const desc =
  description ??
  "Staff Product Designer at Snapchat — visual storytelling, motion, and UX for delightful product experiences.";
const ogImageUrl = new URL(ogImage ?? "/favicon.png", Astro.site).toString();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />

    <!-- OG / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).toString()} />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Phosphor Icons (free, MIT) — single source of truth for glyphs.
         Mirrors style-guide.html so prod and the spec stay in lock-step. -->
    <script src="https://unpkg.com/@phosphor-icons/web@2.1.1" is:inline></script>
  </head>
  <body>
    <CursorAurora />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Fade-in observer (cheap, works without any framework) -->
    <script is:inline>
      (function () {
        if (typeof window === "undefined") return;
        var els = document.querySelectorAll(".fade-in");
        if (!("IntersectionObserver" in window)) {
          els.forEach(function (el) { el.classList.add("is-visible"); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15 }
        );
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
