---
/**
 * Showcase — one project block on the v2 home page.
 *
 * Layout (desktop):
 *   ┌──────────────────┬──────────────────┐
 *   │ eyebrow / title  │  hero (slot)     │
 *   │ tagline          │                  │
 *   │ stats            │                  │
 *   │ CTA              │                  │
 *   └──────────────────┴──────────────────┘
 *
 * On mobile, the hero stacks above the text.
 *
 * Stats are passed as a small array; pass an interactive hero via the slot.
 */
interface StatProps {
  value: string;
  label: string;
}
interface Props {
  /** Path to a company logo PNG/SVG. Rendered as a height-locked img next
   *  to the company name so the brand is the strongest signal in the row. */
  companyLogo?: string;
  companyName?: string;
  year?: string | number;
  role?: string;
  title: string;
  tagline?: string;
  stats?: StatProps[];
  /** Optional bullet list rendered between tagline and CTA (e.g. "Featuring:"). */
  features?: string[];
  ctaHref?: string;
  ctaLabel?: string;
  accent?: string;
  reverse?: boolean;
  /** Optional anchor id so a sticky nav can deep-link to this section. */
  id?: string;
  /** When true, render as a placeholder block — no case study link, a
   *  disabled "Case study coming soon" button instead of the CTA, and the
   *  title/hero are not clickable. Hovering anywhere on the showcase swaps
   *  the button label to "Ask me about it!" (still in disabled style). */
  comingSoon?: boolean;
}
const {
  companyLogo,
  companyName,
  year,
  role,
  title,
  tagline,
  stats = [],
  features = [],
  ctaHref,
  ctaLabel = "Read case study",
  accent,
  reverse = false,
  id,
  comingSoon = false,
} = Astro.props;
const isLinked = !!ctaHref && !comingSoon;
const isExternal = !!ctaHref && /^https?:\/\//.test(ctaHref);

const accentStyle = accent ? `--cs-accent:${accent};` : "";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolvedLogo = companyLogo && (companyLogo.startsWith("http") || companyLogo.startsWith(base)
  ? companyLogo
  : `${base}${companyLogo.startsWith("/") ? "" : "/"}${companyLogo}`);
const meta = [year ? String(year) : null, role].filter(Boolean) as string[];
---

<section class={"showcase" + (reverse ? " showcase--reverse" : "")} style={accentStyle} id={id}>
  <div class="showcase__inner">
    <div class="showcase__text">
      {(resolvedLogo || companyName) && (
        <div class="showcase__brand">
          {resolvedLogo && (
            <img
              class={"showcase__logo " + (companyName ? "showcase__logo--has-name" : "")}
              src={resolvedLogo}
              alt={companyName ? "" : (companyName || "")}
              loading="lazy"
            />
          )}
          {companyName && <span class="showcase__company">{companyName}</span>}
        </div>
      )}
      {meta.length > 0 && (
        <p class="t-eyebrow showcase__meta">{meta.join(" · ")}</p>
      )}
      <h2 class="showcase__title">
        {isLinked ? <a class="showcase__title-link" href={ctaHref}>{title}</a> : title}
      </h2>
      {tagline && <p class="showcase__tagline">{tagline}</p>}
      {features.length > 0 && (
        <div class="showcase__features">
          <p class="showcase__features-label">Featuring:</p>
          <ul class="showcase__features-list">
            {features.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      )}
      {stats.length > 0 && (
        <ul class="showcase__stats">
          {stats.map((s) => (
            <li>
              <p class="showcase__stat-value">{s.value}</p>
              <p class="showcase__stat-label">{s.label}</p>
            </li>
          ))}
        </ul>
      )}
      {comingSoon ? (
        <p class="showcase__coming-soon">
          <button class="showcase__coming-soon-btn" disabled aria-disabled="true">
            <span class="showcase__cs-default">Case study coming soon</span>
            <span class="showcase__cs-hover" aria-hidden="true">Ask me about it!</span>
          </button>
        </p>
      ) : ctaHref && (
        <p class="showcase__cta">
          <a
            class="showcase__cta-btn"
            href={ctaHref}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined}
          >
            <span class="showcase__cta-label">{ctaLabel}</span>
            <i class="ph ph-arrow-up-right showcase__cta-arrow" aria-hidden="true"></i>
          </a>
        </p>
      )}
    </div>
    <div class={"showcase__hero" + (isLinked ? " showcase__hero--linked" : "")}>
      {isLinked ? (
        <a
          class="showcase__hero-link"
          href={ctaHref}
          target={isExternal ? "_blank" : undefined}
          rel={isExternal ? "noopener noreferrer" : undefined}
          aria-label={isExternal ? `${ctaLabel}: ${title}` : `Read the ${title} case study`}
          tabindex="-1"
        >
          <slot />
        </a>
      ) : (
        <slot />
      )}
    </div>
  </div>
</section>

<style>
  .showcase {
    --cs-accent: var(--brand-primary);
    padding-block: var(--s-20);
    position: relative;
    isolation: isolate;
  }
  .showcase::before {
    /* Soft brand-color cloud contained within the section so adjacent
       showcases don't produce hard edges where their gradients meet. */
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(55% 65% at 50% 50%, color-mix(in srgb, var(--cs-accent) 18%, transparent) 0%, transparent 50%);
    z-index: -1;
    pointer-events: none;
  }
  @media (max-width: 720px) {
    .showcase { padding-block: var(--s-12); }
  }

  /* Both columns are equal-width so the two halves carry the same
     amount of negative space; the text and image inside each column
     are then constrained and centered so the whole composition reads
     as one centered band rather than a left-flush text + centered
     image (which made the page feel off-balance). */
  .showcase__inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 var(--s-6);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-6);
    align-items: center;
  }
  .showcase--reverse .showcase__text { order: 2; }
  .showcase--reverse .showcase__hero { order: 1; }

  .showcase__text {
    max-width: 440px;
    margin-inline: auto;
    width: 100%;
  }

  @media (max-width: 900px) {
    .showcase__inner { grid-template-columns: 1fr; gap: var(--s-8); padding: 0 var(--s-5); }
    .showcase__text { max-width: 520px; }
    .showcase--reverse .showcase__text { order: 2; }
    .showcase--reverse .showcase__hero { order: 1; }
    .showcase__inner > .showcase__text { order: 2; }
    .showcase__inner > .showcase__hero { order: 1; }
  }

  .showcase__brand {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin: 0 0 var(--s-2);
  }
  .showcase__logo {
    height: clamp(12px, 1vw, 14px);
    width: auto;
    display: block;
    object-fit: contain;
  }
  .showcase__company {
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.4vw, 18px);
    font-weight: 600;
    letter-spacing: -0.012em;
    color: var(--text-primary);
  }
  .showcase__meta {
    margin: 0 0 var(--s-3);
    color: var(--text-tertiary);
  }

  .showcase__title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(26px, 3vw, 36px);
    line-height: 1.1;
    letter-spacing: -0.022em;
    color: var(--text-primary);
    margin: 0 0 var(--s-2);
  }
  .showcase__title-link {
    color: inherit;
    text-decoration: none;
    display: inline-block;
  }

  .showcase__tagline {
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.5;
    color: var(--text-primary);
    margin: 0 0 var(--s-4);
  }

  .showcase__stats {
    list-style: none;
    margin: 0 0 var(--s-4);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-3);
  }
  .showcase__stats li {
    display: grid;
    gap: var(--s-1);
  }
  /* Games-specific: "30M" is so short that the equal-width grid creates
     an uneven visual gap. Nudge the middle stat left to optically balance. */
  #snapchat-games .showcase__stats li:nth-child(2) {
    transform: translateX(-30px);
  }
  .showcase__stat-value {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1.1;
    letter-spacing: -0.018em;
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
    margin: 0;
  }
  .showcase__stat-label {
    font-size: 13px;
    line-height: 1.4;
    color: var(--text-secondary);
    margin: 0;
  }

  .showcase__cta {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
  }
  .showcase__cta-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--text-primary);
    text-decoration: none;
    padding: 10px 18px;
    border-radius: var(--r-full);
    border: 1.5px solid var(--brand-primary-2);
    background: var(--brand-wash-soft);
    transition:
      background var(--dur-normal) var(--ease-out),
      border-color var(--dur-normal) var(--ease-out),
      gap var(--dur-normal) var(--ease-out),
      transform var(--dur-normal) var(--ease-out),
      box-shadow var(--dur-normal) var(--ease-out);
  }
  .showcase__cta-arrow {
    font-size: 1.05em;
    line-height: 0;
    transition: transform var(--dur-normal) var(--ease-out);
  }
  /* Hover state triggers on button itself, OR when hovering the title link
     or the hero asset — so the whole project card reads as one interactive
     unit. */
  .showcase__cta-btn:hover,
  .showcase__cta-btn:focus-visible,
  .showcase:has(.showcase__title-link:hover) .showcase__cta-btn,
  .showcase:has(.showcase__title-link:focus-visible) .showcase__cta-btn,
  .showcase:has(.showcase__hero-link:hover) .showcase__cta-btn,
  .showcase:has(.showcase__hero-link:focus-visible) .showcase__cta-btn {
    gap: var(--s-3);
    background: var(--brand-primary);
    border-color: var(--brand-primary-2);
    transform: translateY(-1px);
    box-shadow: 0 8px 20px -12px var(--brand-wash);
  }
  .showcase__cta-btn:hover .showcase__cta-arrow,
  .showcase__cta-btn:focus-visible .showcase__cta-arrow,
  .showcase:has(.showcase__title-link:hover) .showcase__cta-arrow,
  .showcase:has(.showcase__title-link:focus-visible) .showcase__cta-arrow,
  .showcase:has(.showcase__hero-link:hover) .showcase__cta-arrow,
  .showcase:has(.showcase__hero-link:focus-visible) .showcase__cta-arrow {
    transform: translate(2px, -2px);
  }

  .showcase__hero {
    position: relative;
    min-height: 440px;
    /* Wider than the previous 440 cap so heroes that want to match the
       App Redesign phone's ~659px visual height (Custom Lists cluster,
       TV Time hero-2.webp) can do so without being clipped by the column.
       Smaller heroes still cap themselves via their own max-width. */
    max-width: 540px;
    margin-inline: auto;
    width: 100%;
  }
  .showcase__hero-link {
    display: block;
    color: inherit;
    text-decoration: none;
    outline: none;
    transition: transform var(--dur-normal) var(--ease-out);
  }
  .showcase__hero--linked:hover .showcase__hero-link {
    transform: translateY(-3px);
  }

  /* Features list (e.g. "Featuring: Dark Mode, Prompts…") */
  .showcase__features {
    margin-bottom: var(--s-4);
  }
  .showcase__features-label {
    font-size: 13px;
    color: var(--text-secondary);
    margin: 0 0 var(--s-1);
    font-weight: 500;
  }
  .showcase__features-list {
    list-style: disc;
    padding-left: var(--s-4);
    margin: 0;
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  /* Coming-soon disabled button */
  .showcase__coming-soon { margin: 0; }
  .showcase__coming-soon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 18px;
    border-radius: var(--r-full);
    background: transparent;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    border: 1.5px solid var(--border-default);
    cursor: default;
    position: relative;
    overflow: hidden;
    /* width set by JS after font measurement */
    transition: width 220ms var(--ease-out);
  }

  .showcase__cs-default {
    white-space: nowrap;
    transition: opacity 160ms var(--ease-out), transform 160ms var(--ease-out);
  }
  .showcase__cs-hover {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 160ms var(--ease-out), transform 160ms var(--ease-out);
  }

  /* JS adds .cs-hovered to the button on hover of title / hero / button */
  .showcase__coming-soon-btn.cs-hovered .showcase__cs-default {
    opacity: 0;
    transform: translateY(-6px);
  }
  .showcase__coming-soon-btn.cs-hovered .showcase__cs-hover {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase__coming-soon-btn { transition: none; }
    .showcase__cs-default,
    .showcase__cs-hover { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    function initComingSoon() {
      document.querySelectorAll(".showcase__coming-soon-btn").forEach(function (btn) {
        var showcase = btn.closest(".showcase");
        if (!showcase) return;
        var defaultEl = btn.querySelector(".showcase__cs-default");
        var hoverEl   = btn.querySelector(".showcase__cs-hover");
        if (!defaultEl || !hoverEl) return;

        // Measure default width
        var defaultW = btn.offsetWidth;

        // Briefly swap to hover state (no transition) to measure its width
        btn.style.transition   = "none";
        defaultEl.style.opacity    = "0";
        defaultEl.style.visibility = "hidden";
        hoverEl.style.position  = "static";
        hoverEl.style.opacity   = "1";
        hoverEl.style.transform = "none";
        var hoverW = btn.offsetWidth;

        // Restore
        defaultEl.style.opacity    = "";
        defaultEl.style.visibility = "";
        hoverEl.style.position  = "";
        hoverEl.style.opacity   = "";
        hoverEl.style.transform = "";

        // Lock initial width, then re-enable the width transition
        btn.style.width = defaultW + "px";
        void btn.offsetWidth; // force reflow
        btn.style.transition = "";

        var title = showcase.querySelector(".showcase__title");
        var hero  = showcase.querySelector(".showcase__hero");
        var triggers = [btn, title, hero].filter(Boolean);

        var leaveTimer;
        function activate() {
          clearTimeout(leaveTimer);
          btn.style.width = hoverW + "px";
          btn.classList.add("cs-hovered");
        }
        function deactivate() {
          leaveTimer = setTimeout(function () {
            btn.style.width = defaultW + "px";
            btn.classList.remove("cs-hovered");
          }, 40);
        }

        triggers.forEach(function (el) {
          el.addEventListener("mouseenter", activate);
          el.addEventListener("mouseleave", deactivate);
        });
      });
    }

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(initComingSoon);
    } else if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initComingSoon, { once: true });
    } else {
      initComingSoon();
    }
  })();
</script>
