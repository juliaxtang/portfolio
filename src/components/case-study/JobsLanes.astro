---
/**
 * JobsLanes: maps a set of entry points to the jobs-to-be-done they serve.
 *
 * Each lane is a softly tinted row with a left rail (eyebrow + title +
 * description) and a right rail of phone-framed surface tiles. Hovering a
 * tile lifts it, deepens the lane tint, and dims sibling tiles across both
 * lanes so the focused surface reads clearly.
 *
 * Lanes are passed as a prop; surfaces live in the default slot for each
 * lane via named slots `lane-1`, `lane-2`, etc.
 */
interface LaneMeta {
  eyebrow?: string;
  title: string;
  body?: string;
  tint?: "lavender" | "peach" | "blue";
}
interface Props {
  lanes: LaneMeta[];
}
const { lanes } = Astro.props;
---

<div class="cs-jobs-lanes">
  {lanes[0] && (
    <div class={`cs-jobs-lane cs-jobs-lane--${lanes[0].tint ?? "lavender"}`}>
      <div class="cs-jobs-lane__rail">
        {lanes[0].eyebrow && <p class="cs-jobs-lane__eyebrow t-eyebrow">{lanes[0].eyebrow}</p>}
        <h3 class="cs-jobs-lane__title">{lanes[0].title}</h3>
        {lanes[0].body && <p class="cs-jobs-lane__body">{lanes[0].body}</p>}
      </div>
      <div class="cs-jobs-lane__tiles">
        <slot name="lane-1" />
      </div>
    </div>
  )}
  {lanes[1] && (
    <div class={`cs-jobs-lane cs-jobs-lane--${lanes[1].tint ?? "peach"}`}>
      <div class="cs-jobs-lane__rail">
        {lanes[1].eyebrow && <p class="cs-jobs-lane__eyebrow t-eyebrow">{lanes[1].eyebrow}</p>}
        <h3 class="cs-jobs-lane__title">{lanes[1].title}</h3>
        {lanes[1].body && <p class="cs-jobs-lane__body">{lanes[1].body}</p>}
      </div>
      <div class="cs-jobs-lane__tiles">
        <slot name="lane-2" />
      </div>
    </div>
  )}
  {lanes[2] && (
    <div class={`cs-jobs-lane cs-jobs-lane--${lanes[2].tint ?? "blue"}`}>
      <div class="cs-jobs-lane__rail">
        {lanes[2].eyebrow && <p class="cs-jobs-lane__eyebrow t-eyebrow">{lanes[2].eyebrow}</p>}
        <h3 class="cs-jobs-lane__title">{lanes[2].title}</h3>
        {lanes[2].body && <p class="cs-jobs-lane__body">{lanes[2].body}</p>}
      </div>
      <div class="cs-jobs-lane__tiles">
        <slot name="lane-3" />
      </div>
    </div>
  )}
</div>

<style>
  .cs-jobs-lanes {
    max-width: var(--content-max);
    margin: var(--s-8) auto;
    display: grid;
    gap: var(--s-5);
    padding-inline: var(--s-5);
  }

  .cs-jobs-lane {
    --lane-bg: var(--brand-wash-soft);
    --lane-bg-hover: var(--brand-wash);
    display: grid;
    grid-template-columns: minmax(220px, 1fr) minmax(0, 3fr);
    gap: var(--s-8);
    align-items: center;
    padding: var(--s-8) var(--s-8);
    border-radius: var(--r-lg);
    background: var(--lane-bg);
    border: 1px solid var(--border-subtle);
    transition: background 0.35s var(--ease-out, cubic-bezier(0.2, 0, 0, 1));
  }

  .cs-jobs-lane--lavender {
    --lane-bg: rgba(220, 210, 232, 0.30);
    --lane-bg-hover: rgba(220, 210, 232, 0.55);
  }
  .cs-jobs-lane--peach {
    --lane-bg: rgba(244, 217, 204, 0.30);
    --lane-bg-hover: rgba(244, 217, 204, 0.55);
  }
  .cs-jobs-lane--blue {
    --lane-bg: rgba(197, 220, 234, 0.30);
    --lane-bg-hover: rgba(197, 220, 234, 0.55);
  }

  /* When the user is hovering a tile inside the lanes wrapper, deepen the
     parent lane's tint and dim the non-hovered tiles in both lanes. */
  .cs-jobs-lanes:has(.cs-jobs-lane__tile:hover) .cs-jobs-lane__tile {
    opacity: 0.55;
  }
  .cs-jobs-lanes:has(.cs-jobs-lane__tile:hover) .cs-jobs-lane__tile:hover {
    opacity: 1;
  }
  .cs-jobs-lane:has(.cs-jobs-lane__tile:hover) {
    background: var(--lane-bg-hover);
  }

  .cs-jobs-lane__rail {
    display: grid;
    gap: var(--s-3);
    align-content: center;
  }
  .cs-jobs-lane__eyebrow {
    margin: 0;
    font-size: 12px;
    color: var(--text-tertiary);
  }
  .cs-jobs-lane__title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.012em;
    line-height: 1.2;
    color: var(--text-primary);
  }
  .cs-jobs-lane__body {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .cs-jobs-lane__tiles {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: flex-end;
    gap: var(--s-6);
  }

  /* Tile is rendered inline in MDX as <div class="cs-jobs-lane__tile">.
     This block styles whatever sits inside the named slot. */
  :global(.cs-jobs-lane__tile) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-3);
    flex: 0 1 auto;
    max-width: 200px;
    transition: opacity 0.3s var(--ease-out, cubic-bezier(0.2, 0, 0, 1)),
                transform 0.3s var(--ease-out, cubic-bezier(0.2, 0, 0, 1));
    will-change: transform, opacity;
  }
  :global(.cs-jobs-lane__tile:hover) {
    transform: translateY(-6px);
  }
  :global(.cs-jobs-lane__tile img),
  :global(.cs-jobs-lane__tile video) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 28px;
    box-shadow: 0 4px 24px -6px rgba(0, 0, 0, 0.14), 0 1px 4px -1px rgba(0, 0, 0, 0.06);
    transition: box-shadow 0.3s var(--ease-out, cubic-bezier(0.2, 0, 0, 1));
  }
  :global(.cs-jobs-lane__tile:hover img),
  :global(.cs-jobs-lane__tile:hover video) {
    box-shadow: 0 16px 40px -10px rgba(0, 0, 0, 0.22), 0 4px 10px -2px rgba(0, 0, 0, 0.08);
  }
  :global(.cs-jobs-lane__tile-label) {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-tertiary);
    text-align: center;
  }

  @media (max-width: 860px) {
    .cs-jobs-lane {
      grid-template-columns: 1fr;
      gap: var(--s-5);
      padding: var(--s-6);
    }
    .cs-jobs-lane__tiles {
      justify-content: center;
      gap: var(--s-4);
    }
    :global(.cs-jobs-lane__tile) {
      max-width: 140px;
    }
  }
</style>
