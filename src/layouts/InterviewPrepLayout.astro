---
import "../styles/global.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.png" type="image/png" />
  </head>
  <body>
    {
      isDev ? (
        <slot />
      ) : (
        <div style="max-width:560px;margin:120px auto;padding:0 24px;font-family:var(--font-sans);color:var(--text-secondary);">
          <h1 style="font-family:var(--font-display);color:var(--text-primary);">Local-only tool</h1>
          <p>The interview-prep workspace runs only in <code>npm run dev</code>. Boot the dev server and the side-car (<code>npm run prep</code>), then visit this page locally.</p>
        </div>
      )
    }
  </body>
</html>
