---
/**
 * Stat — a single oversized metric with a label underneath.
 *
 * Wrap multiple <Stat> in a <Stats> grid (or inside <TwoUp>) for a row of
 * impact numbers — used at the top of case studies for outcomes (DAU,
 * retention, conversation rate, etc).
 */
interface Props {
  value: string;
  label: string;
  caption?: string;
}

const { value, label, caption } = Astro.props;
---

<div class="cs-stat">
  <p class="cs-stat__value">{value}</p>
  <p class="cs-stat__label">{label}</p>
  {caption && <p class="cs-stat__caption">{caption}</p>}
</div>

<style>
  .cs-stat {
    display: grid;
    align-content: start;
    gap: var(--s-2);
    padding: var(--cs-stat-padding, var(--s-6));
    border-radius: var(--cs-stat-radius, var(--r-lg));
    background: var(--cs-stat-bg, var(--bg-surface));
    border: 1px solid var(--cs-stat-border-color, var(--border-default));
  }
  .cs-stat__value {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--cs-stat-value-size, clamp(28px, 3.2vw, 42px));
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
    margin: 0;
  }
  .cs-stat__label {
    font-family: var(--font-sans);
    font-size: var(--cs-stat-label-size, 14px);
    font-weight: 500;
    line-height: 1.4;
    color: var(--cs-stat-label-color, var(--text-primary));
    margin: 0;
  }
  .cs-stat__caption {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin: 0;
  }
</style>
