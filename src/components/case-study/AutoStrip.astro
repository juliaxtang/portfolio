---
/**
 * AutoStrip — horizontal auto-scrolling strip of cells.
 *
 * Wraps a `.cs-strip__track` of arbitrary children (cards, images, etc).
 * The track auto-scrolls slowly and loops continuously. Duplicates its
 * contents on mount so the loop is seamless. Pauses briefly when the user
 * interacts (wheel, touch, pointer down, focus) and resumes after inactivity.
 * The thin scrollbar is hidden during auto-scroll and revealed at 30% opacity
 * only while the user is interacting (via the `.is-user-scrolling` class).
 *
 * Respects `prefers-reduced-motion: reduce` — no auto-scroll in that case.
 */
interface Props {
  /** Pixels per second of auto-scroll. Defaults to 24. */
  speed?: number;
  /** ms to stay paused after a user interaction. Defaults to 2000. */
  pauseAfterInteraction?: number;
}

const { speed = 24, pauseAfterInteraction = 2000 } = Astro.props;
const instanceId = "as-" + Math.random().toString(36).slice(2, 9);
---

<div
  class="cs-strip"
  data-cs-strip={instanceId}
  data-cs-strip-speed={speed}
  data-cs-strip-pause={pauseAfterInteraction}
>
  <div class="cs-strip__track">
    <slot />
  </div>
</div>

<script is:inline define:vars={{ instanceId }}>
  (() => {
    const root = document.querySelector(`[data-cs-strip="${instanceId}"]`);
    if (!root) return;
    const track = root.querySelector(".cs-strip__track");
    if (!track) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced) return;

    const speed = parseFloat(root.dataset.csStripSpeed || "24");
    const pauseFor = parseFloat(root.dataset.csStripPause || "2000");

    if (!track.dataset.csCloned) {
      const items = Array.from(track.children);
      for (const item of items) {
        const clone = item.cloneNode(true);
        clone.setAttribute("aria-hidden", "true");
        clone.dataset.csClone = "1";
        track.appendChild(clone);
      }
      track.dataset.csCloned = "1";
    }

    let pauseUntil = 0;
    let accum = track.scrollLeft;
    const fps = 60;
    const dx = speed / fps;

    let revealTimer;
    const pause = () => {
      pauseUntil = performance.now() + pauseFor;
      accum = track.scrollLeft;
      track.classList.add("is-user-scrolling");
      if (revealTimer) clearTimeout(revealTimer);
      revealTimer = setTimeout(() => {
        track.classList.remove("is-user-scrolling");
      }, pauseFor);
    };
    track.addEventListener("wheel", pause, { passive: true });
    track.addEventListener("touchstart", pause, { passive: true });
    track.addEventListener("pointerdown", pause);
    root.addEventListener("focusin", pause);

    setInterval(() => {
      const half = track.scrollWidth / 2;
      if (half <= 0) return;
      if (performance.now() <= pauseUntil) return;
      accum += dx;
      if (accum >= half) accum -= half;
      track.scrollLeft = accum;
    }, 1000 / fps);
  })();
</script>
