---
/**
 * NotificationTaxonomy: vertical stack of notification categories beside
 * a relevance axis. The axis runs the full height of the stack with
 * "Most relevant" at the top and "Least relevant" at the bottom, so the
 * reader gets the priority structure at a glance. Each cell shows the
 * label, a one-line description, and the example screenshots inline.
 */
interface ItemImage {
  src: string;
  alt: string;
}
interface Item {
  label: string;
  description?: string;
  images: ItemImage[];
}
interface Props {
  items: Item[];
  axisTopLabel?: string;
  axisBottomLabel?: string;
}

const {
  items,
  axisTopLabel = "Most relevant",
  axisBottomLabel = "Least relevant",
} = Astro.props;
---

<section class="nt">
  <div class="nt__axis" aria-hidden="true">
    <span class="nt__axis-cap nt__axis-cap--top">{axisTopLabel}</span>
    <span class="nt__axis-line">
      <span class="nt__axis-arrow nt__axis-arrow--up"></span>
      <span class="nt__axis-arrow nt__axis-arrow--down"></span>
    </span>
    <span class="nt__axis-cap nt__axis-cap--bottom">{axisBottomLabel}</span>
  </div>

  <ol class="nt__cells" aria-label="Notification categories, ordered by relevance">
    {items.map((item, i) => (
      <li class="nt__cell">
        <div class="nt__head">
          <span class="nt__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <div class="nt__text">
            <p class="nt__label">{item.label}</p>
            {item.description && <p class="nt__desc">{item.description}</p>}
          </div>
        </div>
        <div class="nt__images">
          {item.images.map((img) => (
            <figure class="nt__figure">
              <img src={img.src} alt={img.alt} loading="lazy" />
            </figure>
          ))}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .nt {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: var(--s-6);
    align-items: stretch;
    max-width: var(--content-narrow);
    margin: var(--s-10) auto;
    padding: 0 var(--s-5);
  }

  /* Axis */
  .nt__axis {
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2) 0;
  }
  .nt__axis-cap {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    text-transform: uppercase;
    text-align: center;
    max-width: 140px;
  }
  .nt__axis-line {
    position: relative;
    width: 1.5px;
    align-self: stretch;
    background: var(--text-primary);
    border-radius: var(--r-full);
  }
  .nt__axis-arrow {
    position: absolute;
    left: 50%;
    width: 8px;
    height: 8px;
    border-left: 1.5px solid var(--text-primary);
    border-top: 1.5px solid var(--text-primary);
  }
  .nt__axis-arrow--up {
    top: -1px;
    transform: translateX(-50%) rotate(45deg);
  }
  .nt__axis-arrow--down {
    bottom: -1px;
    transform: translateX(-50%) rotate(-135deg);
  }

  /* Cells */
  .nt__cells {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-10);
  }
  .nt__cell {
    display: grid;
    gap: var(--s-4);
  }

  .nt__head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-3);
    align-items: baseline;
  }
  .nt__num {
    font-family: var(--font-mono, var(--font-sans));
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-tertiary);
    padding-top: 2px;
  }
  .nt__text {
    display: grid;
    gap: 4px;
  }
  .nt__label {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: var(--text-primary);
  }
  .nt__desc {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .nt__images {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }
  .nt__figure {
    margin: 0;
  }
  .nt__figure img {
    width: 100%;
    height: auto;
    border-radius: var(--r-lg);
    display: block;
  }

  @media (max-width: 640px) {
    .nt {
      grid-template-columns: 96px minmax(0, 1fr);
      gap: var(--s-4);
    }
    .nt__axis-cap { font-size: 10px; max-width: 96px; }
  }
</style>
