---
import BaseLayout from "../layouts/BaseLayout.astro";
import FadeIn from "../components/FadeIn.astro";
import HeroGrid from "../components/HeroGrid.astro";
import PolaroidStack from "../components/PolaroidStack.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Hi, in five languages. Auto-rotates with a width-animated container so
// the comma after the ticker glides instead of jumping.
const greetings = [
  { lang: "English",  hi: "Hi" },
  { lang: "Mandarin", hi: "你好" },
  { lang: "French",   hi: "Bonjour" },
  { lang: "Spanish",  hi: "Hola" },
  { lang: "Japanese", hi: "こんにちは" },
];

// Stack of personal polaroids that replaces the old hobby pill row. The
// portrait of Julia is the top card so the page still opens with her
// face; behind it, the four interest photos peek out and shuffle through
// on swipe / tap. Annotations and captions are styled like handwritten
// notes scribbled on the matte / over the photo.
const polaroidItems = [
  {
    src: `${base}/about/julia.jpg`,
    alt: "Portrait of Julia Tang",
    position: "50% 30%",
    tilt: 0,
    caption: "Swipe to learn more about me",
    scribble: "arrow" as const,
  },
  {
    src: `${base}/about/cat-mom.JPG`,
    alt: "Julia's two cats curled up on a bed",
    position: "50% 50%",
    caption: `Mom of two cats.`,
    annotations: [
      { label: "Poe",   top: "22%", left: "73%", tilt: -7 },
      { label: "Mocha", top: "55%", left: "52%", tilt: 4 },
    ],
  },
  {
    src: `${base}/about/scuba-diving.JPG`,
    alt: "Julia in scuba gear underwater",
    position: "50% 50%",
    caption: "Newly certified diver!",
  },
  {
    src: `${base}/about/snowboarding.JPG`,
    alt: "Julia snowboarding down a mountain",
    position: "50% 40%",
    caption: "Powder chaser in the winter",
    scribble: "mountain" as const,
  },
  {
    src: `${base}/about/languagelearning.png`,
    alt: "Julia's handwritten language-learning notebook",
    position: "18% 8%",
    aspectRatio: "320 / 300",
    photoAspect: "4 / 4.8",
    caption: `Currently: English, Mandarin, French, Japanese, Korean, Spanish`,
    annotations: [
      {
        label: "I love languages",
        top: "60%",
        left: "4%",
        tilt: -25,
        tail: false,
        maxWidth: "7.5rem",
      },
    ],
  },
];
---

<BaseLayout title="About">
  <div class="about-canvas" id="about-canvas">
    <HeroGrid />
    <article class="page-narrow about">
      <FadeIn>
        <p class="t-eyebrow about-eyebrow">About</p>
      </FadeIn>

      <FadeIn delay={80}>
        <h1 class="about-title">
          <span class="hi-ticker" aria-live="polite">
            <span class="hi-ghost" aria-hidden="true">&nbsp;</span>
            {greetings.map((g, i) => (
              <span class={`hi-word ${i === 0 ? "is-active" : ""}`} data-lang={g.lang}>{g.hi}</span>
            ))}
          </span><span class="title-rest">, I'm Julia.</span>
        </h1>
      </FadeIn>

      <FadeIn delay={160}>
        <div class="about-stack-row">
          <div class="about-stack-row__photos">
            <PolaroidStack items={polaroidItems} width="320px" />
          </div>

          <div class="about-stack-row__text about-note">
            <div class="about-note__inner">
              <p class="about-body">
                I'm a Product Designer at <span class="co-wrap"><strong class="co co--snap"><img src={`${base}/logos/snapchat.png`} alt="" aria-hidden="true" />Snap</strong>,</span> based in LA, where I present product strategy to the CEO weekly.
              </p>

              <p class="about-body">
                As an internet kid, I taught myself HTML to deck out my Neopets profile with <span class="glitter" aria-label="glitter graphics"><span class="glitter__text">glitter graphics</span><img class="glitter__gif" src={`${base}/about/glittergraphics.gif`} alt="" aria-hidden="true" loading="lazy" /></span> (shoutout to the <span class="fx fx--neopets"
                  ><span class="fx-photo fx-photo--bare fx-photo--wide" style="--tilt:0deg" aria-hidden="true"><img
                    src={`${base}/about/neopets.jpg`} alt="" loading="lazy" /></span
                  >Neopets HTML guide</span>). My taste was<span class="ellipsis">. . .</span>questionable. But the love for making digital things stuck.
              </p>

              <p class="about-body">
                Before product design, I studied <span class="fx fx--film"
                  ><span class="fx-photo" style="--tilt:-5deg" aria-hidden="true"><img
                    src={`${base}/about/film.png`} alt="" loading="lazy" /></span
                  >film</span> at USC, which gave me a deep appreciation for visual storytelling.
              </p>

              <p class="about-body">
                Overall, I just love making and tinkering with things, whether it's fully scaled features for millions, or just a fun side project for me.
              </p>
            </div>
          </div>
        </div>
      </FadeIn>

      <div class="about-body-stack">
        <section class="exp" aria-label="Experience">
          <FadeIn>
            <p class="t-eyebrow about-eyebrow">Experience</p>
          </FadeIn>

          <ol class="exp-list" role="list">
            <FadeIn delay={80}>
              <li class="exp-row" data-cursor="hide">
                <span class="exp-co-name">Snap Inc.</span>
                <div class="exp-role">
                  <p class="exp-role-title">Staff Product Designer</p>
                  <p class="exp-role-desc">Owning design for Camera, AR, Messaging, and Growth, plus new product verticals like Games and Topic Chats.</p>
                </div>
                <p class="exp-dates">2024 — Now</p>
                <span class="fx-photo fx-photo--bare exp-reveal-art exp-reveal-art--bare" style="--tilt:-2deg; width: auto;" aria-hidden="true">
                  <span class="exp-pair exp-pair--snap">
                    <img src={`${base}/about/snapchat-camera.gif`} alt="" loading="lazy" />
                    <img src={`${base}/about/onboarding.gif`} alt="" loading="lazy" />
                    <img src={`${base}/about/snapchat-hero.gif`} alt="" loading="lazy" />
                  </span>
                </span>
              </li>
            </FadeIn>

            <FadeIn delay={120}>
              <li class="exp-row" data-cursor="hide">
                <span class="exp-co-name">Tinder</span>
                <div class="exp-role">
                  <p class="exp-role-title">Senior Product Designer</p>
                  <p class="exp-role-desc">Owned the Swipe Stack and user discovery profiles. Introduced dynamic profiles to Tinder and led 0 to 1 discovery experiences.</p>
                </div>
                <p class="exp-dates">2021 — 2024</p>
                <span class="fx-photo fx-photo--bare exp-reveal-art exp-reveal-art--bordered" style="--tilt:3deg; width: 234px;" aria-hidden="true">
                  <img src={`${base}/about/tinder-hero.gif`} alt="" loading="lazy" />
                </span>
              </li>
            </FadeIn>

            <FadeIn delay={160}>
              <li class="exp-row" data-cursor="hide">
                <span class="exp-co-name">Whip Media</span>
                <div class="exp-role">
                  <p class="exp-role-title">UX Designer</p>
                  <p class="exp-role-desc">Designed Whip Media Marketplace 0 to 1 and led UX for TV Time, the consumer mobile app, doubling monthly active users during my tenure.</p>
                </div>
                <p class="exp-dates">2019 — 2021</p>
                <span class="fx-photo fx-photo--bare exp-reveal-art exp-reveal-art--bare" style="--tilt:-2deg; width: 420px;" aria-hidden="true">
                  <img src={`${base}/projects/tv-time-onboarding/hero-2.webp`} alt="" loading="lazy" />
                </span>
              </li>
            </FadeIn>

            <FadeIn delay={200}>
              <li class="exp-row" data-cursor="hide">
                <span class="exp-co-name">Tangent Agency</span>
                <div class="exp-role">
                  <p class="exp-role-title">Graphic &amp; Motion Designer</p>
                  <p class="exp-role-desc">Multi-format creative storytelling for marketing campaigns across major film and television releases.</p>
                </div>
                <p class="exp-dates">2018 — 2019</p>
                <span class="fx-photo fx-photo--bare exp-reveal-art" style="--tilt:0deg; width: auto;" aria-hidden="true">
                  <span class="exp-pair">
                    <img src={`${base}/about/GitS_AdvanceTicketsFacebook_1200x1200_V07 1.png`} alt="" loading="lazy" />
                    <img src={`${base}/about/BabyGroot_Infographic_Page_7 1.png`} alt="" loading="lazy" />
                  </span>
                </span>
              </li>
            </FadeIn>
          </ol>
        </section>

        <section class="cred cred--solo" aria-label="Awards">
          <div class="cred-col">
            <FadeIn>
              <p class="t-eyebrow about-eyebrow">Awards</p>
            </FadeIn>
            <FadeIn delay={80}>
              <ul class="cred-list" role="list">
                <li class="cred-row cred-row--reveal" data-cursor="hide">
                  <a class="cred-link cred-link--reveal" href="https://winners.webbyawards.com/2023" target="_blank" rel="noopener noreferrer">
                    <span class="cred-body">
                      <span class="cred-title">Webby Award</span>
                      <span class="cred-sub">Whip Media Marketplace</span>
                      <span class="fx-photo fx-photo--bare cred-reveal-art" style="--tilt:-2deg; width: 520px;" aria-hidden="true">
                        <img src={`${base}/about/wme.png`} alt="" loading="lazy" />
                      </span>
                    </span>
                    <span class="cred-meta">2023</span>
                  </a>
                </li>
                <li class="cred-row cred-row--reveal" data-cursor="hide">
                  <div class="cred-body">
                    <p class="cred-title">10-Year Hackathon Winner</p>
                    <p class="cred-sub">Tinder App Redesign</p>
                    <span class="fx-photo fx-photo--bare cred-reveal-phone" style="--tilt:-3deg; width: 200px;" aria-hidden="true">
                      <span class="cred-phone">
                        <span class="cred-phone__screen">
                          <video
                            src={`${base}/projects/tinder-app-redesign/sparks-recording.mp4`}
                            autoplay
                            muted
                            loop
                            playsinline
                            preload="metadata"
                            aria-hidden="true"
                          ></video>
                        </span>
                        <img class="cred-phone__frame" src={`${base}/projects/tinder-app-redesign/phone-frame.png`} alt="" aria-hidden="true" draggable="false" loading="lazy" />
                      </span>
                    </span>
                  </div>
                  <p class="cred-meta">2022</p>
                </li>
                <li class="cred-row cred-row--reveal" data-cursor="hide">
                  <a class="cred-link cred-link--reveal" href="https://winners.webbyawards.com/2021/apps-software-immersive/general-apps/entertainment-sports/167683/tv-time" target="_blank" rel="noopener noreferrer">
                    <span class="cred-body">
                      <span class="cred-title">Webby Award</span>
                      <span class="cred-sub">TV Time</span>
                      <span class="fx-photo fx-photo--bare cred-reveal-art" style="--tilt:-2deg; width: 680px;" aria-hidden="true">
                        <img src={`${base}/about/custom lists.png`} alt="" loading="lazy" />
                      </span>
                    </span>
                    <span class="cred-meta">2021</span>
                  </a>
                </li>
                <li class="cred-row cred-row--reveal" data-cursor="hide">
                  <a class="cred-link cred-link--reveal" href="https://www.thetangentagency.com/projects/lego-movie-2" target="_blank" rel="noopener noreferrer">
                    <span class="cred-body">
                      <span class="cred-title">Platinum AVA, Silver Clio</span>
                      <span class="cred-sub">The Lego Movie 2</span>
                      <span class="fx-photo fx-photo--bare cred-reveal-art" style="--tilt:2deg; width: 460px;" aria-hidden="true">
                        <img src={`${base}/about/lego-movie-2.gif`} alt="" loading="lazy" />
                      </span>
                    </span>
                    <span class="cred-meta">2019</span>
                  </a>
                </li>
              </ul>
            </FadeIn>
          </div>
        </section>

        <FadeIn delay={120}>
          <div class="about-cta about-cta--standalone">
            <a href={`${base}/#work`} class="cta-btn">
              Check out my work!
              <span class="cta-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </FadeIn>
      </div>

    </article>
  </div>
</BaseLayout>

<script is:inline>
  // Polyglot ticker — width-animated container + cross-fade so the comma
  // after the ticker glides smoothly instead of snapping.
  (async function () {
    const ticker = document.querySelector(".hi-ticker");
    if (!ticker) return;
    const words = Array.from(ticker.querySelectorAll(".hi-word"));
    if (words.length < 2) return;

    if (document.fonts && document.fonts.ready) {
      try { await document.fonts.ready; } catch (e) {}
    }

    function measure() {
      return words.map((w) => {
        const clone = w.cloneNode(true);
        clone.removeAttribute("class");
        clone.style.cssText =
          "position:absolute;visibility:hidden;opacity:1;transform:none;" +
          "white-space:nowrap;left:0;top:0;";
        ticker.appendChild(clone);
        const width = Math.ceil(clone.getBoundingClientRect().width);
        clone.remove();
        return width;
      });
    }

    let widths = measure();
    let i = 0;
    ticker.style.setProperty("--w", widths[i] + "px");

    const HOLD = 2400;
    const FADE = 700;

    setInterval(() => {
      const current = words[i];
      i = (i + 1) % words.length;
      const next = words[i];

      current.classList.remove("is-active");
      current.classList.add("is-leaving");
      next.classList.add("is-active");
      ticker.style.setProperty("--w", widths[i] + "px");

      setTimeout(() => {
        current.classList.remove("is-leaving");
      }, FADE);
    }, HOLD);

    let resizeT;
    window.addEventListener("resize", () => {
      clearTimeout(resizeT);
      resizeT = setTimeout(() => {
        widths = measure();
        ticker.style.setProperty("--w", widths[i] + "px");
      }, 120);
    });
  })();
</script>

<script is:inline>
  // Subtle scroll parallax for the handwritten note — drifts down a few
  // pixels as the row passes through the viewport center so the note
  // feels physically tucked next to the polaroid stack instead of
  // pinned. Photos are handled internally by PolaroidStack.
  (function () {
    const row = document.querySelector(".about-stack-row");
    if (!row) return;
    const note = row.querySelector(".about-note__inner");
    if (!note) return;

    let ticking = false;
    function update() {
      const r = row.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;
      if (r.bottom < -200 || r.top > vh + 200) {
        ticking = false;
        return;
      }
      const center = r.top + r.height / 2;
      let progress = (center - vh / 2) / (vh / 2);
      if (progress < -1) progress = -1;
      if (progress > 1) progress = 1;
      note.style.setProperty("--parallax-y", (progress * 10).toFixed(2) + "px");
      ticking = false;
    }
    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  })();
</script>

<script is:inline>
  // Per-character jitter for the handwritten note. Each printable
  // character becomes an inline-block span with a small random rotation
  // and vertical offset so the line doesn't sit on a perfect baseline.
  // Whitespace is left alone (preserves natural word wrap). Inline media
  // (.glitter-inline img, .fx-photo polaroids, prose-out previews) is
  // skipped so the cursor-portal artwork stays intact.
  (function () {
    const root = document.querySelector(".about-note");
    if (!root) return;
    const SKIP = new Set(["IMG", "VIDEO", "PICTURE", "SOURCE", "SVG"]);
    const SKIP_CLASS = ["fx-photo", "prose-out__preview", "pill-photo", "glitter-inline", "ellipsis"];

    function isSkipped(el) {
      if (!el || el.nodeType !== 1) return false;
      if (SKIP.has(el.tagName)) return true;
      if (el.classList) {
        for (const c of SKIP_CLASS) if (el.classList.contains(c)) return true;
      }
      return false;
    }

    function jitter(node) {
      const kids = Array.from(node.childNodes);
      for (const ch of kids) {
        if (ch.nodeType === 3) {
          // Text node
          const text = ch.textContent;
          if (!text || !text.trim()) continue;
          const frag = document.createDocumentFragment();
          for (const c of text) {
            if (c === " " || c === "\n" || c === "\t") {
              frag.appendChild(document.createTextNode(c));
            } else {
              const span = document.createElement("span");
              span.className = "hwc";
              const r = (Math.random() * 4 - 2).toFixed(2); // ±2deg
              const y = (Math.random() * 2.2 - 1.1).toFixed(2); // ±1.1px
              span.style.setProperty("--r", r + "deg");
              span.style.setProperty("--y", y + "px");
              span.textContent = c;
              frag.appendChild(span);
            }
          }
          ch.replaceWith(frag);
        } else if (ch.nodeType === 1) {
          if (isSkipped(ch)) continue;
          jitter(ch);
        }
      }
    }

    root.querySelectorAll(".about-body").forEach(jitter);
  })();
</script>

<script is:inline>
  // Touch tap-to-reveal for the hover-only image cues that would
  // otherwise live in the custom cursor: .fx-photo polaroids under
  // "film"/"Neopets HTML guide", .prose-out__preview behind "The Lego
  // Movie 2", and the .exp-row / .cred-row--reveal art on the right
  // column. Adds .is-revealed to the closest container on tap; tapping
  // a second time (or anywhere outside) clears it. No-op on hover-
  // capable devices — the cursor portal handles those.
  (function () {
    const coarse = window.matchMedia(
      "(hover: none), (pointer: coarse), (max-width: 720px)"
    ).matches;
    if (!coarse) return;

    const SELECTORS = ".fx, .prose-out, .exp-row, .cred-row--reveal";
    function init() {
      document.querySelectorAll(SELECTORS).forEach(function (el) {
        // Make the container focusable / tappable. The .fx / .prose-out
        // are inline spans wrapping body text, so we don't add role=button
        // (that would break inline accessibility); just listen for clicks.
        el.addEventListener("click", function (e) {
          // Let inline links inside the reveal target keep their default
          // behavior. .cred-link--reveal IS the link, so we still toggle
          // for that and let the user tap the link separately for the
          // outbound action via the visible Webby/credit text.
          if (
            !el.classList.contains("cred-row--reveal") &&
            e.target.closest &&
            e.target.closest("a")
          ) return;
          e.preventDefault();
          const wasOpen = el.classList.contains("is-revealed");
          document.querySelectorAll(SELECTORS + ".is-revealed").forEach(function (other) {
            if (other !== el) other.classList.remove("is-revealed");
          });
          el.classList.toggle("is-revealed", !wasOpen);
        });
      });

      // Outside tap collapses any open reveal.
      document.addEventListener("click", function (e) {
        const inTrigger = e.target.closest && e.target.closest(SELECTORS);
        if (inTrigger) return;
        document.querySelectorAll(SELECTORS + ".is-revealed").forEach(function (el) {
          el.classList.remove("is-revealed");
        });
      });
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
  })();
</script>

<style>
  .about-canvas {
    position: relative;
    isolation: isolate;
  }

  /* Lock the polaroid mats and the handwritten-note canvas to their
     light-mode treatment regardless of the page theme. Photographs and
     handwritten paper read as physical artifacts pinned to the canvas,
     so they shouldn't flip to dark surfaces when the rest of the site
     does. */
  .fx-photo {
    background: #FFFFFF !important;
    border-color: #EAE6DF !important;
  }
  /* Every text node inside the handwritten note stays dark ink, even
     for inline emphasis (.co, .fx--film, .fx--neopets, .prose-out, etc.)
     or any link/hover state that would otherwise pull from theme tokens
     and flip pale in dark mode. */
  .about-note,
  .about-note *,
  [data-theme="dark"] .about-note,
  [data-theme="dark"] .about-note * {
    color: #15171C !important;
  }
  /* .fx-photo--bare deliberately drops the polaroid frame — keep that
     transparent treatment intact. */
  .fx-photo--bare,
  .cursor__media .fx-photo--bare {
    background: none !important;
    border: none !important;
  }

  .about {
    padding-top: var(--s-24);
    position: relative;
    max-width: 940px;
    --about-shift: clamp(0px, 3vw, 48px);
  }
  /* Shared inward shift: header elements (eyebrow, title) and the
     scrapbook row all start at the same x-position so the headline reads
     as flush-left with the photo stack's left edge. */
  .about-eyebrow,
  .about-title,
  .about-stack-row { padding-left: var(--about-shift); }
  /* Nested eyebrows (Experience / Awards section headers) already
     inherit the shift via their parent section's padding-left — reset
     so they don't double-pad off-grid. */
  .exp .about-eyebrow,
  .cred .about-eyebrow { padding-left: 0; }
  @media (max-width: 760px) {
    .about { --about-shift: 0px; }
  }
  @media (max-width: 720px) {
    .about { padding-top: var(--s-10); }
  }
  /* Narrow desktop (1024–1340px): the SideRail wordmark + Work/About/Resume
     nav are still visible (the rail dissolves into the sticky header at
     ≤1023px), and the default .about max-width: 940px combined with the
     `margin: 0 auto` from .page-narrow leaves only ~10px between the rail
     and the leftmost content (title, polaroid, body copy) at these
     viewports. Cap the container to .page-narrow's natural 760px and push
     it right with a viewport-scaled margin so the content visibly clears
     the rail. */
  @media (min-width: 1024px) and (max-width: 1340px) {
    .about {
      max-width: 760px;
      margin-left: clamp(220px, 22vw, 300px);
      margin-right: auto;
    }
  }
  .about-eyebrow { margin-bottom: var(--s-3); color: var(--text-tertiary); }

  /* Body stack — paragraphs flush-left at the same edge as the title.
     The about-stack-row above (PolaroidStack + note) sits at the same
     edge; the experience and awards sections fall in below. */
  .about-body-stack {
    margin-top: var(--s-12);
  }
  .about-body-stack::after {
    content: "";
    display: block;
    clear: both;
  }

  /* About stack row — the swipeable polaroid deck on the left, the
     handwritten note column on the right. The note overlaps the stack
     by a small margin so the page reads as a journal page with photos
     tucked over a letter. Stacks vertically on narrow viewports.
     Margin-bottom matches the old .about-row spacing so the section
     below (Experience / Awards) keeps the same rhythm. */
  .about-stack-row {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    margin-top: var(--s-12);
    margin-bottom: clamp(var(--s-10), 5vw, var(--s-20));
    /* Headroom under the deck so the swipe-affordance pill below the
       deck (the narrow-desktop fallback) doesn't get clipped by the
       next section. */
    padding-bottom: var(--s-3);
  }
  .about-stack-row__photos {
    flex: 0 0 auto;
    position: relative;
    z-index: 2;
  }
  .about-stack-row__text {
    flex: 0 1 auto;
    min-width: 0;
    max-width: 380px;
  }
  .about-stack-row__text > .about-note__inner > .about-body:last-child {
    margin-bottom: 0;
  }
  @media (max-width: 760px) {
    .about-stack-row {
      flex-direction: column;
      align-items: stretch;
      gap: var(--s-6);
    }
    .about-stack-row__photos {
      align-self: center;
    }
  }

  .about-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: normal;
    font-size: clamp(48px, 6.4vw, 88px);
    line-height: 1.0;
    letter-spacing: -0.01em;
    margin: 0 0 var(--s-10);
    color: var(--text-primary);
    white-space: nowrap;
  }
  @media (max-width: 720px) {
    .about-title { white-space: normal; font-size: clamp(40px, 9vw, 56px); margin-bottom: var(--s-8); }
  }
  @media (max-width: 420px) {
    .about-title { font-size: 38px; }
  }

  .hi-ticker {
    position: relative;
    display: inline-block;
    vertical-align: baseline;
    width: var(--w, auto);
    height: 1em;
    line-height: 1;
    transition: width 600ms cubic-bezier(0.16, 1, 0.3, 1);
    overflow: visible;
  }
  .hi-ghost {
    display: inline-block;
    width: 0;
    visibility: hidden;
  }
  .hi-word {
    position: absolute;
    top: 0;
    left: 0;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-0.32em);
    transition:
      opacity 480ms var(--ease-out),
      transform 700ms var(--ease-out);
    will-change: opacity, transform;
  }
  .hi-word.is-active {
    opacity: 1;
    transform: translateY(0);
    transition-duration: 700ms;
  }
  .hi-word.is-leaving {
    opacity: 0;
    transform: translateY(0.32em);
    transition-duration: 380ms;
  }
  .title-rest { color: var(--text-primary); }

  /* All about-page body paragraphs share the same type so the page reads
     as a single voice, not a resume summary + body. */
  .about-body-stack :global(.below-portrait) {
    clear: left;
  }

  /* Handwritten note treatment for the intro narrative — the prose
     column reads like a personal letter on paper, sitting next to the
     polaroid stack. The note tucks a small distance behind the stack on
     the left edge so the page reads as a journal page with photos
     tucked over a letter. */
  .about-note {
    position: relative;
    z-index: 1;
    flex: 0 1 auto;
    max-width: 520px;
    background-color: #FFFFFF;
    /* Crumpled grid-paper photo Julia provided. Layer a translucent
       white over the texture to lift its overall brightness and soften
       its contrast — the crumple + grid still read through but the
       shadows are gentler. */
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.35), rgba(255, 255, 255, 0.35)),
      url("/about/paper-texture.avif");
    background-size: 100% 100%, cover;
    background-position: center, center;
    background-repeat: no-repeat, no-repeat;
    padding: var(--s-10) var(--s-10) var(--s-10) 92px;
    margin-left: -60px;
    border-radius: var(--r-md);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.6) inset,
      0 22px 44px -22px rgba(40, 40, 60, 0.18),
      0 6px 14px -4px rgba(40, 40, 60, 0.08);
    transform: rotate(-1.2deg);
    transform-origin: 50% 50%;
    transition:
      transform 520ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 520ms var(--ease-out);
  }
  /* Single-artifact fade-in: override .fade-in's translateY+scale entry
     so the note rotates in as one piece (don't fight the -1.2deg rest
     transform). Paragraphs inside ride along with the parent. */
  .about-note.fade-in {
    opacity: 0;
    transform: rotate(-1.2deg) translateY(28px) scale(0.97);
    filter: blur(4px);
  }
  .about-note.fade-in.is-visible {
    opacity: 1;
    transform: rotate(-1.2deg) scale(1);
    filter: blur(0);
  }
  .about-note.fade-in.is-visible:hover {
    transform: rotate(0.4deg) translateY(-4px);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.6) inset,
      0 34px 60px -22px rgba(40, 40, 60, 0.28),
      0 10px 22px -6px rgba(40, 40, 60, 0.14);
  }
  /* Inner wrapper carries the scroll-parallax translate. No transition
     here, so scroll updates paint instantly — no lag/jitter from a
     transform tween chasing the scroll position. */
  .about-note__inner {
    display: block;
    transform: translate3d(0, var(--parallax-y, 0), 0);
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    .about-note { transition: none; }
    .about-note.fade-in.is-visible:hover { transform: rotate(-1.2deg); }
    .about-note__inner { transform: none; }
  }
  .about-note .about-body {
    font-family: var(--font-hand);
    font-weight: 400;
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.1;
    letter-spacing: -0.07em;
    word-spacing: 0.14em;
    /* Lock to the light-mode ink color regardless of theme — the
       handwritten note's paper is always white, so the writing should
       always read as dark ink, not flip pale in dark mode. */
    color: #15171C;
  }
  /* Snap (and any other .co callout) defaults to inline-flex with a
     `gap` that spaces every flex child — including the per-character
     jitter spans we wrap text into. Inside the note, override to plain
     inline so the letters of "Snap" sit at the same tracking as the
     rest of the script, and nudge the logo image manually. */
  .about-note .about-body .co {
    display: inline;
    gap: 0;
    padding: 0;
    white-space: nowrap;
  }
  .about-note .about-body .co img {
    height: 0.62em;
    max-width: none;
    margin-right: 0.08em;
    /* Pull the logo up so its visual middle aligns with the
       handwriting's x-height. The handwritten letters sit a touch
       lower than printed type, so the logo image needs a small
       NEGATIVE translate to land on the text baseline instead of
       hanging below it. */
    transform: translateY(-0.06em);
  }
  /* Per-character jitter — JS wraps each printable char in .hwc and
     stamps a small random rotation + vertical offset via inline vars so
     letters don't all sit on the same baseline at the same angle. */
  .about-note .about-body .hwc {
    display: inline-block;
    transform: translateY(var(--y, 0)) rotate(var(--r, 0));
    transform-origin: 50% 80%;
  }
  /* The Snap company name and other inline emphasis ride the
     handwritten font too, but the inline logo image keeps its size. */
  .about-note .about-body .co {
    font-family: inherit;
    font-weight: 400;
  }
  .about-note .about-body strong {
    font-weight: 400;
  }
  /* Spaced ellipsis ". . ." for the "My taste was [...] questionable"
     pause. Resets the note's tight letter-spacing so the dots breathe,
     and adds horizontal padding so it doesn't crash into the words on
     either side. */
  .about-note .about-body .ellipsis {
    display: inline-block;
    letter-spacing: -0.18em;
    padding: 0 0.4em;
    text-decoration: none;
    background: none;
  }

  /* Inside the handwritten note, the powder-blue brand underline gets
     visually lost against the blue grid-paper lines. Use a warm coral
     that contrasts the grid, and thicken the line so it reads at the
     larger handwriting size. */
  .about-note {
    /* Dusk-blue colored-pencil underline. #446680 lives in the style
       guide as the dark-mode --brand-selection ("dusk blue — light
       text reads on it"), so it's a real palette stop, not an
       invented color. Reads as inky pen on the paper, contrasts hard
       against the powder-blue grid so the emphasis pops instead of
       blending into the lines. */
    --note-underline: #446680;
    --note-underline-wash: var(--brand-wash);
    /* Positive offset drops the rule below the baseline (was -2px). */
    --note-underline-offset: 2px;
  }
  /* Inside the note, draw the emphasis underline with text-decoration
     so it sits right at the letter baseline. Descenders like y and g
     naturally cross the line, giving it a hand-drawn underline feel
     instead of a perfectly clean rule. The hover wash is layered as
     background-image, which doesn't fight the decoration.

     Note: Snap (.co / strong wrapper) is intentionally NOT in this
     list. Now that Snap has no hover state in the note, an underline
     would read as a dead affordance — the company name just rides as
     part of the prose voice, with the inline logo doing all the
     branding work. */
  .about-note .about-body .fx--film,
  .about-note .about-body .fx--neopets,
  .about-note .about-body .prose-out {
    text-decoration: underline;
    text-decoration-color: var(--note-underline);
    text-decoration-thickness: 2px;
    text-underline-offset: var(--note-underline-offset, 2px);
    background-image: linear-gradient(var(--note-underline-wash), var(--note-underline-wash));
    background-size: 100% 0;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 280ms var(--ease-out);
  }
  .about-note .about-body .fx--film:hover,
  .about-note .about-body .fx--neopets:hover,
  .about-note .about-body .prose-out:hover {
    background-size: 100% 100%;
  }
  /* Snap (and any other .co callout) inside the note stays static — no
     hover wash, no company-color fill. It's part of the prose voice,
     not an interactive chip the way the homepage hero treats it. The
     reset below kills both the global underline-fill on .co:hover
     and the company-specific wash (--co-wash-snap) for any .co inside
     the note. */
  .about-note .about-body .co:hover,
  .about-note .about-body .co--snap:hover {
    background-size: 100% 0;
    background-image: linear-gradient(var(--note-underline-wash), var(--note-underline-wash));
  }
  /* Homemade Apple is dense and italicized by nature; the inline polaroid
     captions, .fx underlines, and prose-out links inherit the script too.
     Bump their kerning slightly so they don't crowd adjacent words. */
  .about-note .about-body .fx,
  .about-note .about-body .fx--film,
  .about-note .about-body .fx--neopets,
  .about-note .about-body .prose-out {
    font-family: inherit;
  }
  @media (max-width: 760px) {
    .about-note {
      padding: var(--s-6);
      margin-left: 0;
      transform: none;
    }
  }

  .about-body {
    font-size: clamp(20px, 2vw, 24px);
    line-height: 1.5;
    color: var(--text-primary);
    margin: 0 0 var(--s-5);
    /* Let the browser rebalance the last 1–2 lines so we don't end up
       with a lonely "(" or a single-word widow at the end of a paragraph
       in the narrow two-up columns. */
    text-wrap: pretty;
  }
  .about-body strong {
    font-weight: 600;
    color: var(--text-primary);
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    padding-bottom: 1px;
  }

  /* Interactive company callouts — small logo to the left, brand underline
     at rest, company-colored wash on hover. Matches the homepage hero pattern. */
  .about-body .co {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    line-height: inherit;
    white-space: nowrap;
    gap: 0.32em;
    padding: 0 0.18em;
    cursor: default;
    font-weight: 400;
    border-radius: var(--r-xs);
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 0;
    transition:
      background-size 280ms var(--ease-out),
      background-image 280ms var(--ease-out);
  }
  .about-body .co img {
    height: 0.95em;
    width: auto;
    max-width: 1.4em;
    display: inline-block;
    object-fit: contain;
    position: relative;
    z-index: 1;
    /* Nudge the logo down a hair so its visual mid-line aligns with
       the text baseline (logos read top-heavy at baseline alignment). */
    transform: translateY(0.08em);
  }
  /* Keep the company callout and its trailing comma on the same line so
     the comma can't be orphaned to the start of the next line. */
  .about-body .co-wrap {
    white-space: nowrap;
  }
  .about-body .co:hover {
    background-size: 100% 100%;
  }
  .about-body .co--snap:hover {
    background-image: linear-gradient(var(--co-wash-snap), var(--co-wash-snap));
  }
  .about-body .co--tinder:hover {
    background-image: linear-gradient(var(--co-wash-tinder), var(--co-wash-tinder));
  }
  .about-body .co--tvtime:hover {
    background-image: linear-gradient(var(--co-wash-tvtime), var(--co-wash-tvtime));
  }
  .about-body .co--whip:hover {
    background-image: linear-gradient(var(--co-wash-whip), var(--co-wash-whip));
  }

  .fx {
    position: relative;
    display: inline-block;
    cursor: default;
  }

  /* Polaroid photo that appears above an .fx word on hover. Image renders
     at natural aspect (no crop). Each .fx-photo can set its own --tilt. */
  .fx-photo {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    width: 240px;
    pointer-events: none;
    opacity: 0 !important;
    transform: translateX(-50%) translateY(8px) rotate(var(--tilt, -4deg)) scale(0.94);
    transform-origin: 50% 100%;
    transition:
      opacity 240ms var(--ease-out),
      transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 5;
    background: var(--bg-surface);
    /* Thin polaroid border so the image fills the frame instead of
       floating in a bulky matte. */
    padding: 3px 3px 10px;
    border-radius: var(--r-xs);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-subtle);
  }
  .fx-photo img {
    width: 100%;
    height: auto;
    display: block;
  }
  /* Bare + wide variant — no polaroid frame, larger so a full
     screenshot like the Neopets HTML guide reads at this scale. */
  .fx-photo--bare {
    background: none;
    border: none;
    box-shadow: none;
    padding: 0;
    border-radius: var(--r-xs);
    overflow: hidden;
  }
  .fx-photo--wide { width: 460px; }
  /* The hover-revealed photo is rendered as a clone inside the
     custom cursor (.cursor__media), so the original stays invisible. */

  .fx--film,
  .fx--clio {
    font-weight: 400;
    color: var(--text-primary);
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    padding-bottom: 1px;
    border-radius: var(--r-xs);
    transition:
      background-size 280ms var(--ease-out),
      background-image 280ms var(--ease-out);
  }
  .fx--film:hover,
  .fx--clio:hover {
    background-image: linear-gradient(var(--brand-wash-soft), var(--brand-wash-soft));
    background-size: 100% 100%;
  }

  /* Neopets nod — softer than .fx--film, no bold weight, just a thin
     brand underline that fills into the wash on hover. The cursor-portal
     image is the main hover signal; the underline is only a hint that
     the parenthetical is hoverable. */
  /* Glitter graphics — always-on inline GIF that replaces the words
     "glitter graphics" in the sentence flow. Sized to sit inside the
     paragraph's line-box without pushing the line taller than its
     text-only siblings (1.4em + a -0.15em baseline nudge keeps the
     glyphs centered on the x-height, per the HM stress-test fix). */
  .glitter-inline {
    display: inline-block;
    vertical-align: -0.15em;
    height: 1.4em;
    width: auto;
    margin: 0 0.1em;
  }

  /* Glitter swap — by default the words "glitter graphics" read inline
     with the same brand underline as other emphasis words. On hover the
     text fades out and the looping GIF fades in over the same footprint
     so the line never reflows. */
  .glitter {
    position: relative;
    display: inline-block;
    cursor: default;
  }
  .glitter__text {
    display: inline-block;
    color: #15171C;
    text-decoration: underline;
    text-decoration-color: var(--note-underline, var(--brand-primary));
    text-decoration-thickness: 2px;
    text-underline-offset: var(--note-underline-offset, 2px);
    transition: opacity 220ms var(--ease-out);
  }
  .glitter__gif {
    position: absolute;
    left: 50%;
    top: 50%;
    /* Match the in-flow line size so the GIF reads as a swap for the
       text, not as an oversized graphic that overflows the column. The
       1.55em / -0.15em pairing mirrors the always-on .glitter-inline
       sizing used elsewhere in the paragraph, with a small bump so the
       GIF reads a touch wider than the underlying text footprint. */
    height: 1.0em;
    width: auto;
    max-width: 110%;
    transform: translate(-50%, calc(-50% - 0.15em));
    transform-origin: 50% 50%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 220ms var(--ease-out);
    z-index: 5;
  }
  .glitter:hover .glitter__text { opacity: 0; }
  .glitter:hover .glitter__gif { opacity: 1; }

  /* Keep .fx--neopets as plain inline so the link wraps with the
     surrounding sentence instead of being treated as an inline-block
     atom that pushes adjacent punctuation onto its own line. */
  .fx--neopets {
    display: inline;
    white-space: nowrap;
    color: var(--text-primary);
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    padding-bottom: 1px;
    border-radius: var(--r-xs);
    transition:
      background-size 280ms var(--ease-out),
      background-image 280ms var(--ease-out);
  }
  .fx--neopets:hover {
    background-image: linear-gradient(var(--brand-wash-soft), var(--brand-wash-soft));
    background-size: 100% 100%;
  }

  .about-highlight {
    position: relative;
    background-color: var(--bg-surface);
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.62), rgba(255, 255, 255, 0.62)),
      linear-gradient(
        135deg,
        #F8E4D9 0%,
        #EAE2F0 45%,
        #F8E4D9 75%,
        #DDEAF2 100%
      );
    background-size: 100% 100%, 260% 260%;
    background-position: 0 0, 0% 50%;
    background-repeat: no-repeat, no-repeat;
    border-radius: var(--r-sm);
    padding: var(--s-4) var(--s-5);
    text-align: center;
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(20px, 2.2vw, 24px);
    line-height: 1.35;
    transition: background-color 600ms var(--ease-out);
  }
  .about-highlight::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1.5px;
    background: conic-gradient(
      from var(--shine-angle, 0deg),
      transparent 0deg,
      rgba(197, 220, 234, 0.9) 60deg,
      rgba(220, 210, 232, 0.9) 110deg,
      rgba(244, 217, 204, 0.9) 160deg,
      transparent 220deg,
      transparent 360deg
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
            mask-composite: exclude;
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
    pointer-events: none;
  }
  .about-highlight:hover {
    animation: about-highlight-drift 8s ease-in-out infinite;
  }
  .about-highlight:hover::before {
    opacity: 1;
    animation: about-highlight-shine 6s linear infinite;
  }
  @keyframes about-highlight-drift {
    0%   { background-position: 0 0, 0% 50%; }
    50%  { background-position: 0 0, 100% 50%; }
    100% { background-position: 0 0, 0% 50%; }
  }
  @property --shine-angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }
  @keyframes about-highlight-shine {
    to { --shine-angle: 360deg; }
  }
  @media (prefers-reduced-motion: reduce) {
    .about-highlight,
    .about-highlight:hover,
    .about-highlight:hover::before { animation: none; transition: none; }
  }

  .about-body b {
    font-weight: 600;
    color: var(--text-primary);
  }

  .fx--key {
    font-weight: 600;
    color: var(--text-primary);
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    padding-bottom: 1px;
    border-radius: var(--r-xs);
    transition:
      background-size 280ms var(--ease-out),
      background-image 280ms var(--ease-out);
  }
  .fx--key:hover {
    background-image: linear-gradient(var(--brand-wash-soft), var(--brand-wash-soft));
    background-size: 100% 100%;
  }

  /* Outbound prose links — match the fx-- words: brand underline fills to a
     full wash on hover so the whole word highlights. */
  .prose-out {
    font-weight: 400;
    color: var(--text-primary);
    text-decoration: none;
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    padding-bottom: 1px;
    border-radius: var(--r-xs);
    transition:
      background-size 280ms var(--ease-out),
      background-image 280ms var(--ease-out);
  }
  .prose-out:hover {
    background-image: linear-gradient(var(--brand-wash-soft), var(--brand-wash-soft));
    background-size: 100% 100%;
  }

  /* Image preview that floats above the link on hover. Default has a
     polaroid frame; the --bare modifier drops the frame for actual work
     images (Webby, Lego Movie 2). Each preview can set its own --tilt. */
  .prose-out--preview {
    position: relative;
  }
  .prose-out__preview {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    /* width intentionally omitted so the global
       .prose-out__preview--wide value (820px) isn't shadowed by a
       higher-specificity scoped base. */
    pointer-events: none;
    opacity: 0;
    transform: translateX(-50%) translateY(8px) rotate(var(--tilt, -3deg)) scale(0.94);
    transform-origin: 50% 100%;
    transition:
      opacity 240ms var(--ease-out),
      transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 5;
    background: var(--bg-surface);
    padding: 10px 10px 40px;
    border-radius: var(--r-sm);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-subtle);
  }
  .prose-out__preview--bare {
    background: none;
    padding: 0;
    border: none;
    border-radius: var(--r-xs);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  .prose-out__preview--round {
    width: 162px;
    aspect-ratio: 1 / 1;
    background: none;
    padding: 0;
    border: none;
    border-radius: 50%;
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  .prose-out__preview--round img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.18);
    transform-origin: center;
  }
  /* Width override removed — the global .prose-out__preview--wide
     value (820px) was being pinned down to 320px by this scoped
     duplicate, capping the Lego Movie 2 hover at the wrong size. */
  .prose-out__preview img {
    width: 100%;
    height: auto;
    display: block;
  }
  .prose-out--preview:hover .prose-out__preview,
  .prose-out--preview:focus-visible .prose-out__preview {
    opacity: 1;
    transform: translateX(-50%) translateY(0) rotate(var(--tilt, -3deg)) scale(1);
  }

  /* Touch devices: the cursor-portal images can't fire without a real
     mouse, so the .fx-photo polaroids and .prose-out__preview previews
     for "film", "Neopets HTML guide", and "The Lego Movie 2" stay
     hidden by default and reveal as an inline block only when the user
